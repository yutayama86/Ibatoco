{
  "schemaVersion": 2,
  "primary": {
    "name": "GA4 月間表示回数10万",
    "source": "Google Analytics 4",
    "accountId": "547804264",
    "metric": "screen_page_views",
    "metricLabel": "Views（ウェブでは page_view。再閲覧を含む）",
    "windowDays": 28,
    "target": 100000,
    "stabilityDays": 14,
    "definition": "GA4のscreen_page_views（Views）をローリング28日で100,000以上。単発イベントの山だけでなく14日連続で目標水準を維持できたら安定達成とみなす。"
  },
  "secondary": {
    "searchConsole": {
      "role": "acquisition_diagnostic",
      "metrics": [
        "clicks",
        "impressions",
        "ctr",
        "position"
      ],
      "note": "GSC表示回数はNorth Starではない。GA4 Viewsを増やすための検索獲得診断に使う。"
    },
    "business": {
      "role": "business_health",
      "metrics": [
        "confirmed_revenue",
        "gross_profit",
        "revenue_per_1000_views",
        "revenue_per_hour",
        "recurring_revenue_share"
      ],
      "note": "値が取得できない場合は推測しない。Views 100,000達成だけで事業成功としない。"
    }
  },
  "guardrails": {
    "doNotOptimizeViewsAlone": true,
    "watch": [
      "active_users",
      "sessions",
      "engagement_rate",
      "organic search sessions",
      "gsc clicks",
      "gsc ctr",
      "gsc position",
      "business_cta_click",
      "outbound_booking_click",
      "generate_lead",
      "returning sessions",
      "returning views",
      "confirmed affiliate revenue",
      "confirmed B2B revenue",
      "revenue per 1000 views",
      "gross profit",
      "revenue per hour",
      "channel concentration"
    ],
    "notes": "GA4 Viewsだけを増やすための不要なページ分割や自動リロードは禁止。検索意図適合、一次情報性、流入、回遊、送客・問い合わせを同時に確認する。"
  },
  "acquisitionOperatingModel": {
    "effectiveDate": "2026-10-01",
    "targetMonth": "2026-11",
    "targetViews": 100000,
    "mode": "portfolio-gap-closure",
    "objective": "Maximize probability of reaching 100,000 GA4 Views in November by allocating effort to the largest confidence-adjusted incremental Views opportunities.",
    "portfolioClusters": [
      "autumn-leaves",
      "oarai-ankou",
      "tsuchiura-fireworks",
      "november-major-demand",
      "evergreen-utility",
      "validated-other-channels"
    ],
    "requiredDailyFields": [
      "portfolioExpectedViews",
      "confidenceAdjustedExpectedViews",
      "coverage",
      "unfilledViews",
      "paceStatus",
      "growthBatchExpectedIncrementalViews"
    ],
    "paceGates": {
      "onPaceCoverage": 1.2,
      "atRiskCoverage": 1,
      "offPaceBelow": 1
    },
    "growthQualification": [
      "new-search-demand",
      "ranking-or-ctr-uplift",
      "recirculation-uplift",
      "validated-channel-growth",
      "high-intent-monetization"
    ],
    "maintenanceDoesNotCountAsGrowth": true,
    "notes": "Maintenance remains mandatory for trust and correctness but cannot by itself satisfy the daily Growth Batch while executable growth work exists."
  }
}
