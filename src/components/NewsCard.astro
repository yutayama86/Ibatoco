---
import type { CollectionEntry } from 'astro:content';
import { NEWS_CATEGORIES } from '../data/news';
import { MUNI_BY_SLUG } from '../data/areas';
import { formatDate } from '../lib/content';
import { listImageOf } from '../lib/card-image';

interface Props {
  item: CollectionEntry<'news'>;
  compact?: boolean;
  featured?: boolean;
}

const { item, compact = false, featured = false } = Astro.props;
const slug = item.id.split('/').pop();
const allMunicipalities = item.data.municipalities.map((value) => MUNI_BY_SLUG.get(value)?.name).filter(Boolean);
/**
 * 市町村を全部並べると、16件持つ記事でカードの札が3行になり、
 * 見出しが押し下がって隣のカードと頭がそろわなくなる。3件までにして残りは数で示す。
 */
const MUNI_SHOWN = 3;
const municipalities = allMunicipalities.length > MUNI_SHOWN
  ? [...allMunicipalities.slice(0, MUNI_SHOWN), `ほか${allMunicipalities.length - MUNI_SHOWN}市町村`]
  : allMunicipalities;
/**
 * 一覧カードを画像なしにしない。選び方は src/lib/card-image.ts に一本化している
 * （専用カード画像 → 記事のビジュアル → 自動生成OGP）。
 */
const { src: image, alt: imageAlt, source: imageSource } = listImageOf(item);
---

<article class:list={['news-card', { compact, featured, 'has-image': Boolean(image) }]} data-image-source={imageSource}>
  {image && (
    <a class="news-card__image" href={`/news/${slug}/`} tabindex="-1" aria-hidden="true">
      <img src={image} alt={imageAlt} loading={featured ? 'eager' : 'lazy'} decoding="async" width="1200" height="630" />
    </a>
  )}
  <div class="news-card__body">
    <div class="news-card__meta">
      <span>{NEWS_CATEGORIES[item.data.category].label}</span>
      {municipalities.length > 0 && <span>{municipalities.join('・')}</span>}
      {item.data.sample && <span class="news-card__sample">実装確認用</span>}
    </div>
    <h3><a href={`/news/${slug}/`}>{item.data.title}</a></h3>
    {!compact && <p>{item.data.description}</p>}
    <div class="news-card__dates">
      <time datetime={item.data.pubDate.toISOString()}>公開 {formatDate(item.data.pubDate)}</time>
      {item.data.updatedDate && <time datetime={item.data.updatedDate.toISOString()}>更新 {formatDate(item.data.updatedDate)}</time>}
      <span class="news-card__arrow" aria-hidden="true">↗</span>
    </div>
  </div>
</article>

<style>
  .news-card{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto 1fr;height:100%;min-width:0;overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-xs);background:var(--color-white);transition:border-color .2s ease,box-shadow .2s ease}
  .news-card:not(.has-image){grid-template-rows:1fr}
  .news-card:hover,.news-card:focus-within{border-color:var(--color-tide);box-shadow:var(--brand-shadow-lift)}
  .news-card__image{display:block;overflow:hidden;aspect-ratio:16/9;background:var(--color-mist)}
  .news-card__image img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
  .news-card:hover .news-card__image img{transform:scale(1.025)}
  .news-card__body{display:flex;flex-direction:column;min-width:0;padding:1.4rem}
  .news-card__meta{display:flex;flex-wrap:nowrap;align-items:center;gap:.5rem .75rem;min-width:0;color:var(--color-tide);font:600 .7rem/1.5 var(--font-brand-meta);letter-spacing:.03em}
  .news-card__meta>*{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
  .news-card__meta>span:first-child{flex:none;padding-left:.65rem;border-left:2px solid currentColor}
  .news-card__sample{color:var(--color-signal)}
  h3{margin-top:.85rem;color:var(--color-ink);font:600 clamp(1.1rem,1.6vw,1.3rem)/1.65 var(--font-brand-display);letter-spacing:.01em;overflow-wrap:anywhere}
  h3 a{text-decoration:none}h3 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.2em}
  p{margin-top:.85rem;color:var(--color-soil);font-size:.84rem;line-height:1.9}
  .news-card__dates{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .85rem;margin-top:auto;padding-top:1.25rem;color:var(--color-soil);font:.68rem/1.6 var(--font-brand-meta)}
  .news-card__arrow{display:grid;place-items:center;flex:none;width:1.9rem;height:1.9rem;margin-left:auto;border:1px solid var(--color-line);border-radius:50%;color:var(--color-tide);font-size:1rem}
  .compact .news-card__body{padding:1.1rem}.compact h3{font-size:1.04rem}
  .featured{grid-column:1/-1;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);grid-template-rows:auto;align-items:stretch}
  .featured .news-card__image{aspect-ratio:auto;min-height:19rem}
  .featured .news-card__image img{object-fit:contain}
  .featured .news-card__body{justify-content:center;padding:clamp(1.4rem,3vw,2.75rem)}
  .featured h3{font-size:clamp(1.4rem,2.1vw,1.95rem);line-height:1.6}
  .featured p{max-width:var(--measure)}
  .featured .news-card__dates{margin-top:1rem}
  @media(max-width:760px){.featured{grid-template-columns:minmax(0,1fr);grid-template-rows:auto 1fr}.featured .news-card__image{aspect-ratio:16/9;min-height:0}.featured h3{font-size:1.35rem}.featured .news-card__body{padding:1.25rem}.news-card__body{padding:1.1rem}}
  @media(prefers-reduced-motion:reduce){.news-card,.news-card__image img{transition:none}.news-card:hover .news-card__image img{transform:none}}
</style>
