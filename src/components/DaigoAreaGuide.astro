---
/**
 * 大子町エリアガイド（旗艦・リッチ版）。日立市（HitachiAreaGuide）と同水準の作り込み。
 *   事実・数値は大子町／大子町観光協会の公開情報に基づく。架空の加筆はしない。
 *   画像は Wikimedia Commons の CC 素材。作者・ライセンス表記（figcaption）は必ず残す（削除不可）。
 *   見出しコピー・出典・FAQは AIO/SEO を意図した構成。数値・季節の断定は裏取り済みのものだけ。
 */
const mapUrl = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
const commons = (file: string) => `https://commons.wikimedia.org/wiki/File:${file}`;

const highlights = [
  { no: '01', title: '袋田の滝', text: '高さ120メートル、幅73メートル。大岩壁を四段に落ちることから「四度（よど）の滝」とも呼ばれ、日本三名瀑のひとつ、国の名勝に数えられます。新緑・紅葉、そして厳冬期の「氷瀑」と、季節でまったく違う姿を見せます。観瀑台へはトンネルを通ります（入場料が必要です）。', image: '/images/area/daigo/fukuroda.jpg', alt: '袋田の滝の全景', credit: '写真：Σ364 / CC BY 3.0', creditUrl: commons('Fukuroda_Falls_29.jpg'), map: mapUrl('袋田の滝') },
  { no: '02', title: '月待の滝', text: '久慈川の支流にかかる滝。滝の裏側へ回り込んで眺められる「裏見の滝」として知られ、安産・子育て・開運の言い伝えが残ります。厳冬期には凍りつくこともあります。', image: '/images/area/daigo/tsukimachi.jpg', alt: '月待の滝', credit: '写真：Σ364 / CC BY 3.0', creditUrl: commons('Tsukimachi_Falls_01.jpg'), map: mapUrl('月待の滝 大子町') },
  { no: '03', title: '生瀬滝', text: '袋田の滝の上流にある滝。遊歩道を上ると、袋田の滝とあわせて見られます。', image: '', alt: '', credit: '', creditUrl: '', map: mapUrl('生瀬滝 大子町') },
  { no: '04', title: '奥久慈の実り（りんご・そば）', text: '上流の山里には、りんご園や常陸秋そばの畑が点在します。秋にはりんご狩りができ、そば処には新そばが並びます。', image: '/images/area/daigo/apple.jpg', alt: '大子町のりんご園', credit: '写真：Σ364 / CC BY 4.0', creditUrl: commons('Apple_orchard_in_Daigo,_Ibaraki_01.jpg'), map: mapUrl('大子町 りんご園') },
];
const tastes = [
  { title: '奥久慈しゃも', text: '全国的に知られるブランド地鶏。しっかりした歯ごたえと、噛むほどに出る旨みで名高い。' },
  { title: '常陸秋そば', text: '香り高い在来種のそば。奥久慈のそば処で味わえます。秋には新そばが出ます。' },
  { title: '奥久慈りんご', text: '秋、上流の山里で実るりんご。時期にはりんご狩りができます。' },
];
const experiences = [
  { title: '季節を変えて、同じ滝を見る', text: '袋田の滝は、新緑・紅葉・氷瀑と、季節で姿が大きく変わります。「四度来なければ本当の風趣は味わえない」と評されたと伝わるとおり、時期を変えて訪ねる価値があります。' },
  { title: '滝の裏側に立つ', text: '月待の滝は、裏側へ回り込める「裏見の滝」。水のカーテンを内側から見上げる、めずらしい体験ができます。' },
  { title: 'そばの季節に訪ねる', text: '秋は新そばの季節。奥久慈のそば処で、香りの高い一杯を。りんご狩りとあわせて山里を巡れます。' },
];
const route = [
  { no: '01', time: '09:30', title: '袋田の滝', text: 'トンネルを抜けて観瀑台へ。まずは滝の全体を見る。' },
  { no: '02', time: '10:30', title: '生瀬滝', text: '遊歩道を上って、上流の滝もあわせて見る。' },
  { no: '03', time: '12:00', title: 'そば処で昼食', text: '常陸秋そばか、奥久慈しゃもを。' },
  { no: '04', time: '13:30', title: '月待の滝', text: '裏見の滝で締める。山里のりんご園へ足を延ばしても。' },
];
const seasons = [
  { tone: 'spring', title: '春', text: '新緑の渓谷。雪どけで滝の水量が増す季節です。', image: '/images/area/daigo/fukuroda.jpg', alt: '新緑の袋田の滝', credit: '写真：Σ364 / CC BY 3.0', creditUrl: commons('Fukuroda_Falls_29.jpg') },
  { tone: 'summer', title: '夏', text: '山あいの涼。滝を見たあと、月待の滝の裏や奥久慈の温泉とあわせて回れます。', image: '/images/area/daigo/cover.jpg', alt: '新緑に包まれた袋田の滝', credit: '写真：Σ364 / CC BY 3.0', creditUrl: commons('Fukuroda_Falls_30.jpg') },
  { tone: 'autumn', title: '秋', text: '紅葉と、常陸秋そばの新そば、りんご狩り。奥久慈がもっとも豊かな季節です。', image: '/images/area/daigo/fukuroda-autumn.jpg', alt: '紅葉の袋田の滝', credit: '写真：t.kunikuni / CC BY-SA 2.0', creditUrl: commons('Autumn_of_Fukuroda_Falls,_Daigo,_Ibaraki;_November_2016.jpg') },
  { tone: 'winter', title: '冬', text: '厳冬期には袋田の滝や月待の滝が凍る「氷瀑」が見られることがあります。凍り方はその年の寒さで変わります。', image: '/images/area/daigo/tsukimachi-hyobaku.jpg', alt: '凍りかけの月待の滝', credit: '写真：Koda6029 / CC BY-SA 4.0', creditUrl: commons('%E5%87%8D%E3%82%8A%E3%81%8B%E3%81%91%E3%81%AE%E6%9C%88%E5%BE%85%E3%81%AE%E6%BB%9D.jpg') },
];
const plans: [string, string][] = [
  ['滞在の目安', '滝めぐりなら半日。そばやりんご狩り、温泉まで組むなら1日あると余裕を持って巡れます。'],
  ['旅の起点', 'JR水郡線・袋田駅が袋田の滝の最寄り。車なら常磐自動車道・那珂ICから国道118号を北上します。'],
  ['町の移動', '滝や山里は互いに離れているため、車が動きやすい。袋田駅から滝まではバス・タクシーの利用が便利です。'],
  ['当日の確認', '氷瀑の凍結、遊歩道・観瀑施設の状況、そば処の営業は変わります。出発前にページ下部の公式情報を確認してください。'],
];
const practical: [string, string][] = [
  ['公共交通', 'JR水郡線・袋田駅が最寄り。滝までは路線バスまたはタクシーが便利です（徒歩なら坂道を30〜40分ほど）。運行は季節で変わるため、公式情報で確認を。'],
  ['車', '常磐自動車道・那珂ICから国道118号を経由。袋田の滝周辺に有料駐車場があります。'],
  ['観瀑施設', '袋田の滝の観瀑台へはトンネルを通り、入場料（通行料）が必要です。第2観瀑台へはエレベーターで上がれます。'],
  ['氷瀑を目当てにするなら', '凍るかどうかはその年の寒さ次第で、見られない年もあります。大子町観光協会の凍結情報を確認してから出かけてください。'],
  ['冬の運転', '山あいは路面が凍結しやすい季節があります。冬用タイヤなど、備えをして向かってください。'],
  ['歩く支度', '滝の遊歩道には階段があります。歩きやすい靴で。'],
];
const faq = [
  { q: '袋田の滝の高さと大きさは？', a: '高さ120メートル、幅73メートルです。大岩壁を四段に落ちることから「四度（よど）の滝」とも呼ばれ、日本三名瀑のひとつ、国の名勝に数えられます。' },
  { q: '袋田の滝の氷瀑（凍った滝）はいつ見られますか？', a: '例年12月下旬から2月ごろの厳冬期に凍ることがあります。ただし凍り方はその年の寒さ次第で、見られない年もあります。凍結状況は大子町観光協会の情報でご確認ください。' },
  { q: '大子町の名物・味覚は？', a: '奥久慈しゃも（ブランド地鶏）、常陸秋そば、奥久慈りんごが知られます。秋にはりんご狩りや、そば処の新そばが楽しめます。' },
  { q: '袋田の滝へのアクセスは？', a: 'JR水郡線・袋田駅が最寄りで、滝まではバスやタクシーが便利です。車の場合は常磐自動車道・那珂ICから国道118号を経由します。観瀑台へはトンネルを通り、入場料が必要です。' },
];
const officialLinks: [string, string][] = [
  ['大子町観光協会｜公式サイト', 'https://www.daigo-kanko.jp/'],
  ['袋田の滝・生瀬滝｜大子町', 'https://www.town.daigo.ibaraki.jp/page/page001474.html'],
  ['袋田の滝 氷瀑情報｜大子町観光協会', 'https://www.daigo-kanko.jp/fukuroda-falls/hyobaku.html'],
  ['大子町｜公式サイト', 'https://www.town.daigo.ibaraki.jp/'],
];
---

<article class="daigo-guide">
  <header class="area-head">
    <div class="area-head-copy bp-wrap">
      <div>
        <nav class="crumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href="/area/">エリア</a><span>/</span><span>県北</span></nav>
        <p class="bp-kicker">県北 / IBARAKI</p><h1>大子町</h1>
        <p class="area-catch">「四度おとずれないと、本当の姿は分からない」と言われた滝の町。</p>
        <div class="area-lead">
          <p>久慈川の上流、山あいに位置する県北の町。奥久慈と呼ばれる一帯の中心で、滝と温泉、山の味覚で知られます。</p>
          <p>袋田の滝は、高さ120メートル、幅73メートル。大岩壁を四段に落ちることから「四度（よど）の滝」とも呼ばれます。一説には、西行法師が「四季に一度ずつ、四度来なければ本当の風趣は味わえない」と評したことが、その名の由来と伝わります。</p>
          <p>厳しい寒さの年には、滝全体が白く凍る「氷瀑」が見られることがあります。同じ滝が、季節でまったく違う姿になる。奥久慈しゃも、常陸秋そば、りんご。山の恵みも豊かな町です。</p>
        </div>
        <a class="map-back" href="/area/">44市町村の地図に戻る →</a>
      </div>
      <figure class="area-cover"><img src="/images/area/daigo/cover.jpg" alt="袋田の滝の全景" loading="eager" fetchpriority="high" width="1600" height="1066"><figcaption><a href={commons('Fukuroda_Falls_30.jpg')} rel="license noopener" target="_blank">写真：Σ364 / CC BY 3.0</a></figcaption></figure>
    </div>
  </header>
  <nav class="area-jump" aria-label="大子町のページ内ナビゲーション"><div class="bp-wrap"><span>知りたいことから読む</span><a href="#highlights">見どころ</a><a href="#taste">食べる</a><a href="#experience">体験する</a><a href="#route">半日コース</a><a href="#seasons">季節</a><a href="#plan">旅の準備</a><a href="#faq">よくある質問</a></div></nav>

  <div class="guide-content bp-wrap">
    <section id="highlights" class="guide-section"><header><p class="bp-kicker">HIGHLIGHTS</p><h2 class="bp-section-title">この町で、訪ねたい場所。</h2><p>奥久慈の滝と山里。この町の魅力が集まる場所を、順に紹介します。</p></header><div class="guide-grid">{highlights.map((item)=><article class:list={['guide-card',!item.image&&'no-image']}>{item.image&&<figure><img src={item.image} alt={item.alt} loading="lazy" decoding="async" width="1600" height="1066"><figcaption><a href={item.creditUrl} rel="license noopener" target="_blank">{item.credit}</a></figcaption></figure>}<div><span>{item.no}</span><h3>{item.title}</h3><p>{item.text}</p><a class="map-link" href={item.map} target="_blank" rel="noopener">Google マップで見る <span aria-hidden="true">↗</span></a></div></article>)}</div></section>

    <section id="taste" class="taste-section"><header><p class="bp-kicker">LOCAL TASTE</p><h2 class="bp-section-title">この町で、味わいたいもの。</h2></header><div class="taste-grid">{tastes.map((item)=><article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>

    <section id="experience" class="experience-section"><header><p class="bp-kicker">EXPERIENCE</p><h2 class="bp-section-title">この町で、体験したいこと。</h2></header><div class="exp-grid">{experiences.map((item)=><article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>

    <section id="route" class="route-section"><header><p class="bp-kicker">HALF-DAY ROUTE</p><h2 class="bp-section-title">滝から、山里へ。</h2><p>移動時間は目安です。運行状況や各施設の最新情報を確認してお出かけください。</p></header><ol>{route.map((item)=><li><div class="route-copy"><span class="route-number">{item.no}</span><time>{item.time}</time><strong>{item.title}</strong><span>{item.text}</span></div></li>)}</ol><aside class="route-extra"><h3>もう半日あるなら</h3><p>冬の氷瀑の時期（例年12月下旬から2月）は、凍結状況が日で変わります。大子町観光協会の凍結情報を見てから出かけてください。秋のりんご狩りをするなら、上流の山里へ足を延ばせます。滝を見たあとは、奥久慈の温泉で温まるのもいい一日の締め方です。</p></aside></section>

    <section id="seasons" class="season-section"><header><p class="bp-kicker">SEASONS</p><h2 class="bp-section-title">いつ訪れる？</h2><p>季節で大きく姿を変える町です。旅の時期を、ここから選びます。</p></header><div>{seasons.map((item)=><article class={`tone-${item.tone}`}><figure><img src={item.image} alt={item.alt} loading="lazy" decoding="async" width="1600" height="1066"><figcaption><a href={item.creditUrl} rel="license noopener" target="_blank">{item.credit}</a></figcaption></figure><div class="season-copy"><strong>{item.title}</strong><p>{item.text}</p></div></article>)}</div></section>

    <section id="plan" class="basics-section"><header><p class="bp-kicker">PLAN YOUR VISIT</p><h2 class="bp-section-title">旅を、どう組み立てる？</h2><p>時間と移動手段から、無理のない巡り方を考えます。</p></header><div>{plans.map(([title,text])=><article><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></section>

    <section class="practical-section"><header><p class="bp-kicker">BEFORE YOU GO</p><h2 class="bp-section-title">行く前に、知っておきたいこと。</h2><p>交通手段や天候、目当てに合わせて選べる実用情報です。</p></header><dl>{practical.map(([title,text])=><div><div><dt>{title}</dt><dd>{text}</dd></div></div>)}</dl></section>

    <section id="faq" class="faq-section"><header><p class="bp-kicker">FAQ</p><h2 class="bp-section-title">よくある質問</h2></header><dl>{faq.map((item)=><div><dt>{item.q}</dt><dd>{item.a}</dd></div>)}</dl></section>

    <aside class="source-note" aria-labelledby="source-note-title"><div><p class="bp-kicker">INFORMATION</p><h2 id="source-note-title">情報の確認について</h2><p>掲載内容は公開情報をもとに編集しています。営業時間・料金・交通・催事・凍結状況は変わるため、訪問前に公式情報をご確認ください。</p></div><div><p>最終確認：<time datetime="2026-08-14">2026年8月14日</time></p><ul>{officialLinks.map(([label,url])=><li><a href={url} target="_blank" rel="noopener">{label}<span aria-hidden="true">↗</span></a></li>)}</ul></div></aside>
  </div>

</article>

<style>
  .daigo-guide{padding-top:clamp(3rem,7vw,6rem)}.area-head{padding-bottom:clamp(3rem,7vw,6rem)}.area-head-copy{display:grid;grid-template-columns:minmax(0,.88fr) minmax(380px,1.12fr);gap:clamp(3rem,7vw,7rem);align-items:start}.crumbs{display:flex;gap:.55rem;margin-bottom:2.5rem;color:var(--color-soil);font-size:.78rem}.crumbs a{border-bottom:1px solid transparent}.crumbs a:hover{border-color:var(--color-tide)}.area-head h1{margin-top:1rem;font:600 clamp(3.8rem,8vw,7rem)/1 var(--font-brand-display);color:var(--color-ink)}.area-catch{margin-top:1.7rem;font:600 clamp(1.55rem,2.7vw,2.6rem)/1.5 var(--font-brand-display);color:var(--color-ink)}.area-lead{display:grid;gap:1rem;margin-top:1.3rem;color:var(--color-soil);line-height:1.95}.area-cover{position:relative;margin-top:2rem}.area-cover img{width:100%;aspect-ratio:4/3;object-fit:cover}.area-cover figcaption,figure figcaption{position:absolute;right:.6rem;bottom:.5rem;padding:.15rem .35rem;background:rgba(13,39,50,.72);font-size:.65rem;color:#fff}.area-cover figcaption a,figure figcaption a{color:inherit}.map-back{display:inline-block;margin-top:1.5rem;color:var(--color-tide);border-bottom:1px solid}.area-jump{position:sticky;top:0;z-index:5;border-block:1px solid var(--color-mist);background:color-mix(in srgb,var(--color-paper) 94%,transparent);backdrop-filter:blur(10px)}.area-jump>div{display:flex;gap:1.5rem;overflow-x:auto;overflow-y:hidden;overscroll-behavior-x:contain;padding-block:1rem;white-space:nowrap;font-size:.82rem}.area-jump span{color:var(--color-soil)}.area-jump a{color:var(--color-ink)}
  .guide-content{display:grid;gap:clamp(5rem,10vw,9rem);padding-block:clamp(5rem,10vw,9rem)}.guide-content section>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.7fr);gap:2rem;align-items:end;margin-bottom:2.5rem}.guide-content section>header .bp-kicker,.guide-content section>header h2{grid-column:1}.guide-content section>header>p:last-child{grid-column:2;grid-row:1/3;color:var(--color-soil);line-height:1.9}.bp-section-title{margin-top:.75rem}
  figure{position:relative;margin:0}.guide-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2.25rem}.guide-card{border-top:1px solid var(--color-ink);padding-top:1rem}.guide-card figure{aspect-ratio:4/3;overflow:hidden}.guide-card figure img{width:100%;height:100%;object-fit:cover}.guide-card.no-image>div{padding-top:.2rem}.guide-card>div{padding:1.2rem .15rem 0}.guide-card>div>span{font:600 .7rem var(--font-brand-meta);color:var(--color-tide)}.guide-card h3{margin-top:.5rem;font:600 clamp(1.35rem,2.4vw,2rem) var(--font-brand-display);color:var(--color-ink)}.guide-card p{margin-top:.8rem;color:var(--color-soil);line-height:1.85}.map-link{display:inline-block;margin-top:1rem;color:var(--color-tide);font-size:.8rem;border-bottom:1px solid}
