---
/**
 * ブランドサイトの共通ヘッダー。
 * 「44市町村」と、自然・季節・目的の各入口をひとつの探索メニューにまとめる。
 */
import { SITE_CONFIG } from '../data/site';
import BrandLogo from './BrandLogo.astro';
import LanguageMenu from './LanguageMenu.astro';
import NavCaret from './NavCaret.astro';
import NavDropdown, { type NavDropdownItem } from './NavDropdown.astro';
import { LOCALES, LOCALE_META, TRANSLATIONS, localeHome } from '../data/i18n';
import { NEWS_CATEGORIES, type NewsCategoryKey } from '../data/news';
import { getNewsCategoryCounts } from '../lib/content';
import { SPORTS_TEAMS } from '../data/sports';

interface Props { translationKey?: string; }
const { translationKey } = Astro.props;
const currentPath = Astro.url.pathname;
const discoverRoots = ['/area/', '/umi/', '/kawa/', '/yama/', '/koen/', '/hanabi/', '/hana/', '/matsuri/', '/kouyou/', '/odekake/', '/eat/', '/michinoeki/', '/sauna-play/', '/stay/', '/life/', '/beauty/', '/company/', '/place/'];
const isDiscoverCurrent = discoverRoots.some((root) => currentPath.startsWith(root));
const isAboutCurrent = currentPath.startsWith('/about/');

// モバイルメニュー用の言語リンク（PCはドロップダウンの LanguageMenu を使う）
const langMap = translationKey ? TRANSLATIONS[translationKey] : undefined;
const langItems = LOCALES.map((code) => ({
  label: LOCALE_META[code].label,
  htmlLang: LOCALE_META[code].htmlLang,
  href: langMap?.[code] ?? localeHome(code),
  current: code === 'ja',
}));

const discoveryGroups = [
  {
    label: '自然から探す',
    items: [
      { label: '海', note: '太平洋と海辺の町', href: '/umi/' },
      { label: '川・湖', note: '霞ヶ浦、那珂川、鬼怒川', href: '/kawa/' },
      { label: '山', note: '筑波山、八溝山地', href: '/yama/' },
      { label: '公園', note: '季節の花と大きな空', href: '/koen/' },
    ],
  },
  {
    label: '季節から探す',
    items: [
      { label: 'イベント', note: '日程・会場・駐車場から探す', href: '/events/' },
      { label: '花火', note: '県内の大会とつくり手', href: '/hanabi/' },
      { label: '花', note: '梅、桜、ネモフィラ', href: '/hana/' },
      { label: '祭り', note: '土地に残る行事', href: '/matsuri/' },
      { label: '紅葉', note: '渓谷と山の秋', href: '/kouyou/' },
    ],
  },
  {
    label: '目的から探す',
    items: [
      { label: 'おでかけ', note: '自然・季節・目的から選ぶ', href: '/odekake/' },
      { label: '食べる', note: '畑、港、店の物語', href: '/eat/' },
      { label: '道の駅', note: '県内16駅を一覧で', href: '/michinoeki/' },
      { label: '出かける', note: '休日の行き先', href: '/sauna-play/' },
      { label: '泊まる', note: '朝の光ごと身を置く', href: '/stay/' },
      { label: '暮らす', note: 'この土地の日常を訪ねる', href: '/life/' },
      { label: '整える', note: '温泉とサウナ', href: '/beauty/' },
      { label: '働く・つくる', note: '仕事、技、人の物語', href: '/company/' },
    ],
  },
];

const aboutLinks: NavDropdownItem[] = [
  { label: '私たちについて', href: '/about/', mark: '01' },
  { label: '編集方針', href: '/about/editorial-policy/', mark: '02' },
  { label: '運営・チーム', href: '/about/team/', mark: '03' },
];

// ニュースのカテゴリ。記事が1本以上あるものだけ、多い順に出す。
// 空のカテゴリを並べると、押した先に何も無い項目ができるため。
const categoryCounts = await getNewsCategoryCounts();
const newsLinks: NavDropdownItem[] = [
  { label: 'すべての解説', href: '/news/', note: '新着順にすべて表示' },
  ...[...categoryCounts.entries()]
    .filter(([, count]) => count > 0)
    .sort((a, b) => b[1] - a[1])
    .map(([key]) => ({
      label: NEWS_CATEGORIES[key as NewsCategoryKey].label,
      href: `/news/category/${key}/`,
      note: NEWS_CATEGORIES[key as NewsCategoryKey].note,
    })),
];

// スポーツは5チーム。競技とリーグは data/sports.ts の確認済みの値をそのまま使う。
// リーグ名は data 側で短く統一してあるので、ここで加工しない。
const sportsLinks: NavDropdownItem[] = [
  { label: '茨城のスポーツ', href: '/sports/', note: '観戦・遠征・地域から読む' },
  ...SPORTS_TEAMS.map((team) => ({
    label: team.name,
    href: `/sports/${team.slug}/`,
    note: team.league ? `${team.sport}・${team.league}` : team.sport,
  })),
];
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${SITE_CONFIG.name} ホーム`}>
      <BrandLogo size={40} />
    </a>

    <nav class="desktop-nav" aria-label="メインナビゲーション">
      {/* 並びはサイトの実態に合わせる。44市町村＋テーマ（60ページ）が中核資産なので先頭。
          次に更新の軸のニュース、そのあとに育成中のスポーツ。 */}
      <button type="button" class:list={['nav-link', { 'is-current': isDiscoverCurrent }]} data-menu-trigger="discover" aria-expanded="false" aria-controls="discover-menu">
        茨城を探す <NavCaret />
      </button>
      {/* 子を持つ項目はすべてプルダウン。トリガーと面を同じ入れ物に入れて真下に出す。
          ハブページ（/news/ /sports/）へは各プルダウンの先頭項目から行ける。 */}
      <NavDropdown
        id="news-menu" name="news" label="ニュース" items={newsLinks} wide
        currentPath={currentPath} isCurrent={currentPath.startsWith('/news/')}
      />
      <NavDropdown
        id="sports-menu" name="sports" label="スポーツ" items={sportsLinks} wide
        currentPath={currentPath} isCurrent={currentPath.startsWith('/sports/')}
      />
      <NavDropdown
        id="about-menu" name="about" label="イバトコについて" items={aboutLinks}
        currentPath={currentPath} isCurrent={isAboutCurrent}
      />
      <a href="/contact/" class:list={['nav-link', { 'is-current': currentPath.startsWith('/contact/') }]} aria-current={currentPath.startsWith('/contact/') ? 'page' : undefined}>お問い合わせ</a>
    </nav>

    <div class="site-header__utility">
      <LanguageMenu locale="ja" translationKey={translationKey} id="lang-menu-header" />
      <a class="business-link" href="/biz/">地域事業者の方へ <span aria-hidden="true">↗</span></a>
    </div>

    <button class="mobile-trigger" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu" data-mobile-trigger>
      <span></span><span></span>
    </button>
  </div>

  <div class="mega-menu" id="discover-menu" data-menu-panel="discover" aria-hidden="true">
    <div class="mega-menu__inner">
      <div class="mega-intro">
        <span class="menu-number">01</span>
        <p class="en-label">DISCOVER IBARAKI</p>
        {/* 改行位置は指定する。自動折返しだと「知らなかった茨城／へ。」と
            2文字だけの行ができる（1440pxでも起きる） */}
        <h2>知らなかった<br />茨城へ。</h2>
        <p>自然、季節、目的。いまの気分に近い入口から、土地の話をたどれます。</p>
        <a class="area-gateway" href="/area/">
          <span><small>IBARAKI 44 CITIES</small>44市町村から探す</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>
      <div class="mega-columns">
        {discoveryGroups.map((group) => (
          <section>
            <h3>{group.label}</h3>
            <ul>
              {group.items.map((item) => (
                <li><a href={item.href}><span>{item.label}</span><small>{item.note}</small><b aria-hidden="true">↗</b></a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-menu" data-mobile-panel aria-hidden="true">
    <div class="mobile-panel__inner">
      <p class="en-label">MENU</p>
      {/* PCナビと同じ並び。順番が2つで食い違うと、どちらが正か分からなくなる */}
      <details open>
        <summary>茨城を探す <span aria-hidden="true">＋</span></summary>
        <div class="mobile-discovery">
          <a class="mobile-area" href="/area/"><small>IBARAKI 44 CITIES</small><strong>44市町村から探す</strong><span aria-hidden="true">→</span></a>
          {discoveryGroups.map((group) => (
            <section>
              <h3>{group.label}</h3>
              <div>{group.items.map((item) => <a href={item.href}>{item.label}</a>)}</div>
            </section>
          ))}
        </div>
      </details>
      <details>
        <summary>ニュース <span aria-hidden="true">＋</span></summary>
        <div class="mobile-sub-links">{newsLinks.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      </details>
      <details>
        <summary>スポーツ <span aria-hidden="true">＋</span></summary>
        <div class="mobile-sub-links">{sportsLinks.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      </details>
      <details>
        <summary>イバトコについて <span aria-hidden="true">＋</span></summary>
        <div class="mobile-sub-links">{aboutLinks.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      </details>
      <a class="mobile-main-link" href="/contact/">お問い合わせ <span aria-hidden="true">→</span></a>
      <details class="mobile-lang">
        <summary>言語 / Language <span aria-hidden="true">＋</span></summary>
        <div class="mobile-sub-links">{langItems.map((item) => (
          <a href={item.href} hreflang={item.htmlLang} lang={item.htmlLang} aria-current={item.current ? 'true' : undefined}>
            {item.label}{item.current && <span class="sr-only">（現在の言語）</span>}
          </a>
        ))}</div>
      </details>
      <a class="mobile-business" href="/biz/">地域事業者の方へ <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const triggers = [...header.querySelectorAll<HTMLButtonElement>('[data-menu-trigger]')];
    const panels = [...header.querySelectorAll<HTMLElement>('[data-menu-panel]')];
    const mobileTrigger = header.querySelector<HTMLButtonElement>('[data-mobile-trigger]');
    const mobilePanel = header.querySelector<HTMLElement>('[data-mobile-panel]');

    const closeDesktop = () => {
      triggers.forEach((trigger) => { trigger.classList.remove('is-active'); trigger.setAttribute('aria-expanded', 'false'); });
      panels.forEach((panel) => { panel.classList.remove('is-open'); panel.setAttribute('aria-hidden', 'true'); });
    };
    const closeMobile = () => {
      mobileTrigger?.classList.remove('is-active');
      mobileTrigger?.setAttribute('aria-expanded', 'false');
      mobileTrigger?.setAttribute('aria-label', 'メニューを開く');
      mobilePanel?.classList.remove('is-open');
      mobilePanel?.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('menu-is-open');
    };

    // Astroのクライアント遷移・BFCache復帰を含め、初期状態は必ず閉じる。
    closeDesktop();
    closeMobile();

    // 言語メニューとメガメニューは同時に開かない（相互排他）
    const langTrigger = header.querySelector<HTMLButtonElement>('[data-lang-trigger]');
    const langList = header.querySelector<HTMLElement>('[data-lang-list]');
    const closeLang = () => {
      if (!langTrigger || !langList) return;
      // 開閉の持ち方は LanguageMenu 側と同じ（.is-open）。hidden属性は使わない
      langList.classList.remove('is-open');
      langTrigger.setAttribute('aria-expanded', 'false');
    };
    langTrigger?.addEventListener('click', () => closeDesktop());

    triggers.forEach((trigger) => trigger.addEventListener('click', () => {
      const name = trigger.dataset.menuTrigger;
      const wasOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeDesktop();
      closeLang();
      if (!wasOpen) {
        const panel = panels.find((item) => item.dataset.menuPanel === name);
        trigger.classList.add('is-active');
        trigger.setAttribute('aria-expanded', 'true');
        panel?.classList.add('is-open');
        panel?.setAttribute('aria-hidden', 'false');
      }
    }));

    mobileTrigger?.addEventListener('click', () => {
      const shouldOpen = mobileTrigger.getAttribute('aria-expanded') !== 'true';
      closeDesktop();
      if (!shouldOpen) { closeMobile(); return; }
      mobileTrigger.classList.add('is-active');
      mobileTrigger.setAttribute('aria-expanded', 'true');
      mobileTrigger.setAttribute('aria-label', 'メニューを閉じる');
      mobilePanel?.classList.add('is-open');
      mobilePanel?.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('menu-is-open');
    });

    document.addEventListener('pointerdown', (event) => { if (!header.contains(event.target as Node)) closeDesktop(); });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeDesktop(); closeMobile();
      if (event.target instanceof HTMLElement) event.target.blur();
    });
    window.addEventListener('resize', () => { if (window.innerWidth > 1180) closeMobile(); });
  }
</script>

<style>
  :global(html.menu-is-open){overflow:hidden}
  .site-header{position:sticky;top:0;z-index:50;height:var(--site-header-height);background:rgba(252,253,255,.94);border-bottom:1px solid rgba(7,23,68,.085);box-shadow:0 1px 0 rgba(7,23,68,.025);font-family:var(--font-brand-body);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px)}
  .site-header__inner{width:min(calc(100% - 3rem),1440px);height:100%;margin-inline:auto;display:grid;grid-template-columns:minmax(145px,.72fr) auto minmax(205px,.72fr);align-items:center}
  .site-header__logo{display:inline-flex;align-items:center;justify-self:start;color:var(--color-ink);line-height:1.05;text-decoration:none}
  .desktop-nav{height:100%;display:flex;align-items:stretch;gap:clamp(1.35rem,2.1vw,2.35rem)}
  /* 項目の見た目（.nav-link）と面（.nav-drop）は global.css。
     子コンポーネントが出す要素にも効かせる必要があるため、ここには書かない。 */
  .site-header__utility{justify-self:end;display:flex;align-items:center;gap:clamp(.9rem,1.5vw,1.35rem);white-space:nowrap}
  /* 言語選択と「地域事業者の方へ」を細い罫線で分ける */
  .site-header__utility .business-link{position:relative}
  .business-link{display:inline-flex;min-height:42px;align-items:center;padding:.68rem 1rem!important;border:1px solid rgba(31,99,191,.3);border-radius:999px;color:var(--color-deep-blue);font-size:.76rem;font-weight:700;white-space:nowrap;transition:color .25s ease,background-color .25s ease,border-color .25s ease}.business-link span{margin-left:.55rem;color:var(--color-brand-blue)}.business-link:hover,.business-link:focus-visible{border-color:var(--color-deep-blue);background:var(--color-deep-blue);color:#fff}.business-link:hover span,.business-link:focus-visible span{color:#9ecff4}
  .mobile-trigger{display:none}
  /* 面の色・罫線・影は global.css の --nav-drop-* を使う（3つのメニューで共通） */
  .mega-menu{position:absolute;top:calc(var(--site-header-height) - 1px);left:0;right:0;max-height:calc(100svh - var(--site-header-height));overflow-y:auto;background:var(--nav-drop-surface);border-top:1px solid var(--nav-drop-border);box-shadow:var(--nav-drop-shadow);opacity:0;visibility:hidden;transform:translateY(-.5rem);transition:opacity .22s ease,visibility .22s ease,transform .22s ease}
  .mega-menu.is-open{opacity:1;visibility:visible;transform:translateY(0)}
  .mega-menu__inner{width:min(calc(100% - 3rem),1440px);margin-inline:auto;display:grid;grid-template-columns:minmax(250px,.72fr) minmax(660px,2.3fr);gap:clamp(2.6rem,6vw,6.25rem);padding:2.6rem 0 3rem}
  .menu-number{font:600 .72rem/1 var(--font-brand-meta);color:#789095}.en-label{font:800 .62rem/1 var(--font-brand-meta);letter-spacing:.2em;color:#668087}.mega-intro>.en-label{margin-top:.7rem}
  .mega-intro h2{margin:1rem 0;font:500 clamp(1.6rem,2.1vw,2.25rem)/1.5 var(--font-brand-display);letter-spacing:.04em}.mega-intro>p:not(.en-label){max-width:18rem;color:var(--color-soil);font-size:.8rem;line-height:2}
  .area-gateway{display:flex;align-items:center;justify-content:space-between;gap:1rem;max-width:20rem;margin-top:1.6rem;padding:1rem 1.1rem;background:var(--color-ink);color:#fff;transition:transform .22s ease,box-shadow .22s ease}.area-gateway span{display:grid;gap:.35rem;font:700 1rem/1.4 var(--font-brand-display)}.area-gateway small{font:700 .55rem/1 var(--font-brand-meta);letter-spacing:.14em;color:#9db4b7}.area-gateway b{display:grid;place-items:center;width:2rem;height:2rem;border:1px solid rgba(255,255,255,.45);border-radius:50%;font-weight:400}.area-gateway:hover,.area-gateway:focus-visible{transform:translateY(-3px);box-shadow:0 .8rem 1.4rem rgba(22,45,51,.18)}
  .mega-columns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1.4rem,3vw,3.25rem)}.mega-columns h3{margin:0 0 .9rem;padding-bottom:.75rem;border-bottom:1px solid var(--color-ink);font:600 .95rem/1.4 var(--font-brand-display)}.mega-columns ul{list-style:none;margin:0;padding:0}.mega-columns li{border-bottom:1px solid color-mix(in srgb,var(--color-ink) 14%,transparent)}.mega-columns a{position:relative;display:flex;min-height:3.65rem;flex-direction:column;justify-content:center;padding:.6rem 2.35rem .6rem .65rem;transition:background-color .22s ease,padding-left .22s ease}.mega-columns a span{font:700 1.02rem/1.3 var(--font-brand-display)}.mega-columns a small{margin-top:.25rem;color:var(--color-soil);font-size:.62rem}.mega-columns a b{position:absolute;right:.2rem;top:1.3rem;font-weight:400;transition:transform .2s ease}.mega-columns a:hover,.mega-columns a:focus-visible{padding-left:1rem;background:color-mix(in srgb,var(--color-tide) 7%,transparent)}.mega-columns a:hover b,.mega-columns a:focus-visible b{transform:translate(.25rem,-.25rem)}
  .mobile-panel{display:none}
  @media(max-width:1180px){.site-header__inner{width:100%;grid-template-columns:1fr auto;padding-inline:1.5rem}.desktop-nav,.business-link,.site-header__utility{display:none}.mobile-trigger{z-index:2;display:flex;width:2.75rem;height:2.75rem;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;padding:0;border:0;background:transparent;cursor:pointer}.mobile-trigger span{display:block;width:1.7rem;height:1px;background:var(--color-ink);transition:transform .25s ease}.mobile-trigger.is-active span:first-child{transform:translateY(.28rem) rotate(45deg)}.mobile-trigger.is-active span:last-child{transform:translateY(-.28rem) rotate(-45deg)}.mega-menu{display:none}.mobile-panel{position:fixed;top:var(--site-header-height);inset-inline:0;display:block;height:calc(100svh - var(--site-header-height));overflow-y:auto;background:var(--color-paper);opacity:0;visibility:hidden;transform:translateY(-.5rem);transition:opacity .23s ease,visibility .23s ease,transform .23s ease}.mobile-panel.is-open{opacity:1;visibility:visible;transform:none}.mobile-panel__inner{padding:2rem 1.6rem 3.75rem}.mobile-main-link,.mobile-panel summary{display:flex;min-height:4rem;align-items:center;justify-content:space-between;border-bottom:1px solid var(--color-ink);font:600 1.2rem var(--font-brand-display);cursor:pointer;list-style:none}.mobile-panel summary::-webkit-details-marker{display:none}.mobile-panel details[open] summary span{transform:rotate(45deg)}.mobile-discovery{padding:1.2rem 0 1.6rem}.mobile-area{display:grid;grid-template-columns:1fr auto;gap:.35rem 1rem;align-items:center;margin-bottom:1.4rem;padding:1rem 1.1rem;background:var(--color-ink);color:#fff}.mobile-area small{font:.55rem var(--font-brand-meta);letter-spacing:.14em;color:#9db4b7}.mobile-area strong{grid-column:1;font:700 1rem var(--font-brand-display)}.mobile-area span{grid-column:2;grid-row:1/3}.mobile-discovery section{margin-bottom:1.15rem}.mobile-discovery h3{margin:0 0 .55rem;color:#668087;font-size:.62rem;letter-spacing:.12em}.mobile-discovery section div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;border:1px solid color-mix(in srgb,var(--color-ink) 14%,transparent);background:color-mix(in srgb,var(--color-ink) 14%,transparent)}.mobile-discovery section a{padding:.85rem;background:var(--color-paper);font:600 .9rem var(--font-brand-display)}.mobile-sub-links{display:grid;padding:.5rem 0 1.1rem 1rem}.mobile-sub-links a{padding:.75rem 0;color:var(--color-soil);font-size:.85rem}.mobile-business{display:flex;justify-content:space-between;margin-top:1.75rem;padding:1.2rem;background:var(--color-ink);color:#fff;font-size:.86rem;font-weight:700}.mobile-lang summary{margin-top:0}.mobile-lang .mobile-sub-links a[aria-current="true"]{color:var(--color-ink);font-weight:700}}
  @media(max-width:560px){.site-header__inner{padding-inline:1.1rem}.site-header__logo :global(svg){max-width:8.5rem}.mobile-panel__inner{padding-inline:1.2rem}}
  /* .nav-link / .nav-drop / .nav-caret の reduced-motion は global.css 側 */
  @media(prefers-reduced-motion:reduce){.mega-menu,.area-gateway,.mega-columns a,.mega-columns a b,.mobile-trigger span,.mobile-panel{transition:none}}
</style>
