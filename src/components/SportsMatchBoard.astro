---
/**
 * チームページ上部の3枚組（NEXT MATCH / LAST MATCH / 最新の記事）。
 *
 * 5チームとも同じ部品で出す。データが無い枠は出さない。
 * 「未定」「準備中」も書かない。分かっていないことは、黙って出さないほうが正しい。
 * 3枚とも空なら、この部品自体が何も描かない。
 */
import {
  HOME_AWAY_LABEL, competitionLabel, pkText, resultLabel, type ResolvedMatch,
} from '../lib/sports';
import { formatJapaneseDate, formatJapaneseDateWithWeekday, toDateOnlyString } from '../lib/date-only.js';

interface Story {
  href: string;
  title: string;
  date: Date;
  typeLabel?: string;
}

interface Props {
  next?: ResolvedMatch;
  latest?: ResolvedMatch;
  stories: Story[];
  /** 観戦ガイドの節があるときのアンカー */
  guideAnchor?: string;
}

const { next, latest, stories, guideAnchor } = Astro.props;
const hasAnything = Boolean(next) || Boolean(latest) || stories.length > 0;

const withNote = (value?: string, note?: string) => (value ? (note ? `${value}（${note}）` : value) : undefined);
---

{hasAnything && (
  <section class="mb" aria-label="試合と最新の記事">
    <div class="mb__grid bp-wrap">
      {next && (
        <article class="mb__card">
          <p class="mb__kicker">NEXT MATCH</p>
          {competitionLabel(next) && <p class="mb__comp">{competitionLabel(next)}</p>}
          <p class="mb__opponent">
            <span class="mb__ha" data-ha={next.homeAway}>{HOME_AWAY_LABEL[next.homeAway]}</span>
            vs {next.opponent}
          </p>
          <dl class="mb__facts">
            <div><dt>日付</dt><dd><time datetime={toDateOnlyString(next.date)}>{formatJapaneseDateWithWeekday(next.date)}</time></dd></div>
            {next.kickoff && <div><dt>開始</dt><dd>{withNote(next.kickoff, next.kickoffNote)}</dd></div>}
            {next.openTime && <div><dt>開場</dt><dd>{withNote(next.openTime, next.openTimeNote)}</dd></div>}
            {next.venue && <div><dt>会場</dt><dd>{next.venue}</dd></div>}
            {next.broadcast && <div><dt>中継</dt><dd>{next.broadcast.join('、')}</dd></div>}
          </dl>
          {(guideAnchor || next.articleUrl) && (
            <p class="mb__links">
              {guideAnchor && <a class="mb__link" href={`#${guideAnchor}`}>観戦情報を見る →</a>}
              {next.articleUrl && <a class="mb__link" href={next.articleUrl}>この試合の記事を読む →</a>}
            </p>
          )}
        </article>
      )}

      {latest && (
        <article class="mb__card">
          <p class="mb__kicker">LAST MATCH</p>
          {competitionLabel(latest) && <p class="mb__comp">{competitionLabel(latest)}</p>}
          <p class="mb__opponent">
            <span class="mb__ha" data-ha={latest.homeAway}>{HOME_AWAY_LABEL[latest.homeAway]}</span>
            vs {latest.opponent}
          </p>
          {latest.score && (
            <p class="mb__score">
              <strong>{latest.score.own}</strong><span>-</span><strong>{latest.score.opponent}</strong>
              <em>{resultLabel(latest)}</em>
              {pkText(latest) && <em>{pkText(latest)}</em>}
            </p>
          )}
          <dl class="mb__facts">
            <div><dt>試合日</dt><dd><time datetime={toDateOnlyString(latest.date)}>{formatJapaneseDate(latest.date)}</time></dd></div>
            {latest.venue && <div><dt>会場</dt><dd>{latest.venue}</dd></div>}
          </dl>
          {latest.community && (
            <ul class="mb__tags" aria-label="この試合の企画">
              {latest.community.map((c) => <li>{c}</li>)}
            </ul>
          )}
          {latest.recap && <p class="mb__recap">{latest.recap}</p>}
          {/* 試合前の観戦ガイドしか無い試合で「試合結果を読む」と出さない */}
          {latest.articleUrl && <a class="mb__link" href={latest.articleUrl}>{latest.articleType === 'match-result' ? '試合結果を読む →' : 'この試合の記事を読む →'}</a>}
        </article>
      )}

      {stories.length > 0 && (
        <article class="mb__card mb__card--stories">
          <p class="mb__kicker">LATEST STORIES</p>
          <ul class="mb__stories">
            {stories.map((s) => (
              <li>
                <a href={s.href}>
                  <span class="mb__meta">
                    <time datetime={toDateOnlyString(s.date)}>{formatJapaneseDate(s.date)}</time>
                    {s.typeLabel && <b>{s.typeLabel}</b>}
                  </span>
                  <strong>{s.title}</strong>
                </a>
              </li>
            ))}
          </ul>
        </article>
      )}
    </div>
  </section>
)}

<style>
  .mb{padding-block:clamp(1.6rem,3vw,2.4rem)}
  .mb__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:1px;background:var(--color-mist);border:1px solid var(--color-mist)}
  .mb__card{display:flex;flex-direction:column;gap:.75rem;min-width:0;padding:1.5rem 1.35rem;background:var(--color-white)}
  .mb__kicker{font:700 .62rem/1 var(--font-brand-meta);letter-spacing:.16em;color:var(--color-tide)}
  .mb__comp{font:700 .72rem/1.6 var(--font-brand-meta);color:var(--color-soil)}
  .mb__opponent{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;font:600 1.15rem/1.4 var(--font-brand-display);color:var(--color-ink)}
  .mb__ha{padding:.2rem .5rem;border:1px solid currentColor;font:700 .6rem/1 var(--font-brand-meta);letter-spacing:.1em;color:var(--color-soil)}
  .mb__ha[data-ha="home"]{color:var(--interior-blue,#174f99)}

  .mb__score{display:flex;align-items:baseline;flex-wrap:wrap;gap:.5rem;margin:0}
  .mb__score strong{font:600 2.1rem/1 var(--font-brand-display);color:var(--color-ink)}
  .mb__score span{color:var(--color-soil)}
  .mb__score em{margin-left:.3rem;padding:.18rem .5rem;border:1px solid var(--color-mist);font:700 .68rem/1 var(--font-brand-meta);font-style:normal;color:var(--color-soil)}

  .mb__facts{display:grid;gap:.4rem;margin:0}
  .mb__facts div{display:grid;grid-template-columns:3.6rem minmax(0,1fr);gap:.7rem;align-items:baseline}
  .mb__facts dt{font:700 .62rem/1.6 var(--font-brand-meta);letter-spacing:.08em;color:var(--color-soil)}
  .mb__facts dd{margin:0;font-size:.84rem;line-height:1.6;color:var(--color-ink)}

  .mb__tags{display:flex;flex-wrap:wrap;gap:.4rem;margin:0;padding:0;list-style:none}
  .mb__tags li{padding:.2rem .55rem;background:color-mix(in srgb,var(--color-tide) 8%,var(--color-white));color:var(--color-tide);font-size:.72rem;font-weight:700}
  .mb__recap{margin:0;color:var(--color-soil);font-size:.82rem;line-height:1.85}

  .mb__link{margin-top:auto;font-size:.78rem;font-weight:700;color:var(--interior-blue,#174f99)}
  .mb__links{display:flex;flex-wrap:wrap;gap:.35rem 1.1rem;margin:auto 0 0}
  .mb__links .mb__link{margin-top:0}

  .mb__stories{list-style:none;margin:0;padding:0;display:grid}
  .mb__stories li+li{border-top:1px solid var(--color-mist)}
  .mb__stories a{display:grid;gap:.25rem;padding:.6rem 0;color:var(--color-ink)}
  .mb__stories li:first-child a{padding-top:0}
  .mb__stories a:hover strong{color:var(--interior-blue,#174f99)}
  .mb__meta{display:flex;gap:.6rem;align-items:center;font:.66rem var(--font-brand-meta);color:var(--color-soil)}
  .mb__meta b{padding:.1rem .4rem;border:1px solid var(--color-mist);font-weight:700}
  .mb__stories strong{font:600 .92rem/1.55 var(--font-brand-display)}

  @media(max-width:640px){
    .mb__facts div{grid-template-columns:3.2rem minmax(0,1fr)}
    .mb__score strong{font-size:1.8rem}
  }
</style>
