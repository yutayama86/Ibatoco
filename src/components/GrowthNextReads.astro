---
/**
 * 記事の本文・情報源を読んだあとに置く「次に読む」枠。
 *
 * ## なぜ人気順だけにしないか
 * 以前は popular-pages.json の全体人気を、どのページでも同じ3本出していた。
 * その結果、大洗あんこう祭の読者に笠間の栗まつりと茨城パスポートを出していて、
 * クリック率は2.1%しかなかった（2026-09-24週の実測）。
 * 「大洗の次に大洗を読む」ようにしないと押されない。
 *
 * ## なぜ終了判定を毎回するか
 * popular-pages.json は生成時点の順位なので、そのあと終わったイベントが残る。
 * 実際 9月27日に、9月26日で終わった大洗海上花火を出していた。
 * 保存した値は必ず古くなる（docs/PLATFORM.md §6）。findRelated は既定で
 * 終了イベントを外すので、人気順で埋めるぶんも同じ基準で落とす。
 *
 * ## 並べ方
 * 1. 文脈が近いもの（市町村・意図・カテゴリで重みづけ）を先に
 * 2. 足りない分を全体人気で埋める
 * どちらも終了イベントと現在のページは出さない。
 */
import popular from '../../data/editorial/popular-pages.json';
import { getEvents, getNews } from '../lib/content';
import { facetsOfEvent, facetsOfNews, getAllFacets, type ContentFacets } from '../lib/taxonomy';
import { findRelated } from '../lib/related';
import { MUNI_BY_SLUG } from '../data/areas';

interface Props {
  currentPath: string;
  pageType: 'news' | 'events';
}

const { currentPath, pageType } = Astro.props;
const [news, events, allFacets] = await Promise.all([getNews(), getEvents(), getAllFacets()]);

const titleByPath = new Map<string, string>();
const eventByPath = new Map<string, (typeof events)[number]>();
const newsByPath = new Map<string, (typeof news)[number]>();
for (const item of news) {
  const path = `/news/${item.id.split('/').pop()}/`;
  titleByPath.set(path, item.data.title);
  newsByPath.set(path, item);
}
for (const item of events) {
  const path = `/events/${item.id.split('/').pop()}/`;
  titleByPath.set(path, item.data.title);
  eventByPath.set(path, item);
}

/** いま開いているページの分類。見つからなければ文脈での並べ替えはしない */
let currentFacets: ContentFacets | null = null;
const newsEntry = news.find((item) => `/news/${item.id.split('/').pop()}/` === currentPath);
if (newsEntry) currentFacets = facetsOfNews(newsEntry);
const eventEntry = events.find((item) => `/events/${item.id.split('/').pop()}/` === currentPath);
if (eventEntry) currentFacets = facetsOfEvent(eventEntry);

/** 出してよいパス。終了イベントと noindex は除く（findRelated と同じ基準） */
const linkable = new Set(
  allFacets
    .filter((f) => !f.noindex && f.eventLifecycle !== 'ended')
    .map((f) => f.path),
);

const picked: { path: string; title: string }[] = [];
const seen = new Set<string>([currentPath]);
const push = (path: string) => {
  if (seen.has(path) || !linkable.has(path)) return;
  const title = titleByPath.get(path);
  if (!title) return;
  seen.add(path);
  picked.push({ path, title });
};

// 1) 文脈が近いもの
if (currentFacets) {
  for (const candidate of findRelated(currentFacets, allFacets, { limit: 3 })) push(candidate.facets.path);
}
// 2) 足りない分を全体人気で埋める
for (const entry of popular.pages) {
  if (picked.length >= 3) break;
  push(entry.path);
}

const items = picked.slice(0, 3).map((item, index) => ({ ...item, rank: index + 1 }));
const hasItems = items.length > 0;
---

{hasItems && (
  <nav
    class="growth-next"
    aria-labelledby="growth-next-title"
    data-growth-next
    data-page-type={pageType}
    data-current-path={currentPath}
  >
    <h2 id="growth-next-title">あわせて読みたい</h2>
    <ol>
      {items.map((item) => {
        const event = eventByPath.get(item.path);
        const entry = event ?? newsByPath.get(item.path);
        // 市町村は slug（例 oarai）ではなく名前で出す
        const firstTown = entry?.data.municipalities?.[0];
        const area = event?.data.eventInfo?.venue ?? (firstTown ? MUNI_BY_SLUG.get(firstTown)?.name : undefined);
        return (
          <li data-growth-next-link data-rank={String(item.rank)} data-target-path={item.path}>
            <a href={item.path}>
              <span class="growth-next__meta">{event ? 'イベント・おでかけ' : 'ニュース解説'}{area && <span>／ {area}</span>}</span>
              <strong>{item.title}</strong>
              <span class="growth-next__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ol>
  </nav>
)}

<script>
  import { commonParams, trackEvent } from '../lib/analytics-events';

  for (const block of document.querySelectorAll<HTMLElement>('[data-growth-next]')) {
    let viewed = false;
    const pageType = block.dataset.pageType ?? '';
    const currentPath = block.dataset.currentPath ?? window.location.pathname;

    const sendView = () => {
      if (viewed) return;
      viewed = true;
      trackEvent('growth_next_view', {
        ...commonParams({ page_type: pageType }),
        source_page: currentPath,
        item_count: block.querySelectorAll('[data-growth-next-link]').length,
      });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          sendView();
          observer.disconnect();
        }
      }, { threshold: 0.35 });
      observer.observe(block);
    } else {
      sendView();
    }

    for (const item of block.querySelectorAll<HTMLElement>('[data-growth-next-link]')) {
      const link = item.querySelector<HTMLAnchorElement>('a');
      if (!link) continue;
      link.addEventListener('click', () => {
        trackEvent('growth_next_click', {
          ...commonParams({ page_type: pageType }),
          source_page: currentPath,
          destination_url: item.dataset.targetPath ?? link.getAttribute('href') ?? '',
          item_rank: Number(item.dataset.rank ?? 0),
        });
      });
    }
  }
</script>

<style>
  /* 本文と同じ読み幅。画像や大きなボタンで読了後の候補を押し広げない。 */
  :global(body.interior-site) .growth-next {
    margin: 3rem 0;
    padding: 1.5rem 0 0;
    border-top: 2px solid var(--color-ink);
    color: var(--color-ink);
  }
  :global(body.interior-site) .growth-next h2 {
    margin: 0;
    padding: 0;
    font: 600 1.35rem/1.6 var(--font-brand-display);
    color: var(--color-ink);
  }
  .growth-next ol { margin: 1rem 0 0; padding: 0; list-style: none; }
  :global(body.interior-site) .growth-next li { margin: 0; padding: 0; border-bottom: 1px solid var(--interior-line); }
  :global(body.interior-site) .growth-next li::before { content: none; }
  .growth-next a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.25rem;
    gap: .35rem 1rem;
    align-items: center;
    min-height: 44px;
    padding: 1.15rem 0;
    color: inherit;
    text-decoration: none;
  }
  .growth-next__meta { grid-column: 1; color: var(--color-soil); font: 500 .8125rem/1.65 var(--font-brand-meta); }
  .growth-next strong { grid-column: 1; font: 600 1.0625rem/1.75 var(--font-brand-display); word-break: normal; overflow-wrap: anywhere; line-break: strict; }
  .growth-next__arrow { grid-column: 2; grid-row: 1 / 3; color: var(--color-tide); }
  .growth-next a:hover strong { text-decoration: underline; text-underline-offset: .25em; text-decoration-thickness: 1px; }
  .growth-next a:focus-visible { outline: 2px solid var(--color-tide); outline-offset: 3px; }
</style>
