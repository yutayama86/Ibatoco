---
import { listImageForPath } from '../lib/card-image';

interface Props {
  href: string;
  title: string;
  area?: string;
  image?: string;
  imageAlt?: string;
  reasons?: string[];
  tags?: string[];
  rank?: number;
  analyticsAttr?: string;
  targetPath?: string;
}
const { href, title, area, reasons = [], tags = [], rank, targetPath } = Astro.props;
/**
 * 画像を渡されなかったカード（手で並べたおすすめ枠など）は、リンク先の記事から一覧用の画像を引く。
 * 記事でないリンク先だけ、デザインの代替（IBATOCO の面）になる。
 */
const resolved = Astro.props.image ? null : await listImageForPath(href);
const image = Astro.props.image ?? resolved?.src;
const imageAlt = Astro.props.image ? (Astro.props.imageAlt ?? '') : (resolved?.alt ?? '');
const visibleReasons = reasons.filter(Boolean).slice(0, 2);
const visibleTags = tags.filter(Boolean).slice(0, 3);
---

<a class="toco-card" href={href} data-toco-card data-rank={rank ? String(rank) : undefined} data-target-path={targetPath ?? href}>
  <div class="toco-card__media">
    {image ? <img src={image} alt={imageAlt} loading="lazy" decoding="async" /> : <div class="toco-card__fallback" aria-hidden="true">IBATOCO</div>}
    {visibleReasons.length > 0 && <div class="toco-card__reasons">{visibleReasons.map((r) => <span>{r}</span>)}</div>}
  </div>
  <div class="toco-card__body">
    {area && <p class="toco-card__area">{area}</p>}
    <h3>{title}</h3>
    {visibleTags.length > 0 && <div class="toco-card__tags">{visibleTags.map((tag) => <span>#{tag}</span>)}</div>}
    <span class="toco-card__cta">ここ行ってみる <b aria-hidden="true">→</b></span>
  </div>
</a>

<style>
  .toco-card{display:grid;grid-template-columns:minmax(7rem,34%) minmax(0,1fr);min-height:9rem;overflow:hidden;border:1px solid var(--color-line,var(--color-mist));border-radius:var(--discovery-radius-lg,20px);background:#fff;box-shadow:0 8px 22px rgba(76,105,136,.055);color:var(--color-ink);text-decoration:none;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
  .toco-card:hover,.toco-card:focus-visible{transform:translateY(-2px);border-color:var(--color-brand-blue);box-shadow:var(--discovery-shadow-hover)}
  .toco-card:focus-visible{outline:2px solid var(--color-brand-blue);outline-offset:3px}
  .toco-card__media{position:relative;min-height:100%;overflow:hidden;background:linear-gradient(145deg,#e7edf4,#f8fafc)}
  .toco-card__media img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
  .toco-card:hover img{transform:scale(1.035)}
  .toco-card__fallback{display:grid;place-items:center;width:100%;height:100%;min-height:9rem;color:var(--color-brand-blue);font:700 .65rem var(--font-brand-meta);letter-spacing:.18em}
  .toco-card__reasons{position:absolute;top:.6rem;left:.6rem;display:flex;flex-wrap:wrap;gap:.3rem}
  .toco-card__reasons span{padding:.3rem .48rem;border-radius:999px;background:rgba(255,255,255,.93);box-shadow:0 2px 10px rgba(20,40,55,.08);font:700 .65rem var(--font-brand-meta);color:var(--color-ink)}
  .toco-card__body{display:grid;grid-template-columns:minmax(0,1fr);align-content:start;gap:.45rem;padding:1rem}
  .toco-card__area{margin:0;color:var(--color-brand-blue);font:700 .66rem var(--font-brand-meta);letter-spacing:.08em}
  .toco-card h3{margin:0;font:600 1rem/1.55 var(--font-brand-display)}
  .toco-card__tags{display:flex;flex-wrap:wrap;gap:.35rem;color:var(--color-soil);font-size:.7rem}
  .toco-card__cta{align-self:end;margin-top:auto;padding-top:.35rem;color:var(--color-soil);font-size:.78rem;font-weight:700}
  .toco-card__cta b{color:var(--color-brand-blue)}
  @media(max-width:520px){.toco-card{grid-template-columns:6.5rem minmax(0,1fr)}.toco-card__body{padding:.85rem}.toco-card h3{font-size:.92rem}.toco-card__reasons span:nth-child(n+2){display:none}}
</style>
