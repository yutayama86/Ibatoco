---
const themes = [
  { label: '食べる', en: 'FOOD', path: 'eat', desc: '港の朝、畑の昼。土地の味をたどる。', cta: '食の物語へ' },
  { label: '出かける', en: 'TRAVEL', path: 'sauna-play', desc: '海、山、花。今日の行き先を見つける。', cta: '休日の行き先へ' },
  { label: '泊まる', en: 'STAY', path: 'stay', desc: '朝の光ごと、茨城に身を置く。', cta: '宿を探す' },
  { label: '暮らす', en: 'LIFE', path: 'life', desc: '直売所、朝市、手仕事。土地の日常へ。', cta: '日常を訪ねる' },
  { label: '整える', en: 'WELLNESS', path: 'beauty', desc: '温泉、サウナ、水辺。身体をほどく。', cta: '整う場所へ' },
  { label: '働く・つくる', en: 'CRAFT', path: 'company', desc: '受け継ぐ技と、これからをつくる人。', cta: '仕事と人へ' },
];
---
<nav class="theme-nav" aria-label="テーマから探す">
  <ol>
    {themes.map((theme, i) => (
      <li>
        <a href={`/${theme.path}/`}>
          <span class="tn-meta"><b>0{i + 1}</b><small>{theme.en}</small></span>
          <span class="tn-title">{theme.label}</span>
          <span class="tn-desc">{theme.desc}</span>
          <span class="tn-cta">{theme.cta}<b aria-hidden="true">→</b></span>
          <span class="tn-watermark" aria-hidden="true">{theme.en}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .theme-nav{overflow:hidden}
  .theme-nav ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.85rem;padding:0;background:transparent}
  .theme-nav li{min-width:0;background:transparent}
  .theme-nav a{position:relative;isolation:isolate;display:flex;min-height:17rem;flex-direction:column;overflow:hidden;padding:1.75rem 1.8rem 1.55rem;border:1px solid rgba(36,104,201,.11);border-radius:26px;background:#fff;color:var(--color-deep-blue);box-shadow:0 14px 34px rgba(21,72,135,.055);transition:transform .24s ease,background-color .22s ease,box-shadow .22s ease,border-color .22s ease}
  .theme-nav a::before{content:'';position:absolute;z-index:-1;inset:0;background:linear-gradient(155deg,#f8fbff 0%,#e7f2ff 100%);opacity:0;transition:opacity .22s ease}
  .tn-meta{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-bottom:1.15rem;border-bottom:1px solid rgba(7,23,68,.16)}.tn-meta b{font:500 .65rem/1 var(--font-brand-meta);letter-spacing:.08em}.tn-meta small{font:700 .58rem/1 var(--font-brand-meta);letter-spacing:.22em;color:var(--color-brand-blue)}
  .tn-title{margin-top:2rem;font:600 clamp(1.65rem,2.25vw,2.25rem)/1.3 var(--font-brand-display);letter-spacing:.025em;transition:color .22s ease}
  .tn-desc{max-width:18rem;margin-top:.75rem;font-size:.8rem;line-height:1.85;color:var(--color-soil)}
  .tn-cta{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:1.5rem;font-size:.72rem;font-weight:700}.tn-cta b{display:grid;width:2rem;height:2rem;place-items:center;border:1px solid rgba(7,23,68,.25);border-radius:50%;font-weight:400;transition:transform .22s ease,background-color .22s ease,border-color .22s ease,color .22s ease}
  .tn-watermark{position:absolute;z-index:-2;right:-.2rem;bottom:-.65rem;font:700 clamp(3.4rem,6vw,6.3rem)/1 var(--font-brand-meta);letter-spacing:-.07em;color:rgba(31,99,191,.038);pointer-events:none;white-space:nowrap}
  .theme-nav a:focus-visible{outline:2px solid var(--color-brand-blue);outline-offset:-2px;background:#f1f7fb}.theme-nav a:focus-visible::before{opacity:1}.theme-nav a:focus-visible .tn-title{color:var(--color-brand-blue)}.theme-nav a:focus-visible .tn-cta b{border-color:var(--color-deep-blue);background:var(--color-deep-blue);color:#fff;transform:translateX(.15rem)}
  @media(hover:hover) and (pointer:fine){.theme-nav a:hover{transform:translateY(-5px);background:#f1f7fb;border-color:rgba(36,104,201,.2);box-shadow:0 24px 50px rgba(21,72,135,.13)}.theme-nav a:hover::before{opacity:1}.theme-nav a:hover .tn-title{color:var(--color-brand-blue)}.theme-nav a:hover .tn-cta b{border-color:var(--color-deep-blue);background:var(--color-deep-blue);color:#fff;transform:translateX(.15rem)}}
  @media(max-width:900px){.theme-nav ol{grid-template-columns:repeat(2,minmax(0,1fr))}.theme-nav a{min-height:16rem}}
  @media(max-width:560px){.theme-nav ol{grid-template-columns:1fr;gap:.7rem;padding:0;border:0;background:transparent}.theme-nav li+li{border-top:0}.theme-nav a{min-height:12rem;padding:1.35rem 1rem}.tn-title{margin-top:1.25rem}.tn-cta{padding-top:1rem}}
  @media(prefers-reduced-motion:reduce){.theme-nav a,.theme-nav a::before,.tn-title,.tn-cta b{transition:none}.theme-nav a:hover .tn-cta b,.theme-nav a:focus-visible .tn-cta b{transform:none}}
</style>
