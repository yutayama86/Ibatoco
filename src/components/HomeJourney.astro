---
/**
 * v42 TOPの「花だより」「モデルコース」「ペットとおでかけ」の3区画。
 * 締めの「この街を知るほど、茨城が好きになる。」はサイト共通（レイアウト側）にあるので、ここでは持たない。
 * 見た目は提出デザイン（index.html の flower38 / trip37 / pets38）に合わせ、
 * 中身は公式の一次情報で確かめたものだけを載せる。確かめた日と出典を画面に出す。
 *
 * - 花だより … 開花・開催の状況は日で変わる。showUntil（日本の暦日）を過ぎたカードはビルド時に外し、
 *   全部外れたら区画ごと出さない。毎朝の定期デプロイで切り替わる。差し替えは flowers を更新する
 * - モデルコース … 日立・笠間の街ページ（HitachiAreaGuide / area-guides.ts）にある半日コースの要約
 * - ペット … 各施設の公式案内に書かれた同伴条件だけ。料金や細かな規則は各施設の案内へ送る
 */
import { todayDateOnlyString } from '../lib/date-only.js';

interface Props { section: 'flowers' | 'trips' | 'pets'; }
const { section } = Astro.props;

const FLOWERS_CHECKED = '2026.11.08 確認';
const flowers = [
  {
    city: 'ひたちなか市', state: '咲いています', tone: '', flower: '秋バラ', spot: '常陸ローズガーデン',
    name: '国営ひたち海浜公園', text: '約120品種のローズガーデンで、秋咲きのバラ。',
    source: '公式の開花情報を確認', cta: '最新の開花情報へ', external: true,
    href: 'https://www.hitachikaihin.jp/flower-plant/flower-info/page000482.html',
    image: { src: '/images/v42/v38-autumn-rose.webp', width: 480, height: 320, alt: '秋バラのイメージイラスト' },
    showUntil: '2026-11-15',
  },
  {
    city: '石岡市', state: '品種園が見頃', tone: 'is-peak', flower: '秋バラ', spot: 'バラの品種園',
    name: 'いばらきフラワーパーク', text: '筑波山を望む品種園が見頃。テラスほかは見頃終盤。',
    source: '公式更新：11月7日', cta: '最新の開花情報へ', external: true,
    href: 'https://www.flowerpark.or.jp/news-column/akibara2026/',
    image: { src: '/images/v42/v38-autumn-rose.webp', width: 480, height: 320, alt: '秋バラのイメージイラスト' },
    showUntil: '2026-11-15',
  },
  {
    city: '笠間市', state: '菊まつり開催中', tone: 'is-event', flower: '菊', spot: '門前の花めぐり',
    name: '笠間稲荷神社ほか', text: '立菊や懸崖菊など、多彩な菊を境内で。',
    source: '開催期間：10月24日〜11月23日', cta: '開催案内を読む', external: false,
    href: '/events/kasama-kiku-matsuri-2026/', kiku: true,
    image: { src: '/images/v42/chrysanthemums.webp', width: 420, height: 525, alt: '色とりどりの菊のイメージイラスト' },
    showUntil: '2026-11-23',
  },
];
const today = todayDateOnlyString();
const visibleFlowers = flowers.filter((item) => today <= item.showUntil);

const pets = {
  checked: '2026年11月8日確認',
  cafes: [
    { kicker: 'つくば市 ／ 愛犬とカフェへ', name: 'ペニーレイン つくば店', text: 'お散歩のあとは、愛犬とカフェ時間。', rule: '犬同伴・ドッグカフェ', cta: 'ドッグカフェの案内を見る', href: 'https://pennylane.company/pennylane_d_tsukuba' },
    { kicker: '土浦市 ／ 木漏れ日のテラスへ', name: '森のカフェ', text: '木漏れ日のテラスで、のんびりひと休み。', rule: 'ペット同伴・テラス席', cta: 'お店と利用条件を見る', href: 'https://cafe.thomasforest.jp/' },
  ],
  facilities: [
    { town: 'ひたちなか市', name: '国営ひたち海浜公園', rule: 'ペット同伴可', dogOnly: false, cta: '同伴条件を確認', href: 'https://www.hitachikaihin.jp/faq.php?c=1&code=22&lc=0&mode=detail' },
    { town: '石岡市', name: 'いばらきフラワーパーク', rule: 'ペット同伴可', dogOnly: false, cta: '同伴条件を確認', href: 'https://www.flowerpark.or.jp/faq/' },
    { town: '稲敷市', name: 'こもれび森のイバライド', rule: '犬のみ同伴可', dogOnly: true, cta: '同伴条件を確認', href: 'https://www.ibaraido.co.jp/wp/5282/' },
    { town: '潮来市', name: '水郷潮来あやめ園', rule: 'ペット同伴可', dogOnly: false, cta: '施設情報を確認', href: 'https://www.city.itako.lg.jp/kankou/kankou-itakokankou/kankou-spot/kankou-mainspot/kankou-spot03/page001385.html' },
  ],
};
---

{section === 'flowers' && visibleFlowers.length > 0 && (
  <section class="flower38" id="flower-news" aria-labelledby="flower-title" data-module="home_flowers">
    <div class="flower38-hills" aria-hidden="true"></div>
    <div class="print-wrap flower38-layout">
      <header>
        <p class="print-label">茨城の花だより</p>
        <h2 id="flower-title">いま、会いに<br />行きたい花。</h2>
        <p class="flower38-lead">咲き具合をたしかめて、<br />お気に入りの一輪に会いに。</p>
        <p class="flower38-date"><span aria-hidden="true">✳</span> {FLOWERS_CHECKED}</p>
        <small class="flower38-art-note">背景：ネモフィラとコキアのイラスト</small>
      </header>
      <div class="flower38-content">
        <div class="flower38-cards">
          {visibleFlowers.map((item) => (
            <a class="flower38-card" href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
              <div class="flower38-card-top"><span class="flower38-city">{item.city}</span><span class:list={['flower38-state', item.tone]}>{item.state}</span></div>
              <div class:list={['flower38-specimen', { 'flower38-kiku': item.kiku }]}><img {...item.image} loading="lazy" decoding="async" /><span>{item.flower}<small>{item.spot}</small></span></div>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
              <small class="flower38-source">{item.source}</small>
              <span class="flower38-read">{item.cta} <b aria-hidden="true">{item.external ? '↗' : '→'}</b></span>
            </a>
          ))}
        </div>
        <p class="flower38-note">公式発表を確認した時点の情報です。見頃や開花状況は天候等で変わります。お出かけ前に各施設の最新案内をご確認ください。</p>
      </div>
    </div>
  </section>
)}

{section === 'trips' && (
  <section class="trip37" id="trips" aria-labelledby="weekend-title" data-module="home_trips">
    <div class="print-wrap">
      <header class="trip37-heading">
        <div><p class="print-label">茨城のモデルコース｜歩いてつなぐ休日</p><h2 id="weekend-title">よりみちを、<br class="sp-only" />ひとつの旅に。</h2></div>
        <a class="quiet-link" href="#area">街からコースを探す <span aria-hidden="true">↓</span></a>
      </header>
      <article class="trip37-feature">
        <div class="trip37-visual trip39-visual">
          <figure class="trip37-main"><span class="trip38-tape" aria-hidden="true"></span><img src="/images/area/hitachi/station.jpg" width="1280" height="960" loading="lazy" decoding="async" alt="日立駅のガラス張りの展望ロビーから眺める太平洋" /><figcaption>海の見える日立駅</figcaption></figure>
          <span class="trip37-badge">半日旅<small>HITACHI</small></span>
          <figure class="trip37-small"><img src="/images/v42/hitachi-coast.webp" width="720" height="480" loading="lazy" decoding="async" alt="かみね公園から見渡す日立の街と海" /><figcaption>坂道の先に、街と海。</figcaption></figure>
          <img class="trip39-reporters" src="/images/v42/v39-route-reporters.webp" width="360" height="540" loading="lazy" decoding="async" alt="" />
          <svg class="trip39-trail" viewBox="0 0 260 50" fill="none" aria-hidden="true"><path d="M5 33c26-25 43 18 70-3s31-18 54-3 39 4 61-5 32-13 62-2" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 5"></path><circle cx="250" cy="20" r="4" fill="#f7f4e8" stroke="currentColor" stroke-width="1.2"></circle></svg>
          <span class="trip39-whisper" aria-hidden="true">今日は、どの道を歩こう。</span>
        </div>
        <div class="trip37-copy">
          <p class="print-label">01 ／ 日立市・徒歩とバス</p>
          <h3>海の見える駅から、<br />街を見渡す丘へ。</h3>
          <p>電車を降りたら、目の前は太平洋。<br />海辺の街を、自分の速さでめぐろう。</p>
          <ol>
            <li><span>01</span><div><strong>日立駅</strong><small>展望ロビーで、海を眺める。</small></div></li>
            <li><span>02</span><div><strong>平和通り</strong><small>駅から続く通りを、ひと歩き。</small></div></li>
            <li><span>03</span><div><strong>かみね公園</strong><small>バスで高台へ、街と海を見渡す。</small></div></li>
          </ol>
          <a class="tripbook-button" href="/area/hitachi/#route">日立の半日コースを読む <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <a class="trip37-alternative" href="/area/kasama/">
        <span class="trip38-alt-num" aria-hidden="true">02</span>
        <img src="/images/v42/pottery.webp" width="420" height="525" loading="lazy" decoding="async" alt="笠間焼をイメージした器のイラスト" />
        <span><small>02 ／ 笠間市・半日</small><strong>門前から、焼きものの森へ。</strong><small>笠間稲荷神社 → 芸術の森公園 → 窯元・ギャラリー</small></span>
        <b aria-hidden="true">→</b>
      </a>
      <p class="trip37-credit">写真：<a href="https://commons.wikimedia.org/wiki/File:Hitachi_Station,_Ibaraki_01.jpg" target="_blank" rel="license noopener">日立駅 Σ64 / CC BY 4.0</a>、<a href="https://commons.wikimedia.org/wiki/File:Hitachi_City_from_Kamine_Park_04.jpg" target="_blank" rel="license noopener">かみね公園からの眺め Σ64 / CC BY 4.0</a>。人物と器はイメージイラストです。</p>
    </div>
    <div class="trip37-shore" aria-hidden="true"></div>
  </section>
)}

{section === 'pets' && (
  <section class="pets-chapter pets37 pets38" id="pet-facilities" aria-labelledby="pets-title" data-module="home_pets">
    <div class="print-wrap">
      <header class="pets-heading">
        <div>
          <p class="print-label">ペットとおでかけ</p>
          <h2 id="pets-title">うちの子と、<br />よりみち。</h2>
          <p>カフェでひと休みも、公園のお散歩も。<br />一緒に楽しめる、茨城のよりみち。</p>
          <span class="pets38-stamp"><svg viewBox="0 0 32 32" aria-hidden="true"><ellipse cx="16" cy="23" rx="7" ry="5"></ellipse><ellipse cx="7" cy="14" rx="3" ry="4" transform="rotate(-24 7 14)"></ellipse><ellipse cx="13" cy="8" rx="3" ry="4"></ellipse><ellipse cx="21" cy="8" rx="3" ry="4"></ellipse><ellipse cx="27" cy="14" rx="3" ry="4" transform="rotate(24 27 14)"></ellipse></svg><span>よりみちの相棒と。</span></span>
        </div>
        <figure class="pets38-terrace"><img src="/images/v42/v38-pet-cafe-terrace.webp" width="1200" height="600" loading="lazy" decoding="async" alt="二人が犬と猫を連れてテラスカフェで休む版画調のイラスト" /><figcaption>一緒に過ごす、休日のイメージ。</figcaption></figure>
      </header>
      <div class="pet-cafes37 pet-cafes38">
        {pets.cafes.map((cafe, index) => (
          <a href={cafe.href} target="_blank" rel="noopener">
            <span class="pet38-note-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <svg class="pet38-cup" viewBox="0 0 48 48" aria-hidden="true"><path d="M9 17h25v11a12 12 0 0 1-25 0ZM34 19h4a6 6 0 0 1 0 12h-5M6 41h34M16 11c-4-4 4-5 1-9M25 11c-4-4 4-5 1-9"></path></svg>
            <span class="pet-cafe-kicker">{cafe.kicker}</span>
            <h3>{cafe.name}</h3>
            <p>{cafe.text}</p>
            <span class="pet-rule-label">{cafe.rule}</span>
            <span class="pet-cafe-link">{cafe.cta} ↗</span>
          </a>
        ))}
      </div>
      <div class="pets38-facility-heading"><h3>お散歩の行き先も、見つけよう。</h3><span>公園・花の庭・水辺</span></div>
      <div class="pet-facility-list pet-facilities37">
        {pets.facilities.map((item) => (
          <article>
            <p class="pet-town">{item.town}</p>
            <h3>{item.name}</h3>
            <span class:list={['pet-rule-label', { 'dog-only': item.dogOnly }]}>{item.rule}</span>
            <a href={item.href} target="_blank" rel="noopener">{item.cta} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <p class="pet-note">{pets.checked}。種類・サイズ・入場条件・利用できる範囲は施設ごとに異なります。おでかけ前に各施設の案内をご確認ください。掲載は編集部の選定で、広告ではありません。</p>
    </div>
  </section>
)}

<style>
  .print-wrap{width:var(--print-width);margin-inline:auto}
  .print-label{font-size:13px;font-weight:700;letter-spacing:.1em}
  .quiet-link{display:inline-flex;align-items:center;gap:18px;min-height:44px;color:#284d57;font-size:13px;border-bottom:1px solid #b5bfb5}
  .quiet-link:focus-visible{outline-offset:4px}
  .sp-only{display:none}
  .trip37-credit{margin-top:14px;color:#6f7a68;font-size:11px;line-height:1.8}
  .trip37-credit a{text-decoration:underline;text-underline-offset:2px;white-space:nowrap}
  section{--print-width:min(1200px,calc(100vw - 112px))}
  @media (max-width:760px){.sp-only{display:initial}}
  @media (max-width:760px){section{--print-width:calc(100vw - 48px)}}
  @media (max-width:390px){section{--print-width:calc(100vw - 36px)}}
.tripbook-button {
  display:inline-flex;
  justify-content:space-between;
  align-items:center;
  gap:26px;
  min-height:46px;
  padding:9px 15px;
  background:#254f68;
  color:#fffbed;
  font-size:14px;
  font-weight:700;
}
.tripbook-button:hover {
  background:#173d52;
}
@media (max-width:680px) {
.tripbook-button {
  width:100%;
}
}
.tripbook-button {
  min-height:48px;
  border:1px solid #254f68;
  border-radius:2px;
}
.tripbook-button {
  min-height:52px;
  padding-inline:18px;
  border-radius:3px;
}
.pet-days-event figure {
  background:#f9f7eb;
  aspect-ratio:4/5;
}
.pet-days-event figure img {
  object-fit:contain;
  object-position:center;
}
.pets-chapter {
  background:#f8f4e9;
  border-top:1px solid #dbdecb;
  position:relative;
}
.pets-heading {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:25px;
  align-items:center;
  padding-top:39px;
  margin-bottom:24px;
}
.pets-heading h2 {
  font:600 52px/1.4 var(--font-brand-display);
  letter-spacing:.04em;
  margin:14px 0 17px;
}
.pets-heading>div>p:not(.print-label) {
  font-size:14px;
  line-height:1.95;
  color:#57654e;
}
.pets-heading>img {
  width:100%;
  max-height:310px;
  object-fit:contain;
  object-position:right center;
}
.pet-facility-list {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:19px;
}
.pet-facility-list article {
  padding:21px 17px 0;
  border:1px solid #d2d7c2;
  background:#fffdf6;
  box-shadow:3px 4px 0 #c8c9ac25;
  display:flex;
  flex-direction:column;
  min-width:0;
}
.pet-town {
  font-size:11px;
  color:#7d8868;
  margin:0 0 7px;
}
.pet-facility-list h3 {
  font:600 20px/1.55 var(--font-brand-display);
  margin:0 0 14px;
  min-height:62px;
}
.pet-rule-label {
  align-self:start;
  background:#e9eddc;
  color:#55673f;
  padding:4px 9px;
  font-size:11px;
  font-weight:700;
  border-radius:2px;
}
.pet-rule-label.dog-only {
  background:#efe2d4;
  color:#8a6647;
}
.pet-facility-list article>p:not(.pet-town) {
  font-size:12px;
  line-height:1.95;
  color:#647055;
  margin:13px 0 17px;
}
.pet-facility-list article>a {
  display:flex;
  align-items:center;
  justify-content:space-between;
  min-height:48px;
  border-top:1px solid #d6dbc6;
  font-size:12px;
  color:#254f68;
  font-weight:700;
  margin-top:auto;
}
.pet-note {
  font-size:11px;
  line-height:1.9;
  color:#6b765b;
  margin:19px 0 26px;
}
.pets-chapter .regional-ribbon {
  border-top:1px solid #e3dfcd;
}
@media (min-width:681px) and (max-width:1100px) {
.pet-facility-list {
  grid-template-columns:repeat(2,minmax(0,1fr));
}
}
@media (min-width:681px) and (max-width:1100px) {
.pet-facility-list h3 {
  min-height:0;
}
}
@media (min-width:681px) and (max-width:1100px) {
.pets-heading h2 {
  font-size:44px;
}
}
@media (max-width:680px) {
.pets-heading {
  display:block;
  padding-top:32px;
  margin-bottom:21px;
}
}
@media (max-width:680px) {
.pets-heading h2 {
  font-size:36px;
  line-height:1.4;
  margin:13px 0 15px;
}
}
@media (max-width:680px) {
.pets-heading>div>p:not(.print-label) {
  font-size:13px;
  line-height:1.9;
}
}
@media (max-width:680px) {
.pets-heading>img {
  display:block;
  height:auto;
  max-height:246px;
  object-fit:contain;
  margin:5px auto 0;
}
}
@media (max-width:680px) {
.pet-facility-list {
  grid-template-columns:1fr;
  gap:14px;
}
}
@media (max-width:680px) {
.pet-facility-list article {
  padding:19px 17px 0;
  display:grid;
  grid-template-columns:1fr auto;
  gap:0 12px;
}
}
@media (max-width:680px) {
.pet-town {
  grid-column:1/-1;
  font-size:11px;
}
}
@media (max-width:680px) {
.pet-facility-list h3 {
  min-height:0;
  font-size:21px;
  grid-column:1/-1;
  margin-bottom:12px;
}
}
@media (max-width:680px) {
.pet-rule-label {
  grid-column:1/-1;
  justify-self:start;
  font-size:11px;
}
}
@media (max-width:680px) {
.pet-facility-list article>p:not(.pet-town) {
  grid-column:1/-1;
  font-size:13px;
  margin:12px 0;
}
}
@media (max-width:680px) {
.pet-facility-list article>a {
  grid-column:1/-1;
  font-size:13px;
  min-height:48px;
}
}
@media (max-width:680px) {
.pet-note {
  font-size:10px;
  line-height:1.9;
  margin:18px 0 22px;
}
}
@media (max-width:350px) {
.pet-facility-list h3 {
  font-size:19px;
}
}
.trip37 {
  position:relative;
  background:#fbf8ef;
  padding:52px 0 0;
}
.trip37-heading {
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:25px;
  margin-bottom:34px;
}
.trip37-heading h2 {
  font:600 44px/1.5 var(--font-brand-display);
  margin:13px 0 0;
  letter-spacing:.04em;
}
.trip37-feature {
  display:grid;
  grid-template-columns:1.15fr 1fr;
  gap:74px;
  align-items:center;
}
.trip37-visual {
  position:relative;
  padding:0 15px 53px 0;
}
.trip37-main {
  margin:0;
  background:#fffdf5;
  padding:8px 8px 0;
  box-shadow:4px 8px 24px #4a543b18;
  transform:rotate(-1deg);
}
.trip37-main img {
  display:block;
  width:100%;
  height:310px;
  object-fit:cover;
}
.trip37-main figcaption {
  font-size:10px;
  color:#6a755d;
  padding:9px 6px 12px;
}
.trip37-small {
  position:absolute;
  right:-18px;
  bottom:0;
  margin:0;
  width:43%;
  padding:6px 6px 0;
  background:#fffdf5;
  box-shadow:3px 5px 17px #3f543e20;
  transform:rotate(3deg);
}
.trip37-small img {
  width:100%;
  height:128px;
