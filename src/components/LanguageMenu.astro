---
/**
 * ヘッダー用の言語選択（ドロップダウン）。
 *  - 通常時は「現在の言語 ＋ ⌄」の1ボタン。開くと右揃えのメニューを表示する。
 *  - 対応ページがあればその記事へ、無ければその言語のトップへフォールバック。
 *  - 現在の言語は aria-current と「（現在の言語）」のテキストでも判別できる（色や印だけに依存しない）。
 *  - IP・ブラウザ言語による自動リダイレクトはしない。
 */
import { LOCALES, LOCALE_META, TRANSLATIONS, localeHome, type Locale } from '../data/i18n';
import NavCaret from './NavCaret.astro';

interface Props { locale: Locale; translationKey?: string; id: string; }
const { locale, translationKey, id } = Astro.props;

const map = translationKey ? TRANSLATIONS[translationKey] : undefined;
const items = LOCALES.map((code) => ({
  code,
  label: LOCALE_META[code].label,
  htmlLang: LOCALE_META[code].htmlLang,
  href: map?.[code] ?? localeHome(code),
  current: code === locale,
}));

const current = LOCALE_META[locale];
/** ボタンのラベルはUIの言語に合わせる（英語ページで「言語」と出さない）。 */
const ARIA_LABEL: Record<Locale, string> = {
  ja: '表示言語を選択',
  en: 'Select language',
  'zh-tw': '選擇語言',
  ko: '언어 선택',
};
const CURRENT_NOTE: Record<Locale, string> = {
  ja: '（現在の言語）',
  en: '(current language)',
  'zh-tw': '（目前語言）',
  ko: '(현재 언어)',
};
---

<div class="lang-menu" data-lang-menu>
  <button
    type="button"
    class="lang-menu__button"
    id={`${id}-button`}
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls={id}
    aria-label={ARIA_LABEL[locale]}
    data-lang-trigger
  >
    <span lang={current.htmlLang}>{current.label}</span>
    <NavCaret />
  </button>

  <ul class="nav-drop nav-drop--lang nav-drop__list" id={id} role="menu" aria-labelledby={`${id}-button`} data-lang-list>
    {items.map((item) => (
      <li role="none">
        <a
          role="menuitem"
          href={item.href}
          hreflang={item.htmlLang}
          lang={item.htmlLang}
          aria-current={item.current ? 'true' : undefined}
          class:list={['nav-drop__item', { 'is-current': item.current }]}
          tabindex="-1"
        >
          <span class="nav-drop__mark" aria-hidden="true">{item.current ? '✓' : ''}</span>
          <span class="nav-drop__label">{item.label}</span>
          {item.current && <span class="sr-only">{CURRENT_NOTE[locale]}</span>}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-menu{position:relative}
  .lang-menu__button{display:inline-flex;min-height:42px;align-items:center;gap:.55rem;padding:.55rem .9rem;border:1px solid rgba(31,99,191,.17);border-radius:999px;background:rgba(255,255,255,.58);color:var(--color-ink);font:600 .75rem/1.4 var(--font-brand-body);white-space:nowrap;cursor:pointer;transition:background-color .2s ease,border-color .2s ease,box-shadow .2s ease}
  .lang-menu__button:hover{background:color-mix(in srgb,var(--color-ink) 5%,var(--color-white));border-color:color-mix(in srgb,var(--color-ink) 22%,transparent)}
  .lang-menu__button:focus-visible{outline:2px solid var(--color-tide);outline-offset:2px}
  .nav-drop--lang.is-start{right:auto;left:0}

  /* 面と項目とcaretの見た目は global.css の .nav-drop / .nav-caret が持つ。
     「茨城を探す」「イバトコについて」と同じものを使うため、ここでは上書きしない。 */
</style>

<script>
  // 開閉・キーボード操作・外側クリック。ページ内に複数あっても動く。
  document.querySelectorAll<HTMLElement>('[data-lang-menu]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-lang-trigger]');
    const list = root.querySelector<HTMLElement>('[data-lang-list]');
    if (!trigger || !list) return;
    const items = () => [...list.querySelectorAll<HTMLAnchorElement>('a[role="menuitem"]')];

    // 狭い画面でボタンが左に寄ると、右端そろえの面が画面の左外へ出る（320〜340pxの英語TOPで約100px）。
    // はみ出すときだけ左端そろえにする。閉じている面も同じ位置に置き、画面外に残さない
    const alignToViewport = () => {
      if (!trigger.getClientRects().length) return; // 非表示（メニューの中など）のあいだは測れないので触らない
      list.classList.remove('is-start');
      if (list.getBoundingClientRect().left < 8) list.classList.add('is-start');
    };
    // 見出しの折り返しはフォントの読み込みと画面幅で変わるので、そのたびに測り直す
    document.fonts.ready.then(alignToViewport);
    window.addEventListener('resize', alignToViewport);

    // 開閉は .is-open で持つ（他のドロップダウンと同じ）。
    // 閉じているあいだは visibility:hidden なので、タブ移動もスクリーンリーダーも
    // 中の項目に入らない。hidden属性のときと同じ扱いで、開閉に動きが付く。
    let focusFrame: number | null = null;
    const cancelPendingFocus = () => {
      if (focusFrame !== null) cancelAnimationFrame(focusFrame);
      focusFrame = null;
    };
    const open = (focusIndex?: number) => {
      cancelPendingFocus();
      list.classList.add('is-open');
      alignToViewport();
      trigger.setAttribute('aria-expanded', 'true');
      // visibility の切り替えを描画へ反映してから移動する。最初の矢印キーでも項目へ入れる。
      if (focusIndex !== undefined) {
        const focusWhenVisible = () => {
          focusFrame = null;
          if (!list.classList.contains('is-open')) return;
          // visibility の transition がまだ hidden のフレームでは focus() が無視される。
          if (getComputedStyle(list).visibility !== 'visible') {
            focusFrame = requestAnimationFrame(focusWhenVisible);
            return;
          }
          items()[focusIndex]?.focus();
        };
        focusFrame = requestAnimationFrame(focusWhenVisible);
      }
    };
    const close = (returnFocus = false) => {
      cancelPendingFocus();
      list.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) trigger.focus();
    };
    const isOpen = () => list.classList.contains('is-open');

    trigger.addEventListener('click', () => (isOpen() ? close() : open()));
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open(0);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        open(items().length - 1);
      }
    });

    list.addEventListener('keydown', (event) => {
      const all = items();
      const index = all.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown') { event.preventDefault(); all[(index + 1) % all.length]?.focus(); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); all[(index - 1 + all.length) % all.length]?.focus(); }
      else if (event.key === 'Home') { event.preventDefault(); all[0]?.focus(); }
      else if (event.key === 'End') { event.preventDefault(); all[all.length - 1]?.focus(); }
      else if (event.key === 'Escape') { event.preventDefault(); close(true); }
      else if (event.key === 'Tab') close();
    });

    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && isOpen()) close(true); });
    document.addEventListener('pointerdown', (event) => { if (isOpen() && !root.contains(event.target as Node)) close(); });
  });
</script>
