---
/**
 * ReportingMeta — 「いつ・どこで・どう確かめたか」を示す取材メタ情報。
 * Editorial Contract：取材日・公開日・最終更新日・現地取材の有無・
 * 情報提供/費用負担/招待の有無を明示する。
 */
import { formatJapaneseDate, toDateOnlyString } from '../lib/date-only.js';

interface Props {
  publishedAt: Date;
  updatedAt?: Date;
  reportingDate?: Date;
  onSiteReporting?: boolean;
  disclosureNote?: string;
}
const { publishedAt, updatedAt, reportingDate, onSiteReporting = false, disclosureNote } = Astro.props;
---

<dl class="reporting-meta">
  {reportingDate && (
    <div class="rm-row">
      <dt>取材日</dt>
      <dd><time datetime={toDateOnlyString(reportingDate)}>{formatJapaneseDate(reportingDate)}</time></dd>
    </div>
  )}
  <div class="rm-row">
    <dt>公開日</dt>
    <dd><time datetime={toDateOnlyString(publishedAt)}>{formatJapaneseDate(publishedAt)}</time></dd>
  </div>
  {updatedAt && (
    <div class="rm-row">
      <dt>最終更新</dt>
      <dd><time datetime={toDateOnlyString(updatedAt)}>{formatJapaneseDate(updatedAt)}</time></dd>
    </div>
  )}
  <div class="rm-row">
    <dt>現地取材</dt>
    <dd>{onSiteReporting ? 'あり（編集部が現地で確認）' : '公式情報・資料をもとに編集'}</dd>
  </div>
  {disclosureNote && (
    <div class="rm-row">
      <dt>利害関係</dt>
      <dd>{disclosureNote}</dd>
    </div>
  )}
</dl>

<style>
  .reporting-meta {
    display: grid;
    gap: 0.5rem 0;
    font-family: var(--font-brand-meta);
    font-size: 0.85rem;
    color: var(--color-charcoal);
    border-top: 1px solid var(--color-mist);
    border-bottom: 1px solid var(--color-mist);
    padding: 0.9rem 0;
  }
  .rm-row { display: grid; grid-template-columns: 6.5em 1fr; gap: 0 1rem; align-items: baseline; }
  .rm-row dt { color: var(--color-soil); font-weight: 600; letter-spacing: 0.03em; }
  .rm-row dd { color: var(--color-ink); }
  .rm-row time { font-family: var(--font-brand-serif-latin); }
  @media (max-width: 480px) { .rm-row { grid-template-columns: 5.5em 1fr; } }
</style>
