---
/**
 * 「茨城のおいしい図鑑」の個別図鑑の外枠。
 * パンくず・構造化データ（Article / BreadcrumbList / FAQPage）・よくある質問・出典・写真のクレジット・
 * 編集方針・ほかの図鑑への導線を、どの図鑑でも同じ形で出す。本文の章立ては各ページが自分で組む。
 * 見た目の基準は docs/design/food-library.md。
 */
import BrandBase from '../../layouts/BrandBase.astro';
import SeriesNav from './SeriesNav.astro';
import FoodStyles from './FoodStyles.astro';
import { licenseUrl, type FoodGuide, type FoodPhoto } from '../../data/food-library';
import { wikimediaImage } from '../../lib/wikimedia-image';
import { formatJapaneseDate, parseDateOnly } from '../../lib/date-only.js';
import { breadcrumbJsonLd, faqPageJsonLd } from '../../lib/seo';

export interface FoodSource { label: string; url: string; accessedAt: string; note?: string }
export interface FoodFaq { q: string; a: string }

interface Props {
  guide: FoodGuide;
  /** <title>（サイト名は付けない。BrandBase の title をそのまま使う） */
  title: string;
  description: string;
  /** 構造化データの見出し */
  headline: string;
  faq?: FoodFaq[];
  sources: FoodSource[];
  /** このページに出した写真（クレジット一覧に出す） */
  photos: FoodPhoto[];
}

const { guide, title, description, headline, faq = [], sources, photos } = Astro.props;
const site = Astro.site!;
const url = new URL(guide.path, site).href;
const libraryUrl = new URL('/food-library/', site).href;
const heroImage = guide.hero ? wikimediaImage(guide.hero.src, [1280]).src : undefined;
const fmt = (iso: string) => formatJapaneseDate(parseDateOnly(iso));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline,
    description,
    datePublished: guide.publishedAt,
    dateModified: guide.updatedAt,
    inLanguage: 'ja',
    mainEntityOfPage: url,
    ...(heroImage ? { image: heroImage } : {}),
    author: { '@type': 'Organization', name: 'イバトコ編集部', url: new URL('/about/team/', site).href },
    publisher: { '@type': 'Organization', name: 'イバトコ', url: new URL('/', site).href },
    isPartOf: { '@type': 'CollectionPage', name: '茨城のおいしい図鑑', url: libraryUrl },
    about: { '@type': 'Thing', name: guide.name },
  },
  breadcrumbJsonLd([
    { name: 'ホーム', href: '/' },
    { name: '茨城のおいしい図鑑', href: libraryUrl },
    { name: guide.title, href: url },
  ], site),
  ...(faq.length ? [faqPageJsonLd(faq.map((item) => ({ question: item.q, answer: item.a })))] : []),
];
---

<BrandBase title={title} description={description} type="article" publishedAt={parseDateOnly(guide.publishedAt)} updatedAt={parseDateOnly(guide.updatedAt)} jsonLd={jsonLd}>
  <article class={`fg fg--${guide.slug}`} style={`--fg-accent:${guide.accent}`}>
    <!-- パンくずは FoodHero の最上段に置く（見出し上のラベルと二重にしない） -->
    <slot />

    {faq.length > 0 && (
      <section class="fg-section fg-faq" aria-labelledby="fg-faq-title">
        <div class="fg-section__label"><p>よくある質問</p></div>
        <div class="fg-section__body">
          <h2 id="fg-faq-title">{guide.name}について、<span>よく聞かれること。</span></h2>
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <footer class="fg-colophon">
      <section class="fg-colophon__block" aria-labelledby="fg-sources-title">
        <h2 id="fg-sources-title">出典・確認した資料</h2>
        <ol class="fg-sources">
          {sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
              <span>（{fmt(s.accessedAt)}確認{s.note ? `。${s.note}` : ''}）</span>
            </li>
          ))}
        </ol>
      </section>
      {photos.length > 0 && (
        <section class="fg-colophon__block" aria-labelledby="fg-credits-title">
          <h2 id="fg-credits-title">写真</h2>
          <ul class="fg-credits">
            {photos.map((p) => (
              <li>
                {p.place}・{p.taken}撮影。<a href={p.page} target="_blank" rel="noopener noreferrer">{p.author} / Wikimedia Commons</a>（<a href={licenseUrl(p.license)} target="_blank" rel="noopener noreferrer license">{p.license}</a>）。ページの枠に合わせて切り抜いて表示しています。
              </li>
            ))}
          </ul>
        </section>
      )}
      <section class="fg-colophon__block fg-colophon__policy" aria-labelledby="fg-policy-title">
        <h2 id="fg-policy-title">この図鑑のつくり方</h2>
        <p>茨城県・市町村・JA・農研機構などが公開している資料をもとに、イバトコ編集部がまとめました。生産者への取材や現地での撮影は、まだ行っていません。数値と時期は出典の年のもので、品種・作型・天候で前後します。最終確認日：{fmt(guide.updatedAt)}。誤りに気づいたら<a href="/about/corrections/">訂正のご連絡</a>からお知らせください。</p>
      </section>
    </footer>

    <SeriesNav current={guide.slug} />
  </article>
  <FoodStyles />
</BrandBase>
