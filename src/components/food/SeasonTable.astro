---
/**
 * 旬の表。行＝品目・品種・作型、列＝1〜12月。出荷のある月に帯、特に多い月に濃い帯を引く。
 * 表（table）として組むので、読み上げでは「◯月：出荷」と読まれる。
 * 今月（日本時間・ビルド時）の列に印を付ける。
 */
import { dateOnlyFromInstant } from '../../lib/date-only.js';

export interface SeasonRow { label: string; months: number[]; peak?: number[]; note?: string; href?: string }

interface Props {
  caption: string;
  rows: SeasonRow[];
  /** 表の下の注記 */
  note?: string;
  /** 帯の色（省略時は図鑑の差し色） */
  accent?: string;
  /** 帯の意味（凡例と読み上げ）。収穫や畑の一年を表すときに変える */
  inLabel?: string;
}

const { caption, rows, note, accent, inLabel = '出荷の時期' } = Astro.props;
const months = Array.from({ length: 12 }, (_, i) => i + 1);
const thisMonth = dateOnlyFromInstant(new Date()).getUTCMonth() + 1;
const state = (row: SeasonRow, m: number) => (row.peak?.includes(m) ? 'peak' : row.months.includes(m) ? 'in' : 'out');
const stateLabel = { peak: '出荷が特に多い', in: inLabel.replace(/の時期$/, ''), out: '—' } as const;
---

<figure class="fg-season" style={accent ? `--fg-season:${accent}` : undefined}>
  <div class="fg-season__scroll">
    <table>
      <caption>{caption}</caption>
      <thead>
        <tr>
          <th scope="col" class="fg-season__corner"><span class="sr-only">品目</span></th>
          {months.map((m) => <th scope="col" class:list={{ 'is-now': m === thisMonth }}>{m}<span class="fg-season__unit">月</span>{m === thisMonth && <span class="sr-only">（今月）</span>}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row">{row.href ? <a href={row.href}>{row.label}</a> : row.label}{row.note && <small>{row.note}</small>}</th>
            {months.map((m) => {
              const s = state(row, m);
              return <td class:list={[`is-${s}`, { 'is-now': m === thisMonth }]}><span class="sr-only">{m}月：{stateLabel[s]}</span></td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption>
    <span class="fg-season__key"><i class="is-in" aria-hidden="true"></i>{inLabel}</span>
    {rows.some((row) => row.peak?.length) && <span class="fg-season__key"><i class="is-peak" aria-hidden="true"></i>出荷が特に多い時期</span>}
    <span class="fg-season__key"><i class="is-now-key" aria-hidden="true"></i>今月</span>
    {note && <span class="fg-season__note">{note}</span>}
  </figcaption>
</figure>

<style>
  .fg-season { --fg-season: var(--fg-accent, #4f6d78); margin: 0; max-width: 980px; }
  .fg-season__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  /* スマホでも横スクロールさせずに12か月を一度に見せる（月の単位は 560px 未満で省く） */
  table { width: 100%; min-width: 0; border-collapse: collapse; table-layout: fixed; font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-size: 13px; color: var(--fg-mute, #59656a); padding-bottom: 10px; caption-side: top; }
  th, td { padding: 0; }
  thead th { font-family: var(--font-brand-serif-latin); font-weight: 400; font-size: 13px; color: var(--fg-mute, #59656a); text-align: center; padding: 0 0 8px; border-bottom: 1px solid var(--fg-ink, #1f2b31); }
  thead th.is-now { color: var(--fg-ink, #1f2b31); font-weight: 700; }
  .fg-season__unit { font-size: 10px; }
  .fg-season__corner { width: 32%; }
  tbody th { text-align: left; font-weight: 700; font-size: 14px; line-height: 1.5; padding: 12px 12px 12px 0; border-bottom: 1px solid var(--fg-line, #d6cdbf); }
  /* 行の見出しのリンクは、行の高さいっぱいを押せるようにする */
  tbody th a { color: inherit; display: inline-block; padding: 8px 0; margin: -8px 0; }
  tbody th small { display: block; font-weight: 400; font-size: 12px; color: var(--fg-mute, #59656a); }
  td { border-bottom: 1px solid var(--fg-line, #d6cdbf); position: relative; height: 44px; }
  td::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 10px; transform: translateY(-50%); }
  td.is-in::after { background: var(--fg-season); opacity: .42; }
  td.is-peak::after { background: var(--fg-season); height: 14px; }
  td.is-now { background: rgba(31, 43, 49, .05); }
  figcaption { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 12px; font-size: 12.5px; color: var(--fg-mute, #59656a); }
  .fg-season__key { display: inline-flex; align-items: center; gap: 6px; }
  .fg-season__key i { display: inline-block; width: 22px; height: 10px; }
  .fg-season__key .is-in { background: var(--fg-season); opacity: .42; }
  .fg-season__key .is-peak { background: var(--fg-season); }
  .fg-season__key .is-now-key { background: rgba(31, 43, 49, .08); border: 1px solid var(--fg-line, #d6cdbf); }
  .fg-season__note { flex-basis: 100%; line-height: 1.8; }
  @media (max-width: 559px) {
    .fg-season__unit { display: none; }
    thead th { font-size: 12px; }
    tbody th { font-size: 13px; padding-right: 8px; }
    tbody th small { font-size: 11.5px; }
    td::after { height: 8px; }
    td.is-peak::after { height: 12px; }
  }
  @media (min-width: 760px) { .fg-season__corner { width: 26%; } }
</style>
