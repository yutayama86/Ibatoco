---
/**
 * 海外向けトップの表示（言語共通の器）。文言はすべて data 側。
 * 記事カードは TRANSLATIONS に登録済みの実在ページだけを出す。
 */
import { TRANSLATIONS, type Locale } from '../data/i18n';
import type { IntlHome } from '../data/intl-home';
import { wikimediaImage } from '../lib/wikimedia-image';

interface Props { home: IntlHome; locale: Exclude<Locale, 'ja'>; }
const { home, locale } = Astro.props;

// 日本語TOPのFV（src/pages/index.astro）と同じ Wikimedia Commons の原本。別の写真には差し替えない
const PHOTO_SRC = 'https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/2025_Hitachi_Seaside_Park.jpg/1280px-2025_Hitachi_Seaside_Park.jpg';
const PHOTO_PAGE = 'https://commons.wikimedia.org/wiki/File:2025_Hitachi_Seaside_Park.jpg';
const photo = wikimediaImage(PHOTO_SRC);

const guides = home.guides.flatMap((g) => {
  const href = TRANSLATIONS[g.key]?.[locale];
  return href ? [{ ...g, href }] : [];
});
---

<div class="ih">
  <header class="ih-hero bp-wrap">
    <div class="ih-hero__text">
      <p class="bp-kicker">{home.kicker}</p>
      <h1>{home.h1}</h1>
      <div class="ih-lead">{home.lead.map((p) => <p>{p}</p>)}</div>
    </div>
    <figure class="ih-photo">
      <img src={photo.src} srcset={photo.srcset} sizes="(max-width: 820px) 100vw, 46vw" alt={home.heroPhoto.alt} width="1280" height="853" decoding="async" fetchpriority="high" />
      <figcaption>{home.heroPhoto.credit}: Kakidai / <a href={PHOTO_PAGE} rel="license noopener" target="_blank">Wikimedia Commons</a> / <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener" target="_blank">CC BY-SA 4.0</a> · {home.heroPhoto.cropped}</figcaption>
    </figure>
  </header>

  <section class="ih-why bp-wrap">
    <h2 class="bp-section-title">{home.whyHeading}</h2>
    <div class="ih-why-grid">{home.why.map((item) => (
      <article><h3>{item.title}</h3><p>{item.text}</p></article>
    ))}</div>
  </section>

  {guides.length > 0 && (
    <section class="ih-guides bp-wrap">
      <h2 class="bp-section-title">{home.guidesHeading}</h2>
      <p class="ih-guides-intro">{home.guidesIntro}</p>
      <div class="ih-guide-list">{guides.map((g) => (
        <article class="ih-guide">
          <h3><a href={g.href}>{g.title}</a></h3>
          <p>{g.text}</p>
          <a class="ih-guide-cta" href={g.href}>{g.cta} <span aria-hidden="true">→</span></a>
        </article>
      ))}</div>
    </section>
  )}

  <section class="ih-trust">
    <div class="bp-wrap">
      <h2>{home.trustHeading}</h2>
      {home.trustBody.map((p) => <p>{p}</p>)}
    </div>
  </section>
</div>

<style>
  .ih-hero{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(0,1fr);gap:clamp(2rem,4.5vw,4rem);align-items:center;padding-block:clamp(3rem,6vw,5.25rem) clamp(2rem,6vw,5.4rem)}
  .ih-photo{margin:0}
  .ih-photo img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;border:9px solid #fffdf7;box-shadow:5px 6px 0 #dedfce}
  .ih-photo figcaption{margin-top:13px;color:var(--v42-secondary,#53694f);font-size:12px;line-height:1.8}
  .ih-photo figcaption a{color:inherit}
  .ih-hero h1{max-width:10em;margin-top:1rem;font:600 clamp(2.2rem,6vw,4.6rem)/1.25 var(--font-brand-display);color:var(--color-ink)}
  .ih-lead{display:grid;gap:1rem;max-width:var(--measure);margin-top:1.6rem;color:var(--color-soil);line-height:2}
  .ih-why{padding-block:clamp(2.5rem,6vw,4rem);border-top:1px solid var(--color-mist)}
  .ih-why-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;margin-top:2rem}
  .ih-why-grid article{border-top:2px solid var(--color-ink);padding-top:1rem}
  .ih-why-grid h3{font:600 1.2rem var(--font-brand-display);color:var(--color-ink)}
  .ih-why-grid p{margin-top:.7rem;color:var(--color-soil);line-height:1.85;font-size:.92rem}
  .ih-guides{padding-block:clamp(2.5rem,6vw,4rem);border-top:1px solid var(--color-mist)}
  .ih-guides-intro{max-width:var(--measure);margin-top:1rem;color:var(--color-soil);line-height:1.9}
  .ih-guide-list{display:grid;gap:1.2rem;margin-top:2rem}
  .ih-guide{padding:1.6rem;background:var(--color-white);border:1px solid var(--color-mist)}
  .ih-guide h3{font:600 clamp(1.2rem,2.4vw,1.7rem)/1.45 var(--font-brand-display);color:var(--color-ink)}
  .ih-guide h3 a{color:inherit}
  .ih-guide h3 a:hover{color:var(--color-tide)}
  .ih-guide p{margin-top:.8rem;color:var(--color-soil);line-height:1.85}
  .ih-guide-cta{display:inline-block;margin-top:1.1rem;color:var(--color-tide);font-weight:600;font-size:.9rem;border-bottom:1px solid}
  .ih-trust{margin-top:clamp(2.5rem,6vw,4rem);padding-block:clamp(2.5rem,6vw,4rem);background:var(--color-ink);color:var(--color-paper)}
  .ih-trust h2{font:600 clamp(1.3rem,2.6vw,1.8rem) var(--font-brand-display);color:#fff}
  .ih-trust p{max-width:var(--measure);margin-top:1rem;line-height:1.95;font-size:.92rem;color:rgba(246,242,233,.88)}
  @media(max-width:820px){.ih-hero{grid-template-columns:minmax(0,1fr)}.ih-photo img{aspect-ratio:4/3}.ih-why-grid{grid-template-columns:minmax(0,1fr)}}
</style>
