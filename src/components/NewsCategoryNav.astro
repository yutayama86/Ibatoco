---
import { getNewsCategoryCounts } from '../lib/content';
import { NEWS_CATEGORIES, type NewsCategoryKey } from '../data/news';

interface Props { current?: NewsCategoryKey | 'all'; }
const { current = 'all' } = Astro.props;
const categories = [...(await getNewsCategoryCounts()).entries()]
  .filter(([, count]) => count > 0)
  .sort((a, b) => b[1] - a[1]);
const total = categories.reduce((sum, [, count]) => sum + count, 0);
---

<nav class="news-categories bp-wrap" aria-label="ニュースのカテゴリ">
  <ul data-xscroll>
    <li><a href="/news/" aria-current={current === 'all' ? 'page' : undefined}>すべて<span>{total}</span></a></li>
    {categories.map(([key, count]) => (
      <li><a href={`/news/category/${key}/`} aria-current={current === key ? 'page' : undefined}>{NEWS_CATEGORIES[key as NewsCategoryKey].label}<span>{count}</span></a></li>
    ))}
  </ul>
</nav>

<style>
  .news-categories ul{display:flex;gap:clamp(1rem,2.2vw,2rem);overflow-x:auto;padding-block:.65rem;border-block:1px solid var(--color-line);scrollbar-width:thin}
  li{flex:none}
  a{display:flex;align-items:center;gap:.6rem;min-height:44px;padding:.35rem .1rem;border-bottom:2px solid transparent;color:var(--color-soil);font-size:.8rem;font-weight:700;white-space:nowrap}
  a:hover,a[aria-current="page"]{border-bottom-color:var(--color-ink);color:var(--color-ink)}
  a:focus-visible{outline:2px solid var(--color-tide);outline-offset:-2px}
  span{font:.66rem var(--font-brand-meta);font-variant-numeric:tabular-nums;color:var(--color-soil)}
  /* スマホでは全カテゴリを見せる。横に隠れた項目を探す操作を不要にする。 */
  @media(max-width:560px){
    .news-categories ul{flex-wrap:wrap;gap:0 .5rem;overflow-x:visible;padding-block:.35rem}
    a{gap:.4rem;font-size:.875rem}
    span{font-size:.75rem}
  }
</style>
