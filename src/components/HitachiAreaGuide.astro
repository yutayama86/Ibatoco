const highlights = [
  { no:'01', title:'日立駅', text:'改札を抜けると、正面がまるごと海です。デザイン監修は日立市出身の建築家・妹島和世氏。2012年にグッドデザイン賞、2014年には鉄道デザインの国際コンペ「ブルネル賞」駅舎部門で優秀賞を受けています。線路をまたぐガラスの通路の先、展望イベントホールに遮るものはありません。', image:'/images/area/hitachi/station.jpg', alt:'日立駅の海展望ロビー', credit:'Σ64 / CC BY 4.0', creditUrl:'https://commons.wikimedia.org/wiki/File:Hitachi_Station,_Ibaraki_01.jpg', map:'https://www.google.com/maps/search/?api=1&query=%E6%97%A5%E7%AB%8B%E9%A7%85%20%E8%8C%A8%E5%9F%8E%E7%9C%8C%E6%97%A5%E7%AB%8B%E5%B8%82' },
  { no:'02', title:'御岩神社', text:'杉の巨木が並ぶ参道に入ると、光の量が変わります。参道を70メートルほど進んだところに立つ「三本杉」は、樹高50メートル、幹周り8.48メートル。地上3メートルあたりから幹が三本に分かれており、林野庁の「森の巨人たち100選」に選ばれ、茨城県の天然記念物にも指定されています。御岩山そのものを信仰の対象としてきた神社で、いまも山頂へ向かう登拝の道が続いています。参拝は6:00〜17:00、登拝は6:00〜15:00。', image:'/images/area/hitachi/oiwa-jinja.jpg', alt:'日立市・御岩神社の随神門', credit:'Taisuke.Kasuya / CC BY-SA 4.0', creditUrl:'https://commons.wikimedia.org/wiki/File:Zuishinmon_of_Oiwa-jinja_(Hitachi).jpg', map:'https://www.google.com/maps/search/?api=1&query=%E5%BE%A1%E5%B2%A9%E7%A5%9E%E7%A4%BE%20%E8%8C%A8%E5%9F%8E%E7%9C%8C%E6%97%A5%E7%AB%8B%E5%B8%82' },
