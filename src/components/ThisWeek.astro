---
/**
 * 「今日・明日・今週末、茨城で何があるか」。
 *
 * 記事を探させるのではなく、日付から入れるようにするための枠。
 * 中身は src/lib/happenings.ts が既存データ（イベント・試合・季節）から組み立てる。
 *
 * 該当が1件も無ければ、このブロックごと出さない。
 * 「今日は何もありません」と書くくらいなら、無いほうがよい。
 */
import { getHappenings, getWeekBoard, type HappeningKind } from '../lib/happenings';

interface Props {
  /** GA4 の page_type。置いたページに合わせる（TOP以外から使うとき必須） */
  pageType?: string;
  heading?: string;
  lead?: string;
}
const {
  pageType = 'home',
  heading = '今週、茨城でできること',
  lead = '公開情報で日程を確認できたものだけを並べています。終わったものは出していません。',
} = Astro.props;

const now = new Date();
const board = await getWeekBoard(now);
// 静的サイトでも日付の経過だけで自動表示・自動非表示できるよう、120日分を埋め込む。
// 新しい公式発表の追加は通常の公開フロー、既知イベントの状態遷移はブラウザ側が担う。
const candidates = await getHappenings(now, 120);
const manifest = JSON.stringify(candidates.map((item) => ({
  kind: item.kind,
  title: item.title,
  href: item.href,
  start: item.start.toISOString().slice(0, 10),
  end: item.end.toISOString().slice(0, 10),
  startTime: item.startTime,
  place: item.place,
  municipality: item.municipality,
  ongoing: item.ongoing,
}))).replace(/</g, '\\u003c');

const KIND_LABEL: Record<HappeningKind, string> = {
  event: 'イベント',
  sports: '試合',
  season: '開催中',
};
---

{candidates.length > 0 && (
  <section class="tw" aria-labelledby="tw-title" data-this-week data-page-type={pageType} hidden={board.length === 0}>
    <div class="bp-wrap">
      <p class="bp-kicker">THIS WEEK</p>
      <h2 id="tw-title" class="tw__title">{heading}</h2>
      <p class="tw__lead">{lead}</p>

      <div class="tw__groups">
        {board.map((group) => (
          <div class="tw__group">
            <p class="tw__when">{group.label}</p>
            <ul class="tw__list">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} data-week-kind={item.kind} data-week-bucket={group.bucket} data-week-place={item.place ?? ''}>
                    <span class="tw__meta">
                      <span class:list={['tw__kind', `is-${item.active && item.ongoing ? 'season' : item.kind}`]}>{item.active && item.ongoing ? '開催中' : KIND_LABEL[item.kind]}</span>
                      <time>{item.dateLabel}</time>
                    </span>
                    <strong>{item.title}</strong>
                    {item.place && <span class="tw__place">{item.place}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <script is:inline type="application/json" data-this-week-items set:html={manifest}></script>
    </div>
  </section>
)}

<script>
  import { commonParams, trackEvent } from '../lib/analytics-events';
  import { dateOnlyFromInstant, parseDateOnly } from '../lib/date-only.js';
  import { happeningBucket, happeningDateLabel, isHappeningActive } from '../lib/happening-schedule.js';
  import type { HappeningKind } from '../lib/happenings';

  type ClientHappening = {
    kind: HappeningKind;
    title: string;
    href: string;
    start: string;
    end: string;
    startTime?: string;
    place?: string;
    municipality?: string;
    ongoing: boolean;
  };

  const kindLabel: Record<HappeningKind, string> = {
    event: 'イベント',
    sports: '試合',
    season: '開催中',
  };
  const bucketLabel = {
    today: '今日',
    tomorrow: '明日',
    weekend: '今週末',
    thisWeek: 'この先1週間',
  } as const;
  const bucketOrder = ['today', 'tomorrow', 'weekend', 'thisWeek'] as const;

  const appendTextElement = (parent: Element, tag: string, text: string, className?: string) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    element.textContent = text;
    parent.append(element);
    return element;
  };

  const renderCurrentWeek = (block: HTMLElement) => {
    const source = block.querySelector<HTMLScriptElement>('[data-this-week-items]');
    const groups = block.querySelector<HTMLElement>('.tw__groups');
    if (!source || !groups) return;

    let items: ClientHappening[] = [];
    try { items = JSON.parse(source.textContent ?? '[]') as ClientHappening[]; } catch { return; }

    const today = dateOnlyFromInstant(new Date(), 'Asia/Tokyo');
    const grouped = new Map<string, { item: ClientHappening; start: Date; end: Date }[]>();
    for (const item of items) {
      const start = parseDateOnly(item.start);
      const end = parseDateOnly(item.end);
      const bucket = happeningBucket(start, end, today);
      if (!bucket) continue;
      const current = grouped.get(bucket) ?? [];
      current.push({ item, start, end });
      grouped.set(bucket, current);
    }

    groups.replaceChildren();
    for (const bucket of bucketOrder) {
      const entries = grouped.get(bucket);
      if (!entries?.length) continue;
      const group = document.createElement('div');
      group.className = 'tw__group';
      appendTextElement(group, 'p', bucketLabel[bucket], 'tw__when');
      const list = document.createElement('ul');
      list.className = 'tw__list';
      for (const { item, start, end } of entries) {
        const active = item.ongoing && isHappeningActive(start, end, today);
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.href;
        link.dataset.weekKind = item.kind;
        link.dataset.weekBucket = bucket;
        link.dataset.weekPlace = item.place ?? '';
        const meta = document.createElement('span');
        meta.className = 'tw__meta';
        appendTextElement(meta, 'span', active ? '開催中' : kindLabel[item.kind], `tw__kind is-${active ? 'season' : item.kind}`);
        appendTextElement(meta, 'time', happeningDateLabel(start, end, today, item.startTime));
        link.append(meta);
        appendTextElement(link, 'strong', item.title);
        if (item.place) appendTextElement(link, 'span', item.place, 'tw__place');
        li.append(link);
        list.append(li);
      }
      group.append(list);
      groups.append(group);
    }
    block.hidden = groups.childElementCount === 0;
  };

  // 「今週できること」のどれが押されるかを見る。
  // どの区分（今日/今週末/この先）と、どの種類（試合/イベント/開催中）が
  // 押されるかで、次にどのデータを厚くすべきかが決まる。
  for (const block of document.querySelectorAll<HTMLElement>('[data-this-week]')) {
    renderCurrentWeek(block);
    const pageType = block.dataset.pageType ?? 'home';
    block.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-week-kind]');
      if (!link) return;
      trackEvent('next_action_click', {
        ...commonParams({ page_type: pageType }),
        destination_type: link.dataset.weekKind ?? '',
        when_bucket: link.dataset.weekBucket ?? '',
        action_source: 'this_week',
        destination_url: link.getAttribute('href') ?? '',
      });
    });
  }
</script>

<!-- ブラウザで日付ごとに再生成するカードにも適用する。tw固有クラスだけなので他要素へ波及しない -->
<style is:global>
  .tw{padding-block:clamp(4.8rem,7vw,6.8rem);background:#f7f8f6}
  .tw__title{margin-top:.65rem;font:600 clamp(2rem,3.8vw,3rem)/1.3 var(--font-brand-display);color:var(--brand-navy);text-wrap:balance}
  .tw__lead{margin-top:.8rem;max-width:var(--measure);color:var(--color-soil);font-size:.88rem;line-height:1.9}
  .tw__groups{display:grid;gap:0;margin-top:2.4rem;border-top:1px solid rgba(76,105,136,.18)}
  .tw__group{display:grid;grid-template-columns:8rem minmax(0,1fr);gap:1.5rem;padding:1.15rem 0;border-bottom:1px solid rgba(76,105,136,.18);background:transparent}.tw__when{margin:0;color:#72879a;font:800 .68rem var(--font-brand-meta);letter-spacing:.12em}
  .tw__list{display:grid;gap:0;margin:0;padding:0;list-style:none}
  .tw__list li{margin:0}
  .tw__list a{display:grid;grid-template-columns:minmax(8rem,.55fr) minmax(0,1.6fr) minmax(7rem,.45fr);gap:1rem;align-items:baseline;padding:.62rem 0;color:var(--color-ink);text-decoration:none;transition:padding .2s ease,color .2s ease}
  .tw__list a:hover,.tw__list a:focus-visible{padding-left:.6rem;color:var(--color-brand-blue)}
  .tw__list a:focus-visible{outline:2px solid var(--color-tide);outline-offset:2px}
  .tw__meta{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;color:#748596;font-size:.72rem}
  .tw__kind{font:800 .62rem var(--font-brand-meta);letter-spacing:.08em;color:var(--brand-navy)}
  .tw__kind.is-sports{color:var(--color-brand-blue)}
  .tw__kind.is-season{color:#586b5d}
  .tw__list strong{font:600 1rem/1.55 var(--font-brand-display)}
  .tw__place{color:var(--color-soil);font-size:.8rem}
  @media(max-width:760px){.tw__group{grid-template-columns:1fr;gap:.55rem}.tw__list a{grid-template-columns:1fr;gap:.18rem;padding:.75rem 0}.tw__place{font-size:.74rem}}
</style>
