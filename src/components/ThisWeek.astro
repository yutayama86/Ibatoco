---
/**
 * 「今日・明日・今週末、茨城で何があるか」。
 *
 * 記事を探させるのではなく、日付から入れるようにするための枠。
 * 中身は src/lib/happenings.ts が既存データ（イベント・試合・季節）から組み立てる。
 *
 * 該当が1件も無ければ、このブロックごと出さない。
 * 「今日は何もありません」と書くくらいなら、無いほうがよい。
 */
import { getHappenings, getWeekBoard, type HappeningKind } from '../lib/happenings';
import { listImageForPath } from '../lib/card-image';

interface Props {
  /** GA4 の page_type。置いたページに合わせる（TOP以外から使うとき必須） */
  pageType?: string;
  heading?: string;
  lead?: string;
  /** 見出しの横に置く「もっと見る」先（/today/ など）。置いたページ自身へは付けない */
  moreHref?: string;
  moreLabel?: string;
}
const {
  pageType = 'home',
  heading = '今週の茨城',
  lead = '開催日が確認できているイベントや試合を、日付順にまとめています。',
  moreHref,
  moreLabel = '今日の茨城で見る',
} = Astro.props;

const isHomeEditorial = pageType === 'home';
const now = new Date();
const board = await getWeekBoard(now);
const activeItems = board.flatMap((group) => group.items).filter((item) => item.ongoing && item.active);
const activeHref = new Set(activeItems.map((item) => item.href));
const displayBoard = [
  ...(activeItems.length ? [{ bucket: 'active' as const, label: '開催中', items: activeItems }] : []),
  ...board
    .map((group) => ({ ...group, items: group.items.filter((item) => !activeHref.has(item.href)) }))
    .filter((group) => group.items.length > 0),
];
// 静的サイトでも日付の経過だけで自動表示・自動非表示できるよう、120日分を埋め込む。
// 新しい公式発表の追加は通常の公開フロー、既知イベントの状態遷移はブラウザ側が担う。
const candidates = await getHappenings(now, 120);
const eventIllustrations: Record<string, string> = {
  '/events/ibaraki-flowerpark-illumination-2026/': '/images/v42/nightgarden.webp',
  '/events/kamine-park-autumn-festival-2-2026/': '/images/v42/autumn-maple-print.webp',
  '/events/kasama-kiku-matsuri-2026/': '/images/v42/chrysanthemums.webp',
  '/events/oarai-ankou-matsuri-2026/': '/images/v42/hotpot.webp',
};
const homeArtwork = new Map<string, { src: string; caption?: string; contain?: boolean }>();
if (isHomeEditorial) {
  for (const { href, kind } of candidates) {
    if (homeArtwork.has(href)) continue;
    const illustration = kind === 'sports' ? '/images/v42/matchday-supporters.webp' : eventIllustrations[href];
    if (illustration) {
      homeArtwork.set(href, {
        src: illustration,
        caption: 'イメージイラスト',
        contain: kind === 'sports' || illustration.endsWith('-print.webp'),
      });
    } else {
      const image = await listImageForPath(href);
      homeArtwork.set(href, image
        ? { src: image.src, caption: image.source === 'card' ? 'エリア地図' : undefined, contain: image.source !== 'card' }
        : { src: '/images/v42/ibarakiscape.webp', caption: 'イメージイラスト' });
    }
  }
}
const manifest = JSON.stringify(candidates.map((item) => ({
  kind: item.kind,
  title: item.title,
  href: item.href,
  start: item.start.toISOString().slice(0, 10),
  end: item.end.toISOString().slice(0, 10),
  startTime: item.startTime,
  place: item.place,
  municipality: item.municipality,
  ongoing: item.ongoing,
  artwork: homeArtwork.get(item.href),
}))).replace(/</g, '\\u003c');

const HOME_PREVIEW_LIMIT = 3;
const KIND_LABEL: Record<HappeningKind, string> = {
  event: 'イベント',
  sports: '試合',
  season: '開催中',
};
---

{candidates.length > 0 && (
  <section class:list={['tw', { 'tw--home-editorial': isHomeEditorial }]} aria-labelledby="tw-title" data-this-week data-page-type={pageType} hidden={displayBoard.length === 0}>
    <div class="bp-wrap">
      {isHomeEditorial ? (
        <header class="tw__opening">
          <div>
            <span class="tw__eyebrow">EXPLORE IBARAKI / EVENTS</span>
            <h2 id="tw-title" class="tw__title">今、茨城で<br />楽しめるイベント。</h2>
            <p class="tw__lead">今行ける催しや、週末のイベント。日付から次のおでかけを探す。</p>
          </div>
          <img class="tw__opening-art" src="/images/v42/kasama-market-print.webp" width="1280" height="853" alt="" loading="lazy" decoding="async" />
        </header>
      ) : (
        <Fragment>
          <div class="tw__head">
            <h2 id="tw-title" class="tw__title">{heading}</h2>
            {moreHref && <a class="tw__more" href={moreHref} data-week-kind="hub" data-week-bucket="more">{moreLabel}<span aria-hidden="true">&nbsp;→</span></a>}
          </div>
          <p class="tw__lead">{lead}</p>
        </Fragment>
      )}

      <div class="tw__groups">
        {displayBoard.map((group) => (
          <div class:list={['tw__group', `is-${group.bucket}`]}>
            <div class="tw__group-head"><p class="tw__when">{group.label}</p>{isHomeEditorial && <span class="tw__group-note">{group.bucket === 'active' ? 'いま行ける' : group.bucket === 'tomorrow' ? '明日のおでかけ' : group.bucket === 'weekend' ? '週末に行きたい' : '近日開催'}</span>}</div>
            <ul class="tw__list">
              {group.items.map((item) => {
                const artwork = homeArtwork.get(item.href);
                return (
                <li>
                  <a href={item.href} data-week-kind={item.kind} data-week-bucket={group.bucket} data-week-place={item.place ?? ''}>
                    {artwork && (
                      <span class:list={['tw__card-art', { 'is-contained': artwork.contain }]}>
                        <img src={artwork.src} width="112" height="140" alt="" loading="lazy" decoding="async" />
                        {artwork.caption && <small>{artwork.caption}</small>}
                      </span>
                    )}
                    <span class="tw__meta">
                      <span class:list={['tw__kind', `is-${item.active && item.ongoing ? 'season' : item.kind}`]}>{item.active && item.ongoing ? '開催中' : KIND_LABEL[item.kind]}</span>
                      <time>{item.dateLabel}</time>
                    </span>
                    <strong>{item.title}</strong>
                    {item.place && <span class="tw__place">{item.place}</span>}
                    {isHomeEditorial && <span class="tw__read" aria-hidden="true">詳しく見る <span>↗</span></span>}
                  </a>
                </li>
                );
              })}
            </ul>
            {isHomeEditorial && group.items.length > HOME_PREVIEW_LIMIT && (
              <button class="tw__expand" type="button" aria-expanded="false" data-week-expand>
                ほかの{group.items.length - HOME_PREVIEW_LIMIT}件を見る <span aria-hidden="true">→</span>
              </button>
            )}
          </div>
        ))}
      </div>
      {isHomeEditorial && moreHref && <a class="tw__more tw__more--home" href={moreHref} data-week-kind="hub" data-week-bucket="more">{moreLabel}<span aria-hidden="true">&nbsp;→</span></a>}
      <script is:inline type="application/json" data-this-week-items set:html={manifest}></script>
    </div>
  </section>
)}

<script>
  import { commonParams, trackEvent } from '../lib/analytics-events';
  import { dateOnlyFromInstant, parseDateOnly } from '../lib/date-only.js';
  import { happeningBucket, happeningDateLabel, isHappeningActive } from '../lib/happening-schedule.js';
  import type { HappeningKind } from '../lib/happenings';

  type ClientHappening = {
    kind: HappeningKind;
    title: string;
    href: string;
    start: string;
    end: string;
    startTime?: string;
    place?: string;
    municipality?: string;
    ongoing: boolean;
    artwork?: { src: string; caption?: string; contain?: boolean };
  };

  const kindLabel: Record<HappeningKind, string> = {
    event: 'イベント',
    sports: '試合',
    season: '開催中',
  };
  const bucketLabel = {
    active: '開催中',
    today: '今日',
    tomorrow: '明日',
    weekend: '今週末',
    thisWeek: 'この先1週間',
  } as const;
  const bucketOrder = ['active', 'today', 'tomorrow', 'weekend', 'thisWeek'] as const;
  const HOME_PREVIEW_LIMIT = 3;

  const appendTextElement = (parent: Element, tag: string, text: string, className?: string) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    element.textContent = text;
    parent.append(element);
    return element;
  };

  const renderCurrentWeek = (block: HTMLElement) => {
    const source = block.querySelector<HTMLScriptElement>('[data-this-week-items]');
    const groups = block.querySelector<HTMLElement>('.tw__groups');
    if (!source || !groups) return;

    let items: ClientHappening[] = [];
    try { items = JSON.parse(source.textContent ?? '[]') as ClientHappening[]; } catch { return; }

    const today = dateOnlyFromInstant(new Date(), 'Asia/Tokyo');
    const grouped = new Map<string, { item: ClientHappening; start: Date; end: Date }[]>();
    for (const item of items) {
      const start = parseDateOnly(item.start);
      const end = parseDateOnly(item.end);
      const isActiveNow = item.ongoing && isHappeningActive(start, end, today);
      const bucket = isActiveNow ? 'active' : happeningBucket(start, end, today);
      if (!bucket) continue;
      const current = grouped.get(bucket) ?? [];
      current.push({ item, start, end });
      grouped.set(bucket, current);
    }

    groups.replaceChildren();
    for (const bucket of bucketOrder) {
      const entries = grouped.get(bucket);
      if (!entries?.length) continue;
      const group = document.createElement('div');
      group.className = `tw__group is-${bucket}`;
      const isHome = block.dataset.pageType === 'home';
      const head = document.createElement('div');
      head.className = 'tw__group-head';
      appendTextElement(head, 'p', bucketLabel[bucket], 'tw__when');
      if (isHome) appendTextElement(head, 'span', bucket === 'active' ? 'いま行ける' : bucket === 'tomorrow' ? '明日のおでかけ' : bucket === 'weekend' ? '週末に行きたい' : '近日開催', 'tw__group-note');
      group.append(head);
      const list = document.createElement('ul');
      list.className = 'tw__list';
      for (const { item, start, end } of entries) {
        const isActiveNow = item.ongoing && isHappeningActive(start, end, today);
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.href;
        link.dataset.weekKind = item.kind;
        link.dataset.weekBucket = bucket;
        link.dataset.weekPlace = item.place ?? '';
        if (isHome && item.artwork) {
          const art = document.createElement('span');
          art.className = item.artwork.contain ? 'tw__card-art is-contained' : 'tw__card-art';
          const image = document.createElement('img');
          image.src = item.artwork.src;
          image.alt = '';
          image.width = 112;
          image.height = 140;
          image.loading = 'lazy';
          image.decoding = 'async';
          art.append(image);
          if (item.artwork.caption) appendTextElement(art, 'small', item.artwork.caption);
          link.append(art);
        }
        const meta = document.createElement('span');
        meta.className = 'tw__meta';
        appendTextElement(meta, 'span', isActiveNow ? '開催中' : kindLabel[item.kind], `tw__kind is-${isActiveNow ? 'season' : item.kind}`);
        appendTextElement(meta, 'time', happeningDateLabel(start, end, today, item.startTime));
        link.append(meta);
        appendTextElement(link, 'strong', item.title);
        if (item.place) appendTextElement(link, 'span', item.place, 'tw__place');
        if (isHome) {
          const read = appendTextElement(link, 'span', '詳しく見る ', 'tw__read');
          read.setAttribute('aria-hidden', 'true');
          appendTextElement(read, 'span', '↗');
        }
        li.append(link);
        list.append(li);
      }
      group.append(list);
      if (isHome && entries.length > HOME_PREVIEW_LIMIT) {
        const button = document.createElement('button');
        button.className = 'tw__expand';
        button.type = 'button';
        button.dataset.weekExpand = '';
        button.setAttribute('aria-expanded', 'false');
        button.textContent = `ほかの${entries.length - HOME_PREVIEW_LIMIT}件を見る →`;
        group.append(button);
      }
      groups.append(group);
    }
    block.hidden = groups.childElementCount === 0;
  };

  // 「今週できること」のどれが押されるかを見る。
  // どの区分（今日/今週末/この先）と、どの種類（試合/イベント/開催中）が
  // 押されるかで、次にどのデータを厚くすべきかが決まる。
  for (const block of document.querySelectorAll<HTMLElement>('[data-this-week]')) {
    renderCurrentWeek(block);
    const pageType = block.dataset.pageType ?? 'home';
    block.addEventListener('click', (event) => {
      const expand = (event.target as Element).closest<HTMLButtonElement>('[data-week-expand]');
      if (expand) {
        const group = expand.closest<HTMLElement>('.tw__group');
        if (!group) return;
        const expanded = group.classList.toggle('is-expanded');
        expand.setAttribute('aria-expanded', String(expanded));
        if (expanded) expand.textContent = '閉じる ↑';
        else expand.textContent = `ほかの${Math.max(0, group.querySelectorAll('.tw__list > li').length - HOME_PREVIEW_LIMIT)}件を見る →`;
        return;
      }
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-week-kind]');
      if (!link) return;
      trackEvent('next_action_click', {
        ...commonParams({ page_type: pageType }),
        destination_type: link.dataset.weekKind ?? '',
        when_bucket: link.dataset.weekBucket ?? '',
        action_source: 'this_week',
        destination_url: link.getAttribute('href') ?? '',
      });
    });
  }
</script>

<!-- ブラウザで日付ごとに再生成するカードにも適用する。tw固有クラスだけなので他要素へ波及しない -->
<style is:global>
  .tw{position:relative;overflow:hidden;padding-block:clamp(4.8rem,7vw,6.8rem);background:#f7f8f6}
  .tw::after{content:"";position:absolute;right:-5rem;bottom:-4rem;width:25rem;height:14rem;background:url('/brand/terrain-contours.svg') center/contain no-repeat;opacity:.045;pointer-events:none}
  .tw>.bp-wrap{position:relative;z-index:1}
  .tw__title{scroll-margin-top:calc(var(--site-header-height) + 1.5rem);font:600 clamp(2rem,3.6vw,2.9rem)/1.3 var(--font-brand-display);color:var(--brand-navy);text-wrap:balance}
  .tw__head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.35rem 1.5rem}
  .tw__head .tw__title{min-width:0}
  .tw__more{flex:none;color:var(--color-brand-blue);font:700 .84rem var(--font-brand-meta);letter-spacing:.02em;white-space:nowrap;text-decoration:none}
  .tw__more:hover{text-decoration:underline;text-underline-offset:.2em}
  .tw__more:focus-visible{outline:2px solid var(--color-brand-blue);outline-offset:3px;border-radius:4px}
  .tw__lead{margin-top:.65rem;max-width:var(--measure);color:var(--color-soil);font-size:.84rem;line-height:1.85}
  .tw__groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:2rem}
  .tw__group{--tw-accent:#6f8da8;--tw-bg:#edf3f7;min-width:0;padding:1.1rem;border:1px solid rgba(76,105,136,.12);border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(76,105,136,.045)}
  .tw__group.is-active{--tw-accent:#63755d;--tw-bg:#eef2e9}
  .tw__group.is-today{--tw-accent:#274f7a;--tw-bg:#e7f0f8}
  .tw__group.is-tomorrow{--tw-accent:#587a9b;--tw-bg:#edf3f8}
  .tw__group.is-weekend{--tw-accent:#3e78a7;--tw-bg:#e9f3fa}
  .tw__group.is-thisWeek{--tw-accent:#6f8066;--tw-bg:#eef1e9}
  .tw__when{display:inline-flex;margin:0 0 .9rem;padding:.34rem .7rem;border-radius:999px;background:var(--tw-bg);color:var(--tw-accent);font:800 .7rem var(--font-brand-meta);letter-spacing:.04em}
  .tw__list{display:grid;gap:.7rem;margin:0;padding:0;list-style:none}
  .tw__list li{margin:0}
  .tw__list a{display:block;padding:.9rem 0 0;border-top:1px solid rgba(76,105,136,.12);color:var(--color-ink);text-decoration:none}
  .tw__list li:first-child a{padding-top:0;border-top:0}
  .tw__meta{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;color:#758596;font-size:.7rem}
  .tw__kind{font:800 .62rem var(--font-brand-meta);letter-spacing:.04em;color:var(--tw-accent)}
  .tw__list strong{display:block;margin-top:.28rem;font:600 1rem/1.5 var(--font-brand-display);color:var(--brand-navy);transition:color .16s ease}
  .tw__place{display:block;margin-top:.2rem;color:var(--color-soil);font-size:.74rem}
  .tw__list a:hover strong,.tw__list a:focus-visible strong{color:var(--color-brand-blue)}
  .tw__list a:focus-visible{outline:2px solid var(--color-brand-blue);outline-offset:3px;border-radius:8px}
  @media(max-width:980px){.tw__groups{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.tw__groups{grid-template-columns:minmax(0,1fr)}.tw__group{padding:1rem}.tw__title{font-size:1.8rem}}

  /* TOP限定：イベントは3件ずつ編集して見せ、必要な人だけ展開。
     日付によってイベント数が変わっても1列だけ下に伸びない。 */
  .tw--home-editorial{padding-block:clamp(2.75rem,5vw,4.75rem);background:#eef1e6;border:0}
  .tw--home-editorial::after{display:none}
  .tw--home-editorial>.bp-wrap{width:min(1160px,calc(100% - 2.75rem))}
  .tw__opening{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1.5rem 2rem;align-items:end}
  .tw__opening-art{display:block;width:100%;height:auto;max-height:250px;object-fit:contain;object-position:right bottom}
  .tw--home-editorial .tw__eyebrow{font:500 .69rem/1.4 var(--font-brand-meta);letter-spacing:.2em;color:#617357}
  .tw--home-editorial .tw__title{margin-top:.65rem;color:#24434a;font-size:clamp(2rem,3.2vw,2.875rem);font-weight:500;line-height:1.45;letter-spacing:.025em;text-wrap:normal}
  .tw__more--home{display:inline-flex;align-items:center;min-height:44px;margin-top:1rem;border-bottom:1px solid currentColor}
  .tw--home-editorial .tw__lead{max-width:var(--measure);margin-top:.65rem;text-align:left;font-size:clamp(.85rem,1.2vw,1rem)}
  .tw--home-editorial .tw__groups{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:clamp(1.25rem,3vw,2.5rem);margin-top:clamp(1.6rem,3.2vw,2.5rem)}
  .tw--home-editorial .tw__group{display:flex;flex-direction:column;min-width:0;padding:1.25rem 0 0;border:0;border-top:2px solid #24434a;border-radius:0;background:transparent;box-shadow:none}
  .tw--home-editorial .tw__group-head{display:flex;flex-direction:column-reverse;align-items:flex-start;gap:.35rem;padding:0 0 .875rem;border-bottom:1px solid #ccd6c9}
  .tw--home-editorial .tw__when{display:block;margin:0;padding:0;border:0;border-radius:0;background:none;color:#24434a;font:500 clamp(1.3rem,1.8vw,1.65rem)/1.35 var(--font-brand-display);letter-spacing:.04em}
  .tw--home-editorial .tw__group-note{color:#576c64;font-size:.73rem;letter-spacing:.02em}
  .tw--home-editorial .tw__list{display:grid;align-content:start;gap:0;margin:0}
  .tw--home-editorial .tw__list li{min-width:0;border-bottom:1px solid #ccd6c9}
  .tw--home-editorial .tw__list li:nth-child(n+4){display:none}
  .tw--home-editorial .tw__group.is-expanded .tw__list li:nth-child(n+4){display:list-item}
  .tw--home-editorial .tw__list a{display:grid;grid-template-columns:7rem minmax(0,1fr);grid-template-rows:auto auto auto 1fr;align-items:start;gap:.375rem 1rem;padding:1.125rem 0;border:0;min-height:44px}
  .tw--home-editorial .tw__list li:first-child a{padding-top:1.125rem}
  .tw--home-editorial .tw__list a>:not(.tw__card-art){grid-column:2}
  .tw__card-art{position:relative;grid-column:1;grid-row:1/5;display:block;aspect-ratio:4/5;overflow:hidden;background:#f9f7ec}
  .tw__card-art img{display:block;width:100%;height:100%;object-fit:cover}
  .tw__card-art.is-contained img{object-fit:contain}
  .tw__card-art small{position:absolute;inset:auto .1875rem .1875rem;padding:.125rem .2rem;background:#fffdf4;color:#4d5f50;font-size:.6875rem;line-height:1.25;text-align:center}
  .tw--home-editorial .tw__list strong{margin:0;color:#24434a;font-size:clamp(1.125rem,1.55vw,1.375rem);line-height:1.55;line-break:strict;overflow-wrap:break-word;text-wrap:balance}
  .tw--home-editorial .tw__meta{color:#576c64;font-size:.75rem}
  .tw--home-editorial .tw__kind{display:inline-flex;align-items:center;padding:.18rem .5rem;border-radius:100px;background:var(--tw-bg);font-size:.65rem}
  .tw--home-editorial .is-active .tw__kind{display:none}
  .tw--home-editorial .tw__place{font-size:.75rem;line-height:1.4}
  .tw__read{display:flex;justify-content:space-between;gap:.5rem;color:#254f68;font-size:.75rem;font-weight:700}
  .tw--home-editorial .tw__expand{display:block;align-self:stretch;min-height:44px;margin-top:.75rem;padding:.65rem .8rem;border:1px solid var(--color-line);border-radius:var(--radius-xs);background:var(--color-white);color:#174f99;font-size:.78rem;font-weight:700;cursor:pointer;transition:background .18s ease}
  .tw--home-editorial .tw__expand:hover{background:#d7eaf8}
  .tw--home-editorial .tw__expand:focus-visible{outline:2px solid #174f99;outline-offset:2px}
  .tw--home-editorial .tw__expand span{margin-left:.3rem}
  @media(max-width:760px){
    .tw__opening,.tw--home-editorial .tw__groups{grid-template-columns:minmax(0,1fr)}
    .tw__opening{gap:.65rem}
    .tw__opening-art{max-height:185px;object-position:center}
    .tw--home-editorial .tw__title{font-size:clamp(1.75rem,8.2vw,2rem);line-height:1.5}
    .tw--home-editorial .tw__list a{grid-template-columns:clamp(5.6875rem,27vw,6.625rem) minmax(0,1fr);column-gap:.875rem}
  }
</style>
