---
import type { Store } from '../lib/content';
interface Props{store:Store}; const {store}=Astro.props; const d=store.data;
const facts=[['所在地',d.address||d.area],['アクセス',d.access],['営業時間',d.hours],['定休日',d.holiday],['予算',d.budget]].filter(([,v])=>v);
const telHref=d.tel ? `tel:${d.tel.replace(/[^\d+]/g,'')}` : null;
const mapHref=d.map ?? (d.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`茨城県${d.area}${d.address}`)}` : null);
---
<dl class="pf">
  {facts.map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}
  {d.tel && telHref && <div><dt>電話</dt><dd><a href={telHref} data-place-action="tel">{d.tel}</a></dd></div>}
  {mapHref && <div><dt>地図</dt><dd><a href={mapHref} target="_blank" rel="noopener noreferrer" data-place-action="map">Google マップで確認 ↗</a></dd></div>}
</dl>
<style>.pf{border-top:1px solid var(--color-mist)}.pf div{display:grid;grid-template-columns:7rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-mist)}.pf dt{color:var(--color-soil);font-size:.78rem;font-weight:600}.pf dd{color:var(--color-ink);font-size:.9rem}.pf a{color:var(--interior-blue,var(--color-tide));text-decoration:underline;text-underline-offset:.2em}@media(max-width:480px){.pf div{grid-template-columns:5.5rem 1fr}}</style>
