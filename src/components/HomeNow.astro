  .home-now__season strong { font: 600 .9375rem/1.5 var(--font-brand-display); line-break: strict; overflow-wrap: anywhere; }
  .home-now__season-arrow { position: absolute; right: .6rem; bottom: .18rem; color: var(--panel-ink); }
