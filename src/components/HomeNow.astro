  .home-now__season, .home-now__rank { --panel-rule: #c9d3c1; --panel-ink: #345747; min-width: 0; padding: clamp(1rem,2.1vw,1.6rem); border: 1px solid var(--panel-rule); background: #eef1e7; }
  .home-now__rank { --panel-rule: #c8d6da; --panel-ink: #31586b; background: #edf2f3; }
  .home-now__section-head { display: grid; gap: .35rem; margin-bottom: .95rem; padding-bottom: .65rem; border-bottom: 1px solid var(--panel-rule); }
