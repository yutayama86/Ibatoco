---
/**
 * TOPの検索と、開催中・人気記事の案内。
 * v42の検索はヒーロー直下の横長の帯。updates は季節特集・イベントの後に置く。
 * 人気記事と期間ものの判定は従来どおり残し、updates の呼び出しでだけ計算する。
 *
 * - 検索窓 … /search/?q=（GA4の拡張計測がサイト内検索として記録する）
 * - いま見頃・開催中 … src/lib/happenings.ts の期間もの。表示は日本時間で画面側が判定する
 * - いま読まれている … data/editorial/popular-pages.json（直近7日の実測）。終了イベントは出さない。
 *   同じ話題の記事（src/data/topics.ts）は1行にまとめ、閲覧数を合算して順位を決める
 * - 行き先診断 … /shindan/
 * TOPの必須構成（FV3枚・つくった理由・テーマ6・地図44・取材と編集3・事業者導線）には触れない。
 */
import popular from '../../data/editorial/popular-pages.json';
import { getHappenings } from '../lib/happenings';
import { getAllFacets } from '../lib/taxonomy';
import { TOPICS, topicOf } from '../data/topics';
import V42Icon from './V42Icon.astro';

interface Props { variant?: 'search' | 'updates'; }
const { variant = 'search' } = Astro.props;
const searchWays = [
  { label: '日付から', href: '/events/', icon: 'event' },
  { label: 'エリアから', href: '/area/', icon: 'area' },
  { label: '目的から', href: '/odekake/', icon: 'route' },
  { label: '条件から', href: '/discover/', icon: 'search' },
] as const;

const facets = variant === 'updates' ? await getAllFacets() : [];
const facetByPath = new Map(facets.map((facet) => [facet.path, facet]));
const linkable = (path: string) => {
  const facet = facetByPath.get(path);
  return Boolean(facet && !facet.noindex && facet.eventLifecycle !== 'ended');
};
for (const topic of variant === 'updates' ? TOPICS : []) {
  for (const page of topic.pages) {
    if (!facetByPath.has(page.path)) throw new Error(`topics.ts: ${page.path} の記事が見つかりません`);
  }
}

// 同じ話題は1行にまとめる。順位は話題に属する記事の閲覧数の合計で決める
interface RankItem { path: string; title: string; views: number; subs: { path: string; label: string }[] }
const rows = new Map<string, RankItem>();
for (const entry of variant === 'updates' ? popular.pages : []) {
  if (!linkable(entry.path)) continue;
  const topic = topicOf(entry.path);
  const key = topic?.id ?? entry.path;
  const row = rows.get(key);
  if (row) {
    row.views += entry.views;
    continue;
  }
  if (topic) {
    const hub = linkable(topic.hub) ? topic.hub : entry.path;
    rows.set(key, {
      path: hub,
      title: hub === topic.hub ? topic.title : facetByPath.get(hub)!.title.split('｜')[0],
      views: entry.views,
      subs: topic.pages.filter((page) => page.path !== hub && linkable(page.path)),
    });
  } else {
    rows.set(key, { path: entry.path, title: facetByPath.get(entry.path)!.title.split('｜')[0], views: entry.views, subs: [] });
  }
}
const ranking = [...rows.values()].sort((a, b) => b.views - a.views).slice(0, 5);

// 期間もの（季節の見頃・複数日の催し）。開始前のものも出力し、画面側で今日に合うものだけ見せる
const seasonal = (variant === 'updates' ? await getHappenings(new Date(), 60) : [])
  .filter((item) => item.kind === 'season' || item.ongoing)
  .slice(0, 8)
  .map((item) => ({
    title: item.title,
    href: item.href,
    place: item.place ?? '',
    start: item.start.toISOString().slice(0, 10),
    end: item.end.toISOString().slice(0, 10),
  }));
---

{variant === 'search' ? <section class="home-now" aria-labelledby="home-now-title" data-module="home_now">
  <div class="bp-wrap home-now__grid">
    <header class="home-now__intro">
      <p class="home-now__label">次のよりみちを、見つけよう。</p>
      <h2 id="home-now-title" class="home-now__title">茨城の「気になる」を探す。</h2>
      <a class="home-now__shindan" href="/shindan/"><span>まだ決まっていない？</span>3つの質問で、行き先探し <b aria-hidden="true">→</b></a>
    </header>
    <div class="home-now__main">
      <form class="home-now__search" action="/search/" method="get" role="search">
        <label class="home-now__hidden" for="home-q">探したいことば</label>
        <V42Icon name="search" size={22} />
        <input id="home-q" name="q" type="search" placeholder="地名・スポット・気になること" autocomplete="off" enterkeyhint="search" />
        <button type="submit">検索する<V42Icon name="arrow" size={18} /></button>
      </form>
      <nav class="home-now__ways" aria-label="行き先の探し方">{searchWays.map((item) => <a href={item.href}><V42Icon name={item.icon} size={21} /><span>{item.label}</span><b aria-hidden="true">↗</b></a>)}</nav>
    </div>
  </div>
</section> : <section class="home-now-updates" aria-label="いまの茨城と人気記事" data-module="home_popular">
  <div class="bp-wrap home-now-updates__grid">

      {seasonal.length > 0 && (
        <div class="home-now__season" data-home-season hidden>
          <h3>いま見頃・開催中</h3>
          <ul>
            {seasonal.map((item) => (
              <li data-start={item.start} data-end={item.end} hidden>
                <a href={item.href}>{item.title}{item.place && <small>{item.place}</small>}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

    {ranking.length > 0 && (
      <div class="home-now__rank">

        <h3>よく読まれている記事</h3>
        <ol>
          {ranking.map((item, index) => (
            <li>
              <a href={item.path}><span class="home-now__no">{String(index + 1)}</span><span class="home-now__rank-title">{item.title}</span><span class="home-now__rank-arrow" aria-hidden="true">→</span></a>
              {item.subs.length > 0 && (
                <p class="home-now__subs">{item.subs.map((sub) => <a href={sub.path}>{sub.label}</a>)}</p>
              )}
            </li>
          ))}
        </ol>
        <p class="home-now__source">直近7日の閲覧をもとにしています。終了したイベントは除いています。</p>
      </div>
    )}
  </div>
</section>}

<script>
  // 日本時間の今日に開催中・見頃のものだけを見せる（最大4件）
  // 「今日」は date-only.js の todayDateOnlyString() と同じ計算。TOP の初回表示で外部 JS を増やさない
  // （import するとインラインで出せず、表示が遅れて枠が後から現れる）ため、ここだけ直接書く
  const block = document.querySelector<HTMLElement>('[data-home-season]');
  if (block) {
    const parts = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
    const pick = (type: string) => parts.find((part) => part.type === type)?.value ?? '';
    const today = `${pick('year')}-${pick('month')}-${pick('day')}`;
    const live = [...block.querySelectorAll<HTMLElement>('li[data-start]')]
      .filter((item) => (item.dataset.start ?? '') <= today && today <= (item.dataset.end ?? ''))
      .slice(0, 4);
    live.forEach((item) => { item.hidden = false; });
    block.hidden = live.length === 0;
  }
</script>

<style>
  .home-now { padding-bottom: 24px; background: #f7f3e9; }
  .home-now__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr); gap: 36px; align-items: start; width: var(--card-w); margin: 0 auto; padding: 22px 0 9px; border-top: 1px solid #d9d4c2; }
  .home-now__main, .home-now__intro, .home-now__rank { min-width: 0; }
  .home-now__label { margin-bottom: 5px; color: #7d876e; font-size: 10px; letter-spacing: .08em; }
  .home-now__title { color: #24434a; font: 500 24px/1.55 var(--font-brand-display); letter-spacing: .025em; line-break: strict; }
  .home-now__hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .home-now__search { display: flex; align-items: center; gap: 15px; min-height: 61px; padding: 5px 5px 5px 18px; border: 1px solid #a5b397; border-radius: 3px; background: #fffdf6; box-shadow: 2px 4px 0 #a8ae9020; }
  .home-now__search>:global(svg) { color: #748460; }
  .home-now__search input { flex: 1; min-width: 0; width: 100%; height: 3rem; padding: 10px 0; border: 0; background: transparent; color: var(--color-ink); font: inherit; font-size: 1rem; appearance: none; }
  .home-now__search input::placeholder { color: #7f8875; font-size: 14px; }
  .home-now__search input:focus { outline: none; }
  .home-now__search:focus-within { outline: 2px solid var(--color-tide); outline-offset: 3px; }
  .home-now__search button { display: flex; flex: none; align-items: center; justify-content: space-between; gap: 15px; min-width: 122px; min-height: 49px; padding: 11px 16px; border: 0; border-radius: 2px; background: #254f68; color: #fff; font: 700 13px var(--font-brand-body); cursor: pointer; }
  .home-now__search button:hover { background: #193f55; }
  .home-now__search button:focus-visible { outline: 2px solid var(--color-tide); outline-offset: 3px; }
  .home-now__ways { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12px; margin-top: 9px; }
  .home-now__ways a { display: flex; align-items: center; gap: 7px; min-height: 44px; border-bottom: 1px solid #d0d7c1; color: #4f6f57; font-size: 11px; white-space: nowrap; }
  .home-now__ways b { margin-left: auto; color: #819274; font-weight: 400; }
  .home-now__ways a:hover { color: #254f68; border-color: #6d865f; }
  .home-now__shindan { display: block; width: max-content; max-width: 100%; min-height: 44px; padding-block: 8px; color: #627957; font-size: 11px; line-height: 1.8; }
  .home-now__shindan>span { display: block; color: #7d876e; font-size: 10px; }
  .home-now__shindan b { margin-left: 12px; font-weight: 400; }
  .home-now__shindan:hover { color: #254f68; text-decoration: underline; text-underline-offset: .25em; }
  .home-now-updates { padding-block: clamp(2.5rem,5vw,4rem); background: #faf7ef; border-bottom: 1px solid #e3e1d3; }
  .home-now-updates__grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(2.5rem,7vw,6rem); align-items: start; }
  .home-now-updates h3 { color: var(--color-ink); font: 600 1.25rem/1.6 var(--font-brand-display); }
  .home-now__season ul { display: flex; flex-wrap: wrap; gap: 0 1rem; margin: .5rem 0 0; padding: 0; list-style: none; }
  .home-now__season li::before { content: none; }
  .home-now__season li[hidden] { display: none; }
  .home-now__season a { display: inline-flex; align-items: center; flex-wrap: wrap; gap: .4rem; min-height: 44px; color: var(--color-tide); font-size: .875rem; text-decoration: underline; text-underline-offset: .25em; }
  .home-now__season small { color: var(--color-soil); font-size: .8125rem; }
  .home-now__rank h3 { font-size: clamp(1.5rem, 2.2vw, 1.85rem); }
  .home-now__rank ol { margin: 1rem 0 0; padding: 0; border-top: 1px solid var(--color-line); list-style: none; }
  .home-now__rank li { margin: 0; border-bottom: 1px solid var(--color-line); }
  .home-now__rank li::before { content: none; }
  .home-now__rank li > a { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr) 1rem; gap: .75rem; align-items: baseline; min-height: 44px; padding: 1rem 0; color: var(--color-ink); text-decoration: none; }
  .home-now__rank-title { font: 600 1.0625rem/1.75 var(--font-brand-display); }
  .home-now__no { color: var(--color-tide); font: 500 1rem/1.6 var(--font-brand-serif-latin); }
  .home-now__rank-arrow { color: var(--color-tide); }
  .home-now__rank a:hover .home-now__rank-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .25em; }
  .home-now__subs { display: flex; flex-wrap: wrap; gap: 0 1rem; padding: 0 0 .5rem 2rem; }
  .home-now__subs a { display: inline-flex; align-items: center; min-height: 36px; font-size: .8125rem; color: var(--color-tide); text-decoration: underline; text-underline-offset: .2em; }
  .home-now__source { margin-top: .8rem; color: var(--color-soil); font-size: .75rem; line-height: 1.8; }
  .home-now__shindan:focus-visible, .home-now__ways a:focus-visible, .home-now__rank a:focus-visible, .home-now__season a:focus-visible { outline: 2px solid var(--color-tide); outline-offset: 3px; }
  @media (min-width:701px) and (max-width:1199px) { .home-now__grid { grid-template-columns: minmax(0,.9fr) minmax(0,1.4fr); gap: 25px; } .home-now__title { font-size: 21px; } .home-now__ways { gap: 9px; } .home-now__ways a { gap: 4px; font-size: 10px; } .home-now__ways :global(svg) { width: 18px; height: 18px; } .home-now__ways b { display: none; } }
  @media (max-width:860px) { .home-now-updates__grid { grid-template-columns: minmax(0,1fr); gap: 2.5rem; } }
  @media (max-width:700px) {
    .home-now__grid { display: block; padding-top: 19px; }
    .home-now__label { display: none; }
    .home-now__title { font-size: 19px; line-height: 1.6; letter-spacing: .02em; }
    .home-now__shindan { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-bottom: 13px; font-size: 12px; }
    .home-now__shindan>span { font-size: 11px; }
    .home-now__shindan b { margin: 0; }
    .home-now__search { min-height: 56px; gap: 9px; padding-left: 12px; }
    .home-now__search>:global(svg) { width: 18px; height: 18px; }
    .home-now__search input::placeholder { font-size: 12px; }
    .home-now__search button { min-width: 78px; min-height: 44px; gap: 7px; padding: 8px 11px; font-size: 12px; }
    .home-now__search button :global(svg) { display: none; }
    .home-now__ways { gap: 10px; margin-top: 8px; }
    .home-now__ways a { justify-content: center; gap: 5px; min-height: 45px; font-size: 10px; }
    .home-now__ways :global(svg) { width: 18px; height: 18px; }
    .home-now__ways b { display: none; }
  }
  @media (max-width:350px) { .home-now__title { font-size: 17px; } .home-now__search { gap: 7px; padding-left: 9px; } .home-now__search input::placeholder { font-size: 10px; } .home-now__search button { min-width: 70px; padding-inline: 8px; font-size: 11px; } .home-now__ways { gap: 7px; } .home-now__ways a { gap: 3px; font-size: 9px; } .home-now__ways :global(svg) { width: 15px; height: 15px; } }
</style>
