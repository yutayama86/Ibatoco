---
import type { CollectionEntry } from 'astro:content';
import DisclosureBadge from './DisclosureBadge.astro';
import { CATEGORIES } from '../data/site';
interface Props { article: CollectionEntry<'articles'>; featured?: boolean; }
const { article, featured = false } = Astro.props;
const d = article.data; const slug = article.id.split('/').pop(); const cat = CATEGORIES[d.category];
---
<article class:list={['bsc',{'is-featured':featured}] }>
  {d.cover ? <a class="bsc-media" href={`/${d.category}/${slug}/`}><img src={d.cover} alt={d.coverAlt} loading={featured?'eager':'lazy'} /></a> : <div class="bsc-media bsc-media--type" aria-hidden="true"><span>{d.area ?? 'IBARAKI'}</span><em>{cat.reading}</em></div>}
  <div class="bsc-body">
    <div class="bsc-meta"><DisclosureBadge type={d.disclosure} compact /><span>{d.area}</span><time datetime={d.publishedAt.toISOString()}>{d.publishedAt.toLocaleDateString('ja-JP')}</time></div>
    <h3><a href={`/${d.category}/${slug}/`}>{d.title}</a></h3>
    <p>{d.description}</p>
    <a class="bsc-read" href={`/${d.category}/${slug}/`}>物語を読む <span aria-hidden="true">→</span></a>
  </div>
</article>
<style>
  .bsc{display:grid;grid-template-columns:minmax(0,1fr);gap:1.25rem;min-width:0}.bsc-media{aspect-ratio:4/3;overflow:hidden;background:var(--color-mist)}.bsc-media img{width:100%;height:100%;object-fit:cover;transition:transform .3s ease}.bsc:hover img{transform:scale(1.02)}.bsc-media--type{display:grid;align-content:space-between;padding:1.25rem;color:var(--color-ink);background:linear-gradient(145deg,var(--color-mist),color-mix(in srgb,var(--color-soil) 10%,var(--color-paper)))}.bsc-media--type span{font:600 .72rem var(--font-brand-meta);letter-spacing:.16em}.bsc-media--type em{font:500 clamp(2rem,5vw,4rem) var(--font-brand-display);font-style:normal;opacity:.5}.bsc-body{min-width:0}.bsc-meta{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;color:var(--color-soil);font:400 .75rem var(--font-brand-meta)}.bsc h3{margin-top:.85rem;font:600 clamp(1.25rem,2.1vw,1.75rem)/1.55 var(--font-brand-display);color:var(--color-ink)}.bsc h3 a:hover{text-decoration:underline;text-underline-offset:.2em}.bsc p{margin-top:.65rem;color:var(--color-soil);font-size:.92rem;line-height:1.85}.bsc-read{display:inline-block;margin-top:1rem;color:var(--color-tide);font-weight:600;font-size:.85rem}.is-featured{grid-template-columns:minmax(0,1.45fr) minmax(280px,.8fr);align-items:center;gap:clamp(2rem,5vw,4.5rem)}.is-featured .bsc-media{aspect-ratio:3/2}.is-featured h3{font-size:clamp(1.8rem,3.7vw,3.4rem);line-height:1.35}@media(max-width:720px){.is-featured{grid-template-columns:minmax(0,1fr)}.is-featured h3{font-size:1.8rem}}
</style>
