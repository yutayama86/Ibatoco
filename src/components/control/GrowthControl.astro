---
/**
 * Control Center 最上部の Growth Control（運営者向け・非公開）。
 * 11月100,000 Views に対する着地予測・Gap・状態、速度、重点ページ、今日の施策、警告、収益導線を1か所に出す。
 * 計算は src/lib/growth-engine.mjs（日次レポート npm run growth:target と同じ式）。docs/GROWTH_ENGINE.md
 * ビルド時に計算する（デプロイのたびに更新）。サイト内リンク網（dist が必要）を使う項目は日次レポートだけで出す。
 */
import performance from '../../../data/editorial/performance-snapshot.json';
import config from '../../../data/editorial/growth-engine.json';
import radarConfig from '../../../data/editorial/demand-radar.json';
import actionQueue from '../../../data/editorial/action-queue.json';
import registry from '../../../data/editorial/event-registry.json';
import ledger from '../../../data/editorial/revenue-ledger.json';
import asp from '../../../data/editorial/asp-results.json';
import learning from '../../../data/editorial/seasonal-learning.json';
import recovery from '../../../data/editorial/recovery-plan.json';
import searchTrends from '../../../data/editorial/search-trends.json';
import { SEO_CHANGES } from '../../data/seo-changes';
import { todayJst } from '../../lib/growth-engine.mjs';
import { runGrowthOS } from '../../lib/growth-os.mjs';
import { loadContentPages } from '../../../scripts/lib/content-pages.mjs';
import { auditFreshness } from '../../../scripts/freshness-guard.mjs';

const today = todayJst();
const pages = loadContentPages();
// 日次レポート（npm run growth:target）と同じ計算（src/lib/growth-os.mjs）。実測の整合チェックも中で通す
const result = runGrowthOS({
  snapshot: performance,
  engineConfig: config,
  radarConfig,
  pages,
  changes: SEO_CHANGES,
  actions: (actionQueue.actions ?? []) as any[],
  registry,
  inbound: null,
  freshness: auditFreshness({ pages, today }),
  ledger,
  asp,
  learningRecords: (learning.records ?? []) as any[],
  trendsData: searchTrends,
  today,
});
const alerts = result.alerts;
const g = result.gap;
const fmt = (n: number | null | undefined) => (n == null ? '—' : Number(n).toLocaleString('ja-JP'));
const signed = (n: number | null | undefined) => (n == null ? '—' : `${n > 0 ? '+' : ''}${Number(n).toLocaleString('ja-JP')}`);
const pct = (v: number | null | undefined) => (v == null ? '—' : `${(Number(v) * 100).toFixed(1)}%`);
const statusClass = { 'ON TRACK': 'is-good', 'AT RISK': 'is-warn', 'OFF TRACK': 'is-bad', 'NO DATA': 'is-muted' }[g.status as string] ?? 'is-muted';
const priority = result.forecasts.slice(0, 12);
const relay = result.pvRelay;
const rising = result.demandRadar
  .filter((r: any) => r.kind === 'page' && r.components.timing !== 0 && (r.viewsVelocityPct ?? r.impressionsVelocityPct ?? 0) > 0)
  .sort((a: any, b: any) => Math.max(b.viewsVelocityPct ?? 0, b.impressionsVelocityPct ?? 0) - Math.max(a.viewsVelocityPct ?? 0, a.impressionsVelocityPct ?? 0))
  .slice(0, 6);
const velocityText = (v: number | null | undefined, isNew = false) => (v == null ? (isNew ? '新規' : '—') : `${v > 0 ? '+' : ''}${v}%`);
const buckets = [
  { key: '0-30', label: '0〜30日' },
  { key: '31-60', label: '31〜60日' },
  { key: '61-90', label: '61〜90日' },
].map((b) => ({ ...b, items: result.pipeline.filter((p: any) => p.bucket === b.key).slice(0, 8) }));
const funnel = result.revenueFunnel;
const levelLabel: Record<string, string> = { critical: '重大', warning: '注意', info: '情報' };
const recoveryPriorities = (recovery.priorities ?? []).slice(0, 5);
const pace = performance.paceDiagnostics;
---

<section id="growth" class="gc" aria-labelledby="gc-title">
  <div class="gc-target">
    <div class="gc-target__head">
      <p class="gc-eyebrow">NOVEMBER TARGET</p>
      <h2 id="gc-title">11月 {fmt(g.target)} PV</h2>
      <p class:list={['gc-status', statusClass]}>{g.status}</p>
    </div>
    <dl class="gc-kpis">
      <div><dt>{g.monthToDate ? '着地参考値' : '現状ペースの30日換算'}</dt><dd>{fmt(g.forecast)}<small>PV</small></dd></div>
      <div><dt>Gap</dt><dd class:list={[{ 'is-bad': (g.gap ?? 0) < 0 }]}>{signed(g.gap)}<small>PV</small></dd></div>
      <div><dt>必要な1日平均</dt><dd>{fmt(g.targetDailyAverage)}<small>PV</small></dd></div>
      <div><dt>現在の1日平均</dt><dd>{fmt(g.currentDailyAverage)}<small>PV</small></dd><dd class="gc-kpis__note">目標まで {g.requiredMultiplier ?? '—'} 倍</dd></div>
    </dl>
    <p class="gc-note">予測の根拠：{g.forecastBasis}。11月まであと{g.daysToMonth}日。GA4 {g.dataAsOf ?? '—'} 時点・{today} 計算。</p>
  </div>

  <article class="gc-card gc-recovery">
    <h3>11月10万PVへの立て直し</h3>
    <p class="gc-note gc-note--lead">現状ペースの参考値 <b>{fmt(g.forecast)}</b> / {fmt(g.target)}。参考値との差 <b>{fmt(Math.max(0, -(g.gap ?? 0)))}</b> Views。季節需要を積み上げた見通しは未確定です。単純換算を達成保証や確度補正済み予測として扱いません。</p>
    <p class="gc-note">最新3日の平均 <b>{fmt(pace.recent3DailyAverage)}</b> PV/日、7日平均 <b>{fmt(g.currentDailyAverage)}</b> PV/日。最新3日の30日換算は {fmt(pace.referenceRunRate30FromRecent3)} PV（減速確認用の参考値）。GA4 {pace.ga4Through}まで。</p>
    <ol class="gc-batch">
      {recoveryPriorities.map((p: any) => (
        <li>
          <p class="gc-batch__title">P{p.rank} {p.label}</p>
          <p class="gc-batch__meta">{p.objective}</p>
        </li>
      ))}
    </ol>
  </article>

  <div class="gc-grid">
    <article class="gc-card">
      <h3>Growth Velocity</h3>
      <dl class="gc-velocity">
        <div><dt>直近7日</dt><dd>{fmt(g.velocity.last7)}</dd></div>
        <div><dt>前の7日</dt><dd>{fmt(g.velocity.previous7)}</dd></div>
        <div><dt>前週比</dt><dd>{g.velocity.wowPct == null ? '—' : `${g.velocity.wowPct > 0 ? '+' : ''}${g.velocity.wowPct}%`}</dd></div>
        <div><dt>1日平均</dt><dd>{fmt(g.velocity.dailyAverage)}</dd></div>
        <div><dt>必要な1日平均</dt><dd>{fmt(g.velocity.requiredDailyAverage)}</dd></div>
      </dl>
    </article>

    <article class="gc-card">
      <h3>Today's Growth Batch</h3>
      {result.batch.length > 0 ? (
        <ol class="gc-batch">
          {result.batch.map((b) => (
            <li>
              <p class="gc-batch__title">{b.title}</p>
              <p class="gc-batch__meta">期待 +{fmt(b.expectedPv)} PV・確度 {b.confidence ?? '—'}・工数 {b.effortHours}h・緊急度 {b.urgency}{b.replacesAtRisk ? '・失うPVの代替' : ''}{b.reason ? `・${b.reason}` : ''}</p>
            </li>
          ))}
        </ol>
      ) : (
        <p class="gc-empty">期待PVを推定できる施策なし（推測で埋めない）。</p>
      )}
    </article>
  </div>

  <article class="gc-card">
    <h3>Alerts</h3>
    <ul class="gc-alerts">
      {alerts.map((a) => (
        <li class:list={[`is-${a.level}`]}><span class="gc-chip">{levelLabel[a.level] ?? a.level}・{a.kind}</span><span class="gc-alert__text">{a.message}</span></li>
      ))}
    </ul>
  </article>

  <article class="gc-card">
    <h3>PV at Risk</h3>
    <p class="gc-note gc-note--lead">今後7日 <b>{fmt(relay.lostViewsForecast[7])}</b>・14日 {fmt(relay.lostViewsForecast[14])}・30日 {fmt(relay.lostViewsForecast[30])} PV を失う可能性（forecast。直近7日 {fmt(relay.siteViews7)}）</p>
    {relay.baselineExcludingTop2 && <p class="gc-note">{relay.baselineExcludingTop2.label}：直近7日 {fmt(relay.baselineExcludingTop2.views7)} → 30日 {fmt(relay.baselineExcludingTop2.monthly30)}</p>}
    <div class="gc-scroll" data-xscroll tabindex="0" aria-label="主要流入ページの表（横にスクロールできます）">
      <table class="gc-table">
        <thead>
          <tr><th scope="col">主要流入ページ</th><th scope="col">7日Views</th><th scope="col">全体比</th><th scope="col">終わり</th><th scope="col">状態</th><th scope="col">失う可能性 7日/30日</th><th scope="col">代替候補（7日Views・仕込み）</th></tr>
        </thead>
        <tbody>
          {relay.items.map((i: any) => (
            <tr>
              <th scope="row">{i.label}</th>
              <td>{fmt(i.views7)}</td>
              <td>{i.shareOfSite == null ? '—' : `${Math.round(i.shareOfSite * 100)}%`}</td>
              <td>{i.endDate ?? (i.nextMilestone ? `節目 ${i.nextMilestone.date}（${i.nextMilestone.label}）` : '不明')}</td>
              <td><span class:list={['gc-pill', `is-${i.status.toLowerCase().replace(/\s+/g, '-')}`]}>{i.status}</span></td>
              <td>{i.lostViewsIfDrops ? `上限 ${fmt(i.lostViewsIfDrops[7])} / ${fmt(i.lostViewsIfDrops[30])}` : `${fmt(i.lostViewsForecast[7])} / ${fmt(i.lostViewsForecast[30])}`}</td>
              <td class="gc-action">{i.replacements.map((r: any) => `${r.label.slice(0, 20)}（${fmt(r.views7)}・${r.deadlinePassed ? '至急' : r.next ? `${r.next.label} ${r.next.date}` : '—'}）`).join('、') || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gc-note">失う可能性は、終わり（開催終了・期限）の後に流入が止まる想定の forecast。終わりの日付が無い主要ページは「不明」。</p>
  </article>

  <div class="gc-grid">
    <article class="gc-card">
      <h3>Demand Radar</h3>
      <ul class="gc-list">
        {rising.map((r: any) => (
          <li><p class="gc-list__title">{r.label}</p><p class="gc-list__meta">7日 {fmt(r.views7)}（{velocityText(r.viewsVelocityPct, r.isNew)}）・表示28日 {fmt(r.impressions28)}（{velocityText(r.impressionsVelocityPct, r.impressionsPrev28 === 0)}）・Score {r.score ?? '—'}</p></li>
        ))}
      </ul>
      <p class="gc-note">ページ：需要の増加速度が高い順。</p>
      <h4 class="gc-subhead">上昇中の検索語</h4>
      {result.gscQueriesAvailable ? (
        result.risingQueries.length ? (
          <ul class="gc-list">
            {result.risingQueries.map((q: any) => (
              <li><p class="gc-list__title">{q.label}<small>（{q.pageLabel.slice(0, 24)}）</small></p><p class="gc-list__meta">表示7日 {fmt(q.impressions7)}（{velocityText(q.impressions7VelocityPct, q.isNew)}）・28日 {fmt(q.impressions28)}・{q.position == null ? '—' : `${q.position.toFixed(1)}位`}・伸びしろ {q.upside == null ? '—' : `+${fmt(q.upside)}（推定）`}{q.observing ? `・観測中〜${q.observing}` : ''}</p></li>
            ))}
          </ul>
        ) : <p class="gc-empty">上昇中の検索語なし。</p>
      ) : <p class="gc-empty">検索語別の推移（gscQueries）は未取得。performance-snapshot に入ると表示される。</p>}
      {result.gscQueriesAvailable && (
        <>
          <h4 class="gc-subhead">Query Clusters（ページ × 検索意図）</h4>
          <ul class="gc-list">
            {result.searchSignals.rising.slice(0, 6).map((c: any) => (
              <li><p class="gc-list__title">{c.cluster}</p><p class="gc-list__meta">表示7日 {fmt(c.impressions7)}（{velocityText(c.growthPct, c.isNew)}）・{c.position ?? '—'}位・CTR {pct(c.ctr)}・{c.queryCount}語・{c.observing ? `観測中〜${c.observing}` : c.action}</p></li>
            ))}
          </ul>
        </>
      )}
    </article>

    <article class="gc-card">
      <h3>Next Winners</h3>
      <ul class="gc-list">
        {result.nextWinners.map((w: any) => (
          <li><p class="gc-list__title">{w.label}</p><p class="gc-list__meta">伸びしろ {w.upside == null ? '—' : `+${fmt(w.upside)}`}（推定）・速度 {velocityText(w.viewsVelocityPct)}・{w.observing ? `観測中〜${w.observing}` : w.action}</p></li>
        ))}
      </ul>
    </article>
  </div>

  <article class="gc-card">
    <h3>Search Trends（proxy）</h3>
    <p class="gc-note gc-note--lead">Google Trends の相対値（月間検索ボリュームではない）。需要の大きさは基準語「土浦花火」の5年最大＝100。取得 {result.trendsUpdatedAt ?? '—'}</p>
    <div class="gc-scroll" data-xscroll tabindex="0" aria-label="検索需要の季節性の表（横にスクロールできます）">
      <table class="gc-table">
        <thead><tr><th scope="col">検索語</th><th scope="col">需要の大きさ</th><th scope="col">例年の山</th><th scope="col">立ち上がり→山</th><th scope="col">今年の山の週</th><th scope="col">直近（例年同週）</th></tr></thead>
        <tbody>
          {result.searchTrends.slice(0, 12).map((t: any) => (
            <tr>
              <th scope="row">{t.keyword}</th>
              <td>{t.peakRelativeToAnchor ?? '—'}</td>
              <td>{t.typicalPeakMonthDay ? `${t.typicalPeakMonthDay}（${t.seasonsMeasured}年）` : t.status}</td>
              <td>{t.typicalRiseToPeakDays == null ? '—' : `${t.typicalRiseToPeakDays}日`}</td>
              <td>{t.expectedPeakWeek ?? '—'}</td>
              <td>{t.latestComplete ? `${t.latestComplete.belowOne ? '1未満' : t.latestComplete.value}（${t.latestComplete.typicalSameWeek ?? '—'}）` : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gc-note">立ち上がり＝山の10%以上が山まで続く最初の週。スポーツは通年型。季節の実測が2年未満の語は例年を出さない。</p>
  </article>

  <article class="gc-card">
    <h3>100k Gap Map</h3>
    <p class="gc-note gc-note--lead">着地予測 {fmt(result.gapMap.siteForecast)}・伸びしろ +{fmt(result.gapMap.upsideTotal)} → {fmt(result.gapMap.withUpside)}。残り <b>{fmt(result.gapMap.remainingGap)}</b> は根拠のある推定でまだ説明できない（新しい需要の発見が必要）</p>
    <div class="gc-scroll" data-xscroll tabindex="0" aria-label="テーマ別の11月見込みの表（横にスクロールできます）">
      <table class="gc-table">
        <thead><tr><th scope="col">テーマ</th><th scope="col">ページ</th><th scope="col">11月見込み</th><th scope="col">伸びしろ</th><th scope="col">検索需要</th><th scope="col">主なページ</th></tr></thead>
        <tbody>
          {result.gapMap.themes.slice(0, 10).map((t: any) => (
            <tr><th scope="row">{t.theme}</th><td>{t.pages}</td><td>{fmt(t.forecast)}{t.caution ? '※' : ''}</td><td>+{fmt(t.upside)}</td><td>{t.trendsPeakRelative ?? '—'}</td><td class="gc-action">{t.top.map((p: any) => `${p.label.slice(0, 16)}（${fmt(p.forecast)}）`).join('、')}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gc-note">ページ別の11月見込みと伸びしろはどちらも推定（根拠は Growth Engine）。※は11月より前に終わる・節目の後に減る可能性のあるページを含む。</p>
  </article>

  <article class="gc-card">
    <h3>30/60/90 Day Pipeline</h3>
    <div class="gc-pipeline">
      {buckets.map((b) => (
        <section aria-label={b.label}>
          <h4>{b.label}</h4>
          <ul class="gc-list">
            {b.items.map((p: any) => <li><p class="gc-list__title">{p.date} {p.label}{!p.path && <small>（ページなし）</small>}</p><p class="gc-list__meta">{p.action}</p></li>)}
          </ul>
        </section>
      ))}
    </div>
  </article>

  <article class="gc-card">
    <h3>Priority Pages</h3>
    <div class="gc-scroll" data-xscroll tabindex="0" aria-label="重点ページの表（横にスクロールできます）">
      <table class="gc-table">
        <thead>
          <tr><th scope="col">ページ</th><th scope="col">7日Views</th><th scope="col">表示</th><th scope="col">CTR</th><th scope="col">順位</th><th scope="col">11月予測</th><th scope="col">伸びしろ</th><th scope="col">状態</th><th scope="col">次の一手</th></tr>
        </thead>
        <tbody>
          {priority.map((f) => (
            <tr>
              <th scope="row">{f.label}{!f.focus && <small>検出</small>}</th>
              <td>{fmt(f.views7)}</td>
              <td>{fmt(f.impressions)}</td>
              <td>{pct(f.ctr)}</td>
              <td>{f.position == null ? '—' : f.position.toFixed(1)}</td>
              <td>{fmt(f.forecast)}</td>
              <td>{f.upside == null ? '—' : `+${fmt(f.upside)}`}</td>
              <td><span class:list={['gc-pill', `is-${f.status.toLowerCase().replace(/\s+/g, '-')}`]}>{f.status}</span></td>
              <td class="gc-action">{f.action}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gc-note">伸びしろは推定（GSCの表示回数のまま目標順位の一般的なCTRに近づいた場合）。「—」は実測が未取得。ページ別データ（pageMetrics）が入ると確度が上がります。</p>
  </article>

  <div class="gc-grid">
    <article class="gc-card">
      <h3>Revenue Funnel</h3>
      <ol class="gc-funnel">
        {funnel.stages.map((st: any) => <li><span>{st.label}</span><b>{st.value == null ? '未取得' : fmt(st.value)}</b><small>{st.period ?? '—'}</small></li>)}
      </ol>
      <p class="gc-note">Revenue / 1,000 Views ¥{funnel.metrics.revenuePer1000Views ?? '—'}・Affiliate CTR {pct(funnel.metrics.affiliateCtr)}・発生CVR／EPC は期間がそろうまで計算しない。クリックは成果として扱わない。</p>
      {funnel.diagnosis.map((d: any) => <p class="gc-warn">{d.message}</p>)}
    </article>

    <article class="gc-card">
      <h3>Annual Learning</h3>
      <p class="gc-note gc-note--lead">台帳 {result.annualLearning.records} 件・実測あり {result.annualLearning.measured} 件（2027年の公開・更新時期に使う）</p>
      <dl class="gc-revenue">
        {result.annualLearning.categories.map((c: any) => <div><dt>{c.label}</dt><dd>{c.impressionsPeakLeadAvg != null ? `検索ピーク 平均${c.impressionsPeakLeadAvg}日前` : 'データ不足'}</dd><dd class="gc-revenue__note">{c.records} 件・実測 {c.measured} 件・立ち上がり {c.leadDaysAvg != null ? `平均${c.leadDaysAvg}日前` : 'データ不足'}</dd></div>)}
      </dl>
    </article>
  </div>
</section>

<style>
  .gc{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem;margin:1.5rem 0 2rem}
  .gc-target,.gc-card{min-width:0;padding:1.1rem 1.2rem;border:1px solid var(--line);border-radius:16px;background:var(--panel)}
  .gc-recovery{border-color:var(--bad);box-shadow:inset 3px 0 0 var(--bad)}
  .gc-target{background:linear-gradient(160deg,var(--panel-2),var(--panel))}
  .gc-target__head{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem 1rem}
  .gc-eyebrow{flex:1 0 100%;margin:0;color:var(--muted);font-size:.75rem;font-weight:700;letter-spacing:.14em}
  .gc-target h2{margin:0;font-size:clamp(1.4rem,4vw,2rem)}
  .gc-status{margin:0;padding:.3rem .75rem;border-radius:999px;font-size:.85rem;font-weight:800;letter-spacing:.06em}
  .gc-status.is-good{background:color-mix(in srgb,var(--good) 20%,transparent);color:var(--good)}
  .gc-status.is-warn{background:color-mix(in srgb,var(--warn) 20%,transparent);color:var(--warn)}
  .gc-status.is-bad{background:color-mix(in srgb,var(--bad) 20%,transparent);color:var(--bad)}
  .gc-status.is-muted{background:var(--panel-2);color:var(--muted)}
  .gc-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,10rem),1fr));gap:.75rem;margin:1rem 0 .4rem}
  .gc-kpis div,.gc-velocity div,.gc-revenue div{min-width:0;padding:.7rem .8rem;border-radius:12px;background:var(--panel-2)}
  .gc-kpis dt,.gc-velocity dt,.gc-revenue dt{color:var(--muted);font-size:.8rem}
  .gc-kpis dd{margin:.2rem 0 0;font-size:clamp(1.3rem,4.5vw,1.7rem);font-weight:800;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
  .gc-kpis dd small{margin-left:.25rem;color:var(--muted);font-size:.75rem;font-weight:600}
  .gc-kpis dd.is-bad{color:var(--bad)}
  .gc-kpis .gc-kpis__note{margin:.15rem 0 0;color:var(--muted);font-size:.78rem;font-weight:600}
  .gc-note,.gc-empty{margin:.6rem 0 0;color:var(--muted);font-size:.8rem;line-height:1.7}
  .gc-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem}
  @media(min-width:900px){.gc-grid{grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)}}
