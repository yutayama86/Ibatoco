---
import { MUNICIPALITIES, MUNI_BY_SLUG, REGIONS, REGION_ORDER } from '../data/areas';
import { compactPath } from '../lib/svg-path';
import { IBARAKI_GEO, GEO_VIEW } from '../data/ibaraki-geo';

interface Props {
  activeSlug?: string;
  compact?: boolean;
  decor?: boolean; // 装飾用：単色（薄緑）・ラベルなし・非対話
}
const { activeSlug, compact = false, decor = false } = Astro.props;
const { w: W, h: H } = GEO_VIEW;

// 小さな町などラベルが海側にはみ出るものは手動で陸側へ微調整
const LABEL_OFFSET: Record<string, { dx: number; dy: number }> = {
  tokai: { dx: -22, dy: -17 }, // 東海村：重心が海側に出るため陸(形の中心)へ寄せる
  oarai: { dx: -13, dy: -2 }, // 大洗町：ラベルを地図内へ
};

const nodes = MUNICIPALITIES.filter((m) => IBARAKI_GEO[m.slug]).map((m) => {
  const g = IBARAKI_GEO[m.slug];
  const off = LABEL_OFFSET[m.slug] ?? { dx: 0, dy: 0 };
  return { ...m, ...g, lx: g.cx + off.dx, ly: g.cy + off.dy, active: m.slug === activeSlug };
});
// アクティブ（現在の市町村ページ）を最前面に
nodes.sort((a, b) => Number(a.active) - Number(b.active));

// ラベル位置（データ駆動）
const lake = (() => {
  const a = MUNI_BY_SLUG.get('kasumigaura') && IBARAKI_GEO['kasumigaura'];
  const b = MUNI_BY_SLUG.get('namegata') && IBARAKI_GEO['namegata'];
  if (a && b) return { x: (a.cx + b.cx) / 2, y: (a.cy + b.cy) / 2 };
  return { x: W * 0.62, y: H * 0.72 };
})();
---

<figure class:list={["imap", { "imap--compact": compact, "imap--decor": decor }]}
  aria-hidden={decor ? 'true' : undefined} aria-label={decor ? undefined : '茨城県 市町村マップ'}>
  <svg viewBox={`0 0 ${W} ${H}`} role={decor ? 'img' : 'group'}
    aria-label={decor ? undefined : '茨城県の市町村マップ。各市町村を選択できます。'}
    xmlns="http://www.w3.org/2000/svg" class="imap-svg">
    {decor ? (
      nodes.map((n) => <path d={compactPath(n.d)} class="imap-decor" />)
    ) : (
      <>
        <defs>
          <linearGradient id="sea" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#6b9bd1" stop-opacity="0" />
            <stop offset="1" stop-color="#6b9bd1" stop-opacity="0.13" />
          </linearGradient>
        </defs>

        <rect x={W - 58} y="0" width="58" height={H} fill="url(#sea)" />
        <text x={W - 12} y={H * 0.4} class="imap-sea" transform={`rotate(90 ${W - 12} ${H * 0.4})`}>太平洋</text>
        <text x={lake.x} y={lake.y} class="imap-lake">霞ヶ浦</text>

        {/* 塗り（クリック／ホバー） */}
        {nodes.map((n) => (
          <a href={`/area/${n.slug}/`} class:list={["imap-m", { "is-active": n.active }]}
            style={`--_c:${REGIONS[n.region].mapColor}`} aria-label={n.name}>
            <path d={compactPath(n.d)} class="imap-shape" />
          </a>
        ))}
        {/* ラベル（常に最前面のレイヤー・隣の塗りに隠れない） */}
        {nodes.map((n) => (
          <text x={n.lx} y={n.ly} class="imap-label">{n.name}</text>
        ))}
      </>
    )}
  </svg>

  {!decor && (
    <nav class="imap-sr-list sr-only" aria-label="市町村の一覧から選ぶ">
      {REGION_ORDER.map((k) => (
        <section>
          <h3>{REGIONS[k].label}</h3>
          <ul>
            {MUNICIPALITIES.filter((m) => m.region === k).map((m) => (
              <li><a href={`/area/${m.slug}/`}>{m.name}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  )}

  {!decor && (
  <ul class="imap-legend" aria-hidden="true">
    {REGION_ORDER.map((k) => (
      <li><span class="imap-swatch" style={`background:${REGIONS[k].mapColor}`}></span>{REGIONS[k].label}</li>
    ))}
  </ul>
  )}
</figure>

<style>
  .imap { margin: 0; }
  .imap-svg { width: 100%; height: auto; overflow: visible; display: block; }

  /* 装飾モード：FVで茨城の輪郭を明確に見せる */
  .imap-decor {
    fill: color-mix(in srgb, var(--color-tide) 27%, var(--color-paper));
    stroke: var(--color-paper);
    stroke-width: 1.15; stroke-linejoin: round; vector-effect: non-scaling-stroke;
  }
  .imap-sea { fill: #4d7ba8; font-size: 13px; letter-spacing: 0.3em; text-anchor: middle; opacity: 0.6; font-family: var(--font-display); }
  .imap-lake { fill: #6f9ac2; font-size: 10px; text-anchor: middle; opacity: 0.85; font-family: var(--font-display); pointer-events: none; }

  .imap-m { cursor: pointer; }
  .imap-shape {
    fill: color-mix(in srgb, var(--_c) 20%, var(--paper));
    stroke: color-mix(in srgb, var(--_c) 50%, var(--paper));
    stroke-width: 0.8; stroke-linejoin: round;
    transition: fill 0.25s var(--ease), filter 0.25s;
  }
  /* hover/focusは塗りだけでなく境界線も強調（色覚に依存しない状態表現） */
  .imap-m:hover .imap-shape,
  .imap-m.is-hover .imap-shape { fill: color-mix(in srgb, var(--_c) 82%, white); filter: drop-shadow(0 4px 8px rgba(28,26,20,.28)); stroke: var(--ink); stroke-width: 1.6; }
  .imap-m.is-active .imap-shape { fill: var(--_c); stroke: var(--ink); stroke-width: 1.8; }
  /* キーボードフォーカスを明確に可視化 */
  .imap-m:focus-visible { outline: none; }
  .imap-m:focus-visible .imap-shape { stroke: var(--ink); stroke-width: 2.6; filter: drop-shadow(0 0 0 2px rgba(23,43,53,.35)); }
  @media (prefers-reduced-motion: reduce) { .imap-shape { transition: none; } }

  .imap-label {
    font-size: 8.5px; text-anchor: middle; dominant-baseline: central; font-weight: 700;
    fill: var(--ink-soft);
    paint-order: stroke; stroke: var(--paper); stroke-width: 2.4px; stroke-linejoin: round;
    opacity: 1; transition: opacity 0.2s; pointer-events: none; font-family: var(--font-sans);
  }

  .imap-legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; justify-content: center; margin-top: 1rem; font-size: var(--step--1); color: var(--ink-soft); font-weight: 700; }
  .imap-legend li { display: inline-flex; align-items: center; gap: 0.4em; }
  .imap-swatch { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }

  @media (max-width: 560px) { .imap-label { font-size: 11px; } }
</style>

<script>
  // SVG <a> のクリック遷移・ホバー表示を確実に動かす（SVGアンカーは環境差があるためJSで明示制御）
  for (const svg of document.querySelectorAll('.imap-svg')) {
    for (const m of svg.querySelectorAll<SVGAElement>('.imap-m')) {
      const href = m.getAttribute('href');
      // ホバー：クラスでラベル表示（DOM移動はしない＝クリックを壊さない）
      m.addEventListener('pointerenter', () => m.classList.add('is-hover'));
      m.addEventListener('pointerleave', () => m.classList.remove('is-hover'));
      // クリック遷移
      m.addEventListener('click', (e) => {
        if (!href) return;
        // 修飾キー/中クリックは既定動作（新規タブ等）に任せる
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        window.location.href = href;
      });
      // キーボード（Enter / Space）
      m.addEventListener('keydown', (e) => {
        if ((e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') && href) {
          e.preventDefault();
          window.location.href = href;
        }
      });
    }
  }
</script>
