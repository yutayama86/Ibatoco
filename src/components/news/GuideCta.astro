---
/**
 * ガイド型ニュースの CTA（冒頭・各節・最後の3か所）。行き先・広告リンクへの差し替え・rel・計測用の印をここで決める。
 *
 * - 行き先は、広告リンクが登録されていればそちらへ差し替える（ASPが生成したURLをそのまま使う。組み立て直すと計測に乗らない）
 * - 広告リンクの rel は `nofollow sponsored noopener`。**noreferrer を付けない**（参照元が消えると掲載サイトを照合できず、成果が否認されうる）。
 *   広告でない外部リンクは noopener noreferrer
 * - 提携リンクには data-guide-paid-link などを付け、news/[slug].astro の script が outbound_booking_click / paid_booking_click で数える。
 *   data-is-paid は BookingGuide 専用の印なので使わない（本番QAの BookingGuide 検査と混ざらないように）
 */
import { paidLinkFor } from '../../data/affiliates';

interface Props {
  cta: { href: string; label: string; note?: string };
  placement: 'guide_top' | 'guide_section' | 'guide_bottom';
  municipality?: string;
  contentCategory: string;
}

const { cta, placement, municipality, contentCategory } = Astro.props;
const external = /^https?:\/\//.test(cta.href);
const paid = paidLinkFor(cta.href);
const linkAttrs = external
  ? {
      target: '_blank',
      rel: paid ? 'nofollow sponsored noopener' : 'noopener noreferrer',
      ...(paid
        ? {
            'data-guide-paid-link': '1',
            'data-provider': paid.provider,
            'data-placement': placement,
            'data-municipality': municipality,
            'data-content-category': contentCategory,
          }
        : {}),
    }
  : {};
---

<div class:list={['guide-cta', { 'guide-cta--inline': placement === 'guide_section', 'guide-cta--bottom': placement === 'guide_bottom' }]}><a href={paid?.href ?? cta.href} {...linkAttrs}>{cta.label}<span aria-hidden="true">{external ? '↗' : '→'}</span>{external && <span class="sr-only">（新しいタブで開きます）</span>}</a>{cta.note && <p>{cta.note}</p>}</div>

<style>
  /* 色・角丸・ボタンは interior.css の内ページの見た目（青・角丸・丸いボタン）に合わせる */
  .guide-cta{display:grid;justify-items:start;gap:.55rem}
  .guide-cta a{display:inline-flex;align-items:center;gap:.7rem;min-height:3.1rem;padding:.75rem 1.35rem;border-radius:999px;background:var(--interior-blue,var(--color-tide));color:#fff;font-weight:700;font-size:.95rem;line-height:1.5;transition:background-color .2s ease,box-shadow .2s ease,transform .2s ease}
  .guide-cta a:hover,.guide-cta a:focus-visible{background:var(--color-deep-blue,var(--color-ink));box-shadow:0 12px 28px rgba(7,28,76,.18)}
  .guide-cta a:focus-visible{outline:2px solid var(--interior-blue,var(--color-tide));outline-offset:3px}
  @media (prefers-reduced-motion:no-preference){.guide-cta a:hover{transform:translateY(-2px)}}
  .guide-cta p{margin:0;color:var(--color-soil);font-size:.78rem;line-height:1.8}
  .guide-cta--inline{margin-top:1.8rem}
  .guide-cta--bottom{margin-top:3.5rem;padding:clamp(1.3rem,3vw,1.9rem);border:1px solid rgba(31,99,191,.15);border-radius:1rem;background:linear-gradient(135deg,rgba(237,246,255,.95),rgba(255,255,255,.98))}
  @media(max-width:760px){.guide-cta a{width:100%;justify-content:space-between}}
</style>
