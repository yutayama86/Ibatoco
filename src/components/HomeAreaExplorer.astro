---
/**
 * HomeAreaExplorer — 44市町村インタラクティブマップの編集インターフェース。
 * Blueprint §7「地図のビジュアル進化」＋Codex承認事項に基づく。
 *
 * 保護（無変更で再利用）：ibaraki-geo.ts の境界データ・44市町村・5地域・地名。
 * 進化：Tide系の選択色／低彩度の5地域色／隣接情報パネル／二段階操作（概要→この街を読む）／
 *   hover・focus・selected を色以外でも識別／キーボード操作・aria・focus-visible／
 *   同等リンク一覧／モバイルは地域タブ＋市町村リスト。
 */
import { IBARAKI_GEO, GEO_VIEW } from '../data/ibaraki-geo';
import { compactPath } from '../lib/svg-path';
import { MUNICIPALITIES, REGIONS, REGION_ORDER } from '../data/areas';
import { MUNICIPALITY_CONTENT } from '../data/municipality-content';
import { getAreaSummary } from '../lib/content';

const { w: W, h: H } = GEO_VIEW;

const summaries = await Promise.all(MUNICIPALITIES.map((m) => getAreaSummary(m.slug)));
const fmt = (d: Date | null) => (d ? new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(d) : null);

// クライアントのパネル描画用データ（架空を出さない：実データが無ければ空）
const panelData = Object.fromEntries(
  summaries.map((s) => {
    const profile = MUNICIPALITY_CONTENT[s.slug];
    return [s.slug, {
      name: s.name,
      region: s.region,
      href: `/area/${s.slug}/`,
      catch: profile?.catch ?? '',
      intro: profile?.intro ?? '',
      highlights: (profile?.spots ?? []).slice(0, 3).map((item) => item.name),
      lastUpdated: fmt(s.lastUpdated),
      stories: s.stories.slice(0, 2).map((a) => ({ title: a.data.title, href: `/${a.data.category}/${a.id.split('/').pop()}/` })),
      places: s.places.slice(0, 2).map((p) => ({ name: p.data.name, href: `/place/${p.id}/` })),
      people: s.people.slice(0, 2).map((p) => ({ name: p.name, href: `/reporter/${p.slug}/` })),
      hasContent: s.hasContent,
    }];
  })
);

const LABEL_OVERRIDES: Partial<Record<string, { lx: number; ly: number }>> = {
  // 東海村は自動算出された中心点が海側へ外れるため、図形の中央へ補正する。
  tokai: { lx: 392, ly: 268 },
};

const nodes = MUNICIPALITIES.map((m) => ({
  ...m,
  ...IBARAKI_GEO[m.slug],
  lx: LABEL_OVERRIDES[m.slug]?.lx ?? (IBARAKI_GEO[m.slug] as { lx?: number }).lx,
  ly: LABEL_OVERRIDES[m.slug]?.ly ?? (IBARAKI_GEO[m.slug] as { ly?: number }).ly,
})).filter((n) => n.d);
---

<section class="ax">
  <div class="ax-grid">
    <!-- 地図（SVG） -->
    <figure class="ax-mapwrap">
      <svg viewBox={`0 0 ${W} ${H}`} class="ax-map" role="group" aria-label="茨城県の市町村マップ。市町村を選ぶと、その街のページへ移動します。">
        {nodes.map((n) => (
          <g
            class="ax-muni"
            data-slug={n.slug}
            data-region={n.region}
            role="link"
            tabindex="0"
            aria-label={`${n.name}のページを開く`}
          >
            <path d={compactPath(n.d)} class="ax-shape" />
          </g>
        ))}
        {nodes.map((n) => (
          <text x={n.lx ?? n.cx} y={n.ly ?? n.cy} class="ax-label" data-label-slug={n.slug}>{n.name}</text>
        ))}
      </svg>
    </figure>

    <!-- 隣接パネル（選択中の市町村の概要） -->
    <aside class="ax-panel ax-panel--integrated">
      <header class="ax-intro">
        <p class="ax-intro-kicker">街から探す</p>
        <h2>44の街から、<br />茨城を読む。</h2>
        <h3>気になる街を、ひとつ。</h3>
        <p class="ax-intro-copy">
          <span>県北は山と海、県西は一面の畑、鹿行は湖と砂浜。</span>
          <span>同じ県とは思えないほど、街ごとに顔が違います。</span>
          <span>気になる街を選ぶと、その街のページへ移動します。</span>
        </p>
      </header>
      <div class="ax-panel-empty" data-panel-empty></div>
      <div class="ax-panel-body" data-panel-body hidden>
        <p class="ax-panel-region" data-panel-region></p>
        <h3 class="ax-panel-name" data-panel-name></h3>
        <p class="ax-panel-catch" data-panel-catch></p>
        <p class="ax-panel-intro" data-panel-intro></p>
        <div class="ax-panel-highlights" data-panel-highlights hidden>
          <h4>この街を知る入口</h4>
          <ul data-panel-highlight-list></ul>
        </div>
        <p class="ax-panel-updated" data-panel-updated></p>
        <div data-panel-content></div>
        <a class="ax-panel-read" data-panel-read href="#">この街を読む <span aria-hidden="true">→</span></a>
      </div>
      <!-- 市町村リンク一覧（PCは左の列、スマホは地図の下）。見出しの下に5地域と44市町村を常に表示する（開閉なし）。地図と同じく各街のページへ直接移動する。 -->
      <div class="ax-list">
        <h3 class="ax-list-head" id="ax-list-head">市町村名から選ぶ</h3>
        <nav aria-labelledby="ax-list-head">
          {REGION_ORDER.map((k) => (
            <div class="ax-region">
              <p class="ax-region-name" id={`ax-region-${k}`}><span class="ax-region-dot" data-region={k}></span>{REGIONS[k].label}</p>
              <ul aria-labelledby={`ax-region-${k}`}>
                {MUNICIPALITIES.filter((m) => m.region === k).map((m) => (
                  <li><a class="ax-list-btn" href={`/area/${m.slug}/`}>{m.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
    </aside>
  </div>

  <script is:inline type="application/json" set:html={JSON.stringify(panelData)} data-ax-data></script>
</section>

<style>
  .ax { font-family: var(--font-brand-body); color: var(--color-charcoal); }
  .ax { width: 100%; min-width: 0; }
  .ax-grid { display:grid;grid-template-columns:minmax(360px,.9fr) minmax(460px,1.1fr);grid-template-areas:"panel map";gap:clamp(2.5rem,5vw,5rem);align-items:center;min-width:0; }

  .ax-mapwrap { grid-area: map; margin: 0; min-width: 0; display:flex;align-items:center;justify-content:center; }
  .ax-map { width:min(100%,620px);max-width:100%;height:auto;max-height:560px;display:block; }

  /* 5地域：原色分けを避けた、低彩度のブランド派生色 */
  .ax-shape { stroke: color-mix(in srgb, var(--color-paper) 88%, var(--color-ink)); stroke-width: .72; stroke-linejoin: round; vector-effect: non-scaling-stroke;
    transition: filter .2s var(--ease), stroke-width .2s; }
  .ax-muni[data-region="kenpoku"] .ax-shape { fill: #99bbe1; }
  .ax-muni[data-region="keno"]    .ax-shape { fill: #dbe5f0; }
  .ax-muni[data-region="kennan"]  .ax-shape { fill: #c9dbe9; }
  .ax-muni[data-region="rokko"]   .ax-shape { fill: #6f9fc7; }
  .ax-muni[data-region="kensei"]  .ax-shape { fill: #b9bdb2; }

  /* hover は面の明度だけを変え、地図の境界線を乱さない。キーボードフォーカスのみ線でも示す。 */
  .ax-muni {
    cursor: pointer;
    outline: none !important;
    outline-offset: 0 !important;
    border-radius: 0 !important;
    -webkit-tap-highlight-color: transparent;
  }
  .ax-muni:focus,
  .ax-muni:focus-visible { outline: none !important; outline-offset: 0 !important; }
  .ax-muni:hover .ax-shape { filter: brightness(.94) saturate(1.04); }
  .ax-muni:focus-visible .ax-shape { stroke: var(--color-tide); stroke-width: .9; filter: brightness(.94); }

  .ax-label { font-family: var(--font-brand-body); font-size: 9.4px; font-weight: 700; text-anchor: middle; dominant-baseline: central;
    fill: var(--color-ink); paint-order: stroke; stroke: color-mix(in srgb, var(--color-paper) 82%, transparent); stroke-width: 2px; pointer-events: none; }
  .ax-label[data-label-slug="hitachinaka"], .ax-label[data-label-slug="tsukubamirai"] { font-size: 8.5px; }
  .ax-label[data-label-slug="tokai"] { font-size: 8.4px; }
  .ax-label[data-label-slug="kasumigaura"] { font-size: 7.7px; }
  .ax-label[data-label-slug="goka"], .ax-label[data-label-slug="sakai"], .ax-label[data-label-slug="bando"], .ax-label[data-label-slug="joso"], .ax-label[data-label-slug="moriya"], .ax-label[data-label-slug="toride"], .ax-label[data-label-slug="ryugasaki"], .ax-label[data-label-slug="kawachi"], .ax-label[data-label-slug="tone"] { font-size: 8.3px; }
  .ax-label[data-label-slug="yachiyo"], .ax-label[data-label-slug="shimotsuma"] { font-size: 7.7px; }
  .ax-label.is-selected { fill: var(--color-white); stroke: color-mix(in srgb,var(--color-ink) 72%,transparent); }

  /* パネル */
  .ax-panel { grid-area: panel; min-height: 260px; margin-top: clamp(1rem, 4vw, 3.25rem); padding: clamp(1.4rem, 3vw, 2rem) 0; border-block: 1px solid color-mix(in srgb,var(--color-ink) 18%,transparent); background: transparent; min-width: 0; }
  /* TOPは街を選ぶと直接遷移するため、パネル本体は表示されない。凡例を外した後に下線だけが残って空の枠に見えないよう、外側の下線と余白を消す */
  .ax-panel--integrated { margin-top: 0; padding-top: 0; padding-bottom: 0; border-top: 0; border-bottom: 0; min-height: 0; }
  .ax-panel--integrated .ax-panel-empty:empty { display: none; }
  /* 区切り線は直下の「市町村名から選ぶ」の上線に任せる（線が二重に見えないように） */
  .ax-intro { padding-bottom: 0; border-bottom: 0; }
  .ax-intro-kicker { font: 700 .74rem var(--font-brand-meta); letter-spacing: .08em; color: var(--color-tide); }
  .ax-intro h2 { margin-top: .7rem; font: 600 clamp(2rem,4.2vw,3.65rem)/1.24 var(--font-brand-display); letter-spacing: .01em; color: var(--color-ink); }
  .ax-intro h3 { margin-top: clamp(1.3rem,2.5vw,2rem); font: 600 clamp(1.15rem,2vw,1.45rem)/1.5 var(--font-brand-display); color: var(--color-ink); }
  .ax-intro-copy { margin-top: .55rem; font-size: .9rem; line-height: 1.9; color: var(--color-soil); }
  .ax-intro-copy span { display: block; }
  .ax-panel--integrated .ax-panel-empty { padding-top: .2rem; }
  .ax-panel-body { min-width: 0; }
  .ax-panel-kicker { font-family: var(--font-brand-meta); font-size: .72rem; letter-spacing: .14em; color: var(--color-tide); }
  .ax-panel-empty-title { margin-top: .5rem; font-family: var(--font-brand-display); font-size: clamp(1.5rem, 3vw, 2.2rem); color: var(--color-ink); }
  .ax-panel-hint { margin-top: .8rem; color: var(--color-soil); font-size: 0.92rem; line-height: 1.9; }
  .ax-panel-region { font-family: var(--font-brand-meta); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--color-tide); }
  .ax-panel-name { font-family: var(--font-brand-display); font-size: 1.5rem; color: var(--color-ink); margin: 0.2rem 0 0.3rem; }
  .ax-panel-catch { margin-top: .9rem; font-family: var(--font-brand-display); font-size: 1.08rem; font-weight: 600; line-height: 1.6; color: var(--color-ink); }
  .ax-panel-intro { margin-top: .55rem; color: var(--color-soil); font-size: .88rem; line-height: 1.75; }
  .ax-panel-updated { margin-top: .65rem; font-family: var(--font-brand-meta); font-size: 0.72rem; color: var(--color-soil); }
  .ax-panel-highlights { margin-top: .9rem; padding-top: .8rem; border-top: 1px solid var(--color-mist); }
  .ax-panel-highlights ul { display: flex; flex-wrap: wrap; gap: .35rem .8rem; }
  .ax-panel-highlights li { color: var(--color-ink); font-size: .82rem; }
  .ax-panel h4 { font-family: var(--font-brand-meta); font-size: 0.75rem; letter-spacing: 0.06em; color: var(--color-soil); margin: 1rem 0 0.4rem; }
  .ax-panel ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; }
  .ax-panel a { color: var(--color-tide); text-decoration: none; }
  .ax-panel a:hover, .ax-panel a:focus-visible { text-decoration: underline; }
  .ax-panel-read { display: inline-block; margin-top: 1.2rem; font-weight: 600; color: var(--color-ink);
    border: 1px solid var(--color-ink); border-radius: var(--radius-xs); padding: 0.5em 1.1em; text-decoration: none; }
  .ax-panel-read:hover, .ax-panel-read:focus-visible { background: var(--color-ink); color: var(--color-white); }

  /* リスト（PCは左の列、スマホは地図の下） */
  .ax-list { margin-top: clamp(1.6rem,3vw,2.2rem); display: block; }
  /* 「市町村名から選ぶ」は枠で囲まず、上の「気になる街を、ひとつ。」と同じ書体の小見出しにする */
  .ax-panel .ax-list-head { margin: 0; padding-bottom: .7rem; border-bottom: 1px solid color-mix(in srgb,var(--color-ink) 18%,transparent);
    font: 600 clamp(1.02rem,1.6vw,1.18rem)/1.5 var(--font-brand-display); letter-spacing: .02em; color: var(--color-ink); }
  /* 5地域と44市町村は常に表示する。左に地域名、右に市町村名を折り返して並べる */
  .ax-region { display:grid;grid-template-columns:4.4rem minmax(0,1fr);gap:.2rem .85rem;align-items:baseline;padding:.55rem 0;border-bottom:1px solid var(--color-mist); }
  .ax-region-name { display: inline-flex; align-items: center; gap: .5em; font-weight: 600; font-size: .9rem; color: var(--color-ink); white-space: nowrap; }
  .ax-region-dot { width: 12px; height: 12px; border-radius: 3px; display: inline-block; flex: none; }
  .ax-region-dot[data-region="kenpoku"] { background: #99bbe1; }
  .ax-region-dot[data-region="keno"] { background: #dbe5f0; }
  .ax-region-dot[data-region="kennan"] { background: #c9dbe9; }
  .ax-region-dot[data-region="rokko"] { background: #6f9fc7; }
  .ax-region-dot[data-region="kensei"] { background: #b9bdb2; }
  .ax-panel .ax-region ul { display: flex; flex-wrap: wrap; gap:.05rem .85rem; list-style: none; padding: 0; margin: 0; }
  .ax-panel .ax-region .ax-list-btn { display: inline-block; padding: .3em 0; font-size:.84rem;color:var(--color-charcoal); text-decoration: none; }
  .ax-panel .ax-region .ax-list-btn:hover, .ax-panel .ax-region .ax-list-btn:focus-visible { color: var(--color-tide); text-decoration: underline; text-underline-offset: .2em; }
  .ax-list-btn[aria-pressed="true"] { color: var(--color-tide); font-weight: 700; }
  .ax-list-read { font-size: 0.8rem; color: var(--color-tide); text-decoration: none; }

  /* モバイル：地図は保持しつつ、地域タブ＋リストを併設（ピンチ依存にしない） */
  @media (min-width:761px) and (max-width:1100px){.ax-grid{grid-template-columns:minmax(320px,.95fr) minmax(400px,1.05fr);gap:2rem}.ax-map{max-height:500px}.ax-intro h2{font-size:clamp(1.8rem,3vw,2.8rem)}.ax-intro-copy{font-size:.82rem}}
  @media (max-width: 760px) {
    .ax-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "map" "panel"; gap: 1.4rem; }
    .ax-mapwrap { width: 100%; overflow: hidden; padding: .4rem .1rem .2rem; }
    .ax-map { width: 100%; max-width: 100%; height:auto; }
    .ax-label { display: block; font-size: 8.8px; stroke-width: 2.25px; }
    .ax-label[data-label-slug="hitachinaka"], .ax-label[data-label-slug="tsukubamirai"], .ax-label[data-label-slug="tokai"] { font-size: 8px; }
    .ax-label[data-label-slug="kasumigaura"], .ax-label[data-label-slug="yachiyo"], .ax-label[data-label-slug="shimotsuma"] { font-size: 7.2px; }
    .ax-panel { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .ax-shape { transition: none; } }
</style>

<script>
  // TOPでは市町村を選ぶと、その街のページへ直接遷移する。
  const root = document.currentScript?.closest(".ax") ?? document.querySelector(".ax");
  if (root) {
    const data = JSON.parse(root.querySelector("[data-ax-data]")?.textContent || "{}");
    root.querySelectorAll<HTMLElement>(".ax-muni").forEach((el) => {
      const slug = el.getAttribute("data-slug");
      const href = slug ? data[slug]?.href : null;
      if (!href) return;
      const open = () => window.location.assign(href);
      el.addEventListener("click", open);
      el.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " " || event.key === "Spacebar") {
          event.preventDefault();
          open();
        }
      });
    });
  }
</script>
