---
import BrandBase from '../../layouts/BrandBase.astro';
const title = '茨城の干し芋図鑑｜8品種の違い・産地・選び方 | イバトコ';
const description = 'あなたの推し干し芋は？ べにはるか・シルクスイート・玉豊・いずみ・ほしこがねの8品種を比較。ひたちなか・東海・那珂の産地、平干し・丸干しの違いもわかる茨城の干し芋図鑑。';
const varieties = [
  {id:'beniharuka',name:'べにはるか',ruby:'BENIHARUKA',number:'01',lead:'甘く、しっとり。黄金色の定番。',taste:'濃厚な甘み',texture:'しっとり柔らか',story:'近年、茨城の干し芋の主流になった品種。黄金色の美しい仕上がりも魅力です。',tag:'濃厚派'},
  {id:'silksweet',name:'シルクスイート',ruby:'SILK SWEET',number:'02',lead:'絹のように、なめらか。',taste:'上品な甘み',texture:'なめらか',story:'すっきりした甘みと、名前の通りのなめらかな舌ざわりを楽しめます。',tag:'なめらか派'},
  {id:'tamayutaka',name:'玉豊',ruby:'TAMAYUTAKA',number:'03',lead:'懐かしさを噛みしめる。',taste:'素朴な甘み',texture:'噛むほど味わい',story:'産地の歴史を支えた伝統品種。昔ながらの干し芋を探している人に。',tag:'伝統派'},
  {id:'izumi',name:'いずみ',ruby:'IZUMI 13',number:'04',lead:'手間をかけて育つ、希少な味。',taste:'コクのある甘み',texture:'柔らかく粘りがある',story:'栽培と加工に手間がかかる希少品種。濃い飴色とコクが特徴です。',tag:'探究派'},
  {id:'hoshikogane',name:'ほしこがね',ruby:'HOSHIKOGANE',number:'05',lead:'芋そのものの風味を。',taste:'上品な甘み',texture:'製品によって異なる',story:'上品な甘みと、さつまいもらしい風味を楽しめる品種です。',tag:'風味派'},
  {id:'hoshikirari',name:'ほしキラリ',ruby:'HOSHI KIRARI',number:'06',lead:'干し芋のために生まれた、期待の品種。',taste:'糖化しやすく甘みが出やすい',texture:'加工条件により異なる',story:'農研機構が育成した干し芋加工用品種。白く硬い部分「シロタ」が発生しにくく、淡黄色の仕上がりが特徴です。',tag:'加工専用品種'},
  {id:'hoshiakane',name:'ほしあかね',ruby:'HOSHI AKANE',number:'07',lead:'ほんのり橙色、色から楽しむ。',taste:'加工条件により異なる',texture:'加工条件により異なる',story:'農研機構が育成した干し芋加工用品種。カロテン由来の淡い橙色と透明感のある仕上がりが特徴です。',tag:'橙色の干し芋'},
  {id:'tamaotome',name:'タマオトメ',ruby:'TAMAOTOME',number:'08',lead:'加工しやすさにも理由がある。',taste:'製品によって異なる',texture:'製品によって異なる',story:'農研機構が育成した蒸切干向け品種。繊維が少なく、皮がむきやすいことや、黄色い仕上がりが特徴です。',tag:'加工用品種'},
];
const sources = [
 {name:'農研機構「ほしキラリ」研究紹介',url:'https://www.naro.go.jp/publicity_report/press/laboratory/nics/013141.html'},
 {name:'農研機構「ほしあかね」研究成果',url:'https://www.naro.go.jp/publicity_report/press/laboratory/nics/137043.html'},
 {name:'農研機構「タマオトメ」',url:'https://www.naro.go.jp/collab/breed/0100/0102/001435.html'},
 {name:'農研機構「ほしキラリ」',url:'https://www.naro.go.jp/collab/breed/0100/0102/001573.html'},
 {name:'農研機構「ほしあかね」',url:'https://www.naro.go.jp/project/results/4th_laboratory/nics/2020/nics20_s07.html'},
];
const jsonLd = {'@context':'https://schema.org','@type':'Article',headline:'茨城の干し芋図鑑｜8品種の違い・産地・選び方',description,author:{'@type':'Organization',name:'イバトコ'},mainEntityOfPage:new URL('/hoshiimo/',Astro.site).href};
---
<BrandBase title={title} description={description} jsonLd={jsonLd}>
  <main class="hz">
    <section class="hz-hero">
      <div class="hz-hero__inner">
        <p class="hz-kicker">IBATOCO FIELD GUIDE <span>— VOL. 01 / IBARAKI</span></p>
        <p class="hz-eyebrow">茨城の風土と、甘い時間。</p>
        <h1>あなたの<span>推し干し芋</span>、<br/>どの品種？</h1>
        <p class="hz-hero__lead">ねっとり派も、昔ながら派も。<br/>8つの品種から、自分だけのおいしさを見つけよう。</p>
        <a class="hz-primary" href="#diagnosis">30秒で好みを見つける <span aria-hidden="true">↗</span></a>
        <a class="hz-secondary" href="#varieties">8品種を見比べる ↓</a>
      </div>
      <div class="hz-hero__art" aria-hidden="true"><div class="hz-plate"><span class="hz-slice hz-slice--a"></span><span class="hz-slice hz-slice--b"></span><span class="hz-slice hz-slice--c"></span></div><span class="hz-art-label">HOSHIIMO<br/>IBARAKI</span></div>
      <p class="hz-hero__foot">SCROLL TO DISCOVER <span>↓</span></p>
    </section>
    <div class="hz-marquee" aria-hidden="true">BENIHARUKA <span>✳</span> SILK SWEET <span>✳</span> TAMAYUTAKA <span>✳</span> IZUMI <span>✳</span> HOSHIKOGANE</div>
    <section class="hz-section hz-intro">
      <div><p class="hz-section__no">01 / THE STORY</p><h2>同じ干し芋なのに、<br/><em>こんなに違う。</em></h2></div>
      <p>ひとくちに「干し芋」といっても、品種が違えば甘みも香りも、歯ざわりも変わります。茨城の干し芋は、産地の風土と作り手の手仕事が生み出す、食べ比べるほど奥深い食文化です。</p>
    </section>
    <section class="hz-section hz-quiz" id="diagnosis" aria-labelledby="quiz-heading">
      <div class="hz-section-head"><p class="hz-section__no">02 / FIND YOUR TYPE</p><h2 id="quiz-heading">あなたは、<em>何派？</em></h2><p>たった2問で、好みに合いそうな品種を見つけよう。</p></div>
      <form class="hz-quiz__form" id="hz-quiz">
        <fieldset><legend><span>Q1</span> 好きな甘さは？</legend><div class="hz-options"><label><input type="radio" name="taste" value="rich" checked/><span>濃厚な甘さ</span></label><label><input type="radio" name="taste" value="refined"/><span>上品な甘さ</span></label><label><input type="radio" name="taste" value="nostalgic"/><span>昔ながらの味</span></label></div></fieldset>
        <fieldset><legend><span>Q2</span> 好きな食感は？</legend><div class="hz-options"><label><input type="radio" name="texture" value="soft" checked/><span>しっとり</span></label><label><input type="radio" name="texture" value="smooth"/><span>なめらか</span></label><label><input type="radio" name="texture" value="chewy"/><span>噛み応え</span></label></div></fieldset>
        <div class="hz-result" aria-live="polite"><p>あなたにおすすめの候補</p><strong id="hz-result-name">べにはるか</strong><p class="hz-result__note">好みに合わせた編集上の提案です。実際の食感や甘さは商品・加工方法によって異なります。</p><div class="hz-result__actions"><a id="hz-result-link" href="#beniharuka">この品種を詳しく見る ↗</a><button id="hz-share" type="button">結果をコピー</button></div><span id="hz-share-status" role="status"></span></div>
      </form>
    </section>
    <section class="hz-section" id="varieties">
      <div class="hz-section-head"><p class="hz-section__no">03 / THE COLLECTION</p><h2>五つの個性を、<em>味わう。</em></h2><p>数値のランキングではなく、品種ごとの魅力で選ぶ図鑑です。</p></div>
      <div class="hz-varieties">{varieties.map(v=><article class="hz-variety" id={v.id}><div class="hz-variety__top"><span>SPECIMEN / {v.number}</span><span class="hz-tag">{v.tag}</span></div><div class="hz-variety__figure" aria-hidden="true"><span class="hz-variety__shape"></span></div><p class="hz-variety__roman">{v.ruby}</p><h3>{v.name}</h3><p class="hz-variety__lead">{v.lead}</p><dl><div><dt>甘み</dt><dd>{v.taste}</dd></div><div><dt>食感</dt><dd>{v.texture}</dd></div></dl><p class="hz-variety__story">{v.story}</p></article>)}</div>
      <p class="hz-small">※品種の特徴は一般的な傾向です。製品ごとの仕上がりは異なります。イラストは概念表現で、品種ごとの実物写真ではありません。</p>
    </section>
    <section class="hz-section hz-origin" id="origin"><p class="hz-section__no">04 / MADE IN IBARAKI</p><h2>海と大地が育む、<br/><em>干し芋のふるさと。</em></h2><p>ひたちなか市、東海村、那珂市。火山灰由来の水はけのよい土壌、潮風、冬の晴天。茨城の干し芋は、この土地の条件と「蒸す・切る・乾燥させる」手仕事によって育まれてきました。</p><div class="hz-places"><span>ひたちなか市 <small>HITACHINAKA</small></span><span>東海村 <small>TOKAI</small></span><span>那珂市 <small>NAKA</small></span></div></section>
    <section class="hz-section hz-shapes"><p class="hz-section__no">05 / HOW TO CHOOSE</p><h2>平干し、それとも<em>丸干し？</em></h2><div class="hz-shape-grid"><article><span>01 / HIRABOSHI</span><h3>平干し</h3><p>スライスして乾燥させた定番の形。食べやすく、噛むほどに味わいが広がります。</p></article><article><span>02 / MARUBOSHI</span><h3>丸干し</h3><p>小さな芋を切らずに乾燥。しっとりした食感と食べ応えを楽しめます。</p></article></div></section>
    <section class="hz-section hz-faq"><p class="hz-section__no">06 / GOOD TO KNOW</p><h2>干し芋の<em>豆知識。</em></h2><details><summary>砂糖は入っていますか？</summary><p>さつまいもだけで作られる干し芋が一般的ですが、購入する商品の原材料表示を確認してください。</p></details><details><summary>どこで買えますか？</summary><p>産地の直売所や生産者のオンライン販売などで購入できます。品種、在庫、配送方法は販売元の最新情報をご確認ください。</p></details><details><summary>保存はどうすればいいですか？</summary><p>商品によって賞味期限や保存温度が異なります。パッケージの表示を優先し、開封後は指定された方法で保存してください。</p></details></section>
    <section class="hz-section hz-sources"><h2>出典・参考情報</h2><ul>{sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name} ↗</a></li>)}</ul><p>品種の味・食感は目安です。実地取材や生産者写真は、許諾取得後に順次追加します。</p></section>
  </main>
</BrandBase>
<script>
  const quiz=document.querySelector<HTMLFormElement>('#hz-quiz');
  const name=document.querySelector<HTMLElement>('#hz-result-name');
  const link=document.querySelector<HTMLAnchorElement>('#hz-result-link');
  const share=document.querySelector<HTMLButtonElement>('#hz-share');
  const status=document.querySelector<HTMLElement>('#hz-share-status');
  const result=()=>{if(!quiz)return;const data=new FormData(quiz);const t=data.get('taste'),x=data.get('texture');const item=t==='nostalgic'?['玉豊','tamayutaka']:t==='refined'?(x==='smooth'?['シルクスイート','silksweet']:['ほしこがね','hoshikogane']):(x==='smooth'?['シルクスイート','silksweet']:['べにはるか','beniharuka']);if(name)name.textContent=item[0];if(link)link.href='#'+item[1];};
  quiz?.addEventListener('change',result);result();
  share?.addEventListener('click',async()=>{const message='私の推し干し芋候補は「'+(name?.textContent||'べにはるか')+'」！あなたは何派？ #イバトコ #干し芋図鑑 '+window.location.href;try{await navigator.clipboard.writeText(message);if(status)status.textContent='コピーしました';}catch{if(status)status.textContent='コピーできませんでした。';}});
</script>
<style>
  .hz{--navy:#173c59;--ink:#28343b;--paper:#f8f0e4;--line:#d7d9d3;--amber:#b87742;color:var(--ink);background:var(--paper);font-family:inherit;overflow:hidden}.hz *{box-sizing:border-box}.hz h1,.hz h2,.hz h3,.hz p{margin:0}.hz a{color:inherit}.hz-hero{min-height:650px;position:relative;background:#f0e4d2;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;padding:clamp(36px,6vw,90px) max(5vw,24px);isolation:isolate}.hz-hero__inner{position:relative;z-index:2;max-width:760px}.hz-kicker,.hz-section__no{font-size:12px;letter-spacing:.17em;font-weight:700;color:#487088}.hz-kicker span{opacity:.6}.hz-eyebrow{margin:36px 0 12px!important;font-size:16px;letter-spacing:.16em}.hz h1,.hz h2,.hz h3{font-family:inherit;font-weight:800;letter-spacing:-.045em}.hz h1{font-size:clamp(44px,5.6vw,92px);line-height:1.22;color:var(--navy)}.hz h1 span{color:#b76c3b}.hz-hero__lead{font-size:clamp(15px,1.5vw,20px);line-height:2;margin:28px 0!important}.hz-primary{display:inline-flex;gap:24px;align-items:center;background:var(--navy);color:#fff!important;padding:18px 25px;border-radius:50px;text-decoration:none;font-weight:700}.hz-primary:hover{background:#275a7c}.hz-secondary{display:inline-block;margin:16px 0 0 20px;font-weight:700;font-size:13px;text-underline-offset:5px}.hz-hero__art{min-height:420px;position:relative;display:grid;place-items:center}.hz-plate{width:min(34vw,430px);aspect-ratio:1;border-radius:50%;background:#fff7e8;box-shadow:0 25px 65px #173c5924,inset 0 0 0 12px #fff8;display:flex;align-items:center;justify-content:center;gap:8px;transform:rotate(-16deg)}.hz-slice{display:block;width:23%;height:58%;border-radius:43% 38% 42% 30%;background:linear-gradient(95deg,#a35e2b,#e8b56d 35%,#d48c47 75%,#a35e2b);box-shadow:inset 4px 0 12px #fff5,5px 6px 8px #56371b3b;transform:rotate(9deg)}.hz-slice--b{height:67%;transform:rotate(-8deg)}.hz-slice--c{height:54%;transform:rotate(16deg)}.hz-art-label{position:absolute;right:3%;bottom:8%;font-size:11px;letter-spacing:.25em;line-height:1.8;color:#456778}.hz-hero__foot{position:absolute;bottom:20px;left:5vw;font-size:10px;letter-spacing:.18em}.hz-hero__foot span{margin-left:15px}.hz-marquee{white-space:nowrap;overflow:hidden;background:var(--navy);color:#fff;font-size:12px;letter-spacing:.19em;padding:14px;text-align:center}.hz-marquee span{color:#e2ad79;margin:0 16px}.hz-section{padding:clamp(70px,9vw,130px) max(5vw,24px);max-width:1440px;margin:auto;scroll-margin-top:90px}.hz h2{font-size:clamp(32px,4.5vw,62px);line-height:1.35;color:var(--navy);margin:18px 0 24px}.hz h2 em{font-style:normal;color:var(--amber)}.hz-section p{line-height:1.95}.hz-intro{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.hz-intro>p{max-width:540px;font-size:17px}.hz-section-head{text-align:center;margin-bottom:44px}.hz-quiz{background:#e4edf0;max-width:none}.hz-quiz>.hz-section-head,.hz-quiz__form{max-width:1000px;margin-left:auto;margin-right:auto}.hz-quiz__form{background:#fff;border-radius:24px;padding:clamp(24px,5vw,60px);box-shadow:0 18px 60px #173c590c}.hz-quiz fieldset{border:0;padding:0;margin:0 0 32px;min-width:0}.hz-quiz legend{font-weight:800;font-size:19px;margin-bottom:18px}.hz-quiz legend span{color:var(--amber);font-size:14px;margin-right:12px}.hz-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.hz-options label{cursor:pointer;position:relative}.hz-options input{position:absolute;opacity:0}.hz-options label span{display:block;border:1px solid var(--line);border-radius:14px;padding:19px 10px;text-align:center;font-weight:700;background:#fff;transition:background .15s,border-color .15s}.hz-options input:checked+span{border:2px solid var(--navy);background:#e9f2f7}.hz-options input:focus-visible+span{outline:3px solid #b87742;outline-offset:3px}.hz-result{background:var(--navy);color:#fff;border-radius:18px;padding:28px;text-align:center}.hz-result>p:first-child{font-size:13px;letter-spacing:.1em}.hz-result strong{display:block;font-size:clamp(30px,4vw,48px);margin:6px 0}.hz-result__note{font-size:12px;opacity:.85}.hz-result__actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:20px}.hz-result__actions a,.hz-result__actions button{font:inherit;font-weight:700;font-size:13px;border:1px solid #fff9;color:#fff;background:transparent;border-radius:99px;padding:12px 18px;cursor:pointer;text-decoration:none}.hz-result__actions a{background:#fff;color:var(--navy)}#hz-share-status{display:block;font-size:12px;margin-top:8px}.hz-varieties{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.hz-variety{background:#fffaf2;border:1px solid #d9c9b4;border-radius:18px;padding:26px;min-width:0;scroll-margin-top:100px}.hz-variety__top{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:11px;letter-spacing:.12em;color:#597184}.hz-tag{background:#e7f0f2;border-radius:99px;padding:7px 12px;letter-spacing:0;color:var(--navy)}.hz-variety__figure{height:150px;display:grid;place-items:center}.hz-variety__shape{display:block;width:65px;height:130px;border-radius:40% 44% 38% 45%;transform:rotate(35deg);background:linear-gradient(105deg,#8b4b2b,#e9b66e 40%,#c78340 85%);box-shadow:7px 8px 10px #6b3e2030}.hz-variety:nth-child(2) .hz-variety__shape{background:linear-gradient(105deg,#9d643c,#f1cf93,#b97940)}.hz-variety:nth-child(3) .hz-variety__shape{background:linear-gradient(105deg,#9a774e,#d5b78a,#8c6b45)}.hz-variety:nth-child(4) .hz-variety__shape{background:linear-gradient(105deg,#7a4b28,#bd8541,#74441e)}.hz-variety:nth-child(5) .hz-variety__shape{background:linear-gradient(105deg,#a56939,#e6bc79,#a76939)}.hz-variety__roman{font-size:11px;letter-spacing:.16em;color:#8b765e}.hz-variety h3{font-size:30px;color:var(--navy);margin:4px 0 8px}.hz-variety__lead{font-weight:700;font-size:15px}.hz-variety dl{border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin:22px 0;padding:10px 0}.hz-variety dl div{display:flex;justify-content:space-between;gap:12px;padding:6px 0;font-size:13px}.hz-variety dt{color:#64737a}.hz-variety dd{margin:0;font-weight:700;text-align:right}.hz-variety__story{font-size:13px;color:#485760}.hz-small{font-size:12px;color:#65737b;margin-top:24px!important}.hz-origin{background:#e4edf0;max-width:none}.hz-origin>p,.hz-origin>h2,.hz-places{max-width:1200px;margin-left:auto!important;margin-right:auto!important}.hz-origin>p:not(.hz-section__no){max-width:780px;margin-left:auto!important;margin-right:auto!important;text-align:center}.hz-origin>.hz-section__no,.hz-origin h2{text-align:center}.hz-places{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:35px!important}.hz-places span{background:#fff;border-radius:14px;padding:24px;text-align:center;font-weight:800;color:var(--navy)}.hz-places small{display:block;font-size:10px;letter-spacing:.13em;font-weight:500;margin-top:7px}.hz-shape-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.hz-shape-grid article{padding:35px;background:#fff;border:1px solid var(--line);border-radius:18px}.hz-shape-grid article>span{font-size:11px;letter-spacing:.15em;color:#a36b40}.hz-shape-grid h3{font-size:30px;margin:18px 0}.hz-faq details{border-bottom:1px solid var(--line);padding:18px 0}.hz-faq summary{cursor:pointer;font-weight:700;font-size:17px;list-style-position:inside}.hz-faq details p{padding:12px 0 0 20px}.hz-sources{border-top:1px solid var(--line);padding-top:40px}.hz-sources h2{font-size:20px}.hz-sources ul{padding-left:20px;line-height:2}.hz-sources p{font-size:12px;color:#63717b;margin-top:20px!important}
  @media(max-width:800px){.hz-hero{grid-template-columns:1fr;min-height:auto;padding-top:65px;padding-bottom:80px}.hz-hero__art{min-height:270px;grid-row:2}.hz-plate{width:min(65vw,300px)}.hz-hero__foot{bottom:15px}.hz-intro{grid-template-columns:1fr;gap:10px}.hz-varieties{grid-template-columns:repeat(2,minmax(0,1fr))}.hz-places{grid-template-columns:1fr}.hz-hero__lead{margin:20px 0!important}}
