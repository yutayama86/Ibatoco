---
/**
 * 行き先診断（/shindan/）。「いつ・何を・どのあたり」の3問で、行き先と記事を出す。
 *
 * - 候補はイベント・テーマ・市町村（src/lib/site-index.ts）。ニュースは入れない
 *   （開催日を持たないため、終わった話題を勧めてしまう）
 * - 日付を持つイベントは、選んだ期間と重なるものだけ。終了したものは出さない
 * - 判定は日本時間の暦日。ビルド後も日付の経過に追従する（ブラウザで計算）
 * - 答えは URL に残るので、結果を人に送れる
 * - 中身がブラウザで作られるページなので、検索エンジンには出さない（noindex）
 */
import BrandBase from '../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { INTERESTS } from '../lib/site-index';
import { REGIONS, REGION_ORDER } from '../data/areas';
import { wikimediaImage } from '../lib/wikimedia-image';
import '../styles/search.css';

const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: '行き先診断' }];
const whenOptions = [
  { value: 'weekend', label: '今週末' },
  { value: 'month', label: 'これから1か月のうちに' },
  { value: 'any', label: '時期は決めていない' },
];
const whatOptions = Object.entries(INTERESTS).map(([value, label]) => ({ value, label }));
const whereOptions = [...REGION_ORDER.map((key) => ({ value: key, label: `${REGIONS[key].label}（${REGIONS[key].note.replace(/。$/, '')}）` })), { value: 'any', label: 'どこでも' }];
/*
 * 結果の冒頭（提出版 discover-result の「写真の見出し」）。Q2 の答えごとに1枚。
 * 写真は出典とライセンスを確かめたもの（TOP・エリア一覧と同じ原本）だけ。権利を確かめられる写真がない
 * テーマは既存のイメージイラストにし、札で「イメージイラスト」と示す。場所の説明以外の事実は書かない。
 */
type ResultFeature = {
  /** 丸い印の短い言葉（提出版「海とまち」） */
  stamp: string;
  lines: [string, string];
  lead: string;
  img: { src: string; srcset?: string };
  width: number;
  height: number;
  alt: string;
  caption: string;
  credit?: { label: string; href: string };
};
const nemophila = wikimediaImage('https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/2025_Hitachi_Seaside_Park.jpg/1280px-2025_Hitachi_Seaside_Park.jpg', [500, 960]);
const resultFeatures: Record<keyof typeof INTERESTS, ResultFeature> = {
  flower: {
    stamp: '花と紅葉', lines: ['花の丘へ、', '季節に会いに。'], lead: '見頃は年によって前後します。出かける前に、記事の開花情報を確かめてください。',
    img: nemophila, width: 960, height: 640, alt: '国営ひたち海浜公園に咲くネモフィラ', caption: '国営ひたち海浜公園（4月下旬）／実写',
    credit: { label: '写真：Kakidai / CC BY-SA 4.0', href: 'https://commons.wikimedia.org/wiki/File:2025_Hitachi_Seaside_Park.jpg' },
  },
  festival: {
    stamp: '祭りと花火', lines: ['まちの熱気に、', 'まぜてもらう。'], lead: '土地の人が続けてきた行事へ。日程と場所は、記事の確認先で見てください。',
    img: { src: '/images/v42/oarai-festival.webp' }, width: 900, height: 675, alt: '大洗あんこう祭の会場（2014年）', caption: '大洗あんこう祭（2014年）／実写',
    credit: { label: '写真：Miyuki Meinaka / CC BY-SA 4.0', href: 'https://commons.wikimedia.org/wiki/File:Oarai_Anglerfish_Festival_2014.jpg' },
  },
  sea: {
    stamp: '海と魚', lines: ['海風に会う、', '休日はどう？'], lead: '海を眺めて、街をひと歩き。こんなよりみちから、次の休日を考えてみよう。',
    img: { src: '/images/v42/ocean.webp' }, width: 720, height: 480, alt: '大洗海岸から見る太平洋の日の出', caption: '大洗海岸／実写',
    credit: { label: '写真：t.kunikuni / CC BY-SA 2.0', href: 'https://commons.wikimedia.org/wiki/File:Sunrise_of_the_Pacific_Ocean_-_Oarai_coast.jpg' },
  },
  nature: {
    stamp: '山と滝', lines: ['水の音と、', '山の色に会いに。'], lead: '滝や渓谷、山あいの道へ。足もとと天気を確かめて出かけよう。',
    img: { src: '/images/v42/autumn.webp' }, width: 720, height: 480, alt: '紅葉の袋田の滝（大子町）', caption: '袋田の滝（大子町）／実写',
    credit: { label: '写真：t.kunikuni / CC BY-SA 2.0', href: 'https://commons.wikimedia.org/wiki/File:Autumn_of_Fukuroda_Falls,_Daigo,_Ibaraki;_November_2016.jpg' },
  },
  onsen: {
    stamp: '温泉と宿', lines: ['湯につかって、', 'ゆっくり帰ろう。'], lead: '急がない一日のための行き先です。営業日と料金は、記事の確認先で見てください。',
    img: { src: '/images/v42/town-dusk.webp' }, width: 1600, height: 533, alt: '夕暮れの町並みを描いたイメージイラスト', caption: 'イメージイラスト',
  },
  town: {
    stamp: '街と歴史', lines: ['古い道を、', 'のんびり歩く。'], lead: '街並みと、そこに続く暮らしへ。歩く順番は、記事の地図を手がかりに。',
    img: { src: '/images/v42/makabe-town-print.webp' }, width: 720, height: 240, alt: '蔵の並ぶ古い町並みを描いたイメージイラスト', caption: 'イメージイラスト',
  },
  sports: {
    stamp: 'スポーツ', lines: ['スタンドで、', '声をそろえる。'], lead: '試合の日程と会場への行き方は、記事とクラブの公式情報で確かめてください。',
    img: { src: '/images/v42/matchday-supporters.webp' }, width: 520, height: 347, alt: '試合へ向かうサポーターを描いたイメージイラスト', caption: 'イメージイラスト',
  },
};
const labels = JSON.stringify({ interests: INTERESTS, regions: Object.fromEntries(REGION_ORDER.map((key) => [key, REGIONS[key].label])) });
---
<BrandBase title="行き先診断｜イバトコ" description="いつ・何をしたい・どのあたり、の3問に答えるだけで、茨城の行き先と記事をご案内します。" noindex>
  <section class="sd bp-wrap" data-shindan data-labels={labels}>
    <header class="sd-head v42-hero v42-hub-label">
      <Breadcrumbs items={crumbs} />
      <p class="bp-kicker">FIND YOUR IBARAKI</p>
      <h1>3つ答えるだけで、<br />行き先が決まる。</h1>
      <p class="v42-display" data-copy-key="discover.title">次の休日、<br />どこへ行こう。</p>
      <p class="sd-lead">公式の情報で日程を確かめた催しと、季節のテーマ、44市町村のページから選びます。</p>
      <img class="v42-hero__art" src="/images/v42/map-travelers.webp" alt="" width="360" height="540" decoding="async" />
    </header>

    <form class="sd-form" data-shindan-form>
      <fieldset>
        <legend><span>Q1</span>いつ行きますか？</legend>
        <div class="sd-options">{whenOptions.map((option, index) => <label><input type="radio" name="when" value={option.value} checked={index === 0} /><span>{option.label}</span></label>)}</div>
      </fieldset>
      <fieldset>
        <legend><span>Q2</span>何をしたいですか？</legend>
        <div class="sd-options">{whatOptions.map((option, index) => <label><input type="radio" name="what" value={option.value} checked={index === 0} /><span>{option.label}</span></label>)}</div>
      </fieldset>
      <fieldset>
        <legend><span>Q3</span>どのあたりに行きますか？</legend>
        <div class="sd-options">{whereOptions.map((option, index) => <label><input type="radio" name="where" value={option.value} checked={index === whereOptions.length - 1} /><span>{option.label}</span></label>)}</div>
      </fieldset>
      <button type="submit">行き先を見る <span aria-hidden="true">→</span></button>
    </form>

    <div class="sd-result" data-shindan-result hidden>
      {Object.entries(resultFeatures).map(([key, feature]) => (
        <div class="v42-featured sd-feature" data-shindan-feature={key} hidden>
          <div>
            <p class="v42-stamp">{feature.stamp}<small>YOUR IBARAKI</small></p>
            <p class="v42-featured__title">{feature.lines[0]}<br />{feature.lines[1]}</p>
            <p class="v42-featured__lead">{feature.lead}</p>
          </div>
          <figure class="v42-photo">
            <span class="v42-tape" aria-hidden="true"></span>
            <img src={feature.img.src} srcset={feature.img.srcset} sizes="(min-width: 900px) 360px, 92vw" alt={feature.alt} width={feature.width} height={feature.height} loading="lazy" decoding="async" />
            <figcaption>{feature.caption}{feature.credit && <>　<a href={feature.credit.href} rel="license noopener" target="_blank">{feature.credit.label}</a></>}</figcaption>
          </figure>
        </div>
      ))}
      <h2 tabindex="-1" data-shindan-heading>あなたへのおすすめ</h2>
      <p class="sd-note" data-shindan-note></p>
      <ol class="sr-list" data-shindan-list data-module="shindan_results"></ol>
      <div data-shindan-areas hidden>
        <h3>このあたりの街から探す</h3>
        <ul class="sd-areas" data-shindan-area-list data-module="shindan_areas"></ul>
      </div>
      <p class="sd-more">ほかの探し方：<a href="/search/">ことばで探す</a> ／ <a href="/events/">イベントの一覧</a> ／ <a href="/area/">44市町村</a></p>
    </div>
  </section>
</BrandBase>

<style>
  .sd{max-width:880px;padding-block:clamp(2.5rem,6vw,4.5rem)}
  .sd h1{margin-top:.8rem;font:600 clamp(1.9rem,4.8vw,3rem)/1.35 var(--font-brand-display);color:var(--color-ink);text-wrap:balance}
  .sd-lead{margin-top:1rem;color:var(--color-soil);line-height:1.9}
  .sd-form{display:grid;gap:1.6rem;margin-top:2rem}
  .sd-form fieldset{margin:0;padding:0;border:0}
  .sd-form legend{display:flex;align-items:center;gap:.6rem;font:600 1.15rem/1.5 var(--font-brand-display);color:var(--color-ink)}
  .sd-form legend span{display:inline-grid;place-items:center;width:2.2rem;height:2.2rem;border-radius:50%;background:var(--color-tide);color:#fff;font:700 .78rem var(--font-brand-meta)}
  .sd-options{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:.8rem}
  .sd-options label{position:relative}
  .sd-options input{position:absolute;opacity:0;pointer-events:none}
  .sd-options span{display:inline-flex;align-items:center;min-height:2.75rem;padding:.55rem 1rem;border:1px solid var(--color-mist);border-radius:999px;background:var(--color-white);color:var(--color-ink);font-size:.9rem;cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease}
  .sd-options input:checked+span{border-color:var(--color-tide);background:var(--color-tide);color:#fff;font-weight:700}
  .sd-options input:focus-visible+span{outline:2px solid var(--color-tide);outline-offset:2px}
  .sd-form button{justify-self:start;display:inline-flex;align-items:center;gap:.8rem;min-height:3.2rem;padding:.75rem 1.6rem;border:0;border-radius:999px;background:var(--color-ink);color:#fff;font:700 1rem var(--font-brand-body);cursor:pointer}
  .sd-form button:focus-visible{outline:2px solid var(--color-tide);outline-offset:3px}
  .sd-result{margin-top:2.6rem;padding-top:2rem;border-top:1px solid var(--color-mist)}
  .sd-result h2{font:600 clamp(1.5rem,3.4vw,2.1rem)/1.4 var(--font-brand-display);color:var(--color-ink)}
  .sd-result h2:focus{outline:none}
  .sd-note{margin-top:.6rem;color:var(--color-soil);font-size:.88rem;line-height:1.8}
  .sd-result h3{margin-top:2rem;font:600 1.1rem/1.5 var(--font-brand-display);color:var(--color-ink)}
  .sd-areas{display:flex;flex-wrap:wrap;gap:.5rem;margin:.8rem 0 0;padding:0;list-style:none}
  .sd-areas li::before{content:none}
  .sd-areas a{display:inline-block;padding:.5rem .95rem;border:1px solid var(--color-mist);border-radius:999px;background:var(--color-white);color:var(--color-ink);font-size:.88rem}
  .sd-areas a:hover,.sd-areas a:focus-visible{border-color:var(--color-tide);color:var(--color-tide)}
  .sd-more{margin-top:1.8rem;color:var(--color-soil);font-size:.88rem}
  .sd-more a{color:var(--color-tide);border-bottom:1px solid}
  @media(prefers-reduced-motion:reduce){.sd-options span{transition:none}}
</style>

<script>
  import { addDays, escapeHtml, loadIndex, monthsBetween, overlaps, rowHtml, weekendRange, type Row } from '../lib/search-client';
  import { todayDateOnlyString } from '../lib/date-only.js';
  import { bindModuleTracking } from '../lib/module-tracking';

  const root = document.querySelector<HTMLElement>('[data-shindan]');
  const form = document.querySelector<HTMLFormElement>('[data-shindan-form]');
  const result = document.querySelector<HTMLElement>('[data-shindan-result]');
  const heading = document.querySelector<HTMLElement>('[data-shindan-heading]');
  const note = document.querySelector<HTMLElement>('[data-shindan-note]');
  const list = document.querySelector<HTMLElement>('[data-shindan-list]');
  const areasBox = document.querySelector<HTMLElement>('[data-shindan-areas]');
  const areaList = document.querySelector<HTMLElement>('[data-shindan-area-list]');
  const labels = JSON.parse(root?.dataset.labels ?? '{}') as { interests: Record<string, string>; regions: Record<string, string> };

  type Answer = { when: string; what: string; where: string };

  function recommend(rows: Row[], answer: Answer, today: string): { picks: { row: Row; reason: string }[]; relaxed: boolean } {
    const window = answer.when === 'weekend' ? weekendRange(today) : answer.when === 'month' ? { start: today, end: addDays(today, 30) } : null;
    const run = (useWindow: boolean) => rows
      .filter((row) => !row.x && (row.k === 'event' || row.k === 'theme'))
      // 月ごとのまとめ記事は、その月が過ぎたら勧めない
      .filter((row) => !row.ym || row.ym >= today.slice(0, 7))
      .filter((row) => row.i.includes(answer.what))
      .filter((row) => answer.where === 'any' || row.r.length === 0 || row.r.includes(answer.where))
      .filter((row) => {
        if (!useWindow || !window) return true;
        if (row.s) return overlaps(row, window.start, window.end);
        // 日付のないガイドは、見頃の月が期間に重なるものだけ（例：9月末に4月のネモフィラを出さない）
        if (row.m && row.m.length > 0) return monthsBetween(window.start, window.end).some((month) => row.m!.includes(month));
        return true;
      })
      .map((row) => {
        const inWindow = Boolean(window && row.s && overlaps(row, window.start, window.end));
        const inRegion = answer.where !== 'any' && row.r.includes(answer.where);
        const score = (inWindow ? 4 : 0) + (inRegion ? 2 : 0) + (row.k === 'event' ? 2 : 1);
        const reason = [
          inWindow ? (answer.when === 'weekend' ? '今週末に開催' : 'これから1か月のうちに開催') : '',
          inRegion ? `${labels.regions[answer.where]}の行き先` : '',
          labels.interests[answer.what],
        ].filter(Boolean).join('・');
        return { row, reason, score };
      })
      .sort((a, b) => b.score - a.score)
      .slice(0, 6);
    const picks = run(true);
    if (picks.length > 0 || !window) return { picks, relaxed: false };
    return { picks: run(false), relaxed: true };
  }

  async function show(answer: Answer) {
    if (!result || !list || !note || !heading) return;
    const rows = await loadIndex();
    const { picks, relaxed } = recommend(rows, answer, todayDateOnlyString());
    result.hidden = false;
    for (const feature of result.querySelectorAll<HTMLElement>('[data-shindan-feature]')) feature.hidden = feature.dataset.shindanFeature !== answer.what;
    note.textContent = picks.length === 0
      ? '条件に合う行き先が見つかりませんでした。「どこでも」や別の目的でも試してください。'
      : relaxed
        ? '選んだ時期に開催が決まっている催しは見つからなかったので、時期を問わずに選びました。日程は各記事で確認してください。'
        : '公式の情報で日程を確かめたものから選んでいます。出かける前に、各記事の確認先で最新の情報を見てください。';
    list.innerHTML = picks.map((pick) => rowHtml(pick.row, pick.reason)).join('');
    if (areasBox && areaList) {
      const areas = answer.where === 'any' ? [] : rows.filter((row) => row.k === 'area' && row.r.includes(answer.where));
      areaList.innerHTML = areas.map((row) => `<li><a href="${escapeHtml(row.u)}">${escapeHtml(row.p[0] ?? row.t)}</a></li>`).join('');
      areasBox.hidden = areas.length === 0;
    }
    heading.focus();
  }

  if (root && form) {
    bindModuleTracking('shindan', root);
    const params = new URLSearchParams(location.search);
    for (const name of ['when', 'what', 'where'] as const) {
      const value = params.get(name);
      const input = value ? form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(value)}"]`) : null;
      if (input) input.checked = true;
    }
    const read = (): Answer => {
      const data = new FormData(form);
      return { when: String(data.get('when')), what: String(data.get('what')), where: String(data.get('where')) };
    };
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const answer = read();
      history.replaceState(null, '', `?${new URLSearchParams(answer).toString()}`);
      show(answer);
    });
    if (params.has('what')) show(read());
  }
</script>
