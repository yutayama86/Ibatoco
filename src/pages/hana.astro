---
import BrandBase from '../layouts/BrandBase.astro';
import ThemeGuide from '../components/ThemeGuide.astro';
import { THEMES } from '../data/themes';
import { breadcrumbJsonLd } from '../lib/seo';
const theme = THEMES.hana;
const jsonLd = breadcrumbJsonLd([{ name: 'ホーム', href: '/' }, { name: theme.title, href: '/hana/' }], Astro.site);
---
<BrandBase title={theme.metaTitle} description={theme.metaDescription} jsonLd={jsonLd}>
  <ThemeGuide theme={theme} />
</BrandBase>
