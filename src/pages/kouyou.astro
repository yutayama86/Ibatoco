---
import BrandBase from '../layouts/BrandBase.astro';
import ThemeGuide from '../components/ThemeGuide.astro';
import { THEMES } from '../data/themes';
import { breadcrumbJsonLd, faqPageJsonLd } from '../lib/seo';
const theme = THEMES.kouyou;
// FAQは画面に出している内容とそろえる。片方だけ足したり消したりしない。
const jsonLd = [
  breadcrumbJsonLd([{ name: 'ホーム', href: '/' }, { name: theme.title, href: '/kouyou/' }], Astro.site),
  ...(theme.faq && theme.faq.length > 0 ? [faqPageJsonLd(theme.faq)] : []),
];
---
<BrandBase title={theme.metaTitle} description={theme.metaDescription} jsonLd={jsonLd}>
  <ThemeGuide theme={theme} />
</BrandBase>
