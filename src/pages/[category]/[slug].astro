---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BrandBase from '../../layouts/BrandBase.astro';
import BrandStoryCard from '../../components/BrandStoryCard.astro';
import DisclosureBadge from '../../components/DisclosureBadge.astro';
import ReportingMeta from '../../components/ReportingMeta.astro';
import CorrectionHistory from '../../components/CorrectionHistory.astro';
import { CATEGORIES, SITE_CONFIG } from '../../data/site';
import { getPublishedArticles, tagToSlug } from '../../lib/content';
import { reporterByName } from '../../data/reporters';

export const getStaticPaths = (async () => (await getPublishedArticles()).map((article) => ({
  params: { category: article.data.category, slug: article.id.split('/').pop() },
  props: { article },
}))) satisfies GetStaticPaths;

const { article } = Astro.props;
const { data } = article;
const cat = CATEGORIES[data.category];
const slug = article.id.split('/').pop();
const { Content } = await render(article);
const reporter = reporterByName(data.reporter);
const related = (await getPublishedArticles()).filter((item) => item.id !== article.id && item.data.category === data.category).slice(0, 2);
const absolute = (path: string) => new URL(path, Astro.site ?? SITE_CONFIG.domain).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: data.title, description: data.description,
  datePublished: data.publishedAt.toISOString(), dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: reporter ? { '@type': 'Person', name: reporter.name, jobTitle: reporter.role, url: absolute(`/reporter/${reporter.slug}/`) } : { '@type': 'Organization', name: data.author },
  publisher: { '@type': 'Organization', name: SITE_CONFIG.name }, ...(data.cover ? { image: absolute(data.cover) } : {}),
};
---

<BrandBase title={`${data.title}｜イバトコ`} description={data.description} image={data.cover ?? `/og/${cat.path}/${slug}.png`} type="article" publishedAt={data.publishedAt} jsonLd={jsonLd}>
  <article class="story">
    <header class="story-head bp-reading">
      <nav class="crumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href={`/${cat.path}/`}>{cat.label}</a></nav>
      <DisclosureBadge type={data.disclosure} note={data.disclosureNote} />
      <p class="story-label">{data.area} / {cat.label}</p>
      <h1>{data.title}</h1>
      <p class="story-deck">{data.description}</p>
    </header>

    {data.cover && <figure class="story-hero bp-wrap"><img src={data.cover} alt={data.coverAlt} loading="eager" /></figure>}

    <div class="story-grid bp-wrap">
      <aside>
        <ReportingMeta publishedAt={data.publishedAt} updatedAt={data.updatedAt} reportingDate={data.reportingDate} onSiteReporting={data.onSiteReporting} disclosureNote={data.disclosureNote} />
        <p class="story-by">取材・執筆<br /><strong>{data.reporter ?? data.author}</strong></p>
        {reporter && <a class="story-person" href={`/reporter/${reporter.slug}/`}>取材者について →</a>}
      </aside>
      <div class="story-body prose"><Content /></div>
    </div>

    {data.tags.length > 0 && <ul class="story-tags bp-reading">{data.tags.map((tag) => <li><a href={`/tag/${tagToSlug(tag)}/`}>#{tag}</a></li>)}</ul>}
    <div class="story-corrections bp-reading"><CorrectionHistory corrections={data.corrections} /></div>
    <footer class="story-footer bp-reading"><p>内容についてお気づきの点がある場合は、訂正・更新方針をご確認ください。</p><a href="/about/corrections/">訂正・更新方針 →</a></footer>
  </article>

  {related.length > 0 && <section class="bp-wrap bp-section"><p class="bp-kicker">RELATED STORIES</p><h2 class="bp-section-title">続けて読みたい物語</h2><div class="related">{related.map((item) => <BrandStoryCard article={item} />)}</div></section>}
</BrandBase>

<style>
  .story{padding-top:clamp(4rem,9vw,7rem)}.crumbs{display:flex;gap:.55rem;margin-bottom:1.5rem;color:var(--color-soil);font-size:.78rem}.crumbs a{border-bottom:1px solid transparent}.crumbs a:hover{border-color:var(--color-tide)}
  .story-label{margin-top:1.5rem;color:var(--color-tide);font:.75rem var(--font-brand-meta);letter-spacing:.1em}.story-head h1{margin-top:.7rem;font:600 clamp(2rem,5.4vw,4.4rem)/1.3 var(--font-brand-display);color:var(--color-ink)}
  .story-deck{margin-top:1.4rem;font:500 clamp(1rem,1.7vw,1.2rem)/2 var(--font-brand-display);color:var(--color-soil)}.story-hero{margin-top:3rem}.story-hero img{width:100%;max-height:70vh;object-fit:cover}
  .story-grid{display:grid;grid-template-columns:230px minmax(0,700px);justify-content:center;gap:clamp(2rem,6vw,5rem);padding-block:4rem}.story-by{margin-top:1.5rem;color:var(--color-soil);font-size:.8rem;line-height:1.8}.story-by strong{color:var(--color-ink)}.story-person{display:inline-block;margin-top:1rem;color:var(--color-tide);font-size:.78rem;border-bottom:1px solid}
  .story-body.prose h2{border-left:0;padding-left:0;color:var(--color-ink)}.story-body.prose a{color:var(--color-tide)}.story-body.prose li:before{background:var(--color-tide)}
  .story-tags{display:flex;gap:.6rem;flex-wrap:wrap;padding-block:1.5rem;border-top:1px solid var(--color-mist)}.story-tags a{font-size:.78rem;color:var(--color-soil)}.story-corrections{padding-block:1.5rem}
  .story-footer{border-block:1px solid var(--color-mist);padding-block:1.5rem;color:var(--color-soil);font-size:.82rem}.story-footer a{display:inline-block;margin-top:.5rem;color:var(--color-tide)}
  .related{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;margin-top:2rem}.bp-section-title{margin-top:.7rem}
  @media(max-width:760px){.story-grid,.related{grid-template-columns:minmax(0,1fr)}}
</style>
