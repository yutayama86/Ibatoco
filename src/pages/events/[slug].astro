---
/**
 * /events/<slug>/ — イベント・おでかけの実用記事。
 *
 * /news/ の「解説」とは器を分けている。ここに来る人が知りたいのは
 * 日程・場所・料金・駐車場で、編集部の考察ではない。
 *
 * 確認できていない項目は出さない。推測で埋めるくらいなら、
 * 「公式発表を確認できていません」と書いて公式へ送るほうが役に立つ。
 */
import type { GetStaticPaths } from 'astro';
import BrandBase from '../../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import BusinessCta from '../../components/BusinessCta.astro';
import BookingGuide from '../../components/BookingGuide.astro';
import GrowthNextReads from '../../components/GrowthNextReads.astro';
import SponsorSlots from '../../components/SponsorSlots.astro';
import { hasPaidLink } from '../../data/affiliates';
import { getEvents } from '../../lib/content';
import { MUNI_BY_SLUG } from '../../data/areas';
import { lifecycleLabelOf, lifecycleOf } from '../../lib/lifecycle';
import { shareImageOf } from '../../lib/card-image';
import { getAllFacets } from '../../lib/taxonomy';
import { INTERNAL_LINK_LABELS } from '../../data/internal-links';

export const getStaticPaths = (async () => {
  const events = await getEvents();
  return events.map((entry) => ({ params: { slug: entry.id.split('/').pop() }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const info = d.eventInfo;
/**
 * 編集部がつないだリンクは、行き先の名前で見せる。
 * 以前は3枚とも「編集部がつないだ次の候補」と同じ文言で、どこへ行くのか分からなかった。
 */
const facetTitleByPath = new Map((await getAllFacets()).map((f) => [f.path, f.title.split('｜')[0]]));
const pickLabel = (url: string) => INTERNAL_LINK_LABELS[url] ?? facetTitleByPath.get(url) ?? '編集部がつないだ次の候補';

const fmtDate = (x: Date) => new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' }).format(x);

/**
 * 日付を YYYY-MM-DD にする。
 * toISOString() はUTCへ寄せるため、日本時間の日付とズレることがある。
 * frontmatter の日付は日本のイベントの日付なので、日本時間で組み立てる。
 */
const iso = (x: Date) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(x);

/**
 * schema.org の日時。時刻が分かっているときだけ +09:00 付きの
 * ISO 8601 にする。分からなければ日付だけを返す（推測で 00:00 を足さない）。
 */
const isoDateTime = (x: Date, time?: string) => (time ? `${iso(x)}T${time}:00+09:00` : iso(x));

/** 実務情報の行。値が無い項目は行ごと出さない */
const factRows = info ? ([
  ['開催日', info.endDate ? `${fmtDate(info.startDate)} 〜 ${fmtDate(info.endDate)}` : fmtDate(info.startDate)],
  ['時間', info.time],
  ['会場', info.venue],
  ['住所', info.address],
  ['料金', info.fee],
  ['アクセス', info.access],
  ['公共交通', info.publicTransport],
  ['駐車場', info.parking],
  ['雨天・荒天時', info.weatherPolicy],
] as [string, string | undefined][]).filter(([, v]) => Boolean(v)) : [];

/** 埋まっていない実務項目。読者に「調べたが無い」と伝えるため名前を出す */
const unknownLabels = info ? ([
  ['時間', info.time], ['会場', info.venue], ['住所', info.address], ['料金', info.fee],
  ['アクセス', info.access], ['公共交通', info.publicTransport], ['駐車場', info.parking],
  ['雨天・荒天時', info.weatherPolicy],
] as [string, string | undefined][]).filter(([, v]) => !v).map(([k]) => k) : [];

const towns = d.municipalities.map((s) => MUNI_BY_SLUG.get(s)).filter(Boolean);
const verifiedAt = d.updatedDate ?? d.sourceUrls
  .map((s) => s.accessedAt)
  .filter((x): x is Date => Boolean(x))
  .sort((a, b) => b.getTime() - a.getTime())[0] ?? d.pubDate;
const decisionChips = info ? [
  info.fee && { label: '料金', value: info.fee },
  info.parking && { label: '駐車場', value: '情報あり' },
  info.publicTransport && { label: '公共交通', value: '情報あり' },
  info.weatherPolicy && { label: '雨天', value: '確認済み' },
].filter(Boolean).slice(0, 4) as { label: string; value: string }[] : [];
// 開催状況は保存せず毎ビルド計算する。保存すると開催後も upcoming のまま残る
const lifecycle = lifecycleOf(entry);
const lifecycleLabel = lifecycleLabelOf(entry);
/**
 * 関連記事はルールで選ぶ（src/lib/related.ts）。
 * 一致した軸が1つも無いものは出さない。終了したイベントも候補にしない。
 * 編集部が手で選んだ relatedArticleUrls とは重複させない。
 */
const crumbs: Crumb[] = [
  { name: 'ホーム', href: '/' },
  { name: '茨城のイベント・おでかけ', href: '/events/' },
  { name: d.title },
];
/**
 * 目次と見出し番号は、実際に描画されるセクションから作る。
 * ここを1か所にしないと、条件で消えたセクションの番号が飛ぶ。
 */
const highlightLabel = d.articleType === 'event' || d.articleType === 'roundup' ? '見どころ' : 'くわしく';
const sections = ([
  factRows.length > 0 && { id: 'facts', label: '開催情報', en: 'FACTS' },
  d.keyPoints.length > 0 && { id: 'points', label: '押さえておきたいこと', en: 'KEY POINTS' },
  d.highlights.length > 0 && { id: 'highlights', label: highlightLabel, en: 'DETAILS' },
  d.picks.length > 0 && { id: 'picks', label: d.picksHeading ?? '候補', en: 'PICKS' },
  d.notes.length > 0 && { id: 'notes', label: '行く前に', en: 'BEFORE YOU GO' },
  d.faq.length > 0 && { id: 'faq', label: 'よくある質問', en: 'FAQ' },
  { id: 'sources', label: '情報源', en: 'SOURCES' },
] as const).filter(Boolean) as { id: string; label: string; en: string }[];
const no = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');

const jsonLd: Record<string, unknown>[] = [breadcrumbJsonLd(crumbs, Astro.site)];
// 日付が未発表の季節ガイドは Event を推測で出さず、記事としての
// 出典・更新情報を Article で明示する。Event と Article の二重化を避ける。
if (d.articleType === 'guide') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: iso(d.pubDate),
    dateModified: iso(d.updatedDate ?? d.pubDate),
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    ...(d.ogImage ? { image: new URL(d.ogImage, Astro.site).toString() } : {}),
    author: { '@type': 'Organization', name: 'イバトコ' },
    publisher: { '@type': 'Organization', name: 'イバトコ', url: new URL('/', Astro.site).toString() },
  });
}
// Google の Event は location が必須。会場も住所も確認できていないイベントで
// Event を出すと、リッチリザルトの対象にならないうえ Search Console に
// エラーとして積み上がる。確認できるまで出力しない（推測で会場を書かない）。
// frontmatter に venue か address を足せば、自動的に出力が始まる。
const canEmitEvent = Boolean(info && (info.venue || info.address));
if (info && canEmitEvent) {
  // endDate は「終了日」または「開始日＋終了時刻」から作る。
  // 複数日イベントは endDate を持ち、単日イベントでも終了時刻が分かっていれば
  // その日の終了時刻を endDate にできる。どちらも無ければ出力しない
  // （推測で startDate と同じ値を入れることはしない）。
  const endBase = info.endDate ?? (info.endTime ? info.startDate : undefined);
  const endValue = endBase ? isoDateTime(endBase, info.endTime) : undefined;

  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: info.name,
    startDate: isoDateTime(info.startDate, info.startTime),
    ...(endValue ? { endDate: endValue } : {}),
    // location は Google の Event 必須項目。venue（会場名）が無くても
    // address（住所）だけ分かっていれば Place として出せる。
    // 以前は venue がある場合しか出しておらず、住所だけ確認できている
    // イベントで location ごと欠落していた。
    ...(info.venue || info.address
      ? {
          location: {
            '@type': 'Place',
            name: info.venue ?? info.address,
            ...(info.address ? { address: info.address } : {}),
          },
        }
      : {}),
    ...(info.officialUrl ? { url: info.officialUrl } : {}),
    // 開催状況。既定は「開催予定」で、公式が中止・延期を発表したときだけ eventInfo.status を変える
    eventStatus: `https://schema.org/Event${info.status === 'cancelled' ? 'Cancelled' : info.status === 'postponed' ? 'Postponed' : 'Scheduled'}`,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    description: d.description,
  });
}
if (d.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  });
}
---

<BrandBase
  title={`${d.title}｜イバトコ`}
  description={d.description}
  image={shareImageOf(entry)}
  imageAlt={d.ogImageAlt}
  type="article"
  publishedAt={d.pubDate}
  updatedAt={d.updatedDate ?? d.pubDate}
  jsonLd={jsonLd}
  noindex={d.noindex}
  translationKey={d.translationKey}
>
  <header class="ev-head bp-wrap bp-reading">
    <Breadcrumbs items={crumbs} />
    <p class="bp-kicker">{d.articleType === 'event' ? 'EVENT' : d.articleType === 'roundup' ? 'ROUNDUP' : 'GUIDE'}</p>
    <h1>{d.title}</h1>
    {lifecycleLabel && <p class:list={['ev-status', `is-${lifecycle}`]}>{lifecycleLabel}</p>}
    {lifecycle === 'ended' && d.supersededBy && (
      <p class="ev-status__next"><a href={d.supersededBy}>最新の回の記事を見る →</a></p>
    )}
    <p class="ev-lead">{d.summary}</p>
    {d.booking && hasPaidLink(d.booking.items) && <p class="ad-disclosure"><span class="ad-disclosure__tag">#アフィリエイト広告</span>この記事にはアフィリエイト広告を含みます。</p>}
    <p class="ev-meta">
      <time datetime={d.pubDate.toISOString()}>公開 {fmtDate(d.pubDate)}</time>
      {d.updatedDate && <> ／ <time datetime={d.updatedDate.toISOString()}>更新 {fmtDate(d.updatedDate)}</time></>}
    </p>
    <aside class="ev-check" aria-label="この記事の確認状況">
      <div class="ev-check__verified">
        <span aria-hidden="true">✓</span>
        <div><strong>公式情報を確認済み</strong><small>{fmtDate(verifiedAt)}時点</small></div>
      </div>
      {decisionChips.length > 0 && (
        <dl class="ev-check__chips">
          {decisionChips.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
      )}
    </aside>
  </header>

  <div class="ev-layout bp-wrap">
    <aside class="ev-toc" aria-label="この記事の目次">
      <p>この記事の構成</p>
      <ol>{sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ol>
    </aside>

    <div class="ev-body">
  {factRows.length > 0 && (
    <section id="facts" aria-labelledby="ev-facts">
      <p class="section-number">{no('facts')} / FACTS</p>
      <h2 id="ev-facts" class="bp-section-title">開催情報</h2>
      <dl class="ev-facts">
        {factRows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      {unknownLabels.length > 0 && (
        <p class="ev-unknown">
          {unknownLabels.join('、')}については、この記事の更新時点で公式発表を確認できていません。
          推測では書かないため、{info?.officialUrl ? '公式サイト' : '主催者の発表'}で最新の情報をご確認ください。
        </p>
      )}
      {info?.officialUrl && (
        <p class="ev-official"><a href={info.officialUrl} target="_blank" rel="noopener noreferrer">{info.officialName ?? '公式サイト'}で最新情報を見る&nbsp;↗</a></p>
      )}
    </section>
  )}

  {d.keyPoints.length > 0 && (
    <section id="points" aria-labelledby="ev-points">
      <p class="section-number">{no('points')} / KEY POINTS</p>
      <h2 id="ev-points" class="bp-section-title">押さえておきたいこと</h2>
      <ul class="ev-points">{d.keyPoints.map((p) => <li>{p}</li>)}</ul>
    </section>
  )}

  <GrowthNextReads currentPath={`/events/${entry.id.split('/').pop()}/`} pageType="events" />

  {d.highlights.length > 0 && (
    <section id="highlights" aria-labelledby="ev-high">
      <p class="section-number">{no('highlights')} / DETAILS</p>
      <h2 id="ev-high" class="bp-section-title">{highlightLabel}</h2>
      <dl class="ev-list">{d.highlights.map((h) => <div><dt>{h.title}</dt><dd>{h.detail}</dd></div>)}</dl>
    </section>
  )}

  {d.picks.length > 0 && (
    <section id="picks" aria-labelledby="ev-picks">
      <p class="section-number">{no('picks')} / PICKS</p>
      <h2 id="ev-picks" class="bp-section-title">{d.picksHeading ?? '候補'}</h2>
      <div class="ev-picks">{d.picks.map((p) => (
        <article>
          <p class="ev-picks__area">{p.area}</p>
          <h3>{p.url
            ? (p.url.startsWith('/')
                ? <a href={p.url}>{p.name}&nbsp;→</a>
                : <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}&nbsp;↗</a>)
            : p.name}</h3>
          <p class="ev-picks__for">こんな人に：{p.forWhom}</p>
          <p>{p.detail}</p>
        </article>
      ))}</div>
    </section>
  )}

  {d.notes.length > 0 && (
    <section id="notes" aria-labelledby="ev-notes">
      <p class="section-number">{no('notes')} / BEFORE YOU GO</p>
      <h2 id="ev-notes" class="bp-section-title">行く前に</h2>
      <ul class="ev-points">{d.notes.map((n) => <li>{n}</li>)}</ul>
    </section>
  )}

  {d.faq.length > 0 && (
    <section id="faq" aria-labelledby="ev-faq">
      <p class="section-number">{no('faq')} / FAQ</p>
      <h2 id="ev-faq" class="bp-section-title">よくある質問</h2>
      <dl class="ev-list">{d.faq.map((f) => <div><dt>{f.question}</dt><dd>{f.answer}</dd></div>)}</dl>
    </section>
  )}

  {d.booking && <BookingGuide booking={d.booking} pageType="events" municipality={d.municipalities[0]} contentCategory={d.articleType} />}
  <SponsorSlots path={`/events/${entry.id.split('/').pop()}/`} pageType="events" municipality={d.municipalities[0]} />

  <section id="sources" aria-labelledby="ev-src">
    <p class="section-number">{no('sources')} / SOURCES</p>
    <h2 id="ev-src" class="bp-section-title">情報源</h2>
    <ul class="ev-sources">{d.sourceUrls.map((s) => (
      <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}&nbsp;↗</a>{s.accessedAt && <small>（{fmtDate(s.accessedAt)}確認）</small>}</li>
    ))}</ul>
    <p class="ev-caution">開催内容・日程・料金・交通は変更されることがあります。お出かけ前に必ず公式の最新情報をご確認ください。</p>
  </section>
  {/* 本文を読み終えた位置に、地域事業者向けの導線を1つだけ置く */}
  <BusinessCta pageType="events" municipality={d.municipalities[0]} contentCategory={d.articleType} />
    </div>
  </div>

  {(towns.length > 0 || d.relatedArticleUrls.length > 0) && (
    <nav class="ev-discovery bp-wrap bp-section" aria-labelledby="ev-discovery-title" data-event-discovery>
      <p class="bp-kicker">KEEP EXPLORING</p>
      <h2 id="ev-discovery-title" class="bp-section-title">この街から、もう少し</h2>
      <p class="ev-discovery__lead">地域や編集部が明示したつながりだけをまとめています。気になる方向から次の茨城へ。</p>
      <div class="ev-discovery__grid">
        {towns.map((m) => (
          <a class="toco-link-card" href={`/area/${m!.slug}/`} data-discovery-kind="area">
            <span class="toco-link-card__eyebrow">AREA</span>
            <strong>{m!.name}をもっと見る</strong>
            <span>この街のイベント・スポットへ <b aria-hidden="true">→</b></span>
          </a>
        ))}
        {d.relatedArticleUrls.slice(0, 3).map((u) => (
          <a class="toco-link-card" href={u} data-discovery-kind="editorial">
            <span class="toco-link-card__eyebrow">IBATOCO PICK</span>
            <strong>{pickLabel(u)}</strong>
            <span>関連するおでかけ情報へ <b aria-hidden="true">→</b></span>
          </a>
        ))}
        <a class="toco-link-card toco-link-card--all" href="/events/" data-discovery-kind="events-index">
          <span class="toco-link-card__eyebrow">ALL IBARAKI</span>
          <strong>今のおでかけを探す</strong>
          <span>茨城のイベント・おでかけ一覧へ <b aria-hidden="true">→</b></span>
        </a>
      </div>
    </nav>
  )}
  <script>
    import { commonParams, trackEvent } from '../../lib/analytics-events';
    for (const block of document.querySelectorAll<HTMLElement>('[data-event-discovery]')) {
      for (const link of block.querySelectorAll<HTMLAnchorElement>('a[data-discovery-kind]')) {
        link.addEventListener('click', () => {
          trackEvent('next_action_click', {
            ...commonParams({ page_type: 'events' }),
            destination_type: link.dataset.discoveryKind ?? '',
            action_source: 'event_discovery_footer',
            destination_url: link.getAttribute('href') ?? '',
          });
        });
      }
    }
  </script>
</BrandBase>

<style>
  .ev-status{display:inline-flex;align-items:center;margin:1rem 0 0;padding:.3rem .85rem;border-radius:999px;font:700 .8rem var(--font-brand-meta);letter-spacing:.04em}
  .ev-status.is-ended{background:var(--color-mist);color:var(--color-soil)}
  .ev-status.is-today,.ev-status.is-ongoing{background:var(--color-signal,#a63f32);color:#fff}
  .ev-status.is-unconfirmed{background:color-mix(in srgb,var(--color-signal,#a63f32) 10%,#fff);color:var(--color-ink)}
  .ev-status__next{margin:.6rem 0 0;font-size:.88rem}
  .ev-status__next a{color:var(--interior-blue,var(--color-tide));border-bottom:1px solid currentColor}

  /*
   * 本文の基準幅。日本語は1文字＝1emなので em で測る。
   * ch は「0」の字幅＝半角が基準で、56ch と書いても28字にしかならない。
   * 実際 .ev-lead は 1920px 画面で 451px まで潰れ、逆に本文は幅指定が無く
   * 1280px いっぱいに伸びて1行80字を超えていた。両方ここで揃える。
   */
  .ev-head, .ev-body { --ev-measure: 38em; }

  /*
   * 日本語は既定だとどこでも改行できるため、「狩り」が「狩／り」、
   * 「扱わないため」が「扱わ／ないため」のように語の途中で割れる。
   * auto-phrase は文節を見て折るので、これが起きない。
   * 未対応の環境では normal に戻るだけなので、副作用はない。
   */

  /* ニュース記事（.news-detail__layout）と同じ作り。左に目次、右に本文。 */
  .ev-layout{display:grid;grid-template-columns:210px minmax(0,700px);justify-content:center;gap:clamp(2rem,6vw,5rem);padding-block:clamp(3.5rem,7vw,6rem)}
  .ev-toc{position:sticky;top:1rem;align-self:start;padding-top:.5rem;color:var(--color-soil);font-size:.72rem}
  .ev-toc>p{padding-bottom:.65rem;border-bottom:1px solid var(--color-mist);font-weight:700;color:var(--color-ink)}
  .ev-toc ol{display:grid;grid-template-columns:minmax(0,1fr);gap:.5rem;margin-top:.75rem;padding-left:1.2rem;list-style:decimal}
  .ev-toc a:hover{color:var(--color-tide)}
  .ev-body section{scroll-margin-top:1rem}
  .ev-body section+section{margin-top:4rem;padding-top:3rem;border-top:1px solid var(--color-mist)}
  .ev-body h2{margin-top:.6rem}
  @media(max-width:760px){.ev-layout{grid-template-columns:minmax(0,1fr)}.ev-toc{position:static}}

  .ev-head h1{margin-top:.8rem;font:600 clamp(1.9rem,4vw,3rem)/1.4 var(--font-brand-display);color:var(--color-ink)}
  .ev-lead{margin-top:1.5rem;font-size:1.02rem;line-height:2.05;color:var(--color-soil)}
  .ad-disclosure{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin-top:1rem;padding:.45rem .7rem;border:1px solid var(--interior-line,var(--color-mist));border-radius:.5rem;background:var(--interior-sky-soft,#eef6ff);color:var(--color-soil);font-size:.76rem;line-height:1.7;width:max-content;max-width:100%}
  .ad-disclosure__tag{font-weight:700;color:var(--color-ink)}
  .ev-meta{margin-top:1rem;color:var(--color-soil);font:.74rem var(--font-brand-meta)}
