---
/**
 * 法人・自治体向けの窓口（BtoB 受託：コンサル・Web制作・SNS運用）。
 * 仕様 docs/editorial/specs/20261123-biz-b2b-redesign.md、方針 docs/REVENUE_OS.md「事業方針（2026-11-23）」。
 * - 料金の正本は src/data/services.ts。ここに数字を直接書かない
 * - 「実例」はイバトコ自身の運営の実データだけ。ビルド時にスナップショットから出し、取れない値は出さない（0で埋めない）
 * - 受託の取引実績はまだ無い。架空の実績・取引先・推薦文を載せない
 */
import { getCollection } from 'astro:content';
import BrandBase from '../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { SERVICE_PLANS, SERVICE_TERMS, type ServicePlan } from '../data/services';
import { yen } from '../data/sponsorship';
import performance from '../../data/editorial/performance-snapshot.json';

const perf: any = performance;
const views28: number | null = perf?.windows?.ga4?.recent28?.views ?? null;
const ai: any = perf?.aiReferrals ?? null;
const aiNow: number | null = ai?.recent28?.sessions ?? null;
const aiPrev: number | null = ai?.previous28?.sessions ?? null;
const aiRatio = aiNow != null && aiPrev ? aiNow / aiPrev : null;
const asOf: string | null = perf?.asOf ?? null;
const published = (entry: any) => entry.data.draft !== true && entry.data.noindex !== true && entry.data.sample !== true;
const articleCount = (await getCollection('events')).filter(published).length + (await getCollection('news')).filter(published).length;
const fmt = (n: number) => n.toLocaleString('ja-JP');

const facts = [
  { label: '対象の市町村', value: '44', note: '茨城県のすべての市町村を一人＋AIで運営' },
  { label: '公開中の記事', value: fmt(articleCount), note: '公式の一次情報で確認して掲載' },
  ...(views28 != null ? [{ label: '直近28日のページビュー', value: fmt(views28), note: asOf ? `${asOf}までのGA4の実測` : 'GA4の実測' }] : []),
  ...(aiNow != null ? [{ label: 'AI検索からの訪問（28日）', value: fmt(aiNow), note: aiRatio != null ? `前の28日の${aiRatio.toFixed(1)}倍（ChatGPT・Geminiなど）` : 'ChatGPT・Geminiなど' }] : []),
];

const systems = [
  { title: '公式情報の自動監視', body: '自治体・観光協会・施設など約60の公式サイトを毎朝確認し、新しい告知だけを編集の候補に上げます。' },
  { title: '毎日の分析と改善', body: '検索・AI検索・アクセスの数字を毎朝取り込み、改善した施策の効果を期間を決めて判定します。' },
  { title: '事実確認の仕組み', body: '日付・料金・運行などは公式の一次情報で確認し、公開前に自動の検査を通します。' },
];

const groups: { keys: ServicePlan['group'][]; label: string }[] = [
  { keys: ['consult'], label: 'コンサル' },
  { keys: ['build', 'run', 'custom'], label: '制作・運用・自治体向け' },
];
const price = (plan: ServicePlan) => (plan.price == null ? '個別見積' : `${yen(plan.price)}${plan.from ? '〜' : ''}`);

const steps = [
  ['相談', 'フォームから、現状と目的をお送りください。'],
  ['現状診断', '検索・AI検索・発信の現状を確認し、何から直すべきかを整理します。'],
  ['提案・見積', '範囲・期間・費用を事前にお伝えします。合意いただいてから始めます。'],
  ['実施', '決めた範囲で、改善・制作・運用を進めます。'],
  ['月次の改善', '数字を見て、次に直すことを決めます。'],
];

const faqs = [
  { q: '茨城県外でも依頼できますか', a: '全国から承ります。打ち合わせはオンラインが中心です。' },
  { q: '成果は保証されますか', a: '検索順位・売上・AI検索での引用などの成果は保証しません。検索サービスの仕組みはこちらで決められないためです。その代わり、数字で現状と変化をお見せし、改善を続けます。' },
  { q: '範囲外のことも頼めますか', a: 'はい。上限を超える作業や、現地での取材・撮影・追加の制作は、協力者と連携して対応します（別途お見積もり）。' },
  { q: '依頼すると、イバトコの記事で紹介されますか', a: 'いいえ。ご依頼と編集記事は切り離しています。取引のある事業者を記事で扱うときは、その関係を明示し、記事の内容や評価は変えません。' },
];

const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: '法人・自治体の方へ' }];
const site = Astro.site?.origin ?? 'https://ibatoco.jp';
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'イバトコ',
  url: `${site}/biz/`,
  areaServed: { '@type': 'Country', name: '日本' },
  description: '検索・AI検索で見つけられ、選ばれる情報発信のコンサル、Web制作、SNS運用。',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: '提供サービス',
    itemListElement: SERVICE_PLANS.map((plan) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: plan.name, description: plan.summary },
      ...(plan.price != null ? { priceSpecification: { '@type': 'PriceSpecification', price: plan.price, priceCurrency: 'JPY', valueAddedTaxIncluded: false } } : {}),
    })),
  },
};
const contact = '/contact/?subject=法人・自治体のご相談';
---
<BrandBase title="情報発信のコンサル・Web制作・SNS運用｜法人・自治体の方へ｜イバトコ" description="検索とAI検索で見つけられ、選ばれる情報発信を。茨城44市町村のメディアを一人＋AIで運営するイバトコが、コンサル・Web制作・SNS運用で支援します。全国対応。" jsonLd={[breadcrumbJsonLd(crumbs, Astro.site), serviceJsonLd]}>
  <header class="biz-head v42-hero bp-wrap">
    <Breadcrumbs items={crumbs} />
    <img class="v42-hero__art" src="/images/v42/kasama-market-print.webp" alt="" width="960" height="640" decoding="async" />
    <p class="bp-kicker">FOR COMPANIES &amp; LOCAL GOVERNMENTS</p>
    <h1>見つけられ、<br />選ばれる仕組みを。</h1>
    <p>AI検索の時代に、地域と事業の情報が正しく見つかり、選ばれる状態をつくります。自治体・観光協会・観光事業者・地方の企業の方へ、コンサル・Web制作・SNS運用でお手伝いします。全国対応です。</p>
    <a class="biz-head__cta" href={contact} data-biz-service="hero">相談する →</a>
    <p class="biz-head__selfservice">イバトコへの掲載候補・営業時間などの修正だけなら、<a href="/submit/#business">情報送信フォーム</a>から無料で送れます。</p>
    <p class="biz-head__sponsor">イバトコへの広告・タイアップは <a href="/sponsor/">スポンサーのご案内</a> をご覧ください。</p>
  </header>

  <section class="proof bp-wrap bp-section" aria-labelledby="biz-proof">
    <p class="bp-kicker">CASE: IBATOCO</p>
    <h2 id="biz-proof">実例は、このメディアです。</h2>
    <p class="proof__lead">イバトコは、茨城県の44市町村を一人とAIで運営している地域メディアです。ご提案する方法は、まずここで試し、数字で確かめています。以下は自社メディアの運営の実データで、受託の取引実績ではありません。</p>
    <dl class="proof__facts">
      {facts.map((fact) => (
        <div><dt>{fact.label}</dt><dd>{fact.value}</dd><dd class="proof__note">{fact.note}</dd></div>
      ))}
    </dl>
    <ul class="proof__systems">
      {systems.map((item) => <li><h3>{item.title}</h3><p>{item.body}</p></li>)}
    </ul>
  </section>

  <section id="price" class="price"><div class="bp-wrap">
    <p class="bp-kicker">SERVICES &amp; PRICE</p>
    <h2>サービスと料金</h2>
    <p class="price__lead">中身と範囲を決めたプランです。範囲を超えることも、協力者と連携してお受けします。</p>
    {groups.map((group) => {
      const plans = SERVICE_PLANS.filter((plan) => group.keys.includes(plan.group));
      return plans.length > 0 && (
        <>
          <h3 class="price__group">{group.label}</h3>
          <div class="price__grid">{plans.map((plan) => (
            <article id={plan.id}>
              <h4>{plan.name}</h4>
              <p class="price__amount"><strong>{price(plan)}</strong>{plan.price != null && <span>／{plan.unit}（税別）</span>}</p>
              {plan.terms && <p class="price__terms">{plan.terms}</p>}
              <p class="price__summary">{plan.summary}</p>
              <ul>{plan.includes.map((line) => <li>{line}</li>)}</ul>
            </article>
          ))}</div>
        </>
      );
    })}
    <ul class="price__note">{SERVICE_TERMS.map((line) => <li>{line}</li>)}</ul>
    <a class="price__cta" href={contact} data-biz-service="price">料金について相談する <span aria-hidden="true">→</span></a>
  </div></section>

  <section class="flow bp-wrap bp-section" aria-labelledby="biz-flow">
    <p class="bp-kicker">HOW WE WORK</p>
    <h2 id="biz-flow">進め方</h2>
    <ol>{steps.map(([title, body]) => <li><strong>{title}</strong><span>{body}</span></li>)}</ol>
  </section>

  <section class="separation"><div class="bp-wrap"><p class="bp-kicker">TRANSPARENCY</p><h2>Editorial、Partner、PRを混ぜない。</h2><div class="types"><article><span>EDITORIAL</span><h3>編集記事</h3><p>掲載対価を受けず、編集部の判断で企画・取材・編集します。</p></article><article><span>PARTNER</span><h3>受託の支援</h3><p>コンサル・制作・運用に対価をいただく仕事です。取引先を記事で扱うときは関係を明示し、評価は変えません。</p></article><article><span>PR</span><h3>広告・タイアップ</h3><p>広告主の依頼によるコンテンツです。読者が判別できるよう明確に表示します。</p></article></div><a href="/about/pr-policy/">PR・広告の方針を読む →</a></div></section>

  <section class="faq bp-wrap bp-section" aria-labelledby="biz-faq">
    <p class="bp-kicker">FAQ</p>
    <h2 id="biz-faq">よくある質問</h2>
    <dl>{faqs.map((item) => <div><dt>{item.q}</dt><dd>{item.a}</dd></div>)}</dl>
  </section>

  <section class="biz-cta bp-reading"><p class="bp-kicker">CONTACT</p><h2>まず、現状を聞かせてください。</h2><p>何から頼めばいいか決まっていなくても構いません。現状と目的をうかがい、必要なことと不要なことを整理します。</p><a href={contact} data-biz-service="footer">相談する →</a></section>
</BrandBase>
<style>
  .biz-head{padding-block:clamp(5rem,11vw,10rem);border-bottom:1px solid var(--color-mist)}.biz-head h1{margin-top:1rem;font:600 clamp(2.7rem,7vw,6rem)/1.2 var(--font-brand-display);color:var(--color-ink)}.biz-head>p:not(.bp-kicker){max-width:var(--measure);margin-top:2rem;line-height:2;color:var(--color-soil)}
  .biz-head__cta{justify-self:start;width:fit-content;display:inline-flex;align-items:center;min-height:44px;margin-top:2rem;padding:.6rem 1.5rem;border-radius:999px;background:var(--interior-blue,var(--color-tide));color:#fff;font-weight:700;text-decoration:none}
  .biz-head__cta:hover,.biz-head__cta:focus-visible{background:var(--color-ink)}
  .biz-head .biz-head__selfservice,.biz-head .biz-head__sponsor{margin-top:1.2rem;color:var(--color-soil);font-size:.9rem;line-height:1.9}.biz-head__selfservice a,.biz-head__sponsor a{color:var(--color-tide);border-bottom:1px solid}
  .proof h2,.flow h2,.faq h2,.price h2,.separation h2,.biz-cta h2{margin-top:1rem;font:600 clamp(2rem,5vw,4rem)/1.35 var(--font-brand-display);color:var(--color-ink);text-wrap:balance}
  .proof__lead{max-width:var(--measure);margin-top:1.4rem;line-height:2;color:var(--color-soil)}
  .proof__facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr));gap:1rem;margin:2.2rem 0 0}
  .proof__facts>div{padding:1.1rem 1.2rem;border:1px solid var(--color-mist);border-radius:.85rem;background:var(--color-white)}
  .proof__facts dt{color:var(--color-soil);font-size:.82rem}
  .proof__facts dd{margin:.3rem 0 0;font:600 2rem/1.2 var(--font-brand-display);color:var(--color-ink);font-variant-numeric:tabular-nums}
  .proof__facts dd.proof__note{font:400 .8rem/1.7 var(--font-brand-body,inherit);color:var(--color-soil)}
  .proof__systems{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));gap:1.5rem;margin-top:2.2rem;padding:0;list-style:none}
  .proof__systems li{padding-top:1rem;border-top:1px solid var(--color-tide)}
  .proof__systems h3{font:600 1.2rem/1.5 var(--font-brand-display);color:var(--color-ink)}
  .proof__systems p{margin-top:.6rem;color:var(--color-soil);font-size:.88rem;line-height:1.9}
  .price{padding-block:clamp(4rem,9vw,7rem);border-top:1px solid var(--color-mist);background:var(--color-white)}
  .price__lead{max-width:var(--measure);margin-top:1.4rem;line-height:2;color:var(--color-soil)}
  .price__group{margin-top:2.6rem;font:600 1.25rem/1.5 var(--font-brand-display);color:var(--color-ink)}
  .price__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));gap:1.25rem;margin-top:1.1rem}
  .price__grid article{display:flex;flex-direction:column;padding:1.3rem;border:1px solid var(--color-mist);border-radius:.85rem;background:var(--color-paper)}
  .price__grid h4{font:600 1.1rem/1.5 var(--font-brand-display);color:var(--color-ink)}
  .price__amount{display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem;margin-top:.6rem}
  .price__amount strong{font:600 1.7rem/1.2 var(--font-brand-display);color:var(--color-ink);font-variant-numeric:tabular-nums}
  .price__amount span{color:var(--color-soil);font-size:.84rem}
  .price__terms{margin-top:.3rem;color:var(--color-tide);font-size:.8rem;font-weight:700}
  .price__summary{margin-top:.7rem;color:var(--color-soil);font-size:.88rem;line-height:1.85}
  .price__grid ul{display:grid;gap:.4rem;margin-top:.8rem;padding-left:1.1rem;list-style:disc}
  .price__grid li{color:var(--color-soil);font-size:.84rem;line-height:1.75}
  .price__note{display:grid;gap:.4rem;max-width:var(--measure);margin-top:1.8rem;padding-left:1.1rem;list-style:disc}
  .price__note li{color:var(--color-soil);font-size:.84rem;line-height:1.85}
  .price__cta{display:inline-flex;align-items:center;gap:.6rem;min-height:3.1rem;margin-top:1.5rem;padding:.75rem 1.4rem;border-radius:999px;background:var(--color-tide);color:#fff;font-weight:700}
  .flow ol{display:grid;margin-top:2rem;padding:0;list-style:none;counter-reset:step;border-top:1px solid var(--color-mist)}
  .flow li{display:grid;grid-template-columns:2.2rem minmax(0,1fr);gap:.2rem .9rem;padding:.9rem 0;border-bottom:1px solid var(--color-mist);counter-increment:step}
  .flow li:before{content:counter(step);grid-row:span 2;display:grid;place-items:center;width:2.2rem;height:2.2rem;border:1px solid var(--color-tide);border-radius:50%;color:var(--color-tide);font:700 .85rem var(--font-brand-meta)}
  .flow strong{color:var(--color-ink)}
  .flow span{color:var(--color-soil);font-size:.88rem;line-height:1.8}
  .separation{padding-block:clamp(4rem,9vw,7rem);background:var(--color-white)}
  .separation .bp-wrap>a,.biz-cta>a{display:inline-block;margin-top:2rem;color:var(--color-tide);border-bottom:1px solid}
  .types{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));gap:2rem;margin-top:3rem}.types article{padding-top:1rem;border-top:1px solid var(--color-tide)}.types span{font:.68rem var(--font-brand-meta);letter-spacing:.12em;color:var(--color-tide)}.types h3{margin-top:.6rem;font:600 1.4rem var(--font-brand-display);color:var(--color-ink)}.types p{margin-top:.7rem;line-height:1.9;color:var(--color-soil);font-size:.88rem}
  .faq dl{margin:2rem 0 0;border-top:1px solid var(--color-mist)}
  .faq dl>div{padding:1.1rem 0;border-bottom:1px solid var(--color-mist)}
  .faq dt{font:600 1rem/1.6 var(--font-brand-display);color:var(--color-ink)}
  .faq dd{margin:.45rem 0 0;color:var(--color-soil);font-size:.9rem;line-height:1.85}
  .biz-cta{container-type:inline-size;padding-block:clamp(5rem,11vw,9rem)}.biz-cta>p:not(.bp-kicker){margin-top:1.5rem;color:var(--color-soil)}
  /* 「まず、現状を聞かせてください。」（15字）を狭い幅で崩さない */
  .biz-cta h2{font-size:min(clamp(2rem,5vw,4rem),calc(100cqi / 10))}
  @media(max-width:360px){.biz-head h1{font-size:1.8rem;line-height:1.4}}
</style>
<script>
  import { rememberCtaOrigin, trackEvent } from '../lib/analytics-events';
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-biz-service]')) {
    link.addEventListener('click', () => {
      const service = link.dataset.bizService ?? '';
      rememberCtaOrigin({ cta_type: 'service_' + service, cta_location: 'biz_service', cta_page_type: 'biz', cta_origin_path: window.location.pathname });
      trackEvent('business_cta_click', { cta_type: 'service_' + service, cta_location: 'biz_service', cta_page_type: 'biz', link_url: link.getAttribute('href') ?? '' });
    });
  }
</script>
