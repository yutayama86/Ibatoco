---
import BrandBase from '../../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { VISIBLE_GUIDES as GUIDES } from '../../data/guides';

const guides = [...GUIDES].sort((a, b) => new Date(b.publishedAt).valueOf() - new Date(a.publishedAt).valueOf());
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: 'ガイド' }];
---

<BrandBase
  title="茨城のまとめ・モデルコース｜デート・雨の日・休日プラン"
  description="水戸デート、茨城の雨の日、大洗の休日プランなど。イバトコが目的別に巡り方をまとめた、茨城のモデルコース集です。"
  noindex={guides.length === 0}
 jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <section class="wrap section">
    <header class="guide-index-head">
      <Breadcrumbs items={crumbs} />
      <p class="bp-kicker">Field Guide</p>
      <h1 class="bp-title page-title">現地を歩いた記録から、<br />一日の巡り方を編む。</h1>
      <p class="page-lead">公開情報と現地確認が揃ったものから、テーマ別のガイドとして届けます。まだ確かめられていない場所を、数合わせで載せることはしません。</p>
    </header>

    {guides.length > 0 ? (
      <ul class="gl-grid">
        {guides.map((g) => (
          <li data-reveal>
            <a href={`/guide/${g.slug}/`} class="gl-card">
              <div class="gl-card-top">
                <span class="gl-eyebrow latin">MODEL COURSE</span>
                <span class="gl-count">{g.steps.length} spots</span>
              </div>
              <h2 class="display gl-title">{g.title}</h2>
              <p class="gl-lead mincho">{g.lead}</p>
              <ul class="gl-tags">
                {g.tags.slice(0, 4).map((t) => <li>#{t}</li>)}
              </ul>
              <span class="gl-more">コースを見る <span class="arw" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="gl-empty" data-reveal><p>現在、公開できるガイドを取材・確認しています。</p><a href="/area/" class="bp-link">街の記録から探す</a></div>
    )}
  </section>
</BrandBase>

<style>
  .section { padding-block: clamp(3rem, 7vw, 5rem); }
  .page-title { font-size: var(--step-4); margin: 0.5rem 0; }
  .page-lead { font-size: var(--step-1); color: var(--color-slate); line-height: 1.9; max-width: 45rem; margin-bottom: 3rem; }

  .gl-empty { display:grid; gap:1rem; justify-items:start; color:var(--color-slate); font-size: var(--step-1); padding:2rem 0; border-top:1px solid var(--color-line); }
  .gl-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1.5rem, 3vw, 2.2rem); }
  .gl-card { display: grid; gap: 0.7rem; padding: clamp(1.6rem, 3.5vw, 2.4rem); border: 1px solid var(--color-line);
    background: var(--color-paper); position: relative; overflow: hidden;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease), box-shadow 0.25s var(--ease); }
  .gl-card::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--color-tide); }
  .gl-card:hover { border-color: var(--color-tide); transform: translateY(-3px); }
  .gl-card-top { display: flex; justify-content: space-between; align-items: center; }
  .gl-eyebrow { letter-spacing: 0.16em; font-size: var(--step--2); color: var(--_c); font-weight: 700; }
  .gl-count { font-size: var(--step--1); color: var(--ink-mute); font-family: var(--font-latin); }
  .gl-title { font-size: var(--step-2); line-height: 1.35; }
  .gl-lead { color: var(--ink-soft); font-size: var(--step-0); line-height: 1.8; }
  .gl-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.3rem; }
  .gl-tags li { font-size: var(--step--2); color: var(--ink-mute); }
  .gl-more { margin-top: 0.6rem; font-size: var(--step--1); font-weight: 700; color: var(--_c); }

  @media (max-width: 720px) { .gl-grid { grid-template-columns: minmax(0,1fr); } }
</style>
