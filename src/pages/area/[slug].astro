---
import type { GetStaticPaths } from 'astro';
import { CARD_IMAGES } from '../../data/card-images';
import BrandBase from '../../layouts/BrandBase.astro';
import BrandStoryCard from '../../components/BrandStoryCard.astro';
import NewsCard from '../../components/NewsCard.astro';
import HitachiAreaGuide from '../../components/HitachiAreaGuide.astro';
import DaigoAreaGuide from '../../components/DaigoAreaGuide.astro';
import AreaGuide from '../../components/AreaGuide.astro';
import { AREA_GUIDES, type AreaGuide as AreaGuideData } from '../../data/area-guides';
import { MUNICIPALITY_CONTENT } from '../../data/municipality-content';
import { MUNICIPALITIES, MUNI_BY_SLUG, REGIONS, municipalitiesByRegion } from '../../data/areas';
import { getPublishedArticles, getPublishedStores, getIndexableNews, getEventsByMunicipality } from '../../lib/content';
import { themesForArea } from '../../data/themes';
import { lifecycleOf } from '../../lib/lifecycle';
import ArticleNextSteps from '../../components/ArticleNextSteps.astro';
import { getHappeningsForMunicipality } from '../../lib/happenings';
import { businessesInMunicipality } from '../../data/businesses';
import { michinoekiForArea } from '../../data/michinoeki';
import { areaToSlug } from '../../data/areas';

export const getStaticPaths = (() => MUNICIPALITIES.map((municipality) => ({ params: { slug: municipality.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const municipality = MUNI_BY_SLUG.get(slug!);
if (!municipality) return Astro.redirect('/404');
const region = REGIONS[municipality.region];
const [allArticles, allStores] = await Promise.all([getPublishedArticles(), getPublishedStores()]);
const articles = allArticles.filter((article) => areaToSlug(article.data.area) === slug);
const stores = allStores.filter((store) => areaToSlug(store.data.area) === slug);
const neighbors = municipalitiesByRegion(municipality.region).filter((item) => item.slug !== slug);
// この街を扱ったニュース解説。記事側の municipalities から自動で拾う。
// 記事URLの一覧を手で持たないので、記事を1本足せばこの街のページが自動で厚くなる。
// 該当が無い街ではセクションごと出さない（空の見出しを作らない）。
const areaNews = (await getIndexableNews())
  .filter((item) => item.data.municipalities.includes(slug!))
  .slice(0, 8);
// この街のイベント。開催が近い順。終わったものは出さない
const areaEvents = (await getEventsByMunicipality(slug!))
  .filter((e) => {
    // 日付で落とすのは、開催日の決まっている催し（articleType: 'event'）だけ。
    // ガイドや開業情報の startDate は「情報の基準日」なので、
    // 同じ条件で落とすと、通年で使える記事が翌日から街のページに出なくなる。
    return lifecycleOf(e) !== 'ended';
  })
  // その街に固有の記事を先に出す。県全体のまとめ記事は startDate を持たず
  // pubDate で並ぶため、そのままだと個別の催しを押し出して
  // 「◯◯のイベント」にその街のものが1本も出ない、という状態になる。
  // 同じ市町村数どうしの並び（開催が近い順）は、sortが安定なので保たれる。
  .sort((a, b) => a.data.municipalities.length - b.data.municipalities.length)
  .slice(0, 6);
const eventPath = (id: string) => `/events/${id.split('/').pop()}/`;
const eventDate = (x: Date) => new Intl.DateTimeFormat('ja-JP', { month: 'long', day: 'numeric', weekday: 'short' }).format(x);
// ニュース解説もこの街の記録に数える。数えないと、記事があるのに
// 「まだありません」と出てしまう。
const hasContent = articles.length + stores.length + areaNews.length + areaEvents.length > 0;
// 日立市＝出典・CCクレジット付きで作り込んだ旗艦ガイド（指示書 v1.0＋追補v1.1）。index。
// 最終バッチ18市町村＝データ駆動の旅ガイド（text-forward）。「要確認」項目の人手検証まで noindex。
// 残り25市町村は取材記事が付くまでミニマル表示（架空情報で埋めない）。
const isHitachi = slug === 'hitachi';
const isDaigo = slug === 'daigo';
// テーマ軸への戻り導線。テーマ側がこの街を挙げている場合だけ出す（関係は必ず対称）。
const relatedThemes = themesForArea(slug!);
// この街にある道の駅（公式一覧で確認済みのものだけ）
const areaMichinoeki = michinoekiForArea(slug!);
// この街で今週あること（イベント・ホームゲーム・季節もの）。無ければ出さない
const areaThisWeek = await getHappeningsForMunicipality(slug!);
// この街の店舗・施設。実在を確認して登録したものだけ
const areaBusinesses = businessesInMunicipality(slug!);
// 指示書のあるガイド（日立＝別コンポーネント）はそれを使用。
// 現在は43市町村にガイドがあり、日立は専用コンポーネントなので、この分岐は実質通らない。
// ガイドが無い市町村を足したときのフォールバックとして残している。
// なお municipality-content.ts 自体は、TOPのエリアマップ（HomeAreaExplorer）が使う。
const explicitGuide = AREA_GUIDES[slug!];
const mc = !explicitGuide && !isHitachi ? MUNICIPALITY_CONTENT[slug!] : undefined;
const basicGuide: AreaGuideData | undefined = mc && (mc.catch || mc.spots?.length)
  ? {
      catch: mc.catch ?? '',
      lead: mc.intro ? [mc.intro] : [],
      highlights: (mc.spots ?? []).map((s) => ({ title: s.name, text: s.desc })),
      tastes: mc.gourmet?.length ? mc.gourmet.map((g) => ({ title: g.name, text: g.desc })) : undefined,
      experiences: mc.experiences?.length ? mc.experiences.map((e) => ({ title: e.name, text: e.desc })) : undefined,
      metaDescription: `茨城県${municipality.name}の見どころ。${(mc.spots ?? []).map((s) => s.name).slice(0, 3).join('、')}${mc.spots?.length ? 'など' : ''}を、公開情報をもとに編集して紹介します。`,
      checkedAt: '2026年8月7日',
    }
  : undefined;
const guide = explicitGuide ?? basicGuide;
const hasGuide = !!guide;
// タイトル後半は実際にあるセクションだけを約束する（簡略ページで食・半日コースを謳わない）。
const titleSuffix = guide
  ? guide.titleSuffix ?? [
      '見どころ',
      (guide.tastes?.length || guide.tasteNote) ? '食' : null,
      guide.route?.length ? '半日コース' : null,
    ].filter(Boolean).join('・')
  : '見どころ・食・半日コース';
const metaDescription = isHitachi
  ? '茨城県日立市の歩き方。海に張り出した日立駅、山岳信仰の御岩神社、桜と夜景のかみね公園、世界一だった大煙突。久慈浜しらすと味勝手丼、半日モデルコースまで。'
  : isDaigo
    ? '茨城県大子町の歩き方。高さ120m幅73mの袋田の滝と冬の氷瀑、裏見の月待の滝、奥久慈しゃも・常陸秋そば・奥久慈りんご。半日モデルコースとアクセス、よくある質問まで。'
  : hasGuide
    ? guide.metaDescription
    : `茨城県${municipality.name}の、取材・確認を経た記事と場所の情報。イバトコが現地の人と営みを記録します。`;
const pageTitle = isHitachi
  ? '日立市の歩き方｜見どころ・食・半日コース｜イバトコ'
  : isDaigo
    ? '大子町の歩き方｜袋田の滝と奥久慈・半日コース｜イバトコ'
  : hasGuide
    ? guide.pageTitle ?? `${municipality.name}の歩き方｜${titleSuffix}｜イバトコ`
    : `${municipality.name}｜茨城の街を読む｜イバトコ`;
const ogTitle = isHitachi ? '日立市の歩き方｜海の駅と、桜の山｜イバトコ' : isDaigo ? '大子町の歩き方｜四度の滝と、奥久慈の実り｜イバトコ' : undefined;
// noindex 方針：
//  ・日立（旗艦）＝index。
//  ・公式出典で裏取り済みの執筆ページ（guide.sources あり＝水戸・つくば等25）＝index解除。
//  ・最終バッチ18（sources なし／「要確認」項目が残る）＝人手検証まで noindex 維持。
//  ・ガイドなし（記事が付くまで）＝noindex。
const isVerifiedGuide = hasGuide && !!guide?.sources?.length;
const shouldNoindex = (isHitachi || isDaigo) ? false : isVerifiedGuide ? false : hasGuide ? true : !hasContent;
// 構造化データ（44ページ共通・既存データから導出／創作なし）。
// TouristDestination＋各見どころのTouristAttraction、半日コースのItemList、BreadcrumbList。
const hitachiHighlights = ['日立駅', '御岩神社', 'かみね公園', '大煙突'];
const hitachiRoute: [string, string][] = [['10:00', '日立駅'], ['10:40', '平和通り'], ['11:20', 'かみね公園'], ['12:40', '市街へ戻る']];
const daigoHighlights = ['袋田の滝', '月待の滝', '生瀬滝', '奥久慈の実り（りんご・そば）'];
const daigoRoute: [string, string][] = [['09:30', '袋田の滝'], ['10:30', '生瀬滝'], ['12:00', 'そば処で昼食'], ['13:30', '月待の滝']];
// AIO/SEO：大子町のFAQ（DaigoAreaGuideの表示内容と一致）。FAQPage構造化データに使用。
const daigoFaq: [string, string][] = [
  ['袋田の滝の高さと大きさは？', '高さ120メートル、幅73メートルです。大岩壁を四段に落ちることから「四度（よど）の滝」とも呼ばれ、日本三名瀑のひとつ、国の名勝に数えられます。'],
  ['袋田の滝の氷瀑（凍った滝）はいつ見られますか？', '例年12月下旬から2月ごろの厳冬期に凍ることがあります。ただし凍り方はその年の寒さ次第で、見られない年もあります。凍結状況は大子町観光協会の情報でご確認ください。'],
  ['大子町の名物・味覚は？', '奥久慈しゃも（ブランド地鶏）、常陸秋そば、奥久慈りんごが知られます。秋にはりんご狩りや、そば処の新そばが楽しめます。'],
  ['袋田の滝へのアクセスは？', 'JR水郡線・袋田駅が最寄りで、滝まではバスやタクシーが便利です。車の場合は常磐自動車道・那珂ICから国道118号を経由します。観瀑台へはトンネルを通り、入場料が必要です。'],
];
const attractionNames = isHitachi ? hitachiHighlights : isDaigo ? daigoHighlights : (guide?.highlights.map((h) => h.title) ?? []);
const routeSteps: [string, string][] = isHitachi ? hitachiRoute : isDaigo ? daigoRoute : (guide?.route?.map((r) => [r.time, r.place] as [string, string]) ?? []);
const routeName = isHitachi ? '海から高台へ、半日の歩き方。' : isDaigo ? '滝から、山里へ。' : guide?.routeTitle;
const homeUrl = new URL('/', Astro.site).href;
const areaUrl = new URL('/area/', Astro.site).href;
const pageUrl = new URL(`/area/${slug}/`, Astro.site).href;
const jsonLd: Record<string, unknown>[] = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'エリア', item: areaUrl },
    { '@type': 'ListItem', position: 3, name: region.label },
    { '@type': 'ListItem', position: 4, name: municipality.name, item: pageUrl },
  ] },
  { '@context': 'https://schema.org', '@type': 'TouristDestination', name: `茨城県${municipality.name}`, description: metaDescription, url: pageUrl,
    containedInPlace: { '@type': 'AdministrativeArea', name: '茨城県' },
    ...(isDaigo ? { image: new URL('/images/area/daigo/cover.jpg', Astro.site).href } : {}),
    ...(attractionNames.length ? { includesAttraction: attractionNames.map((n) => ({ '@type': 'TouristAttraction', name: n })) } : {}),
  },
  ...(routeSteps.length ? [{ '@context': 'https://schema.org', '@type': 'ItemList', name: routeName,
    itemListElement: routeSteps.map(([t, p], i) => ({ '@type': 'ListItem', position: i + 1, name: `${t} ${p}` })) }] : []),
  ...(isDaigo ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: daigoFaq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }] : []),
];
---

<BrandBase title={pageTitle} ogTitle={ogTitle} description={metaDescription} jsonLd={jsonLd} noindex={shouldNoindex}>
  {isHitachi ? <HitachiAreaGuide /> : isDaigo ? <DaigoAreaGuide /> : hasGuide ? <AreaGuide slug={slug!} guide={guide!} /> : <article class="area-page">
    <header class="area-head bp-wrap">
      <nav class="crumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href="/area/">エリア</a><span>/</span><span>{region.label}</span></nav>
      <p class="bp-kicker">{region.label} / IBARAKI</p>
      <h1>{municipality.name}</h1>
      <p class="area-lead">この街で出会った人、場所、営みを、確認できた情報から記録します。</p>
      <a class="map-back" href="/area/">44市町村の地図に戻る →</a>
    </header>

    {hasContent ? <div class="area-content bp-wrap">
      {articles.length > 0 && <section><p class="bp-kicker">STORIES</p><h2 class="bp-section-title">{municipality.name}で聞いた物語</h2><div class="story-grid">{articles.map((article) => <BrandStoryCard article={article} />)}</div></section>}
      {stores.length > 0 && <section><p class="bp-kicker">PLACES</p><h2 class="bp-section-title">確認できた場所</h2><ul class="place-list">{stores.map((store) => <li><a href={`/place/${store.id}/`}><span><small>{store.data.category}</small><strong>{store.data.name}</strong><span>{store.data.tagline}</span></span><span aria-hidden="true">→</span></a></li>)}</ul></section>}
    </div> : <section class="area-empty bp-reading"><p class="bp-kicker">FIELD NOTE</p><h2>この街の記録は、これから。</h2><p>公開確認済みの記事・場所はまだありません。架空のおすすめや未確認情報では埋めず、現地で確認できた内容から掲載します。</p><a href="/contact/">この街の“いいとこ”を教える →</a>
      {/* 行き止まりにしない。近い街とテーマへ戻れるようにする（既存の部品を再利用） */}
      <ArticleNextSteps municipalities={[slug!]} pageType="news" />
    </section>}

  </article>}

  {/* ここから下は44市町村すべてで出す。ガイドの有無で分かれる三項の外に置く */}
    {areaThisWeek.length > 0 && (
      <section class="area-week bp-wrap" aria-labelledby="area-week-h">
        <p class="bp-kicker">THIS WEEK</p>
        <h2 id="area-week-h" class="bp-section-title">{municipality.name}で、今週できること</h2>
        <ul class="area-week__list">
          {areaThisWeek.map((h) => (
            <li><a href={h.href}>
              <span class="area-week__meta"><time>{h.dateLabel}</time></span>
              <strong>{h.title}</strong>
            </a></li>
          ))}
        </ul>
      </section>
    )}

    {areaBusinesses.length > 0 && (
      <section class="area-biz bp-wrap" aria-labelledby="area-biz-h">
        <p class="bp-kicker">PLACES</p>
        <h2 id="area-biz-h" class="bp-section-title">{municipality.name}の店・施設</h2>
        <ul class="area-biz__list">
          {areaBusinesses.map((b) => (
            <li>
              <div class="area-biz__body">
                <strong>{b.name}</strong>
                {b.description && <p>{b.description}</p>}
                {b.verifiedAt && <span class="area-biz__checked">{b.verifiedAt} 時点の公開情報で確認</span>}
              </div>
              {b.officialUrl && <a href={b.officialUrl} target="_blank" rel="noopener noreferrer" data-business-id={b.id} data-business-name={b.name} data-business-category={b.category} data-business-municipality={b.municipality}>公式サイト ↗</a>}
            </li>
          ))}
        </ul>
      </section>
    )}


  {areaEvents.length > 0 && (
    <section class="area-news area-events">
      <div class="bp-wrap">
        <p class="bp-kicker">EVENTS</p>
        <h2>{municipality.name}のイベント</h2>
        <p class="area-news__lead">これから開催されるものだけを出しています。日程・料金は変わることがあるため、必ず公式でご確認ください。</p>
        <ul class="bp-cards">{areaEvents.map((e) => (
          <li><a href={eventPath(e.id)}>
            <img src={e.data.ogImage ?? CARD_IMAGES[e.id.split('/').pop()!]} alt="" loading="lazy" decoding="async" width="1200" height="630" />
            {e.data.eventInfo?.startDate && <span class="bp-card__meta"><time datetime={e.data.eventInfo.startDate.toISOString()}>{eventDate(e.data.eventInfo.startDate)}</time></span>}
            <strong>{e.data.title}</strong>
          </a></li>
        ))}</ul>
        <p class="area-news__more"><a href="/events/">茨城のイベント・おでかけをすべて見る →</a></p>
      </div>
    </section>
  )}

  {areaNews.length > 0 && (
    <section class="area-news">
      <div class="bp-wrap">
        <p class="bp-kicker">NEWS</p>
        <h2>{municipality.name}のニュース解説</h2>
        <p class="area-news__lead">この街を扱った記事です。発表そのものだけでなく、地域にどう効くのかまで書いています。</p>
        <div class="area-cards">{areaNews.map((item) => <NewsCard item={item} />)}</div>
        <p class="area-news__more"><a href="/news/">茨城ニュース解説をすべて見る →</a></p>
      </div>
    </section>
  )}

  <section class="neighbors">
    <div class="bp-wrap"><p class="bp-kicker">NEARBY CITIES</p><h2>{region.label}の、ほかの街。</h2><ul>{neighbors.map((item) => <li><a href={`/area/${item.slug}/`}>{item.name}</a></li>)}</ul></div>
  </section>

  {(relatedThemes.length > 0 || areaMichinoeki.length > 0) && (
    <section class="area-themes">
      <div class="bp-wrap">
        <p class="bp-kicker">THEMES</p>
        <h2>{municipality.name}が出てくるテーマ</h2>
        <p class="area-themes__lead">同じ土地を、別の切り口から読む。</p>
        {areaMichinoeki.length > 0 && (
          <p class="area-themes__eki">この街には道の駅が{areaMichinoeki.length}駅あります（{areaMichinoeki.map((e) => `道の駅 ${e.name}`).join('、')}）。<a href="/michinoeki/">茨城の道の駅16駅を見る →</a></p>
        )}
        <ul>{relatedThemes.map((theme) => (
          <li><a href={`/${theme.slug}/`}><small>{theme.kicker}</small><span>{theme.title}</span><b aria-hidden="true">→</b></a></li>
        ))}</ul>
      </div>
    </section>
  )}
</BrandBase>

<script>
  import { trackLocalBusinessClick } from '../../lib/analytics-events';

  // 街のページから事業者の公式サイトへ出ていくクリック。
  // IDを付けられるリンクにだけ付ける（名前だけでは後から名寄せできないため）。
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-business-id]')) {
    link.addEventListener('click', () => {
      trackLocalBusinessClick({
        business_id: link.dataset.businessId ?? '',
        business_name: link.dataset.businessName ?? '',
        business_category: link.dataset.businessCategory ?? '',
        link_kind: 'official',
        page_type: 'area',
        municipality: link.dataset.businessMunicipality ?? '',
        content_category: 'area',
      });
    });
  }
</script>

<style>
  .area-week{padding-block:clamp(2rem,4vw,3rem)}
  .area-week__list{display:grid;gap:.6rem;margin-top:1.5rem;padding:0;list-style:none}
  .area-week__list li{margin:0}
  .area-week__list a{display:grid;gap:.3rem;padding:.9rem 1rem;border:1px solid var(--color-mist);border-radius:.85rem;color:var(--color-ink);text-decoration:none}
  .area-week__list a:hover,.area-week__list a:focus-visible{border-color:var(--color-tide)}
  .area-week__meta{color:var(--color-soil);font-size:.78rem}
  .area-week__list strong{font:600 1rem/1.55 var(--font-brand-display)}
  .area-biz{padding-block:clamp(2rem,4vw,3rem)}
  .area-biz__list{display:grid;gap:.9rem;margin-top:1.5rem;padding:0;list-style:none}
  .area-biz__list li{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.8rem;margin:0;padding:1rem;border:1px solid var(--color-mist);border-radius:.85rem}
  .area-biz__body strong{display:block;font:600 1.02rem var(--font-brand-display);color:var(--color-ink)}
  .area-biz__body p{margin:.35rem 0 0;color:var(--color-soil);font-size:.88rem;line-height:1.8}
  .area-biz__checked{display:inline-block;margin-top:.4rem;color:var(--color-soil);font-size:.74rem}
  .area-biz__list a{display:inline-flex;align-items:center;min-height:44px;padding:.5rem 1rem;border-radius:999px;background:var(--interior-sky-soft,#eef6ff);color:var(--color-tide);font-size:.85rem;font-weight:700;text-decoration:none;white-space:nowrap}
  .area-biz__list a:hover,.area-biz__list a:focus-visible{background:var(--color-tide);color:#fff}

  .area-page{padding-top:clamp(4rem,9vw,7rem)}.area-head{padding-bottom:clamp(4rem,8vw,7rem);border-bottom:1px solid var(--color-mist)}.crumbs{display:flex;gap:.55rem;margin-bottom:2.5rem;color:var(--color-soil);font-size:.78rem}.crumbs a{border-bottom:1px solid transparent}.crumbs a:hover{border-color:var(--color-tide)}
