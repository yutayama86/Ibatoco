---
import BrandBase from '../../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import HomeAreaExplorer from '../../components/HomeAreaExplorer.astro';
import V42Cards, { type V42CardItem } from '../../components/V42Cards.astro';
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: 'エリアから探す' }];

const moreCards: V42CardItem[] = [
  { href: '/area/hitachi/', img: '/images/v42/hitachi-coast.webp', alt: 'かみね公園から見た日立市の街と海', tag: '実写', kicker: 'AREA GUIDE ／ 日立市', title: '海と丘の街、日立へ。', text: '日立の歩き方と、半日のコース。' },
  { href: '/food-library/', img: '/images/v42/hoshiimo-field-visit.webp', alt: '干し芋づくりの現場を訪ねる二人を描いたイメージイラスト', tag: 'イメージイラスト', kicker: 'FOOD LIBRARY', title: '知るほど、おいしい。', text: '品種と産地から読む、茨城の食。' },
  { href: '/events/', img: '/images/v42/oarai-festival.webp', alt: '大洗あんこう祭の会場（2014年）', tag: '実写', kicker: 'EVENTS', title: '今週末、茨城でなにしよう。', text: '開催日と場所から探すイベント。' },
];
---

<BrandBase title="エリアから探す｜44市町村から茨城を読む｜イバトコ" description="茨城県44市町村を地図から選び、取材・確認を経た地域の記事、場所、人を探せます。" jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <header class="area-hero v42-hero v42-hero--fill bp-wrap">
    <Breadcrumbs items={crumbs} />
    <p class="bp-kicker">IBARAKI 44 CITIES</p>
    <h1 id="area-index-title" class="area-hero__title">茨城県44市町村から探す</h1>
    <p class="area-hero__lead">海の街、山の街、畑の街。<br />気になる場所から、物語をひとつ。</p>
    <img class="v42-hero__art" src="/images/v42/map-travelers.webp" alt="" width="360" height="540" decoding="async" />
  </header>

  <section class="area-index-main" aria-labelledby="area-index-title">
    <div class="bp-wrap"><HomeAreaExplorer heading={{ kicker: 'FIND YOUR TOWN', lines: ['どのまちへ、', '歩こう。'] }} art={false} /></div>
  </section>

  <section class="v42-section" aria-labelledby="area-more-title">
    <div class="bp-wrap">
      <header class="v42-section__head"><p class="bp-kicker">ONE MORE DISCOVERY</p><h2 id="area-more-title">ここから、もうひと歩き。</h2></header>
      <V42Cards items={moreCards} />
      <p class="v42-credit">
        写真：<a href="https://commons.wikimedia.org/wiki/File:Hitachi_City_from_Kamine_Park_04.jpg" rel="license noopener" target="_blank">Σ64 / CC BY 4.0</a>（日立市）、
        <a href="https://commons.wikimedia.org/wiki/File:Oarai_Anglerfish_Festival_2014.jpg" rel="license noopener" target="_blank">Miyuki Meinaka / CC BY-SA 4.0</a>（大洗あんこう祭）。トリミング・縮小しています。
      </p>
    </div>
  </section>
</BrandBase>

<style>
  .area-hero{padding-inline:0}
  .area-hero :global(.crumbs){margin-bottom:1.2rem}
  /* 提出版（area-region）は H1 をそのまま表紙の大きな見出しにする（52.4px／スマホ30px） */
  .area-hero__title{margin-top:.9rem;color:var(--v42-ink);font:500 clamp(30px,3.64vw,52.4px)/1.43 var(--font-brand-display)!important;letter-spacing:.05em;text-wrap:balance}
  .area-hero__lead{margin-top:1.1rem;color:var(--v42-copy);font-size:.9375rem;line-height:1.9}
  /* スマホは提出版どおり、説明文の右に挿絵を並べる（共通の帯は文字の下に置くため、このページだけ上書き） */
  @media (max-width:760px){
    :global(body.interior-site) .area-hero{grid-template-columns:minmax(0,1fr) 84px!important;column-gap:.75rem}
    :global(body.interior-site) .area-hero > *{grid-column:1 / -1}
    :global(body.interior-site) .area-hero > .area-hero__lead{grid-column:1}
    :global(body.interior-site) .area-hero > .v42-hero__art{grid-column:2;grid-row:auto;order:0;align-self:end;max-width:none;width:84px;max-height:126px;margin-top:0}
  }
  /* 地図と5地域は薄い緑の段に直接置く（従来の白い枠は外す）。interior.css の指定より強くするため body から書く */
  :global(body.interior-site) .area-index-main{padding-block:clamp(2.5rem,5vw,4.5rem);background:#eaf0df}
  :global(body.interior-site) .area-index-main > .bp-wrap{margin-top:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none}
</style>
