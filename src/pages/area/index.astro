---
import BrandBase from '../../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import HomeAreaExplorer from '../../components/HomeAreaExplorer.astro';
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: 'エリアから探す' }];
---

<BrandBase title="エリアから探す｜44市町村から茨城を読む｜イバトコ" description="茨城県44市町村を地図から選び、取材・確認を経た地域の記事、場所、人を探せます。" jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <section class="area-index-main" aria-labelledby="area-index-title">
    <div class="bp-wrap"><Breadcrumbs items={crumbs} /></div>
    <h1 id="area-index-title" class="sr-only">茨城県44市町村から探す</h1>
    <div class="bp-wrap"><HomeAreaExplorer /></div>
  </section>
</BrandBase>

<style>
  .area-index-main{
    min-height:calc(100svh - 76px);
    padding-block:clamp(3rem,7vw,6.5rem);
    background:color-mix(in srgb,var(--color-sand) 42%,var(--color-paper));
  }
  /*
   * 761〜1100pxの地図レイアウト（HomeAreaExplorer）は、2列の最小幅 320px＋400px を前提にしている。
   * この一覧は左右の余白（bp-wrap）のぶん枠が狭く、768pxで地図が右へ32pxはみ出し、神栖市・北茨城市など
   * 東端が切れていた（2026-10-04、本番でも確認）。このページだけ列の最小幅を外す。TOPの見た目は変えない。
   */
  @media (min-width:761px) and (max-width:1100px){
    .area-index-main :global(.ax-grid){grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr)}
  }
</style>
