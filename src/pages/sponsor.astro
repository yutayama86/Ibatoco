---
/**
 * 協賛のご案内（/sponsor/）。協賛・広告を検討する事業者・自治体向け。
 *
 * - 数字は data/editorial/performance-snapshot.json から読む。手で書き写さない
 *   （集計が更新されれば、ページも次のビルドで追従する）
 * - 料金とメニューは src/data/sponsorship.ts が正本。媒体資料も同じ内容にする
 * - 成果は約束しない。報告するのは実測値だけ（PR・広告の方針）
 */
import BrandBase from '../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd, faqPageJsonLd } from '../lib/seo';
import { formatJapaneseDate, parseDateOnly } from '../lib/date-only.js';
import snapshot from '../../data/editorial/performance-snapshot.json';
import { REGIONAL_SUPPORTER_PLAN as plan, yen } from '../data/sponsorship';

const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: '地域事業者の方へ', href: '/biz/' }, { name: '協賛のご案内' }];
const inquiryUrl = '/contact/?subject=協賛・広告のご相談';

const homeViews = snapshot.ga4TopPages.recent28.find((row) => row.path === '/')?.views;
const asOfLabel = formatJapaneseDate(parseDateOnly(snapshot.asOf));
const stats = [
  ...(typeof homeViews === 'number' && Number.isFinite(homeViews)
    ? [{ value: homeViews, label: 'トップページの閲覧数' }] : []),
  { value: snapshot.northStar.current, label: 'サイト全体の閲覧数' },
];

const faq = [
  { q: '何を用意すればよいですか。', a: '掲載するお名前、ロゴの画像、公式サイトのURLをお知らせください。ロゴは掲載の許諾があるものをご用意ください。' },
  { q: '支払いはいつですか。', a: `掲載を始めたあとに、${plan.duration}分を一括でご請求します。お支払いは銀行振込で、期限は請求書の発行月の翌月末日です。` },
  { q: '掲載を続けたい場合はどうすればよいですか。', a: '掲載終了時にご希望をうかがい、次の掲載期間と料金に合意いただいてから更新します。' },
  { q: '協賛枠の表示回数は分かりますか。', a: '掲載後、ご希望に応じて、計測できた範囲の表示回数とリンククリック数をお伝えします。' },
  { q: '集客や売上の効果は保証されますか。', a: 'お約束するのは事前に合意した掲載内容と期間です。集客・売上・検索順位の成果は保証の対象外です。' },
  { q: '掲載をお断りすることはありますか。', a: '内容を確認できないもの、法令や公序良俗に反するもの、読者に誤解を与えるおそれがあるものは、お断りすることがあります。' },
];

const jsonLd = [
  breadcrumbJsonLd(crumbs, Astro.site),
  faqPageJsonLd(faq.map((item) => ({ question: item.q, answer: item.a }))),
];
---
<BrandBase title="協賛のご案内｜イバトコ" description="茨城の取材と発信を支えるイバトコ地域サポーターのご案内。トップページの協賛欄に社名・ロゴ・公式サイトへのリンクを掲載する企業・店舗向けプランです。" jsonLd={jsonLd}>
  <header class="sp-head v42-hero bp-wrap">
    <Breadcrumbs items={crumbs} />
    <p class="bp-kicker">SPONSORSHIP</p>
    <h1>茨城へ行く前に、<br />調べる人へ届ける。</h1>
    <p>茨城を歩き、出会った人や場所を取材して届ける。イバトコの活動を支えてくださる企業・お店を、トップページの協賛欄でご紹介します。</p>
    <div class="sp-head__actions">
      <a class="sp-head__cta" href="#sp-plans-h">掲載内容・料金を見る <span aria-hidden="true">↓</span></a>
      <a class="sp-head__sub" href={inquiryUrl} data-sponsor-cta="head">協賛について相談する</a>
    </div>
    <img class="v42-hero__art" src="/images/v42/field-reporters.webp" alt="" width="360" height="540" decoding="async" />
  </header>

  <section class="sp-plans" aria-labelledby="sp-plans-h"><div class="bp-wrap">
    <p class="bp-kicker">SUPPORTER</p>
    <h2 id="sp-plans-h">掲載内容と料金</h2>
    <article class="sp-plan">
      <div class="sp-plan__details">
          <p class="sp-plan__for">企業・店舗・団体向け</p>
          <h3>{plan.name}</h3>
          <p class="sp-plan__price"><strong>{yen(plan.price)}</strong><span>（税別）／{plan.duration}</span></p>
          <ul>
            <li>トップページ下部の協賛欄に社名・ロゴを掲載</li>
            <li>公式サイトや店舗ページへのリンク1つ</li>
            <li>掲載開始後に{plan.duration}分を一括でお支払い</li>
          </ul>
          <a class="sp-head__cta sp-plan__apply" href="/sponsor/apply/" data-sponsor-cta="apply_regional-supporter">地域サポーターに申し込む <span aria-hidden="true">→</span></a>
      </div>
      <figure class="sp-placement">
        <figcaption>掲載イメージ<span>トップページ下部</span></figcaption>
        <div class="sp-placement__example">
          <p>茨城を、一緒におもしろく。</p>
          <p class="sp-placement__label">地域サポーター（協賛広告）</p>
          <div class="sp-placement__logo"><span aria-hidden="true">LOGO</span>事業者名 <span aria-hidden="true">↗︎</span></div>
        </div>
      </figure>
    </article>
  </div></section>

  <section class="sp-stats bp-wrap bp-section" aria-labelledby="sp-stats-h">
    <p class="bp-kicker">NUMBERS</p>
    <h2 id="sp-stats-h">イバトコの閲覧数</h2>
    <dl class="sp-stats__grid">
      {stats.map((item) => <div><dt>{item.label}</dt><dd>{item.value.toLocaleString('ja-JP')} <span>PV</span></dd></div>)}
    </dl>
    <p class="sp-note">{asOfLabel}時点の直近28日間の実測値（Google Analytics 4）。協賛枠の表示回数とクリック数は掲載後に計測します。</p>
  </section>

  <section class="sp-rules bp-wrap bp-section" aria-labelledby="sp-rules-h">
    <p class="bp-kicker">TRANSPARENCY</p>
    <h2 id="sp-rules-h">協賛しても、事実は変えない。</h2>
    <ul class="sp-rules__list">
      <li>地域サポーターは「協賛広告」と明示してご紹介します。</li>
      <li>取材・記事の評価・掲載順は編集方針に沿って決めます。</li>
    </ul>
    <p class="sp-links"><a class="sp-link" href="/about/pr-policy/">PR・広告の方針を読む →</a><a class="sp-link" href="/sponsor/terms/">協賛（広告）掲載規約を読む →</a></p>
  </section>

  <section class="sp-flow" aria-labelledby="sp-flow-h"><div class="bp-wrap">
    <p class="bp-kicker">FLOW</p>
    <h2 id="sp-flow-h">お申し込みから掲載まで</h2>
    <ol>
      <li><strong>お申し込み</strong><span><a href="/sponsor/apply/">申込フォーム</a>から事業者名と公式サイトをお知らせください。</span></li>
      <li><strong>掲載内容の確認</strong><span>利用許諾のあるロゴを返信メールでお送りください。掲載内容と期間をご確認いただきます。</span></li>
      <li><strong>掲載・ご請求</strong><span>合意した日に掲載を始め、{plan.duration}分を一括でご請求します。</span></li>
    </ol>
  </div></section>

  <section class="sp-faq bp-wrap bp-section" aria-labelledby="sp-faq-h">
    <p class="bp-kicker">FAQ</p>
    <h2 id="sp-faq-h">よくある質問</h2>
    <dl>{faq.map((item) => <div><dt>{item.q}</dt><dd>{item.a}</dd></div>)}</dl>
  </section>

  <section class="sp-cta v42-band bp-reading">
    <img class="sp-cta__art" src="/images/v42/kasama-market-print.webp" alt="" width="960" height="640" loading="lazy" decoding="async" />
    <p class="bp-kicker">CONTACT</p>
    <h2>地域サポーターのお申し込み</h2>
    <p>掲載前のご質問、以前のお見積りや個別の企画については、協賛の相談窓口へお寄せください。</p>
    <div class="sp-head__actions">
      <a class="sp-head__cta" href="/sponsor/apply/" data-sponsor-cta="bottom_apply">申し込む <span aria-hidden="true">→</span></a>
      <a class="sp-head__sub" href={inquiryUrl} data-sponsor-cta="bottom">協賛について相談する</a>
    </div>
  </section>
</BrandBase>

<style>
  .sp-head{padding-block:clamp(4.5rem,10vw,9rem);border-bottom:1px solid var(--color-mist)}
  .sp-head h1{margin-top:1rem;font:600 clamp(2.4rem,6.5vw,5.4rem)/1.25 var(--font-brand-display);color:var(--color-ink);text-wrap:balance}
  .sp-head>p:not(.bp-kicker){max-width:var(--measure);margin-top:1.8rem;line-height:2;color:var(--color-soil)}
  .sp-head__cta{display:inline-flex;align-items:center;gap:.6rem;justify-self:start;align-self:flex-start;width:max-content;max-width:100%;min-height:3rem;margin-top:2rem;padding:.7rem 1.4rem;border-radius:999px;background:var(--color-tide);color:#fff;font-weight:700;text-decoration:none}
  .sp-head__cta:hover,.sp-head__cta:focus-visible{background:var(--color-ink)}
  .sp-head__actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.4rem;margin-top:2rem}
  .sp-head__actions .sp-head__cta{margin-top:0}
  .sp-head__sub{color:var(--color-tide);font-weight:700;border-bottom:1px solid}
  .sp-links{display:flex;flex-wrap:wrap;gap:.4rem 1.6rem}
  .sp-head__cta:focus-visible{outline:2px solid var(--color-tide);outline-offset:3px}
  .sp-stats h2,.sp-plans h2,.sp-rules h2,.sp-flow h2,.sp-faq h2,.sp-cta h2{margin-top:.8rem;font:600 clamp(1.8rem,4.4vw,3.2rem)/1.35 var(--font-brand-display);color:var(--color-ink);text-wrap:balance}
  .sp-stats__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr));gap:1.25rem;margin-top:2rem}
  .sp-stats__grid>div{padding-top:1rem;border-top:2px solid var(--color-tide)}
  .sp-stats__grid dt{color:var(--color-soil);font-size:.84rem;line-height:1.7}
  .sp-stats__grid dd{margin:.3rem 0 0;font:600 clamp(2rem,4vw,2.8rem)/1.2 var(--font-brand-display);color:var(--color-ink);font-variant-numeric:tabular-nums}
  .sp-stats__grid dd span { font: 600 .85rem var(--font-brand-body); }
  .sp-note{max-width:var(--measure);margin-top:1.2rem;color:var(--color-soil);font-size:.84rem;line-height:1.9}
  .sp-plans{padding-block:clamp(4rem,9vw,7rem);background:var(--color-white);border-block:1px solid var(--color-mist)}
  #sp-plans-h { scroll-margin-top: 7rem; }
  .sp-plan {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-top: 1.6rem;
    padding: clamp(1.25rem, 4vw, 2.75rem);
    border: 1px solid var(--color-mist);
    border-radius: .75rem;
    background: var(--color-paper);
  }
  .sp-plan__for{color:var(--color-tide);font-size:.78rem;font-weight:700;letter-spacing:.04em}
  .sp-plan h3{margin-top:.4rem;font:600 clamp(1.25rem,3vw,1.75rem)/1.5 var(--font-brand-display);color:var(--color-ink)}
  .sp-plan__price{display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem;margin-top:.7rem}
  .sp-plan__price strong{font:600 clamp(1.9rem,4vw,3rem)/1.2 var(--font-brand-display);color:var(--color-ink);font-variant-numeric:tabular-nums}
  .sp-plan__price span{color:var(--color-soil);font-size:.86rem}
  .sp-plan ul{display:grid;gap:.45rem;margin-top:1.05rem;padding-left:1.1rem;list-style:disc}
  .sp-plan li{color:var(--color-soil);font-size:.875rem;line-height:1.8}
  .sp-plan__apply { margin-top: 1.25rem; }
  .sp-placement {
    min-width: 0;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--color-mist);
    border-radius: .5rem;
    background: var(--color-white);
  }
  .sp-placement figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .25rem .75rem;
    color: var(--color-ink);
    font-size: .82rem;
    font-weight: 700;
  }
  .sp-placement figcaption span { color: var(--color-soil); font-weight: 400; }
  .sp-placement__example {
    margin-top: .7rem;
    padding: clamp(.75rem, 3vw, 1.3rem);
    border: 1px solid var(--color-mist);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .sp-placement__example > p:first-child {
    font: 600 clamp(1rem, 2.4vw, 1.35rem)/1.5 var(--font-brand-display);
    text-align: center;
  }
  .sp-placement__label {
    margin-top: .85rem;
    color: var(--color-soil);
    font-size: .75rem;
  }
  .sp-placement__logo {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .25rem;
    align-items: center;
    margin-top: .45rem;
    padding: .65rem .75rem;
    border: 1px solid var(--color-mist);
    border-radius: .3rem;
    background: var(--color-white);
    font-size: .82rem;
  }
  .sp-placement__logo span:first-child {
    grid-column: 1 / -1;
    color: var(--color-soil);
    font-size: .7rem;
    letter-spacing: .1em;
  }
  @media (max-width: 680px) {
    .sp-plan { grid-template-columns: minmax(0, 1fr); }
  }
  .sp-rules__list{display:grid;gap:0;margin-top:1.8rem;padding:0;list-style:none;border-top:1px solid var(--color-mist)}
  .sp-rules__list li{padding:1rem 0;border-bottom:1px solid var(--color-mist);color:var(--color-ink);line-height:1.8}
  .sp-rules__list li::before{content:none}
  .sp-link{display:inline-block;margin-top:1.5rem;color:var(--color-tide);border-bottom:1px solid}
  .sp-flow{padding-block:clamp(4rem,9vw,7rem);background:var(--color-white);border-block:1px solid var(--color-mist)}
  .sp-flow ol{display:grid;margin-top:1.6rem;padding:0;list-style:none;counter-reset:step;border-top:1px solid var(--color-mist)}
  .sp-flow li{display:grid;grid-template-columns:2.2rem minmax(0,1fr);gap:.2rem .9rem;padding:.9rem 0;border-bottom:1px solid var(--color-mist);counter-increment:step}
  .sp-flow li::before{content:counter(step);grid-row:span 2;display:grid;place-items:center;width:2.2rem;height:2.2rem;border:1px solid var(--color-tide);border-radius:50%;color:var(--color-tide);font:700 .85rem var(--font-brand-meta)}
  .sp-flow strong{color:var(--color-ink)}
  .sp-flow span{color:var(--color-soil);font-size:.88rem;line-height:1.8}
  .sp-flow span a{color:var(--color-tide);border-bottom:1px solid}
  .sp-faq dl{margin-top:1.6rem;border-top:1px solid var(--color-mist)}
  .sp-faq dl>div{padding:1.15rem 0;border-bottom:1px solid var(--color-mist)}
  .sp-faq dt{font:600 1rem/1.6 var(--font-brand-display);color:var(--color-ink)}
  .sp-faq dd{margin:.45rem 0 0;color:var(--color-soil);font-size:.9rem;line-height:1.85}
  .sp-cta{padding-block:clamp(4.5rem,10vw,8rem)}
  .sp-cta>p:not(.bp-kicker){margin-top:1.2rem;color:var(--color-soil);line-height:1.9}
</style>

<script>
  import { rememberCtaOrigin, trackEvent } from '../lib/analytics-events';
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-sponsor-cta]')) {
    link.addEventListener('click', () => {
      const location = link.dataset.sponsorCta ?? '';
      rememberCtaOrigin({ cta_type: 'sponsorship', cta_location: 'sponsor_' + location, cta_page_type: 'sponsor', cta_origin_path: window.location.pathname });
      trackEvent('business_cta_click', { cta_type: 'sponsorship', cta_location: 'sponsor_' + location, cta_page_type: 'sponsor', link_url: link.getAttribute('href') ?? '' });
    });
  }
</script>
