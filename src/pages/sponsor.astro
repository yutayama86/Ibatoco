---
/**
 * 協賛のご案内（/sponsor/）。協賛・広告を検討する事業者・自治体向け。
 *
 * - 数字は data/editorial/performance-snapshot.json から読む。手で書き写さない
 *   （集計が更新されれば、ページも次のビルドで追従する）
 * - 料金とメニューは src/data/sponsorship.ts が正本。媒体資料も同じ内容にする
 * - 成果は約束しない。報告するのは実測値だけ（PR・広告の方針）
 */
import BrandBase from '../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { getEvents, getNews } from '../lib/content';
import snapshot from '../../data/editorial/performance-snapshot.json';
import { SPONSOR_PLANS, MONITOR_OFFER, yen } from '../data/sponsorship';

const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: '地域事業者の方へ', href: '/biz/' }, { name: '協賛のご案内' }];

// ---- 実数（集計データから） ----
const ga4 = snapshot.windows.ga4;
const gsc = snapshot.windows.gsc;
const num = (value: number) => value.toLocaleString('ja-JP');
const channels = ga4.channelRecent7 as { channel: string; sessions: number }[];
const totalSessions = channels.reduce((sum, row) => sum + row.sessions, 0);
const organic = channels.find((row) => row.channel === 'Organic Search')?.sessions ?? 0;
const organicShare = totalSessions > 0 ? Math.round((organic / totalSessions) * 100) : 0;
const [asOfYear, asOfMonth, asOfDay] = snapshot.asOf.split('-').map(Number);
const asOfLabel = `${asOfYear}年${asOfMonth}月${asOfDay}日`;
const growth = gsc.recent7VsPrevious7.impressionsPct;

const stats = [
  { value: num(snapshot.northStar.current), label: 'ページビュー（直近28日）' },
  { value: num(ga4.recent28.users), label: 'ユーザー（直近28日）' },
  { value: num(gsc.recent28.impressions), label: 'Google検索での表示回数（直近28日）' },
  { value: `${organicShare}%`, label: '検索から来た人の割合（直近7日）' },
];

// ---- よく読まれたページ（トップページを除く上位3件） ----
const [news, events] = await Promise.all([getNews(), getEvents()]);
const titleByPath = new Map<string, string>();
for (const item of news) titleByPath.set(`/news/${item.id.split('/').pop()}/`, item.data.title.split('｜')[0]);
for (const item of events) titleByPath.set(`/events/${item.id.split('/').pop()}/`, item.data.title.split('｜')[0]);
const topPages = (snapshot.ga4TopPages.recent28 as { path: string; views: number }[])
  .filter((row) => row.path !== '/' && titleByPath.has(row.path))
  .slice(0, 3)
  .map((row) => ({ ...row, title: titleByPath.get(row.path)! }));

const faq = [
  { q: '集客や売上の効果は保証されますか。', a: '保証しません。お約束できるのは、掲載の内容と期間、そして実測した数字をそのままご報告することです。' },
  { q: '協賛すると、記事での扱いや検索の順位は変わりますか。', a: '変わりません。協賛の有無で、記事の事実・評価・並び順を変えることはありません。協賛の枠と記事は、PRの表示で分けています。' },
  { q: '支払いはいつですか。', a: '掲載を始めたあとにご請求します。料金は事前にお見積りでお伝えし、合意いただいてから進めます。' },
  { q: '掲載をお断りすることはありますか。', a: '内容を確認できないもの、法令や公序良俗に反するもの、読者に誤解を与えるおそれがあるものは、お断りすることがあります。' },
  { q: '紹介文や写真は、こちらで用意するのですか。', a: 'イベント協賛枠は、紹介文（120字以内）と写真1枚をご用意ください。PR記事は、資料をいただければ文章はイバトコが書きます。' },
];

const jsonLd = [
  breadcrumbJsonLd(crumbs, Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
  },
];
---
<BrandBase title="協賛のご案内｜イバトコ" description="茨城へ行く前に調べる人へ届ける、イバトコの協賛・広告のご案内。イベント協賛枠、PR記事、シーズン協賛の内容と料金、PRの表示方針、実測の数字を掲載しています。" jsonLd={jsonLd}>
  <header class="sp-head bp-wrap">
    <Breadcrumbs items={crumbs} />
    <p class="bp-kicker">SPONSORSHIP</p>
    <h1>茨城へ行く前に、<br />調べる人へ届ける。</h1>
    <p>イバトコの読者は、イベントや施設、制度の名前で検索して、行く前に調べに来る人です。その読者に向けて、PRと明示したうえで、事業や取り組みを紹介できます。</p>
    <a class="sp-head__cta" href="/contact/?subject=協賛・広告のご相談" data-sponsor-cta="head">協賛について相談する <span aria-hidden="true">→</span></a>
  </header>

  <section class="sp-stats bp-wrap bp-section" aria-labelledby="sp-stats-h">
    <p class="bp-kicker">NUMBERS</p>
    <h2 id="sp-stats-h">実測の数字</h2>
    <dl class="sp-stats__grid">
      {stats.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
    </dl>
    <p class="sp-note">Google検索での表示回数は、直近7日で前の週より{growth >= 0 ? `${growth}%増えました` : `${Math.abs(growth)}%減りました`}。数字はGoogle Analytics 4とGoogle Search Consoleの実測値です（{asOfLabel}時点の集計）。</p>
    {topPages.length > 0 && (
      <div class="sp-top">
        <h3>よく読まれたページ（直近28日）</h3>
        <ol>{topPages.map((row) => <li><a href={row.path}>{row.title}</a><span>{num(row.views)}ページビュー</span></li>)}</ol>
        <p class="sp-note">イベントや季節の記事は、開催の数週間前から読まれています。</p>
      </div>
    )}
  </section>

  <section class="sp-plans" aria-labelledby="sp-plans-h"><div class="bp-wrap">
    <p class="bp-kicker">PLANS</p>
    <h2 id="sp-plans-h">協賛メニューと料金</h2>
    <p class="sp-plans__lead">月額の契約はありません。1イベント、1本から始められます。料金はすべて税別です。</p>
    <div class="sp-plans__grid">
      {SPONSOR_PLANS.map((plan) => (
        <article id={plan.id}>
          <p class="sp-plan__for">{plan.forWhom}</p>
          <h3>{plan.name}</h3>
          <p class="sp-plan__price"><strong>{yen(plan.price)}</strong><span>／{plan.unit}</span></p>
          <p class="sp-plan__summary">{plan.summary}</p>
          <ul>{plan.includes.map((line) => <li>{line}</li>)}</ul>
          {plan.options && (
            <div class="sp-plan__options">
              <p>オプション</p>
              <ul>{plan.options.map((option) => <li>{option.label}：{yen(option.price)}{option.note && `（${option.note}）`}</li>)}</ul>
            </div>
          )}
        </article>
      ))}
    </div>
    <p class="sp-monitor"><strong>{MONITOR_OFFER.label}</strong>{MONITOR_OFFER.text}</p>
  </div></section>

  <section class="sp-rules bp-wrap bp-section" aria-labelledby="sp-rules-h">
    <p class="bp-kicker">TRANSPARENCY</p>
    <h2 id="sp-rules-h">協賛しても、事実は変えない。</h2>
    <ul class="sp-rules__list">
      <li>協賛の枠と記事は、必ず「PR」と文言で示します。</li>
      <li>協賛の有無で、記事の事実・評価・並び順は変えません。</li>
      <li>紹介文に、根拠のない「No.1」「必ず」などの表現は載せません。</li>
      <li>ご報告する数字は実測値だけです。推計や見込みは使いません。</li>
    </ul>
    <a class="sp-link" href="/about/pr-policy/">PR・広告の方針を読む →</a>
  </section>

  <section class="sp-flow" aria-labelledby="sp-flow-h"><div class="bp-wrap">
    <p class="bp-kicker">FLOW</p>
    <h2 id="sp-flow-h">ご相談から報告まで</h2>
    <ol>
      <li><strong>ご相談</strong><span>フォームから、目的と時期をお送りください</span></li>
      <li><strong>お見積り</strong><span>掲載する記事・期間・料金をお伝えします。合意いただいてから進めます</span></li>
      <li><strong>素材のご提供</strong><span>紹介文・写真・資料をお送りください</span></li>
      <li><strong>掲載</strong><span>公開前に内容をご確認いただきます。掲載を始めたあとにご請求します</span></li>
      <li><strong>ご報告</strong><span>表示回数・クリック数・閲覧数を、実測でお伝えします</span></li>
    </ol>
  </div></section>

  <section class="sp-faq bp-wrap bp-section" aria-labelledby="sp-faq-h">
    <p class="bp-kicker">FAQ</p>
    <h2 id="sp-faq-h">よくある質問</h2>
    <dl>{faq.map((item) => <div><dt>{item.q}</dt><dd>{item.a}</dd></div>)}</dl>
  </section>

  <section class="sp-cta bp-reading">
    <p class="bp-kicker">CONTACT</p>
    <h2>まずは、ご相談ください。</h2>
    <p>目的と時期をうかがったうえで、合う形をご提案します。媒体資料もお送りできます。</p>
    <a class="sp-head__cta" href="/contact/?subject=協賛・広告のご相談" data-sponsor-cta="bottom">協賛について相談する <span aria-hidden="true">→</span></a>
  </section>
</BrandBase>

<style>
  .sp-head{padding-block:clamp(4.5rem,10vw,9rem);border-bottom:1px solid var(--color-mist)}
  .sp-head h1{margin-top:1rem;font:600 clamp(2.4rem,6.5vw,5.4rem)/1.25 var(--font-brand-display);color:var(--color-ink);text-wrap:balance}
  .sp-head>p:not(.bp-kicker){max-width:var(--measure);margin-top:1.8rem;line-height:2;color:var(--color-soil)}
  .sp-head__cta{display:inline-flex;align-items:center;gap:.6rem;justify-self:start;align-self:flex-start;width:max-content;max-width:100%;min-height:3rem;margin-top:2rem;padding:.7rem 1.4rem;border-radius:999px;background:var(--color-tide);color:#fff;font-weight:700;text-decoration:none}
  .sp-head__cta:hover,.sp-head__cta:focus-visible{background:var(--color-ink)}
  .sp-head__cta:focus-visible{outline:2px solid var(--color-tide);outline-offset:3px}
  .sp-stats h2,.sp-plans h2,.sp-rules h2,.sp-flow h2,.sp-faq h2,.sp-cta h2{margin-top:.8rem;font:600 clamp(1.8rem,4.4vw,3.2rem)/1.35 var(--font-brand-display);color:var(--color-ink);text-wrap:balance}
  .sp-stats__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr));gap:1.25rem;margin-top:2rem}
  .sp-stats__grid>div{padding-top:1rem;border-top:2px solid var(--color-tide)}
  .sp-stats__grid dt{color:var(--color-soil);font-size:.84rem;line-height:1.7}
  .sp-stats__grid dd{margin:.3rem 0 0;font:600 clamp(2rem,4vw,2.8rem)/1.2 var(--font-brand-display);color:var(--color-ink);font-variant-numeric:tabular-nums}
  .sp-note{max-width:var(--measure);margin-top:1.2rem;color:var(--color-soil);font-size:.84rem;line-height:1.9}
  .sp-top{margin-top:2.5rem}
  .sp-top h3{font:600 1.15rem/1.5 var(--font-brand-display);color:var(--color-ink)}
  .sp-top ol{display:grid;margin-top:.9rem;padding:0;list-style:none;border-top:1px solid var(--color-mist)}
  .sp-top li{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.3rem 1rem;padding:.85rem 0;border-bottom:1px solid var(--color-mist)}
  .sp-top li::before{content:none}
  .sp-top a{color:var(--color-ink);font-weight:700;border-bottom:1px solid var(--color-mist)}
  .sp-top span{color:var(--color-soil);font-size:.86rem;font-variant-numeric:tabular-nums}
  .sp-plans{padding-block:clamp(4rem,9vw,7rem);background:var(--color-white);border-block:1px solid var(--color-mist)}
  .sp-plans__lead{max-width:var(--measure);margin-top:1.2rem;color:var(--color-soil);line-height:1.9}
  .sp-plans__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:1.25rem;margin-top:2.2rem}
  .sp-plans__grid article{display:flex;flex-direction:column;padding:1.4rem;border:1px solid var(--color-mist);border-radius:.9rem;background:var(--color-paper)}
  .sp-plan__for{color:var(--color-tide);font-size:.78rem;font-weight:700;letter-spacing:.04em}
  .sp-plans__grid h3{margin-top:.4rem;font:600 1.4rem/1.4 var(--font-brand-display);color:var(--color-ink)}
  .sp-plan__price{display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem;margin-top:.7rem}
  .sp-plan__price strong{font:600 1.9rem/1.2 var(--font-brand-display);color:var(--color-ink);font-variant-numeric:tabular-nums}
  .sp-plan__price span{color:var(--color-soil);font-size:.86rem}
  .sp-plan__summary{margin-top:.8rem;color:var(--color-charcoal,var(--color-ink));font-size:.9rem;line-height:1.85}
  .sp-plans__grid ul{display:grid;gap:.45rem;margin-top:.9rem;padding-left:1.1rem;list-style:disc}
  .sp-plans__grid li{color:var(--color-soil);font-size:.86rem;line-height:1.8}
  .sp-plan__options{margin-top:1rem;padding-top:.9rem;border-top:1px dashed var(--color-mist)}
  .sp-plan__options>p{color:var(--color-ink);font-size:.84rem;font-weight:700}
  .sp-plan__options ul{margin-top:.4rem}
  .sp-monitor{max-width:var(--measure);margin-top:1.8rem;padding:1rem 1.2rem;border-radius:.75rem;background:var(--color-paper);border:1px solid var(--color-mist);color:var(--color-soil);font-size:.9rem;line-height:1.9}
  .sp-monitor strong{margin-right:.6rem;color:var(--color-ink)}
  .sp-rules__list{display:grid;gap:0;margin-top:1.8rem;padding:0;list-style:none;border-top:1px solid var(--color-mist)}
  .sp-rules__list li{padding:1rem 0;border-bottom:1px solid var(--color-mist);color:var(--color-ink);line-height:1.8}
  .sp-rules__list li::before{content:none}
  .sp-link{display:inline-block;margin-top:1.5rem;color:var(--color-tide);border-bottom:1px solid}
  .sp-flow{padding-block:clamp(4rem,9vw,7rem);background:var(--color-white);border-block:1px solid var(--color-mist)}
  .sp-flow ol{display:grid;margin-top:1.6rem;padding:0;list-style:none;counter-reset:step;border-top:1px solid var(--color-mist)}
  .sp-flow li{display:grid;grid-template-columns:2.2rem minmax(0,1fr);gap:.2rem .9rem;padding:.9rem 0;border-bottom:1px solid var(--color-mist);counter-increment:step}
  .sp-flow li::before{content:counter(step);grid-row:span 2;display:grid;place-items:center;width:2.2rem;height:2.2rem;border:1px solid var(--color-tide);border-radius:50%;color:var(--color-tide);font:700 .85rem var(--font-brand-meta)}
  .sp-flow strong{color:var(--color-ink)}
  .sp-flow span{color:var(--color-soil);font-size:.88rem;line-height:1.8}
  .sp-faq dl{margin-top:1.6rem;border-top:1px solid var(--color-mist)}
  .sp-faq dl>div{padding:1.15rem 0;border-bottom:1px solid var(--color-mist)}
  .sp-faq dt{font:600 1rem/1.6 var(--font-brand-display);color:var(--color-ink)}
  .sp-faq dd{margin:.45rem 0 0;color:var(--color-soil);font-size:.9rem;line-height:1.85}
  .sp-cta{padding-block:clamp(4.5rem,10vw,8rem)}
  .sp-cta>p:not(.bp-kicker){margin-top:1.2rem;color:var(--color-soil);line-height:1.9}
</style>

<script>
  import { rememberCtaOrigin, trackEvent } from '../lib/analytics-events';
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-sponsor-cta]')) {
    link.addEventListener('click', () => {
      const location = link.dataset.sponsorCta ?? '';
      rememberCtaOrigin({ cta_type: 'sponsorship', cta_location: 'sponsor_' + location, cta_page_type: 'sponsor', cta_origin_path: window.location.pathname });
      trackEvent('business_cta_click', { cta_type: 'sponsorship', cta_location: 'sponsor_' + location, cta_page_type: 'sponsor', link_url: link.getAttribute('href') ?? '' });
    });
  }
</script>
