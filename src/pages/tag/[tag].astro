---
import type { GetStaticPaths } from 'astro';
import BrandBase from '../../layouts/BrandBase.astro';
import BrandStoryCard from '../../components/BrandStoryCard.astro';
import NewsCard from '../../components/NewsCard.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { getAllTags, getArticlesByTag, getNewsByTag, tagToSlug } from '../../lib/content';
import { fitLength } from '../../lib/text-fit';

export const getStaticPaths = (async () => {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({ params: { tag: tagToSlug(tag) }, props: { tag } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
const [articles, news] = await Promise.all([getArticlesByTag(tag), getNewsByTag(tag)]);
const total = articles.length + news.length;
// タグ一覧は検索に出さない（オーナー判断 2026-10-07）。記事の寄せ集めで薄くなりやすく、記事ページ・テーマページと検索で競合するため。
// リンクはたどってもらう（noindex, follow）。sitemap にも載せない（scripts/index-health.mjs で検査）
// 見出し「#タグ」を1行に収める大きさの目安（src/lib/text-fit.ts）
const tagLen = fitLength(`#${tag}`);
// パンくずは現在地としてタグ名まで出す（表示と構造化データで同じ配列を使う）
const crumbs: Crumb[] = [
  { name: 'ホーム', href: '/' },
  { name: 'ニュース解説', href: '/news/' },
  { name: `#${tag}` },
];
---

<BrandBase
  title={`#${tag}の記事｜イバトコ`}
  description={`「${tag}」に関する茨城の記事とニュース解説をイバトコがまとめました。`}
  noindex
  jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}
>
  <section class="wrap tag-hero">
    <div data-reveal><Breadcrumbs items={crumbs} /></div>
    <p class="eyebrow" data-reveal>Tag</p>
    <h1 class="display tag-title" data-reveal data-long={Number(tagLen) > 10.2 ? '' : undefined} style={`--fit-len:${tagLen}`}>#{tag}</h1>
    <p class="tag-lead muted" data-reveal>「{tag}」から、次に行きたい茨城を探す。記事・ニュース {total}件</p>
    <nav class="tag-actions" aria-label="タグから次を探す">
      <a href="/events/">今のおでかけを見る →</a>
      <a href="/area/">エリアから広げる →</a>
    </nav>
  </section>

  <section class="wrap section">
    {news.length > 0 && <div class="tag-group"><p class="eyebrow">News</p><h2>ニュース解説</h2><div class="tag-grid tag-grid--news">{news.map((item) => <NewsCard item={item} />)}</div></div>}
    {articles.length > 0 && <div class="tag-group"><p class="eyebrow">Stories</p><h2>記事</h2><div class="tag-grid">{articles.map((a) => <BrandStoryCard article={a} />)}</div></div>}
    {total === 0 && <p class="empty muted mincho">このタグの記事はまだありません。</p>}
  </section>
</BrandBase>

<style>
  .tag-hero { margin-top:clamp(1rem,3vw,2rem); padding:clamp(1.5rem,4vw,2.6rem); border:1px solid var(--color-mist); border-radius:var(--brand-radius-card); background:linear-gradient(145deg,var(--brand-blue-soft),var(--color-white) 55%,var(--brand-lemon)); box-shadow:var(--brand-shadow-card); }
  .crumbs { display: flex; gap: 0.6rem; font-size: var(--step--1); color: var(--ink-mute); margin-bottom: 1.2rem; }
  .crumbs a:hover { color: var(--color-tide); }
  .tag-title { font-size: var(--step-4); margin: 0.4rem 0; color: var(--ink); }
  /* 見出しの大きさをタグの長さに合わせるための基準（src/styles/interior/editorial-pages.css の .tag-title） */
  .tag-hero { container-type: inline-size; }
  /*
   * 320pxで1行に入りきらない長いタグ（例「#つくば霞ヶ浦りんりんロード」）は、文節で折ると
   * 「#」だけの行ができる。字単位で折り、行の長さは見出しの text-wrap:balance（editorial-pages.css）でそろえる。
   */
  .tag-title[data-long] { word-break: normal; }
  .tag-lead { font-size: var(--step-0); }
  .tag-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}
  .tag-actions a{padding:.5rem .8rem;border:1px solid var(--color-mist);border-radius:999px;background:rgba(255,255,255,.86);color:var(--color-ink);font-size:.8rem;font-weight:700}
  .tag-actions a:hover,.tag-actions a:focus-visible{border-color:var(--color-tide);color:var(--color-tide)}
  .section { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .tag-group + .tag-group { margin-top: clamp(3rem, 7vw, 5rem); padding-top: clamp(2rem, 5vw, 3.5rem); border-top: 1px solid var(--color-mist); }
  .tag-group h2 { margin: .4rem 0 1.5rem; font: 600 clamp(1.5rem, 3vw, 2.2rem)/1.35 var(--font-brand-display); color: var(--color-ink); }
  .tag-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .empty { font-size: var(--step-1); padding-block: 2rem; }
  @media (max-width: 1000px) { .tag-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .tag-grid { grid-template-columns: minmax(0,1fr); } }
</style>
