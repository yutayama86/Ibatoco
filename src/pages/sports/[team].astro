---
/**
 * /sports/<team>/ — チームページ。5チームすべて同じ部品・同じデータ構造で作る。
 *
 * 構成：
 *   チーム紹介（最終更新）
 *   ① NEXT MATCH ② LAST MATCH（＋最新記事）
 *   ③ RECENT FORM ④ MATCH GUIDE ⑤ IBARAKI MATCH DAY ⑥ UPCOMING MATCHES
 *   ⑦ 記事（種類ごと）/ この街のニュース / 地域への導線
 *
 * 試合は年間日程（src/data/sports/matches/*.json）と記事の sportsMatch から集める。
 * 記事は sportsTeam で自動的に集まる。記事URLの一覧は持たない。
 * 未確認の日程・結果・順位は出さない。データが無い枠は黙って出さない。
 * 公式ロゴ・選手写真は権利が確認できないため使わない。
 */
import type { GetStaticPaths } from 'astro';
import { CARD_IMAGES } from '../../data/card-images';
import BrandBase from '../../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import SportsMatchBoard from '../../components/SportsMatchBoard.astro';
import SportsRecentForm from '../../components/SportsRecentForm.astro';
import SportsMatchGuide from '../../components/SportsMatchGuide.astro';
import SportsMatchDay from '../../components/SportsMatchDay.astro';
import SportsUpcoming from '../../components/SportsUpcoming.astro';
import ArticleNextSteps from '../../components/ArticleNextSteps.astro';
import BusinessCta from '../../components/BusinessCta.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import {
  SPORTS_TEAMS, SPORTS_TEAM_BY_SLUG, SPORTS_CONTENT_TYPES,
  townSlugsOf, type SportsContentType,
} from '../../data/sports';
import { scheduleUpdatedAt, type SportsSource } from '../../data/sports-schedule';
import { MUNICIPALITIES } from '../../data/areas';
import { getSportsNews, getSportsNewsByKeyword, getIndexableNews } from '../../lib/content';
import {
  getTeamMatches, pickNextMatch, pickLatestResult, pickRecentForm, pickUpcoming,
  competitionLabel, sportsEventJsonLd,
} from '../../lib/sports';

export const getStaticPaths = (() => SPORTS_TEAMS.map((team) => ({ params: { team: team.slug } }))) satisfies GetStaticPaths;

const { team: slug } = Astro.params;
const team = SPORTS_TEAM_BY_SLUG[slug as keyof typeof SPORTS_TEAM_BY_SLUG];
if (!team) return Astro.redirect('/404');

// 試合は年間日程と記事frontmatterの両方から集める（lib/sports.ts）
const matches = await getTeamMatches(team.slug);
const nextMatch = pickNextMatch(matches);
const latestResult = pickLatestResult(matches);
const recentForm = pickRecentForm(matches, 5);
const upcoming = pickUpcoming(matches, nextMatch, 5);
const guide = nextMatch?.guide;
const matchDay = nextMatch?.matchDay;
/**
 * 試合当日にビルドしたときだけ、上部の要点枠を「当日版」の見出しにする。
 * 日付は必ず見出しに入れる（翌日に再ビルドされないまま見られても、何日の話か分かるように）。
 * 試合が終わって score を入れれば nextMatch が次の試合に移り、この枠ごと入れ替わる。
 */
const JST_YMD = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' });
const isMatchDayToday = Boolean(nextMatch) && JST_YMD.format(nextMatch!.date) === JST_YMD.format(new Date());
const GUIDE_ANCHOR = 'match-guide';

/** データを公式情報で確認・更新した日。ビルド日ではない（更新していない日に更新したと見せない） */
const updatedAt = scheduleUpdatedAt(team.slug);
const fmtYmd = (ymd: string) => {
  const [y, m, d] = ymd.split('-').map(Number);
  return `${y}年${m}月${d}日`;
};

// 日程・結果の出典。ページに出した試合のぶんだけ、重複を除いて並べる
const shownMatches = [nextMatch, latestResult, ...recentForm, ...upcoming].filter((m): m is NonNullable<typeof m> => Boolean(m));
const scheduleSources = [...new Map(
  shownMatches.flatMap((m) => m.sources ?? []).map((s): [string, SportsSource] => [s.url, s])
).values()];

// sportsTeam で分類された記事。ChatGPTから追加されるぶんはここに入る。
const tagged = await getSportsNews(team.slug);
// sportsTeam が未設定の既存記事は、チーム名の一致だけで拾う（推測はしない）。
const legacy = await getSportsNewsByKeyword([team.name]);
const seen = new Set<string>();
const articles = [...tagged, ...legacy].filter((item) => {
  if (seen.has(item.id)) return false;
  seen.add(item.id);
  return true;
}).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const newsPath = (id: string) => `/news/${id.split('/').pop()}/`;
const fmt = (d: Date) => new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' }).format(d);

/** 種類ごとに束ねる。分類が未設定の既存記事は「関連記事」へ寄せる。 */
const byType = new Map<SportsContentType, typeof articles>();
const untyped: typeof articles = [];
for (const item of articles) {
  const t = item.data.sportsContentType as SportsContentType | undefined;
  if (t) byType.set(t, [...(byType.get(t) ?? []), item]);
  else untyped.push(item);
}

/**
 * 一覧の見出し。0件の束は作らないので、記事が増えるまで自然に出てこない。
 * ニュースとコラムは1つにまとめる（分けるほど本数が無い段階で細かく割らない）。
 */
const SECTIONS: { title: string; en: string; types: SportsContentType[] }[] = [
  { title: '試合とガイド', en: 'MATCHES & GUIDES', types: ['match-result', 'preview', 'home-guide', 'away-guide'] },
  { title: 'ニュース・コラム', en: 'NEWS & COLUMNS', types: ['news', 'column'] },
];
const sections = SECTIONS
  .map((s) => ({
    title: s.title,
    en: s.en,
    items: s.types
      .flatMap((t) => byType.get(t) ?? [])
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
  }))
  .filter((s) => s.items.length > 0);

/** 記事の種類は、節の見出しではなくカードの札で示す */
const typeLabelOf = (item: (typeof articles)[number]) => {
  const t = item.data.sportsContentType as SportsContentType | undefined;
  return t ? SPORTS_CONTENT_TYPES[t].label : undefined;
};
const thumbOf = (item: (typeof articles)[number]) =>
  item.data.ogImage ?? CARD_IMAGES[item.id.split('/').pop()!];

/** 上部の LATEST STORIES。種類の札を添えて3件まで */
const stories = articles.slice(0, 3).map((item) => {
  const t = item.data.sportsContentType as SportsContentType | undefined;
  return {
    href: newsPath(item.id),
    title: item.data.title,
    date: item.data.pubDate,
    typeLabel: t ? SPORTS_CONTENT_TYPES[t].label : undefined,
  };
});

// ホームタウンの市町村に関わるニュース（このチームの記事は除く）。
// 手で選ばず、既存の municipalities から自動で拾うので、リンク切れが起きない。
const townSlugs = new Set(townSlugsOf(team));
const teamArticleIds = new Set(articles.map((a) => a.id));
const townNews = (await getIndexableNews())
  .filter((item) => !teamArticleIds.has(item.id) && item.data.municipalities.some((m) => townSlugs.has(m)))
  .slice(0, 4);

// 区分（ホームタウン／マザータウン等）を保ったまま市町村を引く。
// 区分をまたいで平らにすると事実が変わるため、まとめない。
const townGroups = team.towns
  .map((group) => ({
    label: group.label,
    towns: group.slugs
      .map((s) => MUNICIPALITIES.find((m) => m.slug === s))
      .filter((m): m is NonNullable<typeof m> => Boolean(m)),
  }))
  .filter((group) => group.towns.length > 0);

const crumbs: Crumb[] = [
  { name: 'ホーム', href: '/' },
  { name: '茨城のスポーツ', href: '/sports/' },
  { name: team.name },
];
const pageUrl = new URL(`/sports/${team.slug}/`, Astro.site).href;

/**
 * title は試合ごとに変えない（毎節変わると検索結果が安定しない）。
 * 試合単体の検索には、次戦を入れた description と、ガイドの見出しで答える。
 * 試合データの無いチームは従来の title・description のまま。
 */
const mdw = (d: Date) => new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', month: 'long', day: 'numeric', weekday: 'short' }).format(d);
const pageTitle = updatedAt
  ? `${team.name}｜次の試合・結果・観戦ガイド｜イバトコ`
  : `${team.name}｜試合と観戦、その周りのこと｜イバトコ`;
const pageDescription = nextMatch
  ? `${team.name}の次の試合は${mdw(nextMatch.date)}${nextMatch.kickoff ? ` ${nextMatch.kickoff}` : ''}、${competitionLabel(nextMatch) ? `${competitionLabel(nextMatch)}の` : ''}${nextMatch.opponent}戦${nextMatch.venue ? `（${nextMatch.venue}）` : ''}。直近の結果と今後の日程${guide ? '、チケットやアクセスなどの観戦ガイド' : ''}を、公式情報で確かめてまとめています。`
  : `${team.name}（${team.sport}）に関する記事、試合の情報、観戦と遠征の手引きをまとめています。${team.venue ? `本拠地は${team.venue}。` : ''}確かめられたことだけを載せます。`;

const jsonLd = [
  breadcrumbJsonLd(crumbs, Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${team.name}｜イバトコ`,
    url: pageUrl,
    description: team.summary,
    ...(updatedAt ? { dateModified: `${updatedAt}T00:00:00+09:00` } : {}),
  },
  // これからの試合のうち、キックオフ時刻と会場が確定しているものだけ
  ...[nextMatch, ...upcoming]
    .map((m) => (m ? sportsEventJsonLd(team, m) : undefined))
    .filter((ld): ld is Record<string, unknown> => Boolean(ld)),
];
---

<BrandBase
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <header class="tm-head bp-wrap">
    <Breadcrumbs items={crumbs} />
    <p class="bp-kicker">{team.sport}</p>
    <h1>{team.name}</h1>
    <p>{team.summary}</p>
    {team.slug === 'mito-hollyhock' && <p>ホーム観戦の前に、<a href="/news/mito-hollyhock-new-stadium-access/">水戸信用金庫スタジアムのアクセス・駐車場・最寄り駅</a>をご確認ください。</p>}
    {(team.league || team.venue) && (
      <dl class="tm-facts">
        {team.league && <div><dt>リーグ</dt><dd>{team.league}</dd></div>}
        {team.venue && <div><dt>本拠地</dt><dd>{team.venue}</dd></div>}
      </dl>
    )}
    {updatedAt && (
      <p class="tm-updated">
        <strong>最終更新：<time datetime={updatedAt}>{fmtYmd(updatedAt)}</time></strong>
        <span>試合の前後に公式情報を確認し、次の試合・結果・観戦ガイドを更新しています。</span>
      </p>
    )}
    {team.basicsPending && (
      <p class="tm-pending">本拠地の会場など、公式で確認できていない基本情報があります。確認できしだい追記します。確認できていないことは書きません。</p>
    )}
  </header>

  <SportsMatchBoard next={nextMatch} latest={latestResult} stories={stories} guideAnchor={guide ? GUIDE_ANCHOR : undefined} />

  {/* 次の試合の直前に必要なことだけを、ページ上部で先に見せる。詳細は MATCH GUIDE と個別記事 */}
  {nextMatch && guide && guide.keyFacts.length > 0 && (
    <section class="tm-block bp-wrap tm-keyfacts" aria-labelledby="tm-keyfacts">
      <p class="tm-eyebrow">{isMatchDayToday ? 'MATCH DAY TODAY' : 'MATCH DAY ESSENTIALS'}</p>
      <h2 id="tm-keyfacts" class="tm-title">{mdw(nextMatch.date)} {nextMatch.opponent}戦{isMatchDayToday ? ' 当日に確認すること' : 'で押さえること'}</h2>
      <ul class="tm-keylist">{guide.keyFacts.map((fact) => <li>{fact}</li>)}</ul>
      <p class="tm-keylinks">
        <a href={`#${GUIDE_ANCHOR}`}>観戦ガイドの詳細（出典つき）→</a>
        {nextMatch.articleUrl && <a href={nextMatch.articleUrl}>この試合の観戦記事を読む →</a>}
      </p>
    </section>
  )}

  {recentForm.length > 0 && (
    <section class="tm-block bp-wrap bp-section" aria-labelledby="tm-form">
      <p class="tm-eyebrow">RECENT FORM</p>
      <h2 id="tm-form" class="tm-title">直近の成績（公式戦{recentForm.length}試合）</h2>
      <SportsRecentForm matches={recentForm} />
    </section>
  )}

  {guide && (
    <section id={GUIDE_ANCHOR} class="tm-block bp-wrap bp-section" aria-labelledby="tm-guide">
      <p class="tm-eyebrow">MATCH GUIDE</p>
      <h2 id="tm-guide" class="tm-title">{guide.title}</h2>
      <SportsMatchGuide guide={guide} />
    </section>
  )}

  {matchDay && (
    <section class="tm-block bp-wrap bp-section" aria-labelledby="tm-matchday">
      <p class="tm-eyebrow">IBARAKI MATCH DAY</p>
      <h2 id="tm-matchday" class="tm-title">{matchDay.title}</h2>
      <SportsMatchDay plan={matchDay} />
    </section>
  )}

  {upcoming.length > 0 && (
    <section class="tm-block bp-wrap bp-section" aria-labelledby="tm-upcoming">
      <p class="tm-eyebrow">UPCOMING MATCHES</p>
      <h2 id="tm-upcoming" class="tm-title">今後の試合</h2>
      <SportsUpcoming matches={upcoming} />
      {scheduleSources.length > 0 && (
        <div class="tm-sources">
          <p>日程・結果・観戦情報の出典</p>
          <ul>{scheduleSources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
          ))}</ul>
        </div>
      )}
    </section>
  )}

  {sections.map((section) => (
    <section class="tm-block bp-wrap bp-section">
      <p class="tm-eyebrow">{section.en}</p>
      <h2 class="tm-title">{section.title}</h2>
      <ul class="bp-cards">{section.items.map((item) => (
        <li><a href={newsPath(item.id)}>
          <img src={thumbOf(item)} alt="" loading="lazy" decoding="async" width="1200" height="630" />
          <span class="bp-card__meta">
            {typeLabelOf(item) && <em>{typeLabelOf(item)}</em>}
            <time datetime={item.data.pubDate.toISOString()}>{fmt(item.data.pubDate)}</time>
          </span>
          <strong>{item.data.title}</strong>
        </a></li>
      ))}</ul>
    </section>
  ))}

  {untyped.length > 0 && (
    <section class="tm-block bp-wrap bp-section" aria-labelledby="tm-related">
      <p class="tm-eyebrow">RELATED</p>
      <h2 id="tm-related" class="tm-title">関連記事</h2>
      <ul class="bp-cards">{untyped.map((item) => (
        <li><a href={newsPath(item.id)}>
          <img src={thumbOf(item)} alt="" loading="lazy" decoding="async" width="1200" height="630" />
          <span class="bp-card__meta">
            {typeLabelOf(item) && <em>{typeLabelOf(item)}</em>}
            <time datetime={item.data.pubDate.toISOString()}>{fmt(item.data.pubDate)}</time>
          </span>
          <strong>{item.data.title}</strong>
        </a></li>
      ))}</ul>
    </section>
  )}

  {articles.length === 0 && (
    <section class="tm-block bp-wrap bp-section">
      <p class="tm-eyebrow">ARTICLES</p>
      <h2 class="tm-title">記事</h2>
      <p class="tm-empty">このチームの記事はこれから公開します。</p>
    </section>
  )}

  {townNews.length > 0 && (
    <section class="tm-block bp-wrap bp-section" aria-labelledby="tm-townnews">
      <p class="tm-eyebrow">THE TOWN</p>
      <h2 id="tm-townnews" class="tm-title">この街のニュース</h2>
      <p class="tm-lead">ホームタウンの市町村を扱った記事です。試合とは別の切り口で、同じ街を追っています。</p>
      <ul class="bp-cards">{townNews.map((item) => (
        <li><a href={newsPath(item.id)}>
          <img src={thumbOf(item)} alt="" loading="lazy" decoding="async" width="1200" height="630" />
          <span class="bp-card__meta">
            {typeLabelOf(item) && <em>{typeLabelOf(item)}</em>}
            <time datetime={item.data.pubDate.toISOString()}>{fmt(item.data.pubDate)}</time>
          </span>
          <strong>{item.data.title}</strong>
        </a></li>
      ))}</ul>
    </section>
  )}

  <section class="tm-block bp-wrap bp-section" aria-labelledby="tm-area">
    <p class="tm-eyebrow">HOMETOWN</p>
    <h2 id="tm-area" class="tm-title">この街のこと</h2>
    {townGroups.length > 0 ? (
      <>
        <p class="tm-lead">クラブが公式に挙げている市町村です。区分はクラブの表記に合わせています。</p>
        {townGroups.map((group) => (
          <div class="tm-towns">
            {/* 1件のときに「1市町村」と書くと数を強調して読みにくいので出さない */}
            <h3>{group.label}{group.towns.length > 1 && <span>{group.towns.length}市町村</span>}</h3>
            <ul>{group.towns.map((m) => (
              <li><a href={`/area/${m.slug}/`}>{m.name}</a></li>
            ))}</ul>
          </div>
        ))}
      </>
    ) : (
      <p class="tm-empty">ホームタウンとして確認できた市町村がまだありません。確認できしだい、街のページへつなぎます。</p>
    )}
    <ul class="tm-links">
      <li><a href="/sports/">茨城のスポーツ 一覧へ戻る →</a></li>
      <li><a href="/news/">茨城ニュース解説 →</a></li>
    </ul>
  </section>

  {/* 観戦のあとに行ける先。ホームタウンの市町村から、テーマと近い街だけを出す */}
  <div class="bp-wrap bp-section">
    <ArticleNextSteps municipalities={[...townSlugs]} pageType="sports" />
    {/* 記事と同じ、地域事業者向けの導線を1つだけ */}
    <BusinessCta pageType="sports" municipality={[...townSlugs][0]} contentCategory="team" />
  </div>
</BrandBase>

<style>
  /* 上下の余白と全幅の背景は interior.css の見出しバンドが持つ */
  .tm-head h1{margin-top:.8rem;font:600 clamp(2.2rem,5vw,3.6rem)/1.25 var(--font-brand-display);color:var(--color-ink)}
  .tm-head>p{max-width:var(--measure);margin-top:1.3rem;line-height:2;color:var(--color-soil)}
  .tm-facts{display:flex;flex-wrap:wrap;gap:.6rem 2.2rem;margin:1.6rem 0 0}
  .tm-facts div{display:grid;gap:.15rem}
  .tm-facts dt{font:700 .66rem var(--font-brand-meta);letter-spacing:.12em;color:var(--color-tide)}
  .tm-facts dd{margin:0;font:600 1rem var(--font-brand-display);color:var(--color-ink)}
  .tm-pending{max-width:var(--measure);margin-top:1.4rem;padding:.9rem 1.1rem;border-left:2px solid var(--color-mist);color:var(--color-soil);font-size:.8rem;line-height:1.85}
  /* 最終更新。見出し内の他の段落（.tm-head>p）より詳細度を上げて、行間と色を固定する */
  .tm-head>p.tm-updated{display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem .9rem;margin-top:1.4rem;font-size:.8rem;line-height:1.7}
  .tm-updated strong{font:700 .82rem var(--font-brand-meta);color:var(--color-ink);font-variant-numeric:tabular-nums}
  .tm-updated span{color:var(--color-soil)}

  /*
   * 節の見出し。以前は 2.45rem の明朝が1件のリンクの上に載っていて、
   * 見出しだけが目立つ状態だった。記事ページと同じ「英字ラベル＋見出し」に揃え、
   * 中身のカードに主役を渡す。
   */
  .tm-eyebrow{color:var(--color-tide);font:700 .68rem var(--font-brand-meta);letter-spacing:.14em}
  .tm-title{margin:.5rem 0 1.4rem;font:600 clamp(1.35rem,2vw,1.75rem)/1.45 var(--font-brand-display);color:var(--color-ink);text-wrap:balance}
  .tm-empty{color:var(--color-soil);line-height:1.9;font-size:.9rem}

  /* 観戦で押さえること。ボードの直下に置くため、上の余白を詰める */
  .tm-keyfacts{padding-top:clamp(.6rem,1.5vw,1.2rem)}
  .tm-keylist{display:grid;gap:.55rem;max-width:62rem;margin:0;padding:1.2rem 1.3rem;list-style:none;background:var(--color-white);border:1px solid var(--color-mist);border-left:3px solid var(--interior-blue,#174f99)}
  .tm-keylist li{position:relative;padding-left:1rem;color:var(--color-ink);font-size:.9rem;line-height:1.8}
  .tm-keylist li::before{content:'';position:absolute;left:0;top:.78em;width:5px;height:5px;background:var(--interior-blue,#174f99)}
  .tm-keylinks{display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;margin-top:.9rem}
  .tm-keylinks a{color:var(--interior-blue,#174f99);font-size:.86rem;font-weight:700}

  .tm-sources{margin-top:1.4rem;color:var(--color-soil);font-size:.74rem;line-height:1.8}
  .tm-sources p{font-weight:700}
  .tm-sources ul{display:flex;flex-wrap:wrap;gap:.2rem 1.1rem;margin:.3rem 0 0;padding:0;list-style:none}
  .tm-sources a{color:var(--color-soil);text-decoration:underline;text-underline-offset:.15em}

  .tm-lead{max-width:var(--measure);margin-bottom:1.6rem;color:var(--color-soil);font-size:.86rem;line-height:1.9}
  .tm-towns{margin-bottom:1.8rem}
