---
import type { GetStaticPaths } from 'astro';
import BrandBase from '../../layouts/BrandBase.astro';
import NewsCard from '../../components/NewsCard.astro';
import { CATEGORIES, SITE_CONFIG } from '../../data/site';
import { NEWS_CATEGORIES } from '../../data/news';
import { MUNI_BY_SLUG, areaToSlug } from '../../data/areas';
import { formatDate, getArticles, getNews, getRelatedNews, getStores, tagToSlug } from '../../lib/content';
import { INTERNAL_LINK_LABELS } from '../../data/internal-links';
import PassportStampIndex from '../../components/PassportStampIndex.astro';
import BusinessCta from '../../components/BusinessCta.astro';
import BookingGuide from '../../components/BookingGuide.astro';
import ArticleNextSteps from '../../components/ArticleNextSteps.astro';
import GrowthNextReads from '../../components/GrowthNextReads.astro';
import { hasPaidLink } from '../../data/affiliates';

export const getStaticPaths = (async () => (await getNews()).map((item) => ({
  params: { slug: item.id.split('/').pop() },
  props: { item },
}))) satisfies GetStaticPaths;

const { item } = Astro.props;
const { data } = item;
const slug = item.id.split('/').pop();
const canonical = new URL(`/news/${slug}/`, Astro.site ?? SITE_CONFIG.domain).href;
/**
 * 冒頭画像は、その記事のために作った図版がある場合だけ出す。
 * 以前は共通の news-placeholder.svg（「茨城ニュース解説」と書いただけの絵）に
 * 落としていたが、記事について何も伝えないぶん、無いほうが読みやすい。
 */
const visualImagePath = data.ogImage ?? null;
const imagePath = data.ogImage && !data.ogImage.endsWith('.svg') ? data.ogImage : `/og/news/${slug}.png`;
const absolute = (path: string) => new URL(path, Astro.site ?? SITE_CONFIG.domain).href;
const municipalities = data.municipalities.map((value) => MUNI_BY_SLUG.get(value)).filter(Boolean);
const municipalitySet = new Set(data.municipalities);
const [relatedNews, allArticles, allStores] = await Promise.all([getRelatedNews(item), getArticles(), getStores()]);
const relatedArticles = allArticles.filter((article) => municipalitySet.has(areaToSlug(article.data.area) ?? '')).slice(0, 3);
const relatedPlaces = allStores.filter((store) => municipalitySet.has(areaToSlug(store.data.area) ?? '')).slice(0, 3);


// 04セクションの見出し。accessGuide を持つ記事だけアクセス案内として見せ、
// それ以外は本来の「具体的に何が変わる？」に戻す（目次の表記とも揃える）。
const changesHeading = data.accessGuide ? 'アクセス・駐車場・公共交通' : '具体的に何が変わる？';

/**
 * ガイド型記事（guide あり）は、標準の7節の代わりに guide.sections を並べる。
 * 目次と節番号はそこから組み立てる。標準の記事の番号（08 / FAQ など）は変えない。
 */
const guide = data.guide;
/** 広告リンクを含むページは、記事の冒頭（ファーストビュー）でも広告であることを示す（ASPの掲載条件） */
const hasAd = Boolean(data.booking) && hasPaidLink(data.booking!.items);
const pad = (n: number) => String(n).padStart(2, '0');
const guideFaqNo = guide ? guide.sections.length + 2 : 8;
const guideSourcesNo = guide ? guideFaqNo + (data.faq.length > 0 ? 1 : 0) : 9;
const relatedNo = guide ? guideSourcesNo + 1 : 10;
const tocItems = guide
  ? [
      { id: 'conclusion', label: '結論' },
      ...guide.sections.map((section) => ({ id: section.id, label: section.heading })),
      ...(data.faq.length > 0 ? [{ id: 'faq', label: 'FAQ' }] : []),
      { id: 'sources', label: '情報源' },
    ]
  : null;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const linkAttrs = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});

const organizationId = `${SITE_CONFIG.domain}/#organization`;
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    logo: { '@type': 'ImageObject', url: absolute('/favicon.svg') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: { '@type': 'Organization', name: data.author },
    publisher: { '@id': organizationId },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    image: [absolute(imagePath)],
    articleSection: NEWS_CATEGORIES[data.category].label,
    keywords: data.tags.join(', '),
    inLanguage: 'ja-JP',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: '茨城ニュース解説', item: absolute('/news/') },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
    ],
  },
];
// Event の日時は日本時間で組み立てる。news の event は日付だけを持ち時刻を
// 持たないため、toISOString() を使うと 2026-10-10T00:00:00.000Z のように
// UTCの真夜中＝日本時間の午前9時を主張してしまう。日付だけを出力する。
const eventDay = (x: Date) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(x);
// location（placeName）が無い Event は Google の必須項目を満たさないため出力しない
if (data.event && data.event.placeName) jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: data.event.name,
  description: data.description,
  startDate: eventDay(data.event.startDate),
  ...(data.event.endDate ? { endDate: eventDay(data.event.endDate) } : {}),
  ...(data.event.url ? { url: data.event.url } : {}),
  location: {
    '@type': 'Place',
    name: data.event.placeName,
    ...(data.event.address ? { address: data.event.address } : {}),
  },
});
if (data.place) jsonLd.push({ '@context': 'https://schema.org', '@type': 'Place', name: data.place.name, ...(data.place.address ? { address: data.place.address } : {}), ...(data.place.url ? { url: data.place.url } : {}) });
if (data.faq.length > 0) jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
});
---

<BrandBase title={`${data.title}｜イバトコ`} description={data.description} image={imagePath} imageAlt={data.ogImageAlt} type="article" publishedAt={data.pubDate} updatedAt={data.updatedDate ?? data.pubDate} jsonLd={jsonLd} noindex={data.noindex}>
  <article class="news-detail">
    <header class="news-detail__head bp-reading">
      <nav class="crumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href="/news/">茨城ニュース解説</a></nav>
      {data.sample && <p class="sample-note"><strong>実装確認用サンプル</strong>　この記事はニュース機能の表示確認用です。実際の施策発表を報じる記事ではありません。</p>}
      <div class="news-detail__meta"><span>{NEWS_CATEGORIES[data.category].label}</span>{municipalities.length > 0 && <span>{municipalities.map((value) => value!.name).join('・')}</span>}</div>
      <h1>{data.title}</h1>
      <p class="news-detail__deck">{data.description}</p>
      {hasAd && <p class="ad-disclosure"><span class="ad-disclosure__tag">#アフィリエイト広告</span>この記事にはアフィリエイト広告を含みます。</p>}
      {data.tags.length > 0 && <ul class="news-detail__tags" aria-label="記事のタグ">{data.tags.map((tag) => <li><a href={`/tag/${tagToSlug(tag)}/`}>#{tag}</a></li>)}</ul>}
      <div class="news-detail__dates"><time datetime={data.pubDate.toISOString()}>公開 {formatDate(data.pubDate)}</time>{data.updatedDate && <time datetime={data.updatedDate.toISOString()}>更新 {formatDate(data.updatedDate)}</time>}<span>{data.author}</span></div>
      {guide && <div class="guide-summary">
        <ul class="guide-cards" aria-label="要点">{guide.summaryCards.map((card) => <li class:list={[{ 'is-emphasis': card.emphasis }]}><span>{card.label}</span><strong>{card.value}</strong></li>)}</ul>
        {guide.cta && <div class="guide-cta"><a href={guide.cta.href} {...linkAttrs(guide.cta.href)}>{guide.cta.label}<span aria-hidden="true">{isExternal(guide.cta.href) ? '↗' : '→'}</span>{isExternal(guide.cta.href) && <span class="sr-only">（新しいタブで開きます）</span>}</a>{guide.cta.note && <p>{guide.cta.note}</p>}</div>}
      </div>}
    </header>

    <div class="news-detail__layout bp-wrap">
      <aside class="news-detail__toc" aria-label="この記事の目次"><p>この記事の構成</p>{tocItems ? <ol>{tocItems.map((entry) => <li><a href={`#${entry.id}`}>{entry.label}</a></li>)}</ol> : <ol><li><a href="#conclusion">結論</a></li><li><a href="#points">この記事でわかること</a></li><li><a href="#what-happened">何が起きた？</a></li><li><a href="#changes">{changesHeading}</a></li><li><a href="#analysis">編集部の解説</a></li><li><a href="#impact">地域への影響</a></li><li><a href="#business">地域事業者への示唆</a></li><li><a href="#faq">FAQ</a></li><li><a href="#sources">情報源</a></li></ol>}</aside>
      <div class="news-detail__body">
        {/* 冒頭画像は本文カラムの先頭に置く（見出しと本文のあいだで浮かせない） */}
        {visualImagePath && <figure class="news-detail__hero"><img src={visualImagePath} alt={data.ogImageAlt} loading="eager" width="1200" height="630" />{data.imageCredit && <figcaption>写真：<a href={data.imageCreditUrl} target="_blank" rel="noopener noreferrer">{data.imageCredit}</a>{data.imageLicense && <> / <a href={data.imageLicenseUrl} target="_blank" rel="noopener noreferrer">{data.imageLicense}</a></>}</figcaption>}</figure>}

        <section id="conclusion" class="news-conclusion"><p class="section-number">01 / CONCLUSION</p><h2>結論</h2><p>{data.conclusion}</p></section>
        <GrowthNextReads currentPath={`/news/${slug}/`} pageType="news" />
        {guide ? <>
          {guide.sections.map((section, index) => <section id={section.id} class="guide-section">
            <p class="section-number">{pad(index + 2)}{section.kicker && ` / ${section.kicker}`}</p><h2>{section.heading}</h2>
            {section.lead && <p class="guide-lead"><strong>{section.lead}</strong></p>}
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.steps.length > 0 && <ol class="guide-steps">{section.steps.map((step) => <li class="guide-step"><strong>{step.title}</strong><span>{step.detail}</span></li>)}</ol>}
            {section.items.length > 0 && <ul>{section.items.map((entry) => <li>{entry}</li>)}</ul>}
            {section.details.length > 0 && <div class="guide-details">{section.details.map((detail) => <div><h3>{detail.title}</h3><dl>{detail.rows.map((row) => <><dt>{row.label}</dt><dd>{row.value}</dd></>)}</dl></div>)}</div>}
            {section.notes.length > 0 && <ul class="guide-notes">{section.notes.map((note) => <li>{note}</li>)}</ul>}
            {section.cta && <div class="guide-cta guide-cta--inline"><a href={section.cta.href} {...linkAttrs(section.cta.href)}>{section.cta.label}<span aria-hidden="true">{isExternal(section.cta.href) ? '↗' : '→'}</span>{isExternal(section.cta.href) && <span class="sr-only">（新しいタブで開きます）</span>}</a>{section.cta.note && <p>{section.cta.note}</p>}</div>}
            {section.block === 'passport-stamp-spots' && <PassportStampIndex />}
          </section>)}
          {guide.bottomCta && <div class="guide-cta guide-cta--bottom"><a href={guide.bottomCta.href} {...linkAttrs(guide.bottomCta.href)}>{guide.bottomCta.label}<span aria-hidden="true">{isExternal(guide.bottomCta.href) ? '↗' : '→'}</span>{isExternal(guide.bottomCta.href) && <span class="sr-only">（新しいタブで開きます）</span>}</a>{guide.bottomCta.note && <p>{guide.bottomCta.note}</p>}</div>}
        </> : <>
        <section id="points"><p class="section-number">02 / KEY POINTS</p><h2>この記事でわかること</h2><ul>{data.keyPoints.map((point) => <li>{point}</li>)}</ul></section>
        <section id="what-happened"><p class="section-number">03 / WHAT HAPPENED</p><h2>何が起きた？</h2><p>{data.whatHappened}</p>
          {data.referenceList && <div class="ref-list">
            <h3>{data.referenceList.heading}</h3>
            {data.referenceList.intro && <p class="ref-list__intro">{data.referenceList.intro}</p>}
            <dl>{data.referenceList.groups.map((group) => <><dt>{group.label}</dt><dd><ul>{group.items.map((item) => <li>{item}</li>)}</ul></dd></>)}</dl>
            {data.referenceList.note && <p class="ref-list__note">{data.referenceList.note}</p>}
          </div>}
        </section>
        <section id="changes"><p class="section-number">04 / CHANGES</p><h2>{changesHeading}</h2><p>{data.whatChanges}</p>
          {data.accessGuide && <div class="access-guide">
            <div><h3>場所とホーム利用開始時期</h3><dl><dt>場所</dt><dd>{data.accessGuide.location}</dd><dt>いつから</dt><dd>{data.accessGuide.homeUseStarts}</dd></dl></div>
            <div><h3>車・駐車場</h3><dl>{data.accessGuide.parking.map((item) => <><dt>{item.heading}</dt><dd>{item.detail}</dd></>)}</dl></div>
            <div><h3>電車・無料シャトルバス</h3><dl>{data.accessGuide.publicTransport.map((item) => <><dt>{item.heading}</dt><dd>{item.detail}</dd></>)}</dl></div>
            <div><h3>帰りの動線</h3><p>{data.accessGuide.returnTrip}</p></div>
          </div>}
        </section>
        <section id="analysis"><p class="section-number">05 / EDITORIAL VIEW</p><h2>イバトコ編集部の解説</h2><p>{data.editorialAnalysis}</p></section>
        <section id="impact"><p class="section-number">06 / LOCAL IMPACT</p><h2>地域への影響</h2><p>{data.regionalImpact}</p></section>
        <section id="business"><p class="section-number">07 / FOR BUSINESSES</p><h2>地域事業者への示唆</h2><ul>{data.businessImplications.map((point) => <li>{point}</li>)}</ul></section>
        </>}
        {data.booking && <BookingGuide booking={data.booking} pageType="news" municipality={data.municipalities[0]} contentCategory={data.category} />}
        {data.faq.length > 0 && <section id="faq"><p class="section-number">{pad(guideFaqNo)} / FAQ</p><h2>よくある質問</h2><dl class="news-faq">{data.faq.map((item) => <div><dt>{item.question}</dt><dd>{item.answer}</dd></div>)}</dl></section>}
        <section id="sources"><p class="section-number">{pad(guideSourcesNo)} / SOURCES</p><h2>情報源</h2><ul class="source-list">{data.sourceUrls.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>{source.accessedAt && <small>確認日：{formatDate(source.accessedAt)}</small>}</li>)}</ul><p class="source-note">掲載内容は公開情報をもとに編集しています。制度や運用は変更される場合があるため、行動前に公式情報をご確認ください。</p></section>
        {/* 既存の分類から作った回遊先。該当が無ければ何も出ない */}
        <ArticleNextSteps municipalities={data.municipalities} sportsTeam={data.sportsTeam} pageType="news" />
        {/* 本文を読み終えた位置に、地域事業者向けの導線を1つだけ置く */}
        <BusinessCta pageType="news" municipality={data.municipalities[0]} contentCategory={data.category} />
      </div>
    </div>
  </article>

  {/* relatedArticleUrls も条件に含める。県全体の話題（municipalities が空）でも
      編集部が選んだ関連リンクが消えないようにする。 */}
  {(relatedNews.length > 0 || relatedArticles.length > 0 || relatedPlaces.length > 0 || municipalities.length > 0 || data.relatedArticleUrls.length > 0) && <section class="news-related bp-wrap bp-section"><p class="bp-kicker">{pad(relatedNo)} / RELATED</p><h2 class="bp-section-title">関連情報</h2>
    {municipalities.length > 0 && <div class="municipality-links">{municipalities.map((value) => <a href={`/area/${value!.slug}/`}>{value!.name}を知る →</a>)}</div>}
    {relatedNews.length > 0 && <div class="news-related__grid">{relatedNews.map((related) => <NewsCard item={related} compact />)}</div>}
    {(relatedArticles.length > 0 || relatedPlaces.length > 0) && <div class="local-links">{relatedArticles.map((article) => <a href={`/${CATEGORIES[article.data.category].path}/${article.id.split('/').pop()}/`}><span>記事</span>{article.data.title}</a>)}{relatedPlaces.map((place) => <a href={`/place/${place.id}/`}><span>場所</span>{place.data.name}</a>)}</div>}
    {data.relatedArticleUrls.length > 0 && <nav class="editorial-links" aria-label="編集部が選んだ関連記事">{data.relatedArticleUrls.map((url) => <a href={url}>{INTERNAL_LINK_LABELS[url] ?? '関連情報'} →</a>)}</nav>}
  </section>}
</BrandBase>

<style>
  .news-detail{padding-top:clamp(3.5rem,8vw,6.5rem)}.crumbs{display:flex;gap:.55rem;margin-bottom:1.5rem;color:var(--color-soil);font-size:.75rem}.crumbs a{border-bottom:1px solid transparent}.crumbs a:hover{border-color:var(--color-tide)}.sample-note{margin-bottom:1.5rem;padding:1rem;border-left:3px solid var(--color-signal);background:color-mix(in srgb,var(--color-signal) 7%,var(--color-white));font-size:.78rem;line-height:1.7}.sample-note strong{color:var(--color-signal)}
  /* 市町村を多く持つ記事だと、カテゴリ名（交通・自治体・行政）が縮んで
     「交／通」と1文字ずつ縦に割れていた。カテゴリは縮めず、市町村側を折り返す。 */
  .news-detail__meta{display:flex;flex-wrap:wrap;gap:.4rem 1rem;color:var(--color-tide);font:.72rem var(--font-brand-meta);letter-spacing:.08em}
  .news-detail__meta>span:first-child{flex:0 0 auto;white-space:nowrap}
  .news-detail__meta>span+span{flex:1 1 20rem;min-width:0}.news-detail__head h1{max-width:19em;margin-top:1rem;font:600 clamp(2rem,4vw,3.35rem)/1.38 var(--font-brand-display);color:var(--color-ink)}.news-detail__deck{max-width:46rem;margin-top:1.3rem;color:var(--color-soil);font-size:clamp(1rem,1.6vw,1.15rem);line-height:1.9}.news-detail__tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.25rem;list-style:none}.news-detail__tags a{display:block;padding:.4rem .7rem;background:color-mix(in srgb,var(--color-tide) 8%,var(--color-white));color:var(--color-tide);font-size:.72rem;transition:background-color .2s,color .2s}.news-detail__tags a:hover,.news-detail__tags a:focus-visible{background:var(--color-tide);color:var(--color-white)}.news-detail__dates{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;margin-top:1.25rem;color:var(--color-soil);font-size:.72rem}.news-detail__hero{margin-top:3rem}.news-detail__hero img{width:100%;aspect-ratio:1.9/1;object-fit:cover}.news-detail__hero figcaption{margin-top:.55rem;color:var(--color-soil);font-size:.68rem;text-align:right}.news-detail__hero figcaption a{text-decoration:underline;text-underline-offset:.15em}
  .news-detail__layout{display:grid;grid-template-columns:210px minmax(0,700px);justify-content:center;gap:clamp(2rem,6vw,5rem);padding-block:clamp(3.5rem,7vw,6rem)}.news-detail__toc{position:sticky;top:1rem;align-self:start;padding-top:.5rem;color:var(--color-soil);font-size:.72rem}.news-detail__toc>p{padding-bottom:.65rem;border-bottom:1px solid var(--color-mist);font-weight:700;color:var(--color-ink)}.news-detail__toc ol{display:grid;gap:.5rem;margin-top:.75rem;list-style:decimal;padding-left:1.2rem}.news-detail__toc a:hover{color:var(--color-tide)}
  .news-detail__body section{scroll-margin-top:1rem}.news-detail__body section+section{margin-top:4rem;padding-top:3rem;border-top:1px solid var(--color-mist)}.section-number{color:var(--color-tide);font:.68rem var(--font-brand-meta);letter-spacing:.12em}.news-detail__body h2{margin-top:.6rem;font:600 clamp(1.55rem,3vw,2.25rem)/1.4 var(--font-brand-display);color:var(--color-ink)}.news-detail__body h2+p,.news-detail__body h2+ul,.news-faq,.source-list{margin-top:1.3rem}.news-detail__body p,.news-detail__body li,.news-detail__body dd{color:var(--color-charcoal);font-size:1rem;line-height:2}.news-detail__body ul:not(.source-list){display:grid;gap:.65rem}.news-detail__body ul:not(.source-list) li{position:relative;padding-left:1.1rem}.news-detail__body ul:not(.source-list) li:before{content:'';position:absolute;left:0;top:.9em;width:5px;height:5px;background:var(--color-tide)}.news-conclusion{padding:1.5rem!important;background:var(--color-white);border:1px solid var(--color-mist)!important}
  .access-guide{display:grid;gap:1px;margin-top:2rem;background:var(--color-mist);border:1px solid var(--color-mist)}.access-guide>div{padding:1.25rem;background:var(--color-white)}.access-guide h3{font:600 1.15rem/1.5 var(--font-brand-display);color:var(--color-ink)}.access-guide dl{display:grid;grid-template-columns:minmax(7rem,.7fr) minmax(0,2fr);gap:.65rem 1rem;margin-top:1rem}.access-guide dt{font-weight:700;color:var(--color-tide)}.access-guide dd{margin:0}.access-guide h3+p{margin-top:.75rem}
  /* 一覧記事の表。左が市町村などのまとまり、右がその中身 */
  .ref-list{margin-top:2rem;padding:1.35rem 1.5rem;border:1px solid var(--color-mist);background:var(--color-white)}
  .ref-list h3{font:600 1.15rem/1.5 var(--font-brand-display);color:var(--color-ink)}
  .ref-list__intro{margin-top:.7rem;color:var(--color-soil);font-size:.9rem;line-height:1.9}
  /* 左は「つくばみらい市（1か所）」が1行で収まる幅にする */
  .ref-list dl{display:grid;grid-template-columns:minmax(12rem,1fr) minmax(0,2.4fr);gap:0 1.3rem;margin-top:1.2rem;border-top:1px solid var(--color-mist)}
  .ref-list dt{padding:.85rem 0 .3rem;font-weight:700;color:var(--color-tide);font-size:.92rem}
