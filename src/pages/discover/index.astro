---
import BrandBase from '../../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { getDiscoveryEntities } from '../../lib/discovery';
import { listImageOf } from '../../lib/card-image';
import { getCollection } from 'astro:content';

const entities = await getDiscoveryEntities();
const entries = await getCollection('events', ({ data }) => !data.draft && data.reviewed && !data.noindex);
const entryById = new Map(entries.map((entry) => [entry.id, entry]));
const initialLimit = 18;
const quickCandidates = [
  { label: '雨の日', term: '雨の日' },
  { label: '子連れ', term: '子連れ' },
  { label: 'デート', term: 'デート' },
  { label: '紅葉', term: '紅葉' },
  { label: '花火', term: '花火' },
  { label: '公園', term: '公園' },
  { label: '水族館', term: '水族館' },
].map((item) => ({
  ...item,
  count: entities.filter((entity) => entity.searchText.includes(item.term.toLowerCase())).length,
})).filter((item) => item.count > 0);
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: '行きたいところ検索' }];
const jsonLd = [
  breadcrumbJsonLd(crumbs, Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '茨城で今日どこ行く？ 行きたいところ検索',
    url: new URL('/discover/', Astro.site).href,
    description: '気分、同行者、エリアから茨城のおでかけ候補を探せます。候補が少ないときは条件を自動で広げ、行き先がゼロにならないように案内します。',
  },
];
---

<BrandBase
  title="茨城で今日どこ行く？｜行きたいところ検索｜イバトコ"
  description="茨城のおでかけ先を、気分・同行者・エリアから検索。イベント、観光、雨の日、子連れ、デートなど、イバトコが公式情報を確認した記事から候補を提案します。"
  jsonLd={jsonLd}
>
  <header class="discover-head bp-wrap">
    <Breadcrumbs items={crumbs} />
    <p class="bp-kicker">IBATOCO DISCOVERY</p>
    <h1>今日、茨城で<br />どこ行く？</h1>
    <p>場所の名前が決まっていなくても大丈夫。気分と条件から、イバトコにあるおでかけ候補を絞ります。</p>
  </header>

  <section class="discover-tool bp-wrap" aria-labelledby="discover-title" data-discovery-root>
    <div class="discover-tool__intro">
      <div>
        <p class="discover-label">行きたいところ検索</p>
        <h2 id="discover-title">いまの気分から探す</h2>
      </div>
      <p>完全一致が少ないときは、条件を少し広げた候補も表示します。検索結果をゼロのままにはしません。</p>
    </div>

    <form class="discover-form" data-discovery-form>
      <label>
        <span>どんな気分？</span>
        <input type="search" name="q" placeholder="例：雨でも、癒されたい、海、温泉、花火" autocomplete="off" />
      </label>
      <label>
        <span>誰と？</span>
        <select name="with">
          <option value="">指定なし</option>
          <option value="子連れ">子ども・家族</option>
          <option value="デート">恋人・デート</option>
          <option value="ひとり">ひとり</option>
          <option value="友人">友人</option>
        </select>
      </label>
      <label>
        <span>どの辺？</span>
        <select name="area">
          <option value="">茨城県全域</option>
          <option value="県北">県北</option>
          <option value="県央">県央</option>
          <option value="県南">県南</option>
          <option value="鹿行">鹿行</option>
          <option value="県西">県西</option>
        </select>
      </label>
      <label>
        <span>何したい？</span>
        <select name="theme">
          <option value="">おまかせ</option>
          <option value="イベント">イベント</option>
          <option value="花火">花火</option>
          <option value="紅葉">紅葉</option>
          <option value="水族館">水族館</option>
          <option value="公園">公園</option>
          <option value="雨の日">雨の日</option>
          <option value="温泉">温泉</option>
          <option value="グルメ">グルメ</option>
        </select>
      </label>
      <button type="submit">候補を見る</button>
    </form>

    {quickCandidates.length > 0 && (
      <div class="discover-quick" aria-label="人気の条件">
        <span>すぐ探す</span>
        {quickCandidates.map((item) => (
          <button type="button" data-quick-term={item.term}>
            {item.label}<small>{item.count}</small>
          </button>
        ))}
      </div>
    )}

    <div class="discover-status" aria-live="polite" data-discovery-status>
      現在、{entities.length}件の候補から探せます。まずはおすすめ{Math.min(initialLimit, entities.length)}件を表示しています。
    </div>

    <ul class="discover-results" data-discovery-results>
      {entities.map((item, index) => {
        const entry = entryById.get(item.id);
        if (!entry) return null;
        const image = listImageOf(entry);
        return (
          <li
            data-discovery-card
            data-search={item.searchText}
            data-area={item.regionLabels.join(' ')}
            data-tags={item.tags.join(' ')}
            data-kind={item.kind}
            data-rank={index}
            hidden={index >= initialLimit}
          >
            <a href={item.href}>
              <img src={image.src} alt="" loading="lazy" decoding="async" width="1200" height="630" />
              <span class="discover-card__meta">
                <b>{item.kind === 'event' ? 'EVENT' : 'GUIDE'}</b>
                {item.municipalityNames[0] && <span>{item.municipalityNames[0]}</span>}
              </span>
              <strong>{item.title}</strong>
              <p>{item.summary.slice(0, 96)}{item.summary.length > 96 ? '…' : ''}</p>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="discover-more">
      <a href="/events/">イベントを日付から探す →</a>
      <a href="/area/">44市町村から探す →</a>
    </div>
  </section>
</BrandBase>

<script>
  import { commonParams, trackEvent } from '../../lib/analytics-events';

  const root = document.querySelector<HTMLElement>('[data-discovery-root]');
  const form = root?.querySelector<HTMLFormElement>('[data-discovery-form]');
  const status = root?.querySelector<HTMLElement>('[data-discovery-status]');
  const cards = root ? [...root.querySelectorAll<HTMLElement>('[data-discovery-card]')] : [];
  const quickButtons = root ? [...root.querySelectorAll<HTMLButtonElement>('[data-quick-term]')] : [];

  const normalize = (value: FormDataEntryValue | string | null | undefined) =>
    String(value ?? '').trim().toLowerCase().normalize('NFKC');

  if (form && status && cards.length) {
    const runSearch = () => {
      const data = new FormData(form);
      const q = normalize(data.get('q'));
      const companion = normalize(data.get('with'));
      const area = normalize(data.get('area'));
      const theme = normalize(data.get('theme'));
      const terms = [q, companion, theme].filter(Boolean);

      const exact = cards.filter((card) => {
        const haystack = normalize(`${card.dataset.search} ${card.dataset.tags}`);
        const areaText = normalize(card.dataset.area);
        return terms.every((term) => haystack.includes(term)) && (!area || areaText.includes(area));
      });

      const scored = cards
        .map((card) => {
          const haystack = normalize(`${card.dataset.search} ${card.dataset.tags}`);
          const areaText = normalize(card.dataset.area);
          let score = 0;
          for (const term of terms) if (haystack.includes(term)) score += 3;
          if (area && areaText.includes(area)) score += 2;
          if (!area && terms.length === 0) score += 1;
          score -= Number(card.dataset.rank ?? 0) / 1000;
          return { card, score };
        })
        .sort((a, b) => b.score - a.score);

      const relaxed = scored.filter((item) => item.score > 0).map((item) => item.card);
      const chosen = (exact.length >= 3 ? exact : [...exact, ...relaxed.filter((card) => !exact.includes(card))]).slice(0, 12);

      if (chosen.length === 0) {
        chosen.push(...cards.slice(0, 12));
      }

      cards.forEach((card) => card.hidden = !chosen.includes(card));

      if (exact.length >= 3) {
        status.textContent = `条件に合う候補を${Math.min(exact.length, 12)}件表示しています。`;
      } else if (exact.length > 0) {
        status.textContent = `ぴったりの候補は${exact.length}件。近い条件の候補も含めて${chosen.length}件表示しています。`;
      } else {
        status.textContent = `完全一致はありませんでした。近い候補を${chosen.length}件表示しています。`;
      }

      trackEvent('discovery_search', {
        ...commonParams({ page_type: 'discover', content_category: 'utility' }),
        query_present: q ? 1 : 0,
        companion: companion || 'any',
        area: area || 'all',
        theme: theme || 'any',
        exact_count: exact.length,
        shown_count: chosen.length,
      });
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      runSearch();
    });

    for (const button of quickButtons) {
      button.addEventListener('click', () => {
        const input = form.querySelector<HTMLInputElement>('input[name="q"]');
        if (!input) return;
        input.value = button.dataset.quickTerm ?? '';
        runSearch();
      });
    }
  }
</script>

<style>
  .discover-head{padding-top:clamp(2rem,5vw,4.5rem);padding-bottom:2rem}
  .discover-head h1{margin:.8rem 0 1rem;font:600 clamp(2.6rem,7vw,5.4rem)/1.08 var(--font-brand-display);letter-spacing:-.035em;color:var(--color-ink)}
  .discover-head>p:last-child{max-width:42rem;color:var(--color-soil);line-height:1.9}
  .discover-tool{padding-bottom:5rem}
  .discover-tool__intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(16rem,30rem);gap:2rem;align-items:end;padding:1.5rem 0 1.25rem;border-top:1px solid var(--color-mist)}
  .discover-label{margin:0 0 .4rem;color:var(--color-tide);font:700 .74rem var(--font-brand-meta);letter-spacing:.12em}
  .discover-tool__intro h2{margin:0;font:600 clamp(1.8rem,4vw,3rem)/1.2 var(--font-brand-display)}
  .discover-tool__intro>p{margin:0;color:var(--color-soil);line-height:1.8}
  .discover-form{display:grid;grid-template-columns:2fr repeat(3,minmax(0,1fr)) auto;gap:.7rem;padding:1rem;border:1px solid var(--color-mist);border-radius:1rem;background:var(--color-white);box-shadow:0 16px 45px rgba(20,50,70,.08)}
  .discover-form label{display:grid;gap:.35rem}.discover-form label span{font-size:.74rem;font-weight:700;color:var(--color-soil)}
  .discover-form input,.discover-form select{width:100%;min-height:46px;padding:.7rem .8rem;border:1px solid var(--color-mist);border-radius:.65rem;background:#fff;color:var(--color-ink);font:inherit}
  .discover-form button{align-self:end;min-height:46px;padding:.75rem 1.15rem;border:0;border-radius:.65rem;background:var(--color-ink);color:#fff;font-weight:700;cursor:pointer}
  .discover-quick{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-top:1rem}
  .discover-quick>span{margin-right:.25rem;color:var(--color-soil);font-size:.78rem;font-weight:700}
  .discover-quick button{display:inline-flex;align-items:center;gap:.35rem;min-height:40px;padding:.5rem .75rem;border:1px solid var(--color-mist);border-radius:999px;background:#fff;color:var(--color-ink);font:inherit;font-size:.82rem;font-weight:700;cursor:pointer}
  .discover-quick button:hover,.discover-quick button:focus-visible{border-color:var(--color-tide);color:var(--color-tide)}
  .discover-quick button:focus-visible{outline:2px solid var(--color-tide);outline-offset:2px}
  .discover-quick small{color:var(--color-soil);font-size:.68rem}
  .discover-status{margin:1rem 0;color:var(--color-soil);font-size:.9rem}
  .discover-results{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:0;padding:0;list-style:none}
  .discover-results li[hidden]{display:none}
  .discover-results a{display:block;height:100%;overflow:hidden;border:1px solid var(--color-mist);border-radius:1rem;background:#fff;color:inherit;text-decoration:none}
  .discover-results img{width:100%;aspect-ratio:16/9;object-fit:cover;background:var(--color-mist)}
  .discover-card__meta{display:flex;gap:.6rem;align-items:center;padding:.9rem 1rem .2rem;color:var(--color-soil);font-size:.72rem}.discover-card__meta b{color:var(--color-tide);letter-spacing:.08em}
  .discover-results strong{display:block;padding:.35rem 1rem 0;font:600 1.04rem/1.55 var(--font-brand-display)}
  .discover-results p{margin:0;padding:.5rem 1rem 1.1rem;color:var(--color-soil);font-size:.82rem;line-height:1.75}
  .discover-more{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.4rem}.discover-more a{color:var(--interior-blue,#174f99);font-weight:700}
  @media (max-width:900px){.discover-tool__intro{grid-template-columns:1fr}.discover-form{grid-template-columns:1fr 1fr}.discover-form label:first-child{grid-column:1/-1}.discover-form button{grid-column:1/-1}.discover-results{grid-template-columns:1fr 1fr}}
  @media (max-width:600px){.discover-form{grid-template-columns:1fr}.discover-form label:first-child,.discover-form button{grid-column:auto}.discover-results{grid-template-columns:1fr}.discover-head h1{font-size:clamp(2.35rem,14vw,3.8rem)}}
</style>
