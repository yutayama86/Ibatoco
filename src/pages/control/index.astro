---
import ControlBase from '../../layouts/ControlBase.astro';
import performance from '../../../data/editorial/performance-snapshot.json';
import ledger from '../../../data/editorial/revenue-ledger.json';

const fmt = new Intl.NumberFormat('ja-JP');
const pct = (v: number | null | undefined, digits = 1) => v == null ? '—' : `${(v * 100).toFixed(digits)}%`;
const yen = (v: number | null | undefined) => v == null ? '—' : `¥${fmt.format(Math.round(v))}`;

const north = performance.northStar;
const ga7 = performance.windows.ga4.recent7;
const ga28 = performance.windows.ga4.recent28;
const gsc28 = performance.windows.gsc.recent28;
const conv = performance.conversionDetail.recent7;

const ledgerEntries = (ledger.entries ?? []) as Array<{ status?: string; revenueYen?: number }>;
const confirmedRevenue = ledgerEntries
  .filter((entry) => entry.status === 'confirmed')
  .reduce((sum, entry) => sum + Number(entry.revenueYen ?? 0), 0);
const siteRpm = ga28.views > 0 ? confirmedRevenue / ga28.views * 1000 : 0;

const topPages = performance.ga4TopPages?.recent7 ?? [];
const gscSignals = (performance.gscDiscovery?.findings ?? []).slice(0, 6);
const warnings = performance.source?.warnings ?? [];

const providerRows = performance.conversionDetail.byProviderPage ?? [];
const providerSummary = new Map<string, { provider: string; clicks: number; paid: number; candidate: number; official: number }>();
for (const row of providerRows) {
  const provider = String(row.link_provider ?? 'unknown');
  const current = providerSummary.get(provider) ?? { provider, clicks: 0, paid: 0, candidate: 0, official: 0 };
  const count = Number(row.event_count ?? 0);
  current.clicks += count;
  if (row.classification === 'paid') current.paid += count;
  if (row.classification === 'non-partner-candidate') current.candidate += count;
  if (row.classification === 'official') current.official += count;
  providerSummary.set(provider, current);
}
const providerTable = [...providerSummary.values()].sort((a,b) => b.clicks - a.clicks);

const freshness = performance.source?.freshness;
const paceBad = north.status !== 'on-pace' && north.status !== 'ahead';
const blockers = [
  ...(paceBad ? [`10万PV目標に対して28日換算 ${fmt.format(north.runRate28FromRecent7)} Views。必要日次平均 ${fmt.format(Math.round(north.requiredDailyAverage))}。`] : []),
  ...(Number(conv.active_unmapped_booking_click ?? 0) > 0 ? [`Active Partnerの未収益化clickが${conv.active_unmapped_booking_click}件。`] : []),
  ...(Number(conv.non_partner_candidate_click ?? 0) > 0 ? [`未提携候補clickが${conv.non_partner_candidate_click}件。Partner Opportunityで提携要否を確認。`] : []),
  ...(confirmedRevenue === 0 ? ['確定売上はまだ0円。ASP確定成果をledgerへ接続するとActual RPMが有効化されます。'] : []),
];

const generatedLabel = `GA4: ${freshness?.ga4LatestConfirmedDate ?? '—'} / GSC: ${freshness?.gscLatestConfirmedDate ?? '—'}`;
---

<ControlBase>
  <main class="control">
    <header class="control__head">
      <div>
        <p class="eyebrow">OWNER ONLY</p>
        <h1>Ibatoco Control Center</h1>
        <p class="sub">事業・集客・収益・運営を1画面で確認。GA4計測対象外。</p>
      </div>
      <div class="freshness">
        <span>DATA</span>
        <strong>{generatedLabel}</strong>
        <small>snapshot {performance.asOf}</small>
      </div>
    </header>

    <section class="metric-grid" aria-label="経営サマリー">
      <article class="metric metric--hero">
        <span>28日 Views</span>
        <strong>{fmt.format(ga28.views)}</strong>
        <small>目標 {fmt.format(north.target)} / 進捗 {pct(north.progress)}</small>
        <div class="bar"><i style={`width:${Math.min(100, north.progress * 100)}%`}></i></div>
      </article>
      <article class="metric">
        <span>7日 Views</span>
        <strong>{fmt.format(ga7.views)}</strong>
        <small>前週比 {performance.windows.ga4.recent7VsPrevious7.viewsPct > 0 ? '+' : ''}{performance.windows.ga4.recent7VsPrevious7.viewsPct.toFixed(1)}%</small>
      </article>
      <article class="metric">
        <span>GSC 28日 Clicks</span>
        <strong>{fmt.format(gsc28.clicks)}</strong>
        <small>{fmt.format(gsc28.impressions)} imp / CTR {pct(gsc28.ctr)}</small>
      </article>
      <article class="metric">
        <span>Paid Clicks / 7日</span>
        <strong>{fmt.format(Number(conv.paid_booking_click ?? 0))}</strong>
        <small>Commercial Share {pct(Number(conv.monetized_click_share ?? 0))}</small>
      </article>
      <article class="metric">
        <span>確定売上</span>
        <strong>{yen(confirmedRevenue)}</strong>
        <small>Site RPM {yen(siteRpm)} / 1,000 Views</small>
      </article>
      <article class="metric">
        <span>未提携候補 Clicks</span>
        <strong>{fmt.format(Number(conv.non_partner_candidate_click ?? 0))}</strong>
        <small>Active未収益化 {fmt.format(Number(conv.active_unmapped_booking_click ?? 0))}</small>
      </article>
    </section>

    <section class="two-col">
      <article class="panel">
        <div class="panel__head">
          <div><span>TRAFFIC</span><h2>勝ちページ</h2></div>
          <small>直近7日</small>
        </div>
        <ol class="rank-list">
          {topPages.map((item, index) => (
            <li>
              <span class="rank">{String(index + 1).padStart(2,'0')}</span>
              <a href={item.path} target="_blank" rel="noreferrer">{item.path}</a>
              <strong>{fmt.format(item.views)}</strong>
            </li>
          ))}
        </ol>
      </article>

      <article class="panel">
        <div class="panel__head">
          <div><span>REVENUE</span><h2>Booking Funnel</h2></div>
          <small>{conv.start} → {conv.end}</small>
        </div>
        <div class="funnel">
          <div><span>Guide View</span><strong>{fmt.format(Number(conv.booking_guide_view ?? 0))}</strong></div>
          <div><span>Booking Click</span><strong>{fmt.format(Number(conv.outbound_booking_click ?? 0))}</strong></div>
          <div><span>Official</span><strong>{fmt.format(Number(conv.official_booking_click ?? 0))}</strong></div>
          <div><span>Paid</span><strong>{fmt.format(Number(conv.paid_booking_click ?? 0))}</strong></div>
        </div>
        <p class="note">{performance.conversionDetail.interpretation}</p>
      </article>
    </section>

    <section class="two-col">
      <article class="panel">
        <div class="panel__head"><div><span>SEO</span><h2>検索機会</h2></div><small>GSC</small></div>
        <div class="signal-list">
          {gscSignals.map((item) => (
            <div class="signal">
              <div>
                <b>{item.query ?? item.signalType}</b>
                <a href={item.page} target="_blank" rel="noreferrer">{item.page}</a>
              </div>
              <p>{item.recommendedAction}</p>
              <small>{item.impressions != null ? `${fmt.format(item.impressions)} imp` : item.period}</small>
            </div>
          ))}
        </div>
      </article>

      <article class="panel">
        <div class="panel__head"><div><span>PARTNERS</span><h2>クリック内訳</h2></div><small>GA4実測</small></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Provider</th><th>Click</th><th>Paid</th><th>Candidate</th></tr></thead>
            <tbody>
              {providerTable.map((row) => (
                <tr><td>{row.provider}</td><td>{row.clicks}</td><td>{row.paid}</td><td>{row.candidate}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
    </section>

    <section class="two-col">
      <article class="panel panel--alert">
        <div class="panel__head"><div><span>ACTION</span><h2>今見るべきこと</h2></div></div>
        {blockers.length ? (
          <ul class="action-list">{blockers.map((item) => <li>{item}</li>)}</ul>
        ) : <p class="ok">重大ブロッカーなし。</p>}
      </article>

      <article class="panel">
        <div class="panel__head"><div><span>DATA HEALTH</span><h2>データ状態</h2></div></div>
        <dl class="health">
          <div><dt>GA4 latest</dt><dd>{freshness?.ga4LatestConfirmedDate ?? '—'}</dd></div>
          <div><dt>GSC latest</dt><dd>{freshness?.gscLatestConfirmedDate ?? '—'}</dd></div>
          <div><dt>Refresh</dt><dd>{freshness?.todayRefreshSucceeded ? 'OK' : 'CHECK'}</dd></div>
          <div><dt>Source</dt><dd>{performance.source?.primary ?? '—'}</dd></div>
        </dl>
        {warnings.length > 0 && <details><summary>Warnings / notes ({warnings.length})</summary><ul>{warnings.map((w) => <li>{w}</li>)}</ul></details>}
      </article>
    </section>

    <footer class="control__foot">
      <span>IBATOCO PRIVATE CONTROL</span>
      <a href="/" target="_blank" rel="noreferrer">公開サイトを開く ↗</a>
    </footer>
  </main>
</ControlBase>

<style>
  .control{width:min(calc(100% - 2rem),1180px);margin:auto;padding:2rem 0 4rem}
  .control__head{display:flex;justify-content:space-between;gap:2rem;align-items:flex-end;padding:1rem 0 2rem;border-bottom:1px solid var(--line)}
  .eyebrow,.panel__head span{margin:0;color:var(--accent);font-size:.7rem;font-weight:800;letter-spacing:.14em}
  h1{margin:.35rem 0 0;font-size:clamp(2rem,5vw,4.4rem);line-height:1;letter-spacing:-.045em}
  .sub{max-width:42rem;margin:.85rem 0 0;color:var(--muted);font-size:.88rem}
  .freshness{display:grid;gap:.2rem;text-align:right}.freshness span{color:var(--muted);font-size:.65rem}.freshness strong{font-size:.8rem}.freshness small{color:var(--muted);font-size:.68rem}
  .metric-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;margin-top:1rem}
  .metric{display:grid;gap:.45rem;min-height:145px;padding:1.1rem;border:1px solid var(--line);border-radius:14px;background:var(--panel)}
  .metric span{color:var(--muted);font-size:.74rem;font-weight:700}.metric strong{font-size:clamp(1.7rem,4vw,2.8rem);letter-spacing:-.04em}.metric small{color:var(--muted);font-size:.72rem;line-height:1.5}
  .metric--hero{grid-column:span 2;background:linear-gradient(135deg,var(--panel-2),var(--panel))}
  .bar{height:7px;margin-top:auto;border-radius:999px;background:#23304a;overflow:hidden}.bar i{display:block;height:100%;background:var(--accent);border-radius:inherit}
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:.8rem}
  .panel{min-width:0;padding:1.1rem;border:1px solid var(--line);border-radius:14px;background:var(--panel)}
  .panel__head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;margin-bottom:1rem}.panel__head h2{margin:.25rem 0 0;font-size:1.15rem}.panel__head small{color:var(--muted);font-size:.68rem}
  .rank-list{display:grid;gap:.25rem;margin:0;padding:0;list-style:none}.rank-list li{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;gap:.6rem;align-items:center;padding:.7rem 0;border-top:1px solid var(--line)}.rank-list li:first-child{border-top:0}.rank{color:var(--muted);font-size:.65rem}.rank-list a{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-decoration:none;font-size:.78rem}.rank-list strong{font-size:.78rem}
  .funnel{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem}.funnel div{display:grid;gap:.35rem;padding:.8rem;border-radius:10px;background:var(--panel-2)}.funnel span{color:var(--muted);font-size:.66rem}.funnel strong{font-size:1.35rem}.note{margin:1rem 0 0;color:var(--muted);font-size:.75rem;line-height:1.65}
  .signal-list{display:grid;gap:.6rem}.signal{padding:.8rem;border-radius:10px;background:var(--panel-2)}.signal div{display:flex;justify-content:space-between;gap:1rem}.signal b{font-size:.8rem}.signal a{max-width:45%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--accent);font-size:.68rem;text-decoration:none}.signal p{margin:.55rem 0;color:var(--muted);font-size:.73rem;line-height:1.6}.signal small{color:var(--muted);font-size:.64rem}
  .table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:.73rem}th,td{padding:.65rem .5rem;border-bottom:1px solid var(--line);text-align:right}th:first-child,td:first-child{text-align:left}th{color:var(--muted);font-size:.64rem}
  .panel--alert{border-color:#4b3c28}.action-list{display:grid;gap:.7rem;margin:0;padding-left:1.1rem}.action-list li{color:var(--warn);font-size:.8rem;line-height:1.6}.ok{color:var(--good)}
  .health{display:grid;gap:.2rem;margin:0}.health div{display:flex;justify-content:space-between;gap:1rem;padding:.65rem 0;border-bottom:1px solid var(--line)}.health dt{color:var(--muted);font-size:.72rem}.health dd{margin:0;font-size:.74rem;text-align:right}
  details{margin-top:1rem;color:var(--muted);font-size:.72rem}details ul{display:grid;gap:.5rem;padding-left:1.2rem;line-height:1.55}
  .control__foot{display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;padding:1rem 0;color:var(--muted);font-size:.67rem}.control__foot a{text-decoration:none;color:var(--accent)}
  @media(max-width:800px){.control{width:min(calc(100% - 1rem),1180px);padding-top:1rem}.control__head{align-items:flex-start;flex-direction:column}.freshness{text-align:left}.metric-grid{grid-template-columns:1fr 1fr}.metric--hero{grid-column:1/-1}.two-col{grid-template-columns:1fr}.funnel{grid-template-columns:1fr 1fr}}
  @media(max-width:480px){.metric-grid{grid-template-columns:1fr}.metric--hero{grid-column:auto}.metric{min-height:125px}.funnel{grid-template-columns:1fr 1fr}.control__foot{flex-direction:column}}
</style>
