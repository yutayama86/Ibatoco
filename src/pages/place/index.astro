---
import BrandBase from '../../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import ThemeNav from '../../components/ThemeNav.astro';
import { getPublishedStores, getIndexableNews } from '../../lib/content';
const stores = await getPublishedStores();
// 場所データがまだ無い間も行き止まりにしない。実在する読み物へ逃がす。
const latestNews = stores.length === 0 ? (await getIndexableNews()).slice(0, 3) : [];
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: '場所を探す' }];
---

<BrandBase title="場所を探す｜イバトコ" description="茨城で取材・確認できた店、施設、企業を探せます。公式情報と編集情報を分けて掲載します。" noindex={stores.length === 0} jsonLd={breadcrumbJsonLd(crumbs, Astro.site)}>
  <header class="places-head bp-wrap"><Breadcrumbs items={crumbs} /><p class="bp-kicker">PLACES</p><h1>確認できた場所から、<br />探す。</h1><p>住所や営業時間などの公式情報と、取材で受け取った物語を分けて掲載します。</p></header>
  <section class="theme-filter"><div class="bp-wrap"><ThemeNav /></div></section>
  {stores.length > 0 ? <section class="place-list bp-wrap">{stores.map((store) => <article><p>{store.data.area}</p><h2><a href={`/place/${store.id}/`}>{store.data.name}</a></h2><p>{store.data.tagline}</p><a href={`/place/${store.id}/`}>基本情報を見る →</a></article>)}</section> : <section class="place-empty bp-reading"><p class="bp-kicker">VERIFIED PLACES</p><h2>場所の情報は、確かめてから。</h2><p>公開確認済みの場所データはまだありません。架空の店名、住所、写真では埋めず、公式情報との照合が完了した場所から掲載します。</p><a href="/about/editorial-policy/">掲載基準を読む →</a>{latestNews.length > 0 && <div class="empty-exits"><h3>いま読めるもの</h3><ul><li><a href="/area/">44市町村から、街ごとに読む</a></li>{latestNews.map((item) => <li><a href={`/news/${item.id.split('/').pop()}/`}>{item.data.title}</a></li>)}</ul><p class="empty-more"><a href="/news/">茨城ニュース解説をすべて見る →</a></p></div>}</section>}
</BrandBase>

<style>
  .places-head{padding-block:clamp(5rem,11vw,9rem);border-bottom:1px solid var(--color-mist)}.places-head h1{margin-top:1rem;font:600 clamp(2.5rem,7vw,6rem)/1.2 var(--font-brand-display);color:var(--color-ink)}.places-head>p:last-child{max-width:var(--measure);margin-top:1.5rem;line-height:2;color:var(--color-soil)}
  .theme-filter{padding-block:clamp(3rem,6vw,5rem);background:var(--color-white)}.place-list{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;padding-block:clamp(4rem,9vw,7rem)}.place-list article{padding-block:1.5rem;border-block:1px solid var(--color-mist)}.place-list article>p:first-child{font-size:.72rem;color:var(--color-tide)}.place-list h2{margin-top:.4rem;font:600 1.5rem var(--font-brand-display);color:var(--color-ink)}.place-list h2+p{margin-top:.7rem;color:var(--color-soil);font-size:.85rem}.place-list article>a{display:inline-block;margin-top:1rem;color:var(--color-tide);font-size:.8rem;border-bottom:1px solid}
  .place-empty{padding-block:clamp(5rem,11vw,9rem)}.place-empty h2{margin-top:1rem;font:600 clamp(2rem,5vw,4rem)/1.3 var(--font-brand-display);color:var(--color-ink)}.place-empty>p:not(.bp-kicker){margin-top:1.5rem;line-height:2;color:var(--color-soil)}/* ボタンの形は interior.css がピル型（inline-flex・中央寄せ・4辺の枠）で描く。
     下線リンクだった頃の display / color / border-bottom は特異度でそれに勝ち、
     文字が上端に張り付く・下辺だけ色が違う、という崩れを起こしていたので外した。 */
  .place-empty a{margin-top:2rem}
  @media(max-width:800px){.place-list{grid-template-columns:minmax(0,1fr)}}
</style>
