---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BrandBase from '../../layouts/BrandBase.astro';
import PlaceFacts from '../../components/PlaceFacts.astro';
import BrandStoryCard from '../../components/BrandStoryCard.astro';
import DisclosureBadge from '../../components/DisclosureBadge.astro';
import { SITE_CONFIG } from '../../data/site';
import { getPublishedStores, getPublishedArticles } from '../../lib/content';
import { areaToSlug } from '../../data/areas';

export const getStaticPaths = (async () => (await getPublishedStores()).map((store) => ({ params: { id: store.id }, props: { store } }))) satisfies GetStaticPaths;

const { store } = Astro.props;
const { data } = store;
const Content = store.entry ? (await render(store.entry)).Content : null;
const articles = store.entry ? (await getPublishedArticles()).filter((article) => article.data.place?.id === store.entry!.id) : [];
const areaSlug = areaToSlug(data.area);
const absolute = (path: string) => new URL(path, Astro.site ?? SITE_CONFIG.domain).href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', name: data.name, description: data.description,
  ...(data.cover ? { image: absolute(data.cover) } : {}),
  ...(data.address ? { address: { '@type': 'PostalAddress', addressRegion: '茨城県', addressLocality: data.area, streetAddress: data.address, addressCountry: 'JP' } } : {}),
  ...(data.tel ? { telephone: data.tel } : {}), ...(data.website ? { url: data.website } : {}),
};
---

<BrandBase title={`${data.name}｜イバトコ`} description={data.description} image={data.cover} jsonLd={jsonLd}>
  <article class="place" data-place-id={store.id} data-place-name={data.name} data-place-category={data.category}>
    <header class="place-head bp-wrap">
      <div>
        <nav class="crumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href="/place/">場所</a>{areaSlug && <><span>/</span><a href={`/area/${areaSlug}/`}>{data.area}</a></>}</nav>
        <DisclosureBadge type={data.disclosure} note={data.disclosureNote} />
        <p class="bp-kicker place-kicker">PLACE / {data.area}</p><h1>{data.name}</h1><p>{data.tagline}</p>
      </div>
      <p class="place-note">掲載情報<br /><strong>公式情報と照合して掲載</strong>{data.verifiedAt && <><br />確認日：{data.verifiedAt.toLocaleDateString('ja-JP')}</>}</p>
    </header>

    {data.cover && <figure class="place-image bp-wrap"><img src={data.cover} alt={data.name} loading="eager" /></figure>}

    <div class="place-grid bp-wrap">
      <div class="place-main">
        <section><p class="bp-kicker">ABOUT</p><h2>この場所について</h2><div class="place-description">{Content ? <Content /> : <p>{data.description}</p>}</div></section>
        {data.features.length > 0 && <section><p class="bp-kicker">FEATURES</p><ul class="features">{data.features.map((feature) => <li>{feature}</li>)}</ul></section>}
        {data.faq.length > 0 && <section><p class="bp-kicker">QUESTIONS</p><h2>訪れる前に</h2><dl class="faq">{data.faq.map((item) => <div><dt>{item.q}</dt><dd>{item.a}</dd></div>)}</dl></section>}
      </div>
      <aside><p class="facts-label">基本情報</p><PlaceFacts store={store} />{data.website && <a class="official" href={data.website} target="_blank" rel="noopener noreferrer" data-place-action="official">公式サイトを確認する ↗</a>}<p class="fact-note">営業日時などは変更される場合があります。訪問前に公式情報をご確認ください。</p></aside>
    </div>
  </article>

  {articles.length > 0 && <section class="bp-wrap bp-section"><p class="bp-kicker">REPORTED STORIES</p><h2 class="bp-section-title">この場所を取材した記事</h2><div class="related">{articles.slice(0,2).map((article) => <BrandStoryCard article={article} />)}</div></section>}
</BrandBase>

<script>
  import { trackLocalBusinessClick } from '../../lib/analytics-events';

  for (const page of document.querySelectorAll<HTMLElement>('[data-place-id]')) {
    const businessId = page.dataset.placeId ?? '';
    const businessName = page.dataset.placeName ?? '';
    const businessCategory = page.dataset.placeCategory ?? '';
    for (const link of page.querySelectorAll<HTMLAnchorElement>('[data-place-action]')) {
      link.addEventListener('click', () => {
        trackLocalBusinessClick({
          business_id: businessId,
          business_name: businessName,
          business_category: businessCategory,
          link_kind: link.dataset.placeAction ?? 'official',
          page_type: 'place',
        });
      });
    }
  }
</script>

<style>
  .place{padding-block:clamp(4rem,9vw,7rem)}.crumbs{display:flex;gap:.55rem;margin-bottom:1.5rem;color:var(--color-soil);font-size:.78rem}.crumbs a{border-bottom:1px solid transparent}.crumbs a:hover{border-color:var(--color-tide)}
  .place-head{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:end}.place-kicker{margin-top:1.2rem}.place-head h1{margin-top:.8rem;font:600 clamp(2.3rem,6vw,5rem)/1.15 var(--font-brand-display);color:var(--color-ink)}.place-head>div>p:last-child{margin-top:1rem;font:500 1.15rem var(--font-brand-display);color:var(--color-soil)}
  .place-note{padding-left:1rem;border-left:1px solid var(--color-tide);font-size:.75rem;color:var(--color-soil)}.place-note strong{color:var(--color-ink)}.place-image{margin-top:3rem}.place-image img{width:100%;max-height:70vh;object-fit:cover}
  .place-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:clamp(3rem,8vw,7rem);padding-top:4rem}.place-main section+section{margin-top:3.5rem}.place-grid h2{margin-top:.6rem;font:600 clamp(1.6rem,3vw,2.5rem) var(--font-brand-display);color:var(--color-ink)}
  .place-description{margin-top:1.2rem;max-width:var(--measure);line-height:2;color:var(--color-soil)}.features{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.features li{padding:.4rem .7rem;border:1px solid var(--color-mist);font-size:.78rem}
  .facts-label{margin-bottom:.7rem;color:var(--color-tide);font-size:.75rem;font-weight:600}.official{display:inline-block;margin-top:1.5rem;border-bottom:1px solid var(--color-tide);font-size:.85rem}.fact-note{margin-top:1.2rem;color:var(--color-soil);font-size:.72rem;line-height:1.8}
  .faq{margin-top:1.5rem;border-top:1px solid var(--color-mist)}.faq div{padding-block:1rem;border-bottom:1px solid var(--color-mist)}.faq dt{font-weight:600;color:var(--color-ink)}.faq dd{margin-top:.5rem;color:var(--color-soil);line-height:1.8}
  .related{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;margin-top:2rem}.bp-section-title{margin-top:.7rem}
  @media(max-width:720px){.place-head,.place-grid,.related{grid-template-columns:1fr}.place-note{margin-top:1rem}}
</style>
