---
/**
 * /reporters/ — ローカルエディター（協力者）の案内ページ。
 *   目的：「協力したい」を引き出す。関わり方を段階的に提示する。
 *   前提：イバトコは収益化前で、金銭の支払いができない。求人・募集ではなく、
 *     無償の協力であることを、隠さず先に伝える。これを曖昧にすると、
 *     来てくれた人との認識がずれて、いちばん失礼なことになる。
 *   方針(CLAUDE.md)：虚偽の実績・数値・口コミ・SNSを作らない。PR/提供/招待は明示。
 *     断定・順位表現を使わない。本人確認と掲載許諾が済んだ人だけを公開する。
 *   公開中のエディターがいれば一覧表示、いなければ参加の呼びかけに集中する。
 */
import BrandBase from '../layouts/BrandBase.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import PersonCard from '../components/PersonCard.astro';
import { VISIBLE_REPORTERS } from '../data/reporters';

const CTA_EDITOR = `/contact/?subject=${encodeURIComponent('ローカルエディター')}`;
const CTA_TIP = `/contact/?subject=${encodeURIComponent('取材・掲載相談')}&detail=${encodeURIComponent('街の“いいとこ”を教えたいです。（場所・お店・季節の風景など、ひとことでも大丈夫です）')}`;
const CTA_PHOTO = `/contact/?subject=${encodeURIComponent('取材・掲載相談')}&detail=${encodeURIComponent('写真や体験を提供したいです。（撮影場所・訪れた感想など）')}`;
const CTA_GUIDE = `/contact/?subject=${encodeURIComponent('ローカルエディター')}&detail=${encodeURIComponent('取材の同行・地元の案内で協力したいです。（詳しいエリア・分野）')}`;

const ways = [
  { tag: 'いちばん気軽に', title: '街の“いいとこ”を教える', text: 'お店、景色、季節の風景。「ここ、いいよ」のひとことで十分です。あなたの一言が、取材のきっかけになります。', cta: CTA_TIP, label: '教える' },
  { tag: '写真・体験で', title: '写真や感想を寄せる', text: '撮った一枚や、行ってみた感想を。掲載するときは、提供者としてクレジットを明記します。', cta: CTA_PHOTO, label: '寄せる' },
  { tag: '地元の力で', title: '取材に同行・案内する', text: '地元だから知っている道、人、時間帯。編集部の取材に、案内役として加わってもらえます。', cta: CTA_GUIDE, label: '案内する' },
  { tag: '書き手として', title: 'ローカルエディターとして書く', text: '自分の足で取材し、記事にする。バイライン（署名）とプロフィールを公開します。無償での協力になりますが、書いたものはあなたの記事として残ります。', cta: CTA_EDITOR, label: '書いてみる' },
];

const standards = [
  { no: '01', title: '現地へ行く', text: '写真や伝聞ではなく、まず自分で足を運ぶ。その場の空気ごと持ち帰る。' },
  { no: '02', title: '話を聞く', text: '店主や職人、暮らす人に直接聞く。数字や肩書きの奥にある理由まで。' },
  { no: '03', title: '事実と印象を分ける', text: '確かめられたことと、自分が感じたこと。混ぜずに、正直に書く。' },
];

const who = [
  'その街に、好きな場所がひとつでもある人。',
  '派手な流行より、長く続いているものに惹かれる人。',
  '「行った・食べた・見た」を、大切にできる人。',
  '事実と自分の意見を、分けて書ける人。',
];

const steps = [
  { no: '01', title: '連絡する', text: 'フォームから、興味のある関わり方を送ってください。ひとことでも大丈夫です。' },
  { no: '02', title: '話す・確かめる', text: 'オンラインなどでお話しし、本人確認と、大切にしている方針を共有します。' },
  { no: '03', title: '一緒に試す', text: 'まずは1本、編集部と一緒に取材・編集してみます。相性を確かめる時間です。' },
  { no: '04', title: '公開する', text: 'プロフィールとバイラインを公開。あなたの視点で、街を記録していきます。' },
];

const promises = [
  ['本人確認と掲載許諾', '本人確認と掲載の許諾が済んだ人だけを、プロフィールとして公開します。'],
  ['PRと編集を分ける', '広告・提供・招待を受けた記事は、その旨を必ず明示します。編集の評価と混同しません。'],
  ['断定しない', '根拠のない断定や、順位づけの表現はしません。確かめられた事実にもとづいて書きます。'],
  ['払えないことは、先に言う', '現在は報酬も交通費もお支払いできません。曖昧にしたまま来ていただくことはしません。条件が変わったら、その時点でお伝えします。'],
];

const faq = [
  { q: '取材や執筆の経験がなくても参加できますか？', a: '参加できます。大切なのは経歴よりも、自分の足で確かめる姿勢です。まずは情報提供や写真から関わることもできます。' },
  { q: '茨城に住んでいないと参加できませんか？', a: 'いいえ。県外の方でも、通って・調べて確かめられれば大丈夫です。ただし、現地での取材を前提にしています。交通費はお支払いできないため、無理なく通える範囲でお願いしています。' },
  { q: '書くのは苦手です。写真や情報の提供だけでもいいですか？', a: 'もちろんです。「ここがいい」という情報や、撮った写真を寄せていただくだけでも、大きな力になります。' },
  { q: '報酬は出ますか？', a: 'いまは出せません。イバトコはまだ収益を得ていないため、金銭のお支払いはありません。お渡しできるのは、署名（バイライン）とプロフィールの公開、編集部と一緒に取材・編集する経験、そして掲載された記事そのものです。将来もし収益が立ったときの扱いは、そのときに改めて相談させてください。' },
  { q: '交通費や取材にかかる費用は？', a: '現時点では負担できません。ご自身の移動範囲・無理のない範囲でお願いしています。遠方への取材をお願いすることはありません。' },
  { q: 'ノルマや締め切りはありますか？', a: 'ありません。本数の約束もしていません。書ける時に、書けるぶんだけで大丈夫です。しばらく間が空いても、こちらから催促はしません。' },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'ローカルエディター（協力者）', item: new URL('/reporters/', Astro.site).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({
    '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const crumbs: Crumb[] = [{ name: 'ホーム', href: '/' }, { name: 'ローカルエディター（協力者）' }];
---

<BrandBase
  title="ローカルエディター（協力者）｜一緒に茨城を記録する｜イバトコ"
  ogTitle="その街のいいとこ、あなたが一番知っている。｜イバトコ"
  description="茨城を自分の足で歩き、確かめたことを記録するイバトコに、協力してくれる人を歓迎しています。情報提供・写真提供・取材同行から、記事を書くローカルエディターまで。収益化前のため報酬はお支払いできません。関わり方と、よくある質問。"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <header class="rp-hero">
    <div class="bp-wrap">
      <Breadcrumbs items={crumbs} />
      <p class="bp-kicker">JOIN IBATOCO ／ 協力してくれる人へ</p>
      <h1>その街のこと、<br />あなたが一番<br />知っている。</h1>
      <div class="rp-hero-body">
        <div class="rp-hero-lead">
          <p>イバトコは、茨城を自分の足で歩き、人に会い、確かめたことだけを書くローカルメディアです。</p>
          <p>大きな発信力より、その街を好きな気持ちと、事実への誠実さを大切にします。あなたの知っている“いいとこ”を、一緒に記録しませんか。</p>
        </div>
        <p class="rp-note">先にお伝えします。イバトコはまだ収益を得ていないため、<strong>報酬や交通費はお支払いできません</strong>。求人ではなく、無償での協力のお願いです。それでも面白がってくれる方と、街を歩きたいと思っています。</p>
      </div>
      <div class="rp-cta-row">
        <a class="btn-primary" href={CTA_EDITOR}>協力したいと伝える →</a>
        <a class="btn-ghost" href={CTA_TIP}>まず街のいいとこを教える</a>
      </div>
    </div>
  </header>

  <!-- WHY -->
  <section class="rp-why"><div class="bp-wrap">
    <div>
      <p class="bp-kicker">WHY YOU</p>
      <h2 class="bp-section-title">魅力は、足りないのではない。<br />「伝わっていない」だけ。</h2>
    </div>
    <p>地域のいいものは、たいてい足りていないのではなく、見つけられない・伝わっていない。だからこそ、実際にそこへ通い、好きだと言える人の一次情報がいちばん強い。肩書きよりも、その現場を知っているあなたと組みたいと思っています。</p>
  </div></section>

  <!-- WAYS TO JOIN -->
  <section class="rp-ways bp-wrap">
    <header><p class="bp-kicker">WAYS TO JOIN</p><h2 class="bp-section-title">参加のかたちは、ひとつじゃない。</h2><p>「書く」だけが参加ではありません。あなたに合った関わり方から、無理なく始められます。</p></header>
    <div class="rp-ways-grid">{ways.map((w) => (
      <article class="rp-way">
        <span class="rp-way-tag">{w.tag}</span>
        <h3>{w.title}</h3>
        <p>{w.text}</p>
        <a class="rp-way-link" href={w.cta}>{w.label} <span aria-hidden="true">→</span></a>
      </article>
    ))}</div>
  </section>

  <!-- WHAT EDITORS DO -->
  <section class="rp-standard bp-wrap">
    <header><p class="bp-kicker">WHAT EDITORS DO</p><h2 class="bp-section-title">ローカルエディターの、<br />たった3つの約束。</h2><p>むずかしい資格はいりません。この3つを守れる人と、街を歩きます。</p></header>
    <div class="rp-standard-grid">{standards.map((s) => (
      <article><span class="rp-num">{s.no}</span><h3>{s.title}</h3><p>{s.text}</p></article>
    ))}</div>
  </section>

  <!-- WHO -->
  <section class="rp-who"><div class="bp-wrap">
    <div>
      <p class="bp-kicker">WHO WE LOOK FOR</p>
      <h2 class="bp-section-title">こんな人と、歩きたい。</h2>
      <p class="rp-who-note">経験・年齢・フォロワー数は問いません。大切なのは、地域への理解と、事実への誠実さです。</p>
    </div>
    <ul class="rp-who-list">{who.map((w) => <li>{w}</li>)}</ul>
  </div></section>

  <!-- STEPS -->
  <section class="rp-steps bp-wrap">
    <header><p class="bp-kicker">HOW IT WORKS</p><h2 class="bp-section-title">参加までの流れ。</h2><p>いきなり「書いてください」とは言いません。話して、確かめて、一緒に試してから。</p></header>
    <ol class="rp-steps-list">{steps.map((s) => (
      <li><span class="rp-num">{s.no}</span><strong>{s.title}</strong><span>{s.text}</span></li>
    ))}</ol>
  </section>

  <!-- CURRENT EDITORS (公開中がいれば) -->
  {VISIBLE_REPORTERS.length > 0 ? (
    <section class="rp-people bp-wrap">
      <header><p class="bp-kicker">LOCAL EDITORS</p><h2 class="bp-section-title">いま、街を歩いている人たち。</h2></header>
      <div class="rp-people-grid">{VISIBLE_REPORTERS.map((person) => <PersonCard person={person} />)}</div>
    </section>
  ) : (
    <section class="rp-people-empty bp-wrap">
      <div>
        <p class="bp-kicker">LOCAL EDITORS</p>
        <h2 class="bp-section-title">最初のひとりに、<br />なりませんか。</h2>
      </div>
      <div>
        <p>いま公開できるプロフィールはありません。本人確認と掲載許諾が済んだ人だけを公開する方針だからです。あなたの参加を、待っています。</p>
        <div class="rp-cta-row">
          <a class="btn-primary" href={CTA_EDITOR}>協力したいと伝える →</a>
          <a class="btn-ghost" href={CTA_TIP}>まず街のいいとこを教える</a>
        </div>
      </div>
    </section>
  )}

  <!-- PROMISES -->
  <section class="rp-promise"><div class="bp-wrap">
    <header><p class="bp-kicker">OUR PROMISE</p><h2 class="bp-section-title">イバトコが、守ること。</h2></header>
    <dl>{promises.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
    <a class="rp-inline-link" href="/about/editorial-policy/">編集方針を読む →</a>
  </div></section>

  <!-- FAQ -->
  <section class="rp-faq bp-wrap">
    <header><p class="bp-kicker">FAQ</p><h2 class="bp-section-title">よくある質問。</h2></header>
    <dl>{faq.map((f) => <div><dt>{f.q}</dt><dd>{f.a}</dd></div>)}</dl>
  </section>

  <!-- FINAL CTA -->
  <section class="rp-final"><div class="bp-wrap">
    <p class="bp-kicker">START HERE</p>
    <h2>その街の“いいとこ”を、<br />いちばん知っているのは、あなたです。</h2>
    <div class="rp-cta-row">
      <a class="btn-primary invert" href={CTA_EDITOR}>協力したいと伝える →</a>
      <a class="btn-ghost invert" href={CTA_TIP}>街のいいとこを教える</a>
    </div>
    <p class="rp-final-sub">お店・企業として協力したい方は <a href="/biz/">地域事業者向けのご案内</a> をご覧ください。</p>
  </div></section>
</BrandBase>

<style>
  /*
   * 本文の基準幅。日本語1文字＝1em なので em で測る。
   * ch は半角基準のため、56ch と書いても28字にしかならない。
   * このページはそれで幅が6種類にばらけ、右の余白が不揃いに見えていた。
   */
  .rp-hero,.rp-why,.rp-ways,.rp-standard,.rp-who,.rp-steps,.rp-people-empty,.rp-faq{--rp-measure:36em}

  /* HERO */
  .rp-hero{padding-block:clamp(4.5rem,10vw,8.5rem);border-bottom:1px solid var(--color-mist)}
  .rp-hero h1{margin-top:1.2rem;font:600 clamp(2.8rem,8vw,6.4rem)/1.08 var(--font-brand-display);color:var(--color-ink);letter-spacing:.01em}
  /* 日本語の見出しは、行が不均等だと「の、」のような断片が行頭に落ちる */
  .rp-hero h1,.rp-hero-lead,.rp-note,section h2,section h3{text-wrap:pretty}
  section h2{text-wrap:balance}
  /* 横に長い画面で右半分が空いていたので、リードと注記を並べて幅を使う */
  /* 読みカラム(780px)では2列にすると1列366px＝日本語で約21字になる。30remで縦積みにする */
  .rp-hero-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,30rem),1fr));gap:clamp(1.6rem,3vw,3rem);align-items:start;margin-top:1.8rem}
  .rp-hero-lead{display:grid;gap:1rem;max-width:var(--rp-measure);color:var(--color-soil);line-height:2}
  /* 報酬が出ないことの注記。リードの 52ch（日本語だと約26字）に入れると
     窮屈で改行が汚くなるため、リードの外に出して独自の幅を持たせる。 */
  .rp-note{max-width:var(--rp-measure);padding:1.15rem 1.4rem;border-left:3px solid var(--color-tide);background:color-mix(in srgb,var(--color-mist) 50%,transparent);color:var(--color-soil);font-size:.92rem;line-height:1.95}
  .rp-note strong{color:var(--color-ink);font-weight:600}
  .rp-cta-row{display:flex;flex-wrap:wrap;gap:1rem;margin-top:2.4rem;align-items:center}
  .btn-primary{display:inline-block;padding:1rem 1.8rem;background:var(--color-ink);color:var(--color-paper);font:600 1rem var(--font-brand-body);border:1px solid var(--color-ink);transition:background .2s,color .2s}
  .btn-primary:hover{background:var(--color-tide);border-color:var(--color-tide);color:#fff}
  .btn-ghost{display:inline-block;padding:1rem 0;color:var(--color-ink);border-bottom:1px solid var(--color-ink);font:600 1rem var(--font-brand-body)}
  .btn-ghost:hover{color:var(--color-tide);border-color:var(--color-tide)}
  .btn-primary.invert{background:var(--color-paper);color:var(--color-ink);border-color:var(--color-paper)}.btn-primary.invert:hover{background:var(--color-tide);color:#fff;border-color:var(--color-tide)}
  .btn-ghost.invert{color:var(--color-paper);border-color:rgba(255,255,255,.5)}.btn-ghost.invert:hover{color:#fff;border-color:#fff}

  /* WHY */
  .rp-why{padding-block:clamp(4rem,9vw,7rem)}/* 見出しの下に本文を積むと広い画面で右が丸ごと空くため、.rp-who と同じ2カラムに揃える */.rp-why>div{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(2rem,6vw,5rem);align-items:start}.rp-why h2{margin-top:.7rem}.rp-why>div>p:last-child{max-width:var(--rp-measure);color:var(--color-soil);line-height:2}

  /* WAYS */
  .rp-ways{padding-block:clamp(4rem,9vw,7rem);border-top:1px solid var(--color-mist)}
  .rp-ways>header{max-width:var(--rp-measure);margin-bottom:2.5rem}.rp-ways>header>p:last-child{margin-top:1rem;color:var(--color-soil);line-height:1.9}
  .rp-ways-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem}
  .rp-way{display:flex;flex-direction:column;padding:1.8rem;background:var(--color-white);border:1px solid var(--color-mist);transition:border-color .2s,transform .2s}
  .rp-way:hover{border-color:var(--color-tide);transform:translateY(-2px)}
  .rp-way-tag{align-self:flex-start;padding:.2rem .6rem;background:color-mix(in srgb,var(--color-tide) 12%,transparent);color:var(--color-tide);font:600 .68rem var(--font-brand-meta);letter-spacing:.08em;border-radius:2px}
  .rp-way h3{margin-top:1rem;font:600 clamp(1.3rem,2.3vw,1.75rem) var(--font-brand-display);color:var(--color-ink)}
  .rp-way p{margin-top:.7rem;color:var(--color-soil);line-height:1.85;flex:1}
  .rp-way-link{margin-top:1.2rem;color:var(--color-tide);font:600 .92rem var(--font-brand-body);border-bottom:1px solid;align-self:flex-start;padding-bottom:.1rem}

  /* STANDARD */
  .rp-standard{padding-block:clamp(4rem,9vw,7rem);border-top:1px solid var(--color-mist)}
  .rp-standard>header{max-width:var(--rp-measure);margin-bottom:2.5rem}.rp-standard>header>p:last-child{margin-top:1rem;color:var(--color-soil);line-height:1.9}
  .rp-standard-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}
  .rp-standard-grid article{border-top:2px solid var(--color-ink);padding-top:1.1rem}
  .rp-num{font:600 .78rem var(--font-brand-meta);color:var(--color-tide)}
  .rp-standard-grid h3{margin-top:.5rem;font:600 clamp(1.3rem,2.3vw,1.9rem) var(--font-brand-display);color:var(--color-ink)}
  .rp-standard-grid p{margin-top:.7rem;color:var(--color-soil);line-height:1.85}

  /* WHO */
  .rp-who{background:var(--color-white);border-top:1px solid var(--color-mist)}
  .rp-who>div{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(2rem,6vw,5rem);padding-block:clamp(4rem,9vw,7rem);align-items:start}
  .rp-who h2{margin-top:.7rem}.rp-who-note{margin-top:1.3rem;color:var(--color-soil);line-height:1.95;max-width:var(--rp-measure)}
  .rp-who-list{display:grid;gap:0}.rp-who-list li{padding:1.2rem 0;border-bottom:1px solid var(--color-mist);color:var(--color-ink);font:500 clamp(1.05rem,1.9vw,1.35rem)/1.6 var(--font-brand-display)}
  .rp-who-list li:first-child{border-top:1px solid var(--color-mist)}

  /* STEPS */
  .rp-steps{padding-block:clamp(4rem,9vw,7rem);border-top:1px solid var(--color-mist)}
  .rp-steps>header{max-width:var(--rp-measure);margin-bottom:2.5rem}.rp-steps>header>p:last-child{margin-top:1rem;color:var(--color-soil);line-height:1.9}
  .rp-steps-list{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;margin:0;padding:0;border-top:1px solid var(--color-ink)}
  .rp-steps-list li{display:grid;gap:.5rem;padding:1.3rem 1.2rem 1.6rem;border-right:1px solid var(--color-mist)}
  .rp-steps-list li:last-child{border-right:0}
  .rp-steps-list strong{font:600 1.25rem var(--font-brand-display);color:var(--color-ink)}
