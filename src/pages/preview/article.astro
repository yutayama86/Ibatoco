---
import PreviewBrand from '../../layouts/PreviewBrand.astro'; import DisclosureBadge from '../../components/DisclosureBadge.astro'; import ReportingMeta from '../../components/ReportingMeta.astro'; import BrandStoryCard from '../../components/BrandStoryCard.astro'; import {getPublishedArticles} from '../../lib/content'; import {render} from 'astro:content';
const articles=await getPublishedArticles(); const article=articles[0]; const Content=article?(await render(article)).Content:null; const d=article?.data;
---
<PreviewBrand title="記事ページ preview｜イバトコ">
{article&&d&&Content&&<article class="story"><header class="story-head bp-reading"><DisclosureBadge type={d.disclosure}/><p class="story-label">{d.area} / {d.category}</p><h1>{d.title}</h1><p class="story-deck">{d.description}</p></header>{d.cover&&<figure class="story-hero bp-wrap"><img src={d.cover} alt={d.coverAlt}/></figure>}<div class="story-grid bp-wrap"><aside><ReportingMeta publishedAt={d.publishedAt} updatedAt={d.updatedAt} reportingDate={d.reportingDate} onSiteReporting={d.onSiteReporting} disclosureNote={d.disclosureNote}/><p class="story-by">取材・執筆<br/><strong>{d.reporter??d.author}</strong></p></aside><div class="story-body prose"><Content/></div></div><footer class="story-footer bp-reading"><p>この記事についてお気づきの点がある場合は、訂正・更新方針をご確認ください。</p><a href="/about/corrections/">訂正・更新方針 →</a></footer></article>}
{!article&&<section class="preview-empty bp-reading"><p class="bp-kicker">EDITORIAL STORY</p><h1>記事は、確認を終えてから。</h1><p>公開確認済みの記事データがまだないため、架空の記事を使った画面見本は表示していません。取材・事実確認・公開許諾が完了した記事から、この設計に流し込みます。</p><a href="/about/editorial-policy/">編集方針を読む →</a></section>}
{articles.length>1&&<section class="bp-wrap bp-section"><p class="bp-kicker">RELATED STORIES</p><div class="related">{articles.slice(1,3).map(a=><BrandStoryCard article={a}/>)}</div></section>}
</PreviewBrand>
<style>.story{padding-top:clamp(4rem,9vw,7rem)}.story-head{text-align:left}.story-label{margin-top:1.5rem;color:var(--color-tide);font:.75rem var(--font-brand-meta);letter-spacing:.1em}.story-head h1{margin-top:.7rem;font:600 clamp(2rem,5.4vw,4.4rem)/1.3 var(--font-brand-display);color:var(--color-ink)}.story-deck{margin-top:1.4rem;font:500 clamp(1rem,1.7vw,1.2rem)/2 var(--font-brand-display);color:var(--color-soil)}.story-hero{margin-top:3rem}.story-hero img{width:100%;max-height:70vh;object-fit:cover}.story-grid{display:grid;grid-template-columns:230px minmax(0,700px);justify-content:center;gap:clamp(2rem,6vw,5rem);padding-block:4rem}.story-by{margin-top:1.5rem;color:var(--color-soil);font-size:.8rem;line-height:1.8}.story-by strong{color:var(--color-ink)}.story-body.prose h2{border-left:0;padding-left:0;color:var(--color-ink)}.story-body.prose a{color:var(--color-tide)}.story-body.prose li:before{background:var(--color-tide)}.story-footer{border-block:1px solid var(--color-mist);padding-block:1.5rem;color:var(--color-soil);font-size:.82rem}.story-footer a{display:inline-block;margin-top:.5rem;color:var(--color-tide)}.related{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;margin-top:2rem}@media(max-width:760px){.story-grid{grid-template-columns:minmax(0,1fr)}.related{grid-template-columns:minmax(0,1fr)}}
</style>
<style>.preview-empty{padding-block:clamp(6rem,14vw,11rem)}.preview-empty h1{margin-top:1rem;font:600 clamp(2.2rem,6vw,4.6rem)/1.25 var(--font-brand-display);color:var(--color-ink)}.preview-empty>p:not(.bp-kicker){margin-top:2rem;line-height:2;color:var(--color-soil)}.preview-empty a{display:inline-block;margin-top:2rem;color:var(--color-tide);border-bottom:1px solid}</style>
