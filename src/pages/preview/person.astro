---
import PreviewBrand from '../../layouts/PreviewBrand.astro'; import BrandStoryCard from '../../components/BrandStoryCard.astro'; import {VISIBLE_REPORTERS} from '../../data/reporters'; import {getArticlesByReporter} from '../../lib/content';
const person=VISIBLE_REPORTERS[0]; const articles=person?await getArticlesByReporter(person.name):[]; const name=person?.name.replace(/^公式レポーター\s*/,'');
---
<PreviewBrand title="人物ページ preview｜イバトコ">{person?<article class="person"><header class="person-head bp-wrap"><div class="person-initial" aria-hidden="true">{name?.slice(0,1)}</div><div><p class="bp-kicker">{person.role.replace('公式レポーター','ローカルエディター')}</p><h1>{name}</h1><p>{person.title}</p></div></header><div class="person-grid bp-wrap"><main><p class="person-bio">{person.bio}</p>{person.philosophy&&<blockquote>{person.philosophy}</blockquote>}</main><aside><dl><div><dt>担当</dt><dd>{person.area}</dd></div><div><dt>専門</dt><dd>{person.expertise?.join('、')}</dd></div><div><dt>活動開始</dt><dd>{person.since}年</dd></div></dl><a href="/about/editorial-policy/">編集方針を読む →</a></aside></div>{articles.length>0&&<section class="bp-wrap bp-section"><p class="bp-kicker">STORIES</p><h2 class="bp-section-title">この人が取材した物語</h2><div class="person-stories">{articles.map(a=><BrandStoryCard article={a}/>)}</div></section>}</article>:<section class="person-empty bp-reading"><p class="bp-kicker">LOCAL EDITORS</p><h1>人物ページは、本人確認から。</h1><p>公開プロフィールは、本人確認と掲載許諾が完了したローカルエディターだけを掲載します。現在、公開可能な人物データはありません。</p><a href="/about/team/">編集体制を知る →</a></section>}</PreviewBrand>
<style>.person{padding-top:clamp(4rem,9vw,7rem)}.person-head{display:grid;grid-template-columns:clamp(90px,14vw,160px) 1fr;gap:clamp(1.5rem,5vw,4rem);align-items:center}.person-initial{aspect-ratio:1;border-radius:50%;display:grid;place-items:center;background:var(--color-mist);font:600 clamp(2.5rem,6vw,5rem) var(--font-brand-display);color:var(--color-ink)}.person-head h1{margin-top:.5rem;font:600 clamp(2.5rem,6vw,5rem) var(--font-brand-display);color:var(--color-ink)}.person-head div>p:last-child{margin-top:.5rem;color:var(--color-soil);font:500 1.1rem var(--font-brand-display)}.person-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:clamp(3rem,8vw,7rem);padding-top:4rem}.person-bio{font:500 clamp(1.1rem,2vw,1.35rem)/2 var(--font-brand-display);color:var(--color-ink)}.person blockquote{margin-top:2.5rem;padding:1.5rem 0;border-block:1px solid var(--color-mist);font:500 1rem/2 var(--font-brand-display);color:var(--color-soil)}.person dl{border-top:1px solid var(--color-mist)}.person dl div{padding:1rem 0;border-bottom:1px solid var(--color-mist)}.person dt{font-size:.72rem;color:var(--color-soil)}.person dd{margin-top:.25rem;color:var(--color-ink);font-size:.88rem}.person aside>a{display:inline-block;margin-top:1.2rem;color:var(--color-tide);border-bottom:1px solid}.person-stories{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;margin-top:2rem}@media(max-width:700px){.person-head{grid-template-columns:80px 1fr}.person-grid,.person-stories{grid-template-columns:minmax(0,1fr)}}
</style>
<style>
  .person-empty{padding-block:clamp(6rem,14vw,11rem)}
  .person-empty h1{margin-top:1rem;font:600 clamp(2.2rem,6vw,4.6rem)/1.25 var(--font-brand-display);color:var(--color-ink)}
  .person-empty>p:not(.bp-kicker){margin-top:2rem;line-height:2;color:var(--color-soil)}
  .person-empty a{display:inline-block;margin-top:2rem;color:var(--color-tide);border-bottom:1px solid}
</style>
