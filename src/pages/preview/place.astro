---
import PreviewBrand from '../../layouts/PreviewBrand.astro'; import PlaceFacts from '../../components/PlaceFacts.astro'; import {getPublishedStores} from '../../lib/content';
const stores=await getPublishedStores(); const store=stores[0]; const d=store?.data;
---
<PreviewBrand title="場所ページ preview｜イバトコ">{store&&d?<article class="place"><header class="place-head bp-wrap"><div><p class="bp-kicker">PLACE / {d.area}</p><h1>{d.name}</h1><p>{d.tagline}</p></div><p class="place-note">掲載情報<br/><strong>最終確認準備中</strong></p></header>{d.cover&&<figure class="place-image bp-wrap"><img src={d.cover} alt={d.name}/></figure>}<div class="place-grid bp-wrap"><main><section><p class="bp-kicker">ABOUT</p><h2>この場所について</h2><p>{d.description}</p></section>{d.features.length>0&&<section><p class="bp-kicker">FEATURES</p><ul class="features">{d.features.map(f=><li>{f}</li>)}</ul></section>}</main><aside><p class="facts-label">公式情報</p><PlaceFacts store={store}/>{d.website&&<a class="official" href={d.website}>公式サイトを確認する ↗</a>}</aside></div></article>:<section class="place-empty bp-reading"><p class="bp-kicker">PLACE</p><h1>場所の情報は、確かめてから。</h1><p>公開確認済みの場所データがまだないため、架空の店名・住所・写真は表示していません。所在地、営業時間、公式リンクなどの確認が完了した場所から掲載します。</p><a href="/about/editorial-policy/">掲載基準を読む →</a></section>}</PreviewBrand>
<style>.place{padding-block:clamp(4rem,9vw,7rem)}.place-head{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:end}.place-head h1{margin-top:.8rem;font:600 clamp(2.3rem,6vw,5rem)/1.15 var(--font-brand-display);color:var(--color-ink)}.place-head>div>p:last-child{margin-top:1rem;font:500 1.15rem var(--font-brand-display);color:var(--color-soil)}.place-note{padding-left:1rem;border-left:1px solid var(--color-tide);font-size:.75rem;color:var(--color-soil)}.place-note strong{color:var(--color-ink)}.place-image{margin-top:3rem}.place-image img{width:100%;max-height:70vh;object-fit:cover}.place-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:clamp(3rem,8vw,7rem);padding-top:4rem}.place-grid main section+section{margin-top:3rem}.place-grid h2{margin-top:.6rem;font:600 clamp(1.6rem,3vw,2.5rem) var(--font-brand-display);color:var(--color-ink)}.place-grid main section>p:last-child{margin-top:1.2rem;max-width:var(--measure);line-height:2;color:var(--color-soil)}.features{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.features li{padding:.4rem .7rem;border:1px solid var(--color-mist);font-size:.78rem}.facts-label{margin-bottom:.7rem;color:var(--color-tide);font-size:.75rem;font-weight:600}.official{display:inline-block;margin-top:1.5rem;border-bottom:1px solid var(--color-tide);font-size:.85rem}@media(max-width:720px){.place-head,.place-grid{grid-template-columns:minmax(0,1fr)}.place-note{margin-top:1rem}}
</style>
<style>.place-empty{padding-block:clamp(6rem,14vw,11rem)}.place-empty h1{margin-top:1rem;font:600 clamp(2.2rem,6vw,4.6rem)/1.25 var(--font-brand-display);color:var(--color-ink)}.place-empty>p:not(.bp-kicker){margin-top:2rem;line-height:2;color:var(--color-soil)}/* ボタンの形は interior.css がピル型（inline-flex・中央寄せ・4辺の枠）で描く。
     下線リンクだった頃の display / color / border-bottom は特異度でそれに勝ち、
     文字が上端に張り付く・下辺だけ色が違う、という崩れを起こしていたので外した。 */
  .place-empty a{margin-top:2rem}</style>
