---
import BrandBase from '../layouts/BrandBase.astro';
import { wikimediaImage } from '../lib/wikimedia-image';
import { isWorthLinking, lifecycleOf } from '../lib/lifecycle';
import HomeThemeNav from '../components/HomeThemeNav.astro';
import ThisWeek from '../components/ThisWeek.astro';
import HomeNow from '../components/HomeNow.astro';
import HomeEditorialProcess from '../components/HomeEditorialProcess.astro';
import HomeAreaExplorer from '../components/HomeAreaExplorer.astro';
import HomeJourney from '../components/HomeJourney.astro';
import V42Icon from '../components/V42Icon.astro';
import NewsCard from '../components/NewsCard.astro';
import { getIndexableNews } from '../lib/content';
import { SITE_CONFIG } from '../data/site';
import { FOOD_GUIDES, FOOD_PHOTOS, licenseUrl } from '../data/food-library';

// 終わった催しのニュースはTOPに出さない（/news/ の一覧と記事URLには残る）
const latestNews = (await getIndexableNews()).filter((item) => isWorthLinking(lifecycleOf(item))).slice(0, 3);
const discoveryIntents = [
  { label: '今週末', href: '#discover-now', note: '今日・明日・週末から', icon: 'M5 5h14a1 1 0 0 1 1 1v13H4V6a1 1 0 0 1 1-1Zm2-2v4m10-4v4M4 9h16m-9 5 2 2 3-4' },
  { label: '紅葉', href: '/kouyou/', note: '見頃とドライブ', icon: 'm12 3 2.5 5 3-1-.2 4 3.7 2.5-2.3 3.5-5.7.2L12 22l-1-4.8-5.7-.2L3 13.5 6.7 11l-.2-4 3 1L12 3Zm0 14v-6' },
  { label: '子どもと', href: '/shindan/?who=family', note: '家族のおでかけ', icon: 'M3 20v-3a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v3m2 0v-2a3 3 0 0 1 3-3h1a3 3 0 0 1 3 3v2M11 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm9 3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z' },
  { label: 'デート', href: '/shindan/?who=couple', note: 'ふたりで過ごす', icon: 'M12 20 5 13a4.5 4.5 0 0 1 6.4-6.4l.6.6.6-.6A4.5 4.5 0 0 1 19 13Z' },
  { label: '雨の日', href: '/shindan/?weather=rain', note: '天気を気にせず', icon: 'M3 12a9 9 0 0 1 18 0Zm9 0v6a2.5 2.5 0 0 0 5 0M12 3V2' },
  { label: 'エリア', href: '/area/', note: '44市町村から', icon: 'M19 10c0 4.5-7 10-7 10S5 14.5 5 10a7 7 0 1 1 14 0Zm-5 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z' },
];

// TOP修正指示書 §5：title に「茨城」を含める（ブランドタグライン「現地から、信頼を編む。」はフッター/Aboutで維持）。
const pageTitle = 'イバトコ｜茨城を歩いてつくるローカルメディア';
const pageDescription = '茨城の44市町村を歩いて取材するローカルメディア。食べる、出かける、泊まる、暮らす、整える、働く。現地で会って聞いた茨城を届けます。';
// §6：Organization / WebSite の構造化データ。公式SNSは sameAs に反映（実URLのみ）。
const siteUrl = new URL('/', Astro.site).href;
const socialSameAs = Object.values(SITE_CONFIG.social).filter((u) => typeof u === 'string' && u.length > 0);
const homeJsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'イバトコ', url: siteUrl, areaServed: { '@type': 'AdministrativeArea', name: '茨城県' }, ...(socialSameAs.length ? { sameAs: socialSameAs } : {}) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'イバトコ', url: siteUrl },
];

// v42 のFV。実写のネモフィラを先頭に、3枚を5秒ごとに切り替える（操作ボタン・動きを抑える設定を引き継ぐ）。
// 見出しの改行は COPY-LINES-v42.json（home.hero-nemophila）どおり、すべての幅で2行。
const nemophila = {
  src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/2025_Hitachi_Seaside_Park.jpg/1280px-2025_Hitachi_Seaside_Park.jpg',
  alt: '国営ひたち海浜公園に咲くネモフィラ',
};
const heroSlides = [
  {
    theme: 'walk',
    href: '/area/hitachinaka/',
    tab: '海浜公園を歩く',
    tabShort: '海浜公園を歩く',
    kicker: 'ひたちなか、空と花のあいだ。',
    lines: ['この青を、', '歩きにいこう。'],
    lead: ['一歩ずつ、好きになる。', '茨城の景色も、まちのことも。'],
    cta: 'ひたちなかを歩く',
    photo: { ...wikimediaImage(nemophila.src), alt: nemophila.alt, width: 1280, height: 853 },
    place: '国営ひたち海浜公園（4月下旬）',
    credit: '写真：Kakidai / CC BY-SA 4.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:2025_Hitachi_Seaside_Park.jpg',
    art: '/images/v42/field-walkers.webp',
  },
  {
    theme: 'food',
    href: '/food-library/',
    tab: '茨城のおいしい図鑑',
    tabShort: 'おいしい図鑑',
    kicker: '茨城のおいしい図鑑',
    lines: ['ひと口めから、', '好きになる。'],
    lead: ['品種も、産地も、つくる人も。', 'おいしいの向こう側を、のぞいてみよう。'],
    cta: 'おいしい図鑑をひらく',
    photo: { ...wikimediaImage(FOOD_PHOTOS.hoshiimo.src, [500, 960]), alt: FOOD_PHOTOS.hoshiimo.alt, width: 960, height: 540 },
    place: `干し芋（${FOOD_PHOTOS.hoshiimo.taken}撮影）`,
    credit: `写真：${FOOD_PHOTOS.hoshiimo.author} / ${FOOD_PHOTOS.hoshiimo.license}`,
    creditHref: FOOD_PHOTOS.hoshiimo.page,
    art: '/images/v42/food-vignette.webp',
  },
  {
    theme: 'weekend',
    href: '/events/',
    tab: '今週末のイベント',
    tabShort: '今週末の予定',
    kicker: '週末の予定、ここから。',
    lines: ['今週末、', '茨城で', 'なにしよう。'],
    lead: ['お祭りも、体験も、まちの催しも。', '会いに行きたい時間を見つけよう。'],
    cta: '今週末のイベントを探す',
    photo: { src: '/images/v42/oarai-festival.webp', alt: '2014年の大洗あんこう祭の会場風景', width: 900, height: 675 },
    place: '大洗あんこう祭（2014年）',
    credit: '写真：Miyuki Meinaka / CC BY-SA 4.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:Oarai_Anglerfish_Festival_2014.jpg',
    art: null,
  },
];

// 今月のよりみち帖。月替わりの編集枠（季節の記事と催しの入口）。翌月は SEASON と picks を差し替える。
const SEASON = { month: 11, year: 2026, label: '11月のおすすめ', english: 'NOV.' };
const seasonPicks = {
  walk: {
    href: '/kouyou/',
    kicker: '01 / 色づく森を歩く',
    lines: ['足もとから、', '秋になる。'],
    cta: '紅葉の行き先を探す',
    place: '高萩市・花貫渓谷',
    image: { src: '/images/v42/hananuki-season.webp', alt: '秋の花貫渓谷・汐見滝吊り橋を歩く人々', width: 800, height: 600 },
    credit: '写真：Kanohara / Public domain',
    creditHref: 'https://commons.wikimedia.org/wiki/File:Hananuki_valley_Shiomi-taki_bridge.jpg',
  },
  side: [
    { theme: 'taste', href: '/events/oarai-ankou-nabe-guide/', kicker: '02 / あんこう鍋', lines: ['湯気まで、', 'ごちそう。'], place: '大洗町', note: '冬の味を、店と宿で。', cta: '食べられる店と宿へ', image: '/images/v42/hotpot.webp', alt: 'あんこう鍋をイメージした挿絵', w: 640, h: 427 },
    { theme: 'night', href: '/events/ibaraki-flowerpark-illumination-2026/', kicker: '03 / 光の夜さんぽ', lines: ['光の庭で、', 'ひと寄り道。'], place: '石岡市', note: 'いばらきフラワーパーク', cta: '夜の開催情報を見る', image: '/images/v42/nightgarden.webp', alt: '灯りのともる庭の夜さんぽをイメージした挿絵。実際の会場を再現したものではありません', w: 760, h: 507 },
  ],
  more: { href: '/events/ibaraki-events-november-2026/', label: '11月のおすすめをもっと見る' },
  extra: [
    { href: '/events/tsuchiura-hanabi-2026/', label: '土浦全国花火競技大会2026', note: '土浦市｜11月7日' },
    { href: '/events/oarai-ankou-matsuri-2026/', label: '大洗あんこう祭2026', note: '大洗町｜11月14・15日' },
  ],
};

const matchdays = [
  { slug: 'mito', name: '水戸ホーリーホック', kicker: '水戸の試合へ', stub: '水戸', en: 'MITO', links: [{ href: '/sports/mito-hollyhock/', label: '試合・観戦ガイド' }, { href: '/news/mito-hollyhock-new-stadium-access/', label: '会場への行き方' }] },
  { slug: 'kashima', name: '鹿島アントラーズ', kicker: '鹿島の試合へ', stub: '鹿島', en: 'KASHIMA', links: [{ href: '/sports/kashima-antlers/', label: '試合・観戦ガイド' }, { href: '/area/kashima/', label: '鹿嶋の街ガイド' }] },
];
---

<BrandBase title={pageTitle} description={pageDescription} jsonLd={homeJsonLd} translationKey="home">
  <div class="v42-home">
    <section class="fv" data-module="home_hero" aria-label="今月のイバトコ特集" data-fv>
      <div class="fv-intro">
        <div class="fv-intro__brand"><span class="fv-intro__line" aria-hidden="true"></span><h1>なんか茨城、いいかも。</h1></div>
        <p class="fv-intro__note">寄り道したくなる、茨城の話。</p>
        <p class="fv-intro__month" aria-hidden="true"><b>{SEASON.month}</b><span>NOVEMBER<br />{SEASON.year}</span></p>
      </div>

      <div class="fv-carousel">
        <div class="fv-stage">
          {heroSlides.map((slide, index) => (
            <article
              class:list={['fv-cover', `fv-cover--${slide.theme}`]}
              data-fv-slide={index}
              data-pos={index === 0 ? 'active' : index === 1 ? 'next' : 'prev'}
              aria-roledescription="スライド"
              aria-label={`${index + 1} / ${heroSlides.length} ${slide.tab}`}
              aria-hidden={index !== 0 ? 'true' : undefined}
              inert={index !== 0}
            >
              <div class="fv-cover__paper" aria-hidden="true"></div>
              <a class="fv-cover__link" href={slide.href}>
                <figure class="fv-cover__visual">
                  <img
                    {...slide.photo}
                    sizes={slide.theme === 'walk' ? '(min-width: 1200px) 1160px, 100vw' : '(min-width: 700px) 50vw, 100vw'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding={index === 0 ? 'sync' : 'async'}
                  />
                </figure>
                <div class="fv-cover__copy">
                  <p class="fv-cover__kicker">{slide.kicker}</p>
                  <h2>{slide.lines.map((line) => <span>{line}</span>)}</h2>
                  <p class="fv-cover__lead">{slide.lead[0]}<br />{slide.lead[1]}</p>
                </div>
                {slide.theme === 'walk'
                  ? <div class="fv-cover__ticket"><div><small>歩いて旅する、茨城。</small><p>花の丘から、ひたちなかのまちへ。</p></div><span class="fv-cover__cta">{slide.cta}<V42Icon name="arrow" size={20} /></span></div>
                  : <span class="fv-cover__cta">{slide.cta}<V42Icon name="arrow" size={20} /></span>}
                {slide.theme === 'walk' && <span class="fv-cover__note" aria-hidden="true"><small>HITACHINAKA</small><b>空と花の、<br />あいだ。</b></span>}
                {slide.art && <img class="fv-cover__art" src={slide.art} alt="" width="360" height="540" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
                {slide.theme === 'weekend' && <span class="fv-cover__stamp" aria-hidden="true"><small>HELLO, WEEKEND!</small><b>よりみち<br />日和。</b></span>}
              </a>
              <p class="fv-cover__credit">{slide.place}／<a href={slide.creditHref} target="_blank" rel="license noopener">{slide.credit}</a></p>
            </article>
          ))}
        </div>
        <button class="fv-arrow fv-arrow--prev" type="button" aria-label="前の特集へ" data-fv-step="-1"><span aria-hidden="true">←</span></button>
        <button class="fv-arrow fv-arrow--next" type="button" aria-label="次の特集へ" data-fv-step="1"><span aria-hidden="true">→</span></button>
      </div>

      <div class="fv-bottom">
        <p class="fv-count" aria-hidden="true"><b data-fv-current>01</b><span> / {String(heroSlides.length).padStart(2, '0')}</span></p>
        <div class="fv-tabs" role="group" aria-label="特集を選ぶ">
          {heroSlides.map((slide, index) => (
            <button type="button" class:list={['fv-tab', { 'is-active': index === 0 }]} data-hero-dot={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-label={`${index + 1}枚目：${slide.tab}`}>
              <img {...{ ...slide.photo, alt: '', width: 58, height: 40 }} sizes="58px" loading="lazy" decoding="async" />
              <span class="fv-tab__text"><small>STORY 0{index + 1}</small><span class="fv-tab__long">{slide.tab}</span><span class="fv-tab__short">{slide.tabShort}</span></span>
              <V42Icon name="arrow" size={14} />
            </button>
          ))}
        </div>
        <button class="fv-play" type="button" aria-pressed="true" data-fv-play><span class="fv-play__icon" aria-hidden="true">Ⅱ</span><span data-fv-play-label>停止</span></button>
      </div>
      <p class="sr-only" aria-live="polite" data-fv-status></p>
    </section>

    {/* 検索・いま読まれている記事・行き先診断（HomeNow）。TOPの検索フォームは /search/ へ送る */}
    <div id="discover-now"><HomeNow /></div>

    <section class="season" id="season" aria-labelledby="season-title" data-module="home_november">
      <img class="season__canopy" src="/images/v42/autumn-maple-print.webp" width="480" height="480" alt="" loading="lazy" decoding="async" />
      <div class="v42-wrap">
        <header class="season__head">
          <p class="season__folio" aria-hidden="true"><span>{SEASON.english}</span><b>{SEASON.month}</b></p>
          <div class="season__title"><p class="v42-label">{SEASON.label}</p><h2 id="season-title">今月の、<br class="v42-br-phone" />よりみち帖。</h2></div>
          <p class="season__intro">色づく森、湯気の向こう、光の庭。<br />この季節の「行きたい」を、ひとつ。</p>
        </header>
        <div class="season__grid">
          <a class="season-pick season-pick--walk" href={seasonPicks.walk.href}>
            <figure class="season-pick__photo">
              <img {...seasonPicks.walk.image} sizes="(min-width: 900px) 56vw, 100vw" loading="lazy" decoding="async" />
              <span class="season-pick__place">{seasonPicks.walk.place}</span>
            </figure>
            <div class="season-pick__body">
              <p class="season-pick__kicker">{seasonPicks.walk.kicker}</p>
              <h3>{seasonPicks.walk.lines[0]}<br />{seasonPicks.walk.lines[1]}</h3>
              <span class="season-pick__cta">{seasonPicks.walk.cta}<span aria-hidden="true">→</span></span>
            </div>
          </a>
          <div class="season__side">
            {seasonPicks.side.map((pick) => (
              <a class:list={['season-pick', `season-pick--${pick.theme}`]} href={pick.href}>
                <figure class="season-pick__photo"><img src={pick.image} alt={pick.alt} width={pick.w} height={pick.h} loading="lazy" decoding="async" /><figcaption>イメージイラスト</figcaption></figure>
                <div class="season-pick__body">
                  <p class="season-pick__kicker">{pick.kicker}</p>
                  <h3>{pick.lines[0]}<br />{pick.lines[1]}</h3>
                  <p class="season-pick__meta">{pick.place}｜{pick.note}</p>
                  <span class="season-pick__cta">{pick.cta}<span aria-hidden="true">→</span></span>
                </div>
              </a>
            ))}
          </div>
        </div>
        <p class="season__credit">花貫渓谷の写真：<a href={seasonPicks.walk.creditHref} target="_blank" rel="license noopener">{seasonPicks.walk.credit}</a></p>
        <div class="season__more">
          <img src="/images/v42/field-reporters.webp" width="360" height="540" alt="" loading="lazy" decoding="async" />
          <ul>{seasonPicks.extra.map((item) => <li><a href={item.href}><small>{item.note}</small>{item.label}</a></li>)}</ul>
          <a class="v42-button" href={seasonPicks.more.href}>{seasonPicks.more.label}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    {/* 日付から入る枠。該当が無ければブロックごと出ない */}
    <div id="events" data-module="home_this_week"><ThisWeek moreHref="/today/" /></div>

    {/* 人気記事と開催中の案内は残し、季節の特集・イベントの後へ。 */}
    <HomeNow variant="updates" />

    {/* v42の花だより。公式の開花・開催情報を確かめた分だけ。期限を過ぎたカードは出さない */}
    <HomeJourney section="flowers" />

    <section class="v42-theme" id="discover" data-module="home_discover" aria-labelledby="discover-title">
      <div class="v42-wrap">
        <header class="v42-head">
          <div><p class="v42-label">テーマから探す</p><h2 id="discover-title">茨城を、<br />六つの入口から。</h2></div>
          <p>食、旅、宿、暮らし、癒やし、仕事。<br />今日の関心から、土地の物語へ。</p>
        </header>
        <HomeThemeNav />
        <nav class="v42-intents" aria-labelledby="home-intent-title" data-module="home_intent">
          <div class="v42-intents__head"><h3 id="home-intent-title">気分から探す</h3><p>今日の過ごし方に合わせて。</p></div>
          <ul>
            {discoveryIntents.map((item) => (
              <li><a href={item.href}>
                <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
                <span><strong>{item.label}</strong><small>{item.note}</small></span>
                <b aria-hidden="true">→</b>
              </a></li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    <section class="area-home" id="area" data-module="home_area"><div class="v42-wrap"><HomeAreaExplorer compact /></div></section>

    <HomeJourney section="trips" />

    <section class="food-home" data-module="home_hoshiimo" aria-labelledby="hoshiimo-home-title">
      <div class="v42-wrap food-home__layout">
        <div class="food-home__intro">
          <p class="v42-label">旅のあとにも、読みたくなる。</p>
          <h2 id="hoshiimo-home-title">茨城のおいしい図鑑</h2>
          <p>あなたの推し干し芋、どの品種？ 8品種の図鑑から、好みの一本を見つけよう。</p>
          <a class="v42-button" href="/hoshiimo/#diagnosis">30秒で干し芋診断<span aria-hidden="true">→</span></a>
        </div>
        <figure class="food-home__art">
          <img src="/images/v42/hoshiimo-field-visit.webp" alt="干し芋づくりの現場を訪ねる二人を描いた版画調のイメージイラスト" width="1100" height="619" loading="lazy" decoding="async" />
          <figcaption>干し芋づくりのイメージイラスト</figcaption>
        </figure>
        <nav class="food-home__links" aria-labelledby="hoshiimo-home-series">
          <p id="hoshiimo-home-series" class="food-home__series-title">食の図鑑</p>
          <a class="food-home__lead-link" href="/hoshiimo/#varieties"><span><small>8品種</small><strong>茨城の干し芋図鑑</strong></span><i aria-hidden="true">→</i></a>
          <ul>{FOOD_GUIDES.filter((g) => g.slug !== 'hoshiimo').map((g) => <li><a href={g.path}>{g.name}</a></li>)}</ul>
          <a class="food-home__all" href="/food-library/">茨城のおいしい図鑑をすべて見る<i aria-hidden="true">→</i></a>
        </nav>
      </div>
      <p class="v42-wrap food-home__credit">{FOOD_PHOTOS.hoshiimo.place}・{FOOD_PHOTOS.hoshiimo.taken}撮影の写真（FV）：<a href={FOOD_PHOTOS.hoshiimo.page} target="_blank" rel="noopener noreferrer">{FOOD_PHOTOS.hoshiimo.author} / Wikimedia Commons</a>（<a href={licenseUrl(FOOD_PHOTOS.hoshiimo.license)} target="_blank" rel="noopener noreferrer license">{FOOD_PHOTOS.hoshiimo.license}</a>）</p>
    </section>

    <section class="home-news" aria-labelledby="home-news-title" data-module="home_news">
      <div class="v42-wrap">
        <header class="v42-head">
          <div><p class="v42-label">LOCAL JOURNAL ／ まちの新着</p><h2 id="home-news-title">まちの、<br class="v42-pc-br" /><br class="v42-br-narrow" />あたらしい話。</h2></div>
          <p>出来事の先にある、暮らしと地域への影響まで。<br />一次情報を確かめ、編集部の視点で読み解きます。</p>
        </header>
        {latestNews.length > 0 ? <div class="home-news__grid">{latestNews.map((item) => <NewsCard item={item} compact />)}</div> : <div class="home-news__preparing"><p>いま、最初のニュースを確認・編集中です。</p><span>一次情報との照合を終えた解説から公開します。</span></div>}
        <a class="v42-quiet-link" href="/news/">編集部のニュース解説を見る<span aria-hidden="true">&nbsp;↗</span></a>
      </div>
    </section>

    <HomeJourney section="pets" />

    <section class="matchday" aria-labelledby="matchday-title" data-module="home_sports">
