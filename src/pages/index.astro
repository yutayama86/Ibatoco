<script>
  import { bindModuleTracking } from '../lib/module-tracking';
  // どのセクションまで読まれ、どこが押されたか（module_view / module_click）
  bindModuleTracking('home');

  const hero = document.querySelector<HTMLElement>('[data-fv]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-fv-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
    const counter = hero.querySelector<HTMLElement>('[data-fv-current]');
    const status = hero.querySelector<HTMLElement>('[data-fv-status]');
    const play = hero.querySelector<HTMLButtonElement>('[data-fv-play]');
    const playLabel = hero.querySelector<HTMLElement>('[data-fv-play-label]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: number | undefined;
    // 動きを抑える設定では自動再生しない。停止ボタンで止めた場合も、押し直すまで再開しない
    let userPaused = reduced.matches;

    const show = (next: number, announce = false) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const offset = (index - current + slides.length) % slides.length;
        const pos = offset === 0 ? 'active' : offset === 1 ? 'next' : 'prev';
        slide.dataset.pos = pos;
        slide.inert = pos !== 'active';
        if (pos === 'active') slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === current);
        dot.setAttribute('aria-pressed', String(index === current));
      });
      if (counter) counter.textContent = String(current + 1).padStart(2, '0');
      if (announce && status) status.textContent = slides[current].getAttribute('aria-label') ?? '';
    };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (userPaused || reduced.matches) return;
      timer = window.setInterval(() => show(current + 1), 5000);
    };
    const syncPlay = () => {
      play?.setAttribute('aria-pressed', String(!userPaused));
      play?.setAttribute('aria-label', userPaused ? 'スライドの自動再生を再開' : 'スライドの自動再生を停止');
      if (playLabel) playLabel.textContent = userPaused ? '再生' : '停止';
      play?.querySelector('.fv-play__icon')?.replaceChildren(userPaused ? '▷' : 'Ⅱ');
    };

    dots.forEach((dot, index) => dot.addEventListener('click', () => { show(index, true); start(); }));
    hero.querySelectorAll<HTMLButtonElement>('[data-fv-step]').forEach((button) => {
      button.addEventListener('click', () => { show(current + Number(button.dataset.fvStep), true); start(); });
    });
    play?.addEventListener('click', () => { userPaused = !userPaused; syncPlay(); start(); });

    // スマホの横スワイプ。縦スクロールは妨げない（touch-action: pan-y）
    const stage = hero.querySelector<HTMLElement>('.fv-stage');
    let startX: number | null = null;
    stage?.addEventListener('pointerdown', (event) => { if (event.pointerType !== 'mouse') startX = event.clientX; });
    stage?.addEventListener('pointerup', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 48) { show(current + (dx < 0 ? 1 : -1), true); start(); }
    });

    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    reduced.addEventListener('change', () => { if (reduced.matches) userPaused = true; syncPlay(); start(); });
    syncPlay();
    start();
  }
</script>

