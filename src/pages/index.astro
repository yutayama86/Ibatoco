---
import BrandBase from '../layouts/BrandBase.astro';
import HomeThemeNav from '../components/HomeThemeNav.astro';
import ThisWeek from '../components/ThisWeek.astro';
import HomeEditorialProcess from '../components/HomeEditorialProcess.astro';
import HomeAreaExplorer from '../components/HomeAreaExplorer.astro';
import NewsCard from '../components/NewsCard.astro';
import { getIndexableNews, getEditorialFootprint } from '../lib/content';
import { SITE_CONFIG } from '../data/site';

const latestNews = (await getIndexableNews()).slice(0, 3);
// 「確かめたことだけを書いています」の裏づけ。毎ビルド実データから数える
const footprint = await getEditorialFootprint();

// TOP修正指示書 §5：title に「茨城」を含める（ブランドタグライン「現地から、信頼を編む。」はフッター/Aboutで維持）。
const pageTitle = 'イバトコ｜茨城を歩いてつくるローカルメディア';
const pageDescription = '茨城の44市町村を歩いて取材するローカルメディア。食べる、出かける、泊まる、暮らす、整える、働く。現地で会って聞いた茨城を届けます。';
// §6：Organization / WebSite の構造化データ。公式SNSは sameAs に反映（実URLのみ）。
const siteUrl = new URL('/', Astro.site).href;
const socialSameAs = Object.values(SITE_CONFIG.social).filter((u) => typeof u === 'string' && u.length > 0);
const homeJsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'イバトコ', url: siteUrl, areaServed: { '@type': 'AdministrativeArea', name: '茨城県' }, ...(socialSameAs.length ? { sameAs: socialSameAs } : {}) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'イバトコ', url: siteUrl },
];

const heroSlides = [
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/0/09/Sunrise_of_the_Pacific_Ocean_-_Oarai_coast.jpg/1280px-Sunrise_of_the_Pacific_Ocean_-_Oarai_coast.jpg',
    alt: '大洗海岸から望む日の出',
    caption: '一日は、太平洋から始まる。',
    place: '茨城県・大洗海岸',
    credit: '写真：t.kunikuni / CC BY-SA 2.0',
    position: 'center 58%',
  },
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/2025_Hitachi_Seaside_Park.jpg/1280px-2025_Hitachi_Seaside_Park.jpg',
    alt: '国営ひたち海浜公園に咲くネモフィラ',
    caption: '四月下旬、丘が青くなる。',
    place: '茨城県・国営ひたち海浜公園',
    credit: '写真：Kakidai / CC BY-SA 4.0',
    position: 'center 48%',
  },
  {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Fukuroda%20Falls%2042.jpg?width=1280',
    alt: '大子町の袋田の滝',
    caption: '冬、滝は凍る。',
    place: '茨城県・袋田の滝',
    credit: '写真：Σ64 / CC BY 3.0',
    position: 'center 42%',
  },
];
---

<BrandBase title={pageTitle} description={pageDescription} jsonLd={homeJsonLd} translationKey="home">
  <section class="home-hero">
    <div class="hero-slides" aria-live="off">
      {heroSlides.map((slide, index) => (
        <figure class:list={['hero-slide', { 'is-active': index === 0 }]} data-hero-slide aria-hidden={index !== 0}>
          <img
            src={slide.src}
            alt={slide.alt}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding={index === 0 ? 'sync' : 'async'}
            width="1280"
            height="853"
            style={`object-position:${slide.position}`}
          />
          <figcaption><strong>{slide.caption}</strong><span>{slide.place}</span><small>{slide.credit}</small></figcaption>
        </figure>
      ))}
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="bp-wrap hero-inner">
      <div class="hero-copy">
        <p class="bp-kicker">茨城の“本当にいい”を、地元目線で。</p>
        <h1 class="bp-title"><span>まだ知らない茨城を、</span><br /><span>探しにいこう。</span></h1>
        <p class="hero-lead">
          <span>海も山も滝も、車で二時間の中にある。</span>
          <span>土地の日常を、現地から届けます。</span>
        </p>
        <div class="hero-actions">
          <a class="hero-cta hero-primary" href="/area/">
            <span class="cta-index">01</span>
            <span class="cta-label">44市町村から探す<small>街を選んで、茨城を読む</small></span>
            <span class="cta-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="hero-cta hero-secondary" href="#discover">
            <span class="cta-index">02</span>
            <span class="cta-label">テーマから探す<small>自然・季節・目的から</small></span>
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="hero-controls" aria-label="FV写真を切り替える">
        {heroSlides.map((slide, index) => (
          <button type="button" class:list={{ 'is-active': index === 0 }} data-hero-dot={index} aria-label={`${index + 1}枚目：${slide.place}`} aria-pressed={index === 0}><span>{String(index + 1).padStart(2, '0')}</span></button>
        ))}
      </div>
    </div>
  </section>

  <section class="brand-origin">
    <div class="origin-sky" aria-hidden="true"></div>
    <div class="bp-wrap origin-grid">
      <div class="origin-index">
        <span>WHY<br />IBATOCO</span>
        <b>01</b>
      </div>
      <div class="origin-copy">
        <p class="bp-kicker">イバトコをつくった理由</p>
        <h2 class="bp-section-title">検索では見つからない、<br />この土地の理由を。</h2>
        <p class="origin-lead">口コミの星の数には、その店がそこにある理由までは書かれていません。現地へ行き、人に会い、確かめたことだけを書いています。</p>
        {/*
          「消えるもの」と「すること」を対にして見せる。以前は同じ見た目の
          段落が2つ並ぶだけで、どちらが問題でどちらが答えなのか分からなかった。
          番号付きの3枚組は HomeEditorialProcess（01 FIELD / 02 VERIFY /
          03 UPDATE）が持っているので、ここでは番号を使わず対比だけで見せる。
        */}
        <div class="origin-note">
          <div class="origin-note__item">
            <p class="origin-note__label"><span>WHAT DISAPPEARS</span>記録されないまま、消えていくもの</p>
            <p>朝五時の漁港のにおい。何十年も手が覚えている仕事。看板を出していない店の由来。どれも、短い投稿では残りません。</p>
          </div>
          <div class="origin-note__item origin-note__item--answer">
            <p class="origin-note__label"><span>WHAT WE DO</span>イバトコがすること</p>
            <p>足を運び、本人に聞き、公式の発表と突き合わせる。知られていないものを、あとから探せる状態にして残す。それがイバトコの仕事です。</p>
          </div>
        </div>
        {/*
          主張を言葉だけで終わらせず、実際に確かめた量を置く。
          数字は src/lib/content.ts が毎ビルド数える（手で書かない）。
          「37 / 44」のように、まだ届いていないことも隠さずに出す。
        */}
        <dl class="origin-proof">
          <div>
            <dt>確認した一次情報</dt>
            <dd><b>{footprint.sources}</b><span>件</span></dd>
          </div>
          <div>
            <dt>公開した記事</dt>
            <dd><b>{footprint.articles}</b><span>本</span></dd>
          </div>
          <div>
            <dt>取り上げた市町村</dt>
            <dd><b>{footprint.municipalities}</b><span>/ {footprint.totalMunicipalities}</span></dd>
          </div>
        </dl>
        <a href="/about/">私たちについて <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="origin-scene" aria-hidden="true">
      <svg viewBox="0 0 1600 270" preserveAspectRatio="none">
        <path class="scene-skyline" d="M0 202C160 177 287 188 420 207C575 230 717 214 866 174C1049 125 1194 128 1353 170C1457 198 1535 203 1600 186V270H0Z" />
        <path class="scene-hill scene-hill--back" d="M667 210L848 77L1025 216Z" />
        <path class="scene-hill" d="M784 218L945 106L1104 222Z" />
        <path class="scene-garden" d="M0 234C181 195 329 197 479 231C641 267 786 257 941 224C1105 188 1267 192 1414 223C1489 239 1551 242 1600 234V270H0Z" />
        <path class="scene-water" d="M0 244C213 226 386 235 576 252C806 272 1008 254 1187 238C1354 223 1483 230 1600 247V270H0Z" />
        <g class="scene-lines">
          <path d="M108 220C250 190 351 208 463 227" />
          <path d="M113 232C250 205 354 218 465 238" />
          <path d="M121 244C253 220 355 229 471 248" />
        </g>
      </svg>
    </div>
  </section>

  {/* 日付から入る枠。該当が無ければブロックごと出ない（既存TOPの構成は変えない） */}
  <ThisWeek />

  <section class="discover" id="discover">
    <div class="bp-wrap discover-grid">
      <header class="discover-head"><div><p class="bp-kicker">DISCOVER BY INTEREST</p><h2 class="bp-section-title">茨城を、<br />六つの入口から。</h2></div><p>食、旅、宿、暮らし、癒やし、仕事。<br />今日の関心から、土地の物語へ。</p></header>
      <HomeThemeNav />
    </div>
  </section>

  <section class="area-home" id="area"><div class="bp-wrap"><HomeAreaExplorer /></div></section>

  <section class="home-news" aria-labelledby="home-news-title">
    <div class="bp-wrap">
      <header class="home-news__head"><div><p class="bp-kicker">FROM THE EDITORIAL DESK</p><h2 id="home-news-title" class="bp-section-title">いま、茨城で<br />起きていること。</h2></div><p>出来事の先にある、暮らしと地域への影響まで。一次情報を確かめ、編集部の視点で読み解きます。</p></header>
      {latestNews.length > 0 ? <div class="home-news__grid">{latestNews.map((item) => <NewsCard item={item} compact />)}</div> : <div class="home-news__preparing"><p>いま、最初のニュースを確認・編集中です。</p><span>一次情報との照合を終えた解説から公開します。</span></div>}
      <a class="home-news__link" href="/news/">編集部のニュース解説を見る →</a>
    </div>
  </section>

  <section class="process-home"><div class="bp-wrap"><HomeEditorialProcess /></div></section>

  <section class="partner">
    <span class="partner-watermark" aria-hidden="true">STORIES WANTED</span>
    <div class="bp-wrap partner-layout">
      <div class="partner-copy">
        <p class="bp-kicker">OPEN CALL / FOR LOCAL BUSINESSES</p>
        <h2>あなたの街の、<br /><em>まだ書かれていない</em><br />話を。</h2>
        <p class="partner-lead">続けてきた理由。選ばれている理由。まだ言葉になっていない価値を、会って、聞いて、一緒に見つけます。</p>
        <ul class="partner-topics" aria-label="取材対象">
          <li>店と食</li><li>人と仕事</li><li>地域の挑戦</li>
        </ul>
      </div>

      <div class="partner-storyboard">
        <figure>
          <img src="/images/area/hitachi/city-from-kamine.jpg" alt="高台から見渡す日立市街と太平洋" loading="lazy" decoding="async" width="1280" height="853" />
          <figcaption><a href="https://commons.wikimedia.org/wiki/File:Hitachi_City_from_Kamine_Park_04.jpg" target="_blank" rel="license noopener">写真：Σ64 / CC BY 4.0</a></figcaption>
        </figure>
        <ol class="partner-questions" aria-label="取材で聞きたいこと">
          <li><span>01</span><p>なぜ、この場所で<br />続けているのか。</p></li>
          <li><span>02</span><p>誰のために、<br />つくっているのか。</p></li>
          <li><span>03</span><p>次に、どんな景色を<br />つくりたいのか。</p></li>
        </ol>
      </div>

      <div class="partner-actions">
        <a class="partner-primary" href="/contact/"><span>まず、話を聞かせてください</span><b aria-hidden="true">↗</b></a>
        <a class="partner-secondary" href="/biz/">取材・発信支援について →</a>
      </div>
    </div>
  </section>
</BrandBase>

<script>
  const hero = document.querySelector<HTMLElement>('.home-hero');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
    let current = 0;
    let timer: number | undefined;
    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        slide.classList.toggle('is-active', index === current);
        slide.setAttribute('aria-hidden', String(index !== current));
      });
      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === current);
        dot.setAttribute('aria-pressed', String(index === current));
      });
    };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const start = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stop();
      timer = window.setInterval(() => show(current + 1), 5000);
    };
    dots.forEach((dot, index) => dot.addEventListener('click', () => { show(index); start(); }));
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    start();
  }
</script>

<style>
  .home-hero{position:relative;height:min(880px,calc(100svh - var(--site-header-height)));min-height:680px;display:flex;align-items:flex-end;overflow:hidden;background:#233f4a;color:#fff}
  .hero-slides,.hero-slide,.hero-slide img{position:absolute;inset:0;width:100%;height:100%}.hero-slide{margin:0;opacity:0;visibility:hidden;transform:scale(1.018);transition:opacity 1.15s ease,visibility 1.15s ease,transform 6.5s ease}.hero-slide.is-active{opacity:1;visibility:visible;transform:scale(1)}.hero-slide img{object-fit:cover;filter:saturate(.8) contrast(1.03)}
  .hero-slide figcaption{position:absolute;z-index:3;right:clamp(1rem,4vw,3rem);bottom:1.5rem;display:grid;text-align:right;color:rgba(255,255,255,.9);text-shadow:0 1px 8px rgba(0,0,0,.5);font-size:.72rem}.hero-slide figcaption strong{margin-bottom:.35rem;font:600 clamp(.92rem,1.4vw,1.2rem)/1.45 var(--font-brand-display);color:#fff}.hero-slide figcaption small{margin-top:.15rem;font-size:.6rem;color:rgba(255,255,255,.7)}
  .hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,24,48,.9) 0%,rgba(6,35,55,.55) 46%,rgba(5,20,30,.08) 79%),linear-gradient(0deg,rgba(4,21,35,.58),transparent 48%)}
  .hero-inner{position:relative;z-index:2;width:min(calc(100% - clamp(3rem,14vw,17rem)),92rem);padding-block:clamp(3rem,6.5vw,5rem) 1.45rem}.hero-copy{max-width:64rem}.hero-copy .bp-kicker{font-size:clamp(.76rem,1vw,.88rem);letter-spacing:.11em;color:#fff}.hero-copy .bp-title{margin-top:1.15rem;font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-size:clamp(3rem,5.15vw,5.25rem);font-weight:500;line-height:1.4;letter-spacing:.025em;color:#fff;text-shadow:0 2px 24px rgba(0,0,0,.22)}.hero-copy .bp-title span{white-space:nowrap}.hero-lead{margin-top:1.2rem;font-family:var(--font-brand-display);font-size:clamp(.9rem,1.12vw,1.02rem);line-height:2;color:rgba(255,255,255,.92)}.hero-lead span{display:block}
  .hero-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.8rem}.hero-cta{position:relative;display:grid;width:17rem;height:4.9rem;grid-template-columns:1.55rem 1fr 1.4rem;align-items:center;gap:.65rem;padding:0 1.2rem;overflow:hidden;border:1px solid #fff;font-weight:700;transition:color .3s ease,background-color .3s ease,transform .25s ease}.hero-cta::before{content:'';position:absolute;inset:0;background:var(--color-ink);transform:translateY(101%);transition:transform .3s ease}.hero-cta>*{position:relative;z-index:1}.hero-primary{background:#fff;color:var(--color-ink)!important}.hero-secondary{background:rgba(9,34,43,.3);color:#fff;backdrop-filter:blur(8px)}.hero-cta:hover,.hero-cta:focus-visible{transform:translateY(-3px);color:#fff!important}.hero-cta:hover::before,.hero-cta:focus-visible::before{transform:translateY(0)}.cta-index{align-self:start;margin-top:1.2rem;font:.52rem var(--font-brand-meta);letter-spacing:.1em;opacity:.65}.cta-label{display:flex;flex-direction:column;font-size:.83rem;letter-spacing:.03em}.cta-label small{margin-top:.3rem;font-size:.55rem;font-weight:500;letter-spacing:.08em;opacity:.68}.cta-arrow{justify-self:end;transition:transform .2s ease}.hero-cta:hover .cta-arrow,.hero-cta:focus-visible .cta-arrow{transform:translate(.25rem,-.15rem)}
  .hero-controls{display:flex;gap:.55rem;margin-top:2rem}.hero-controls button{width:3.6rem;padding:.55rem 0;border:0;border-top:1px solid rgba(255,255,255,.4);background:transparent;color:rgba(255,255,255,.55);cursor:pointer;text-align:left;transition:border-color .25s ease,color .25s ease}.hero-controls button:hover,.hero-controls button:focus-visible,.hero-controls button.is-active{border-color:#fff;color:#fff}.hero-controls span{font:.62rem var(--font-brand-meta)}
  .brand-origin{position:relative;isolation:isolate;overflow:hidden;min-height:47rem;background:linear-gradient(145deg,#fff 0%,#f3f8fe 62%,#f7f8ec 100%);color:var(--color-deep-blue)}
  .origin-sky{position:absolute;z-index:-1;inset:0;pointer-events:none}.origin-sky::before{content:'';position:absolute;left:-11rem;top:-15rem;width:min(48vw,44rem);height:32rem;border-radius:46% 54% 57% 43% / 61% 44% 56% 39%;background:linear-gradient(140deg,rgba(90,161,221,.66),rgba(202,228,250,.2));transform:rotate(-10deg)}.origin-sky::after{content:'';position:absolute;right:-12rem;top:-8rem;width:min(37vw,34rem);height:22rem;border-radius:56% 44% 66% 34%;background:rgba(190,204,142,.34);transform:rotate(13deg)}
  .origin-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(8rem,.3fr) minmax(0,1.7fr);gap:clamp(2rem,8vw,8rem);padding-top:clamp(6.5rem,10vw,9rem);padding-bottom:17rem}.origin-index{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;padding-top:1rem;border-top:1px solid rgba(7,23,68,.28);color:var(--color-brand-blue)}.origin-index span{font:700 .62rem/1.45 var(--font-brand-meta);letter-spacing:.18em}.origin-index b{font:500 .68rem/1 var(--font-brand-meta)}.origin-copy{max-width:57rem}.brand-origin .bp-kicker{color:var(--color-brand-blue)}.brand-origin h2{max-width:52rem;margin-top:1.05rem;font-size:clamp(2.5rem,4.4vw,4.4rem);line-height:1.42;letter-spacing:.025em;color:var(--color-deep-blue)}.origin-lead{max-width:45rem;margin-top:1.65rem;font:500 clamp(1rem,1.35vw,1.22rem)/2 var(--font-brand-body);letter-spacing:.015em;color:#33435f}/*
   * 「消えるもの」と「すること」の対。左は失われていく側なので線も文字も弱く、
   * 右は残す側なのでブランド色の線と白い面で受け止める。
   * 見出しの小さな欧文ラベルは .origin-index と同じ組み方に揃えている。
   */
  .origin-note{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1.25rem,3vw,2.75rem);max-width:52rem;margin-top:2.5rem}
  .origin-note__item{padding-top:1.1rem;border-top:1px solid rgba(7,23,68,.17)}
  .origin-note__item--answer{padding:1.4rem 1.5rem 1.5rem;border-top:2px solid var(--color-brand-blue);border-radius:0 0 .85rem .85rem;background:rgba(255,255,255,.78);box-shadow:0 14px 34px rgba(7,23,68,.07)}
  .origin-note__label{display:grid;gap:.45rem;margin-bottom:.85rem;font:700 .9rem/1.6 var(--font-brand-body);letter-spacing:.01em;color:var(--color-deep-blue)}
  .origin-note__label span{font:700 .56rem/1 var(--font-brand-meta);letter-spacing:.2em;color:var(--color-brand-blue)}
  .origin-note p{font-size:.82rem;line-height:1.95;color:var(--color-soil)}
  .origin-note__item--answer p:not(.origin-note__label){color:#33435f}
  /* 確かめた量。数字を主役にして、文字だけの面に硬い要素を一つ入れる */
  .origin-proof{display:flex;flex-wrap:wrap;gap:clamp(1.75rem,4vw,3.25rem);max-width:52rem;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid rgba(7,23,68,.17)}
  .origin-proof div{display:grid;gap:.35rem}
  .origin-proof dt{font:700 .62rem/1.4 var(--font-brand-meta);letter-spacing:.12em;color:var(--color-brand-blue)}
  .origin-proof dd{display:flex;align-items:baseline;gap:.35rem;margin:0;color:var(--color-deep-blue)}
  .origin-proof b{font:600 clamp(1.9rem,2.8vw,2.6rem)/1 var(--font-brand-display);letter-spacing:.01em;font-variant-numeric:tabular-nums}
