---
import '../styles/global.css';
import '../styles/interior.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import IntlHeader from '../components/IntlHeader.astro';
import IntlFooter from '../components/IntlFooter.astro';
import { SITE_CONFIG } from '../data/site';
import { DEFAULT_LOCALE, LOCALE_META, alternatesFor, xDefaultFor, type Locale } from '../data/i18n';
import { AI_REFERRAL_HOSTS, GA_OPTOUT_KEY, GA_OPTOUT_PARAM } from '../data/analytics';
interface Props { title?: string; ogTitle?: string; description?: string; image?: string; imageAlt?: string; type?: 'website'|'article'; publishedAt?: Date; updatedAt?: Date; jsonLd?: Record<string, unknown>|Record<string, unknown>[]; noindex?: boolean; locale?: Locale; translationKey?: string; }
const {
  title = 'イバトコ｜現地から、信頼を編む。',
  ogTitle,
  description = '編集部とローカルエディターが現地を歩き、人と営みを取材する茨城の地域価値編集ブランド。',
  image,
  imageAlt,
  type = 'website',
  publishedAt,
  updatedAt,
  jsonLd,
  noindex = false,
  locale = DEFAULT_LOCALE,
  translationKey,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 多言語：実在する翻訳だけを相互参照する（存在しないURLは出さない）。
const localeMeta = LOCALE_META[locale];
const alternates = alternatesFor(translationKey);
const xDefault = xDefaultFor(translationKey);
const isIntl = locale !== DEFAULT_LOCALE;
const absolute = (path: string) => new URL(path, Astro.site).href;
const SKIP_LABEL: Record<Locale, string> = { ja: '本文へスキップ', en: 'Skip to content', 'zh-tw': '跳至主要內容', ko: '본문으로 건너뛰기' };
// OGP画像：SVGはX等の多くのSNSで表示できないため、必ずラスタライズ済み(PNG/JPEG)を使う。
// 画像は scripts/build-og-images.mjs で 1200x630 に固定生成している。
// 言語ごとに既定のOGP画像を分ける（日本語テキストの画像を海外ページに出さない）。
// 文言はサイト内で使っている正式表現をそのまま画像化している。
const OG_DEFAULT_BY_LOCALE: Record<Locale, string> = {
  ja: '/og-default-rich-header-20260819.png',
  en: '/og-en-20260819.png',
  'zh-tw': '/og-zh-tw-20260819.png',
  ko: '/og-ko-20260819.png',
};
const ogImagePath = image ?? OG_DEFAULT_BY_LOCALE[locale];
const absoluteImage = new URL(ogImagePath, Astro.site).href;
const OG_MIME: Record<string, string> = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp', gif: 'image/gif' };
const ogImageType = OG_MIME[ogImagePath.split('.').pop()?.toLowerCase() ?? ''] ?? 'image/png';
// alt は必ず出す（未指定ならページ名で代替）
const ogImageAlt = imageAlt || title;
const GA_ID = (import.meta.env.PUBLIC_GA_ID as string | undefined) || SITE_CONFIG.gaMeasurementId;
const enableGA = import.meta.env.PROD && !!GA_ID;
// 計測して良い本番ホスト。ここ以外（localhost・プレビュー・ステージング）では
// gtag自体を読み込まない。ビルド時の site 設定から取るので取りこぼさない。
const GA_ALLOWED_HOSTS = [new URL(SITE_CONFIG.domain).hostname, `www.${new URL(SITE_CONFIG.domain).hostname}`];
const gaBootConfig = JSON.stringify({
  id: GA_ID,
  hosts: GA_ALLOWED_HOSTS,
  optOutKey: GA_OPTOUT_KEY,
  optOutParam: GA_OPTOUT_PARAM,
  aiHosts: AI_REFERRAL_HOSTS,
});
const pathname = Astro.url.pathname;
const localeHomes = new Set(['/', '/en/', '/ko/', '/zh-tw/']);
const isInterior = !localeHomes.has(pathname);
const routeSegment = pathname.split('/').filter(Boolean)[0]?.replace(/[^a-z0-9-]/gi, '-') || 'home';
---
<!doctype html>
<html lang={localeMeta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('reveal-ready');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf6ff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Discover / 画像プレビュー用に large を明示。noindex ページは検索結果には出さずリンク追跡は許可する。 */}
    <meta name="robots" content={noindex ? 'noindex, follow, max-image-preview:large' : 'max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={absolute(alt.path)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absolute(xDefault)} />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {alternates.filter((alt) => alt.locale !== locale).map((alt) => <meta property="og:locale:alternate" content={LOCALE_META[alt.locale].ogLocale} />)}
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="イバトコ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {enableGA && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        {/*
          gtagは「本番ホスト」かつ「運営者の除外フラグが立っていない」ときだけ読み込む。
          除外条件に当たった場合はタグ自体を挿入しないので、GA4へは1リクエストも飛ばない。
          流入区分（AI / 検索 / その他参照 / Direct）はここで判定して config に載せる。
        */}
        <script is:inline set:html={`(function(){
  var C = ${gaBootConfig};
  var w = window, d = document, loc = w.location;

  // 1) 除外フラグの切り替え（?ga-optout=1 で除外、=0 で解除）
  //    端末・ブラウザごとに設定が必要なので、効いたかどうかを画面に出して確認できるようにする。
  try {
    var q = new URLSearchParams(loc.search).get(C.optOutParam);
    var msg = '';
    if (q === '1') { localStorage.setItem(C.optOutKey, '1'); msg = 'このブラウザをアクセス解析から除外しました。解除は ?' + C.optOutParam + '=0'; }
    else if (q === '0') { localStorage.removeItem(C.optOutKey); msg = 'このブラウザの除外を解除しました。以降のアクセスは計測されます。'; }
    if (msg) {
      var show = function () {
        var box = d.createElement('div');
        box.setAttribute('role', 'status');
        box.textContent = msg;
        box.style.cssText = 'position:fixed;left:50%;bottom:1.25rem;transform:translateX(-50%);z-index:9999;max-width:min(92vw,34rem);padding:.85rem 1.1rem;border-radius:.6rem;background:#172b35;color:#fff;font:500 .82rem/1.6 system-ui,sans-serif;box-shadow:0 10px 30px rgba(0,0,0,.25)';
        d.body.appendChild(box);
        setTimeout(function () { box.remove(); }, 8000);
      };
      if (d.readyState === 'loading') d.addEventListener('DOMContentLoaded', show);
      else show();
    }
  } catch (e) {}

  // 2) 計測対象かどうか。開発・プレビュー・運営者自身は読み込まない
  var host = loc.hostname.toLowerCase();
  if (C.hosts.indexOf(host) === -1) return;
  try { if (localStorage.getItem(C.optOutKey) === '1') return; } catch (e) {}

  // 3) 流入元の分類。特定できたものだけAI扱いし、Directは寄せない
  function hostOf(v) {
    if (!v) return '';
    try { return new URL(v.indexOf('://') > -1 ? v : 'https://' + v).hostname.toLowerCase().replace(/^www\\./, ''); }
    catch (e) { return ''; }
  }
  function aiOf(h) {
    if (!h) return '';
    if (C.aiHosts[h]) return C.aiHosts[h];
    for (var k in C.aiHosts) { if (h.length > k.length && h.slice(-(k.length + 1)) === '.' + k) return C.aiHosts[k]; }
    return '';
  }
  var utm = '';
  try { utm = new URLSearchParams(loc.search).get('utm_source') || ''; } catch (e) {}
  var refHost = hostOf(d.referrer);
  var ai = aiOf(hostOf(utm)) || aiOf(refHost);
  var SEARCH = ['google.com','google.co.jp','bing.com','yahoo.co.jp','duckduckgo.com','ecosia.org','brave.com'];
  function isSearch(h) {
    for (var i = 0; i < SEARCH.length; i++) {
      if (h === SEARCH[i] || (h.length > SEARCH[i].length && h.slice(-(SEARCH[i].length + 1)) === '.' + SEARCH[i])) return true;
    }
    return false;
  }
  var kind = ai ? 'ai_referral' : (!refHost ? 'direct' : (isSearch(refHost) ? 'search' : 'other_referral'));

  // 3-2) セッションの入口の流入区分。traffic_kind はページごとの referrer で決まるので、
  //      記事から問い合わせページへ移ると other_referral（サイト内）になり、成果を入口の流入で見られない。
  //      外から入ったページの区分を sessionStorage に持ち、サイト内の移動では上書きしない。
  //      入口が分からない（サイト内から来たのに記録が無い）ときは unknown にして、推測で埋めない。
  //      途中の Direct（ブックマーク等）は、GA4 と同じく記録済みの入口を上書きしない。
  var landing = null;
  try { landing = JSON.parse(sessionStorage.getItem('ibatoco_landing') || 'null'); } catch (e) {}
  var internal = !!refHost && C.hosts.indexOf(refHost) > -1;
  if (!landing || (!internal && kind !== 'direct')) {
    landing = { kind: internal ? 'unknown' : kind, path: loc.pathname };
    try { sessionStorage.setItem('ibatoco_landing', JSON.stringify(landing)); } catch (e) {}
  }

  // 4) gtag読み込み
  var s = d.createElement('script');
  s.async = true;
  s.src = 'https://www.googletagmanager.com/gtag/js?id=' + C.id;
  d.head.appendChild(s);
  w.dataLayer = w.dataLayer || [];
  w.gtag = function(){ w.dataLayer.push(arguments); };
  w.gtag('js', new Date());
  var params = { traffic_kind: kind, landing_traffic_kind: landing.kind };
  if (ai) params.ai_source = ai;
  w.gtag('config', C.id, params);
  w.__ibatocoTraffic = { kind: kind, aiSource: ai || null, referrerHost: refHost || null, landingKind: landing.kind, landingPath: landing.path };
})();`} />
      </>
    )}
  </head>
  <body class:list={['brand-site', isInterior ? 'interior-site' : 'home-site', `route-${routeSegment}`]}>
    <a href="#main-content" class="sr-only">{SKIP_LABEL[locale]}</a>
    {isIntl ? <IntlHeader locale={locale} translationKey={translationKey} /> : <SiteHeader translationKey={translationKey} />}
    <main id="main-content"><slot /></main>
    {isIntl ? <IntlFooter locale={locale} /> : <SiteFooter />}

    <script>
      const revealTargets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const showAll = () => revealTargets.forEach((el) => el.classList.add('is-in'));
      try {
        if (!revealTargets.length || !('IntersectionObserver' in window)) {
          showAll();
        } else {
          const io = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          }, { rootMargin: '0px 0px 6% 0px', threshold: 0.01 });
          revealTargets.forEach((el) => {
            el.style.setProperty('--delay', '0ms');
            io.observe(el);
          });
          window.setTimeout(showAll, 1100);
        }
      } catch {
        showAll();
      }
    </script>
  </body>
</html>

<style is:global>
  .brand-site{margin:0;overflow-x:clip;background:var(--color-paper);color:var(--color-charcoal);font-family:var(--font-brand-body)}
  .bp-wrap{width:min(calc(100% - 2rem),var(--content-wide));margin-inline:auto}
  .bp-reading{width:min(calc(100% - 2rem),var(--content-reading));margin-inline:auto}
  .bp-section{padding-block:clamp(4rem,9vw,7.5rem)}
  .bp-kicker{font:500 .72rem/1 var(--font-brand-meta);letter-spacing:.16em;text-transform:uppercase;color:var(--color-tide)}
  .bp-title{font-family:var(--font-brand-display);color:var(--color-ink);font-size:clamp(2rem,5vw,4.7rem);line-height:1.18;font-weight:600;letter-spacing:.01em}
  .bp-section-title{font-family:var(--font-brand-display);color:var(--color-ink);font-size:clamp(1.7rem,3.2vw,3rem);line-height:1.3}
  .bp-link{color:var(--color-ink);border-bottom:1px solid var(--color-tide);padding-bottom:.15rem}
  .brand-site :focus-visible{outline-color:var(--color-tide)}
  .brand-site ::selection{background:var(--color-tide);color:var(--color-white)}
  .brand-site .eyebrow{color:var(--color-tide)}
  .brand-site .prose h2{border-left-color:var(--color-tide)}
  .brand-site .prose a{color:var(--color-tide)}
  .brand-site .prose ul li::before{background:var(--color-tide)}
  @media(max-width:480px){.bp-wrap,.bp-reading{width:min(calc(100% - 1.5rem),var(--content-wide))}.bp-section{padding-block:3.5rem}}
</style>
