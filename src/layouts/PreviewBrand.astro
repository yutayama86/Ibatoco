---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description?: string; }
const { title, description = 'イバトコ刷新デザインの確認用プレビュー' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&family=Source+Sans+3:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />
  </head>
  <body class="brand-preview">
    <a href="#preview-main" class="sr-only">本文へスキップ</a>
    <SiteHeader />
    <main id="preview-main"><slot /></main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  .brand-preview { margin:0; overflow-x:clip; background:var(--color-paper); color:var(--color-charcoal); font-family:var(--font-brand-body); }
  .bp-wrap { width:min(calc(100% - 2rem), var(--content-wide)); margin-inline:auto; }
  .bp-reading { width:min(calc(100% - 2rem), var(--content-reading)); margin-inline:auto; }
  .bp-section { padding-block:clamp(4rem,9vw,7.5rem); }
  .bp-kicker { font:600 .72rem/1 var(--font-brand-meta); letter-spacing:.16em; text-transform:uppercase; color:var(--color-tide); }
  .bp-title { font-family:var(--font-brand-display); color:var(--color-ink); font-size:clamp(2rem,5vw,4.7rem); line-height:1.18; font-weight:600; letter-spacing:.01em; }
  .bp-section-title { font-family:var(--font-brand-display); color:var(--color-ink); font-size:clamp(1.7rem,3.2vw,3rem); line-height:1.3; }
  .bp-link { color:var(--color-ink); border-bottom:1px solid var(--color-tide); padding-bottom:.15rem; }
  @media(max-width:480px){.bp-wrap,.bp-reading{width:min(calc(100% - 1.5rem), var(--content-wide))}.bp-section{padding-block:3.5rem}}
</style>
