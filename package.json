{
  "name": "ibatoco",
  "type": "module",
  "version": "0.1.0",
  "description": "イバトコ - 現地から、信頼を編む。茨城の地域価値編集ブランド",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "npm run date:check && node scripts/fact-guard.mjs && node scripts/check-og-glyphs.mjs && node scripts/build-og-backdrop.mjs && astro check && astro build",
    "audit:site": "node scripts/fact-guard.mjs && node scripts/check-og-glyphs.mjs && node scripts/build-og-backdrop.mjs && npm run build && node scripts/quality-audit.mjs",
    "verify": "npm run check && node scripts/quality-audit.mjs && node scripts/tech-audit.mjs && node scripts/security-audit.mjs && node scripts/data-audit.mjs && node scripts/repository-audit.mjs && node scripts/analytics-audit.mjs && npm run editorial:check && node --test scripts/growth-engine.test.mjs && node scripts/freshness-guard.mjs --strict && node scripts/ui-smoke.mjs && node scripts/visual-diff.mjs",
    "verify:article": "node scripts/verify-article.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:responsive": "node scripts/ui-smoke.mjs",
    "test:visual": "node scripts/visual-diff.mjs",
    "verify:prod": "node scripts/verify-production.mjs",
    "qa:prod": "node scripts/ui-smoke.mjs --production",
    "wait:deploy": "node scripts/wait-deploy.mjs",
    "deploy": "npm run audit:site && npx wrangler deploy && node scripts/verify-production.mjs --wait && node scripts/ui-smoke.mjs --production",
    "preview": "astro preview",
    "astro": "astro",
    "db:seed": "node scripts/csv-to-d1-seed.mjs",
    "og:build": "node scripts/build-og-images.mjs",
    "og:check": "node scripts/check-ogp.mjs",
    "seo:log": "node scripts/seo-change.mjs",
    "seo:seal": "node scripts/seo-seal.mjs",
    "date:check": "node scripts/date-integrity.mjs",
    "fact:guard": "node scripts/fact-guard.mjs",
    "og:glyphs": "node scripts/check-og-glyphs.mjs",
    "og:cards": "node scripts/build-og-backdrop.mjs",
    "sports:status": "node scripts/sports-status.mjs",
    "audit:tech": "node scripts/tech-audit.mjs",
    "audit:data": "node scripts/data-audit.mjs",
    "audit:repo": "node scripts/repository-audit.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "opportunity": "node scripts/opportunity.mjs",
    "editorial:sync": "node scripts/editorial-os.mjs sync",
    "editorial:check": "node scripts/editorial-os.mjs check",
    "editorial:daily": "node scripts/editorial-os.mjs daily",
    "editorial:inventory": "node scripts/editorial-os.mjs inventory",
    "audit:analytics": "node scripts/analytics-audit.mjs",
    "growth:target": "node scripts/growth-engine.mjs --write",
    "growth:check": "node scripts/growth-engine.mjs --check",
    "test:growth": "node --test scripts/growth-engine.test.mjs",
    "audit:freshness": "node scripts/freshness-guard.mjs",
    "discovery:coverage": "node scripts/discovery-coverage.mjs",
    "discovery:coverage:write": "node scripts/discovery-coverage.mjs --write",
    "discovery:priority": "node scripts/discovery-priority.mjs",
    "discovery:priority:write": "node scripts/discovery-priority.mjs --write",
    "revenue:engine": "node scripts/revenue-engine.mjs",
    "revenue:engine:write": "node scripts/revenue-engine.mjs --write",
    "monetization:audit": "node scripts/monetization-audit.mjs",
    "monetization:audit:write": "node scripts/monetization-audit.mjs --write",
    "operator:daily": "node scripts/operator-os.mjs --write",
    "partner:opportunity": "node scripts/partner-opportunity.mjs",
    "partner:opportunity:write": "node scripts/partner-opportunity.mjs --write",
    "experiment:booking": "node scripts/booking-experiment.mjs",
    "experiment:booking:write": "node scripts/booking-experiment.mjs --write",
    "revenue:yield": "node scripts/revenue-yield.mjs",
    "revenue:yield:write": "node scripts/revenue-yield.mjs --write",
    "revenue:import": "node scripts/revenue-import.mjs --write-ledger",
    "revenue:import:check": "node scripts/revenue-import.mjs",
    "revenue:inspect": "node scripts/revenue-import-inspect.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.1.6",
    "astro-og-canvas": "^0.13.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
