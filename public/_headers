# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# GA4（gtag.js）の送信先は connect-src で許可する。2026-10 時点の gtag.js は analytics.google.com/g/collect（サブドメインなし）へ送り、
# 予備に www.google.com/g/collect、Google シグナルで stats.g.doubleclick.net を使う。「*.analytics.google.com」はサブドメインなしに一致しない。
# 送信先が許可から外れると GA4 が計測されなくなる（2026-10-08〜10 に発生。Issue #226）。scripts/analytics-audit.mjs と本番 QA で検査する
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com; connect-src 'self' https://formspree.io https://cloudflareinsights.com https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.google.com https://*.g.doubleclick.net; form-action 'self' https://formspree.io; upgrade-insecure-requests

# 不変ハッシュ付きアセットは長期キャッシュ
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 一覧カード画像（scripts/build-og-backdrop.mjs がファイル名に内容のハッシュを入れる）は長期キャッシュ
/images/card/*
  Cache-Control: public, max-age=31536000, immutable

# ハッシュの無い写真・図版・自動生成OGPは1日（同じ名前で差し替えても、翌日までに反映される）。
# パターンを重ねると Cache-Control が連結されるため、フォルダごとに書く
/images/area/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/theme/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/news/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/intl/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
